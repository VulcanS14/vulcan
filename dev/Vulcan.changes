True: [			clickState _ #idle.			clickClient doubleClick: firstClickEvent.			^ self resetClickState].		t > DoubleClickTime ifTrue: [			clickState _ #idle.			clickClient click: firstClickEvent.			^ self resetClickState]].! !!Morph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:18' prior: 39328897!mouseHold: evt	"Handle a hold event, triggered by pressing and holding down the mouse without moving the mouse for the duration of a double click. This message is only sent to clients that request it by sending #waitForClicksOrDrag:event: to the initiating hand in their mouseDown: method. This default implementation treats a hold as a drag."	self startDrag: evt.! !!ScriptableScratchMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:19'!mouseHold: evt	self rightButtonMenu.! !!ScratchStageMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:22' prior: 37460904!mouseDown: evt	"Handle a mouse down event."	evt hand newKeyboardFocus: nil.	evt hand toolType ifNotNil: [evt hand toolType: nil].	evt rightButtonPressed		ifTrue: [Sensor waitNoButton. ^ self rightButtonMenu]		ifFalse:	[evt hand waitForClicksOrDrag: self event: evt].! !!MediaItemMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:29'!mouseHold: evt	self rightButtonMenu.! !!LibraryItemMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:30'!mouseHold: evt	self rightButtonMenu.! !!ScratchScriptsMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:32'!mouseHold: evt	self rightButtonMenu.! !!ScratchScriptsMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:33' prior: 37310250!mouseDown: evt	| m |	evt hand newKeyboardFocus: nil.	evt hand toolType ifNotNil: [		"revert to normal cursor"		evt hand toolType: nil.		^ self].	evt rightButtonPressed ifTrue: [		Sensor waitNoButton.		(m _ self ownerThatIsA: ScratchScriptEditorMorph) ifNil: [^ self].		(m target notNil and: [m currentCategory = 'Scripts'])			ifTrue: [m scriptsMenu: evt hand position].		^ self].	evt hand waitForClicksOrDrag: self event: evt.! !!ScratchScriptsMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:33' prior: 39331775!mouseHold: evt	self rightButtonMenu.! !!ScratchScriptsMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:35' prior: 39332458!mouseHold: evt	| m |	(m _ self ownerThatIsA: ScratchScriptEditorMorph) ifNil: [^ self].	(m target notNil and: [m currentCategory = 'Scripts'])		ifTrue: [m scriptsMenu: evt hand position].! !!SensorBoardMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:36'!mouseHold: evt	self rightButtonMenu.! !!SensorBoardMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:37' prior: 37832061!mouseDown: evt	evt rightButtonPressed | evt shiftPressed		ifTrue: [Sensor waitNoButton. ^ self rightButtonMenu].	evt hand toolType = 'CutTool' ifTrue: [		evt shiftPressed ifFalse: [evt hand toolType: nil].		ScratchFrameMorph putInClipboard: self.		^ self delete].	evt hand toolType ifNil: [		evt hand grabMorph: self.		^ self].	evt hand waitForClicksOrDrag: self event: evt.! !!SensorBoardMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:38' prior: 39333008!mouseDown: evt	evt rightButtonPressed | evt shiftPressed		ifTrue: [Sensor waitNoButton. ^ self rightButtonMenu].	evt hand toolType = 'CutTool' ifTrue: [		evt shiftPressed ifFalse: [evt hand toolType: nil].		ScratchFrameMorph putInClipboard: self.		^ self delete].	evt hand waitForClicksOrDrag: self event: evt.! !----STARTUP----(21 December 2008 12:12:41 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 19 December 2008 at 9:58:42 pm'!!Morph methodsFor: 'event handling' stamp: 'jm 12/19/2008 17:18'!mouseHold: evt	"Handle a hold event, triggered by pressing and holding down the mouse without moving the mouse for the duration of a double click. This message is only sent to clients tha