cratchFrameMorph methodsFor: 'accessing' stamp: 'ee 6/2/2009 18:55' prior: 37021048!projectName	^ self nameFromFileName: projectName! !!ScratchTranslator class methodsFor: 'import/export' stamp: 'ee 5/22/2009 14:16' prior: 41861315!importPootleTranslations	"Imports translations from the LLK Pootle translation directory into the Scratch/locale/ directory"	"First checkout svn://translate.scratch.mit.edu:52400 to the local directory, then run this"	"self importPootleTranslations"	| dir subDir fs |	dir _ FileDirectory default.	(dir directoryNames includes: 'translate.scratch.mit.edu')		ifTrue: [dir _ dir directoryNamed: 'translate.scratch.mit.edu'.			(dir directoryNames includes: 'scratch')				ifTrue: [dir _ dir directoryNamed: 'scratch']				ifFalse: [^ self "dialog should say no scratch folder found"]]		ifFalse: [^ self "dialog should say no scratch folder found"].	dir directoryNames do: [:n |		(n = '.svn') ifFalse: [			subDir _ dir directoryNamed: n.			fs _ self translationDir newFileNamed: n,'.po'.			fs nextPutAll: (subDir fileNamed: n,'.po') contentsOfEntireFile.			fs close]].! !!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'ee 6/2/2009 16:29' prior: 41224262!hookupSensorNames	| sensorNames stage virtualSensors |	sensorNames _ #(		'slider'		'light'		'sound'		'resistance'	).	sensorNames _ sensorNames, #('-' 'tilt' 'distance'). "WeDo sensors"	(stage _ self ownerThatIsA: ScratchStageMorph) ifNotNil: [		stage scratchServer ifNotNil: [			virtualSensors _ stage scratchServer sensorNames.			virtualSensors size > 0 ifTrue: [				^ sensorNames, {'-'}, stage scratchServer sensorNames]]].	^ sensorNames! !!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'ee 6/2/2009 14:34' prior: 41443593!motorDirection	^ {		'this way'.		'that way'.		'reverse'	}! !!ScriptableScratchMorph methodsFor: 'blocks' stamp: 'ee 6/2/2009 14:17' prior: 41375024!costumesPage: xOffset	"Answer a morph containing thumbnails of my costumes."	| bin label m y images n recBut impBut photoBut maxHeight xMargin yMargin separator |	xMargin _ 15.	yMargin _ 15.	bin _ ScratchBlockPaletteMorph new color: ScratchFrameMorph scriptsPaneColor.	(self isKindOf: ScratchStageMorph)		ifTrue: [label _ 'New background:' localized]		ifFalse: [label _ 'New costume:' localized].	m _ StringMorph		contents: label		font: (ScratchFrameMorph getFont: #CostumesPage).	m color: Color white.	bin addMorph: m.	recBut _ ScratchFrameMorph buttonLabel: 'Paint' localized selector: #drawNewCostume.	recBut target: self.	bin addMorph: recBut.	impBut _ ScratchFrameMorph buttonLabel: 'Import' localized selector: #importImage.	impBut target: self.	bin addMorph: impBut.	photoBut _ ScratchFrameMorph buttonLabel: 'Camera' localized selector: #takePhoto.	photoBut target: self.	bin addMorph: photoBut.	maxHeight _ (m height max: (impBut height max: (recBut height max: photoBut height))).	ScratchTranslator isRTL		ifTrue: [			photoBut position: xMargin@(yMargin + ((maxHeight - photoBut height) / 2)).			impBut position: (photoBut right + 4)@(yMargin + ((maxHeight - impBut height) / 2)).			recBut position: (impBut right + 4)@(yMargin + ((maxHeight - recBut height) / 2)).			m position: (recBut right + 4)@(yMargin + ((maxHeight - m height) / 2))]		ifFalse: [			m position: xMargin@(yMargin + ((maxHeight - m height) / 2)).			recBut position: (m right + 4)@(yMargin + ((maxHeight - recBut height) / 2)).			impBut position: (recBut right + 4)@(yMargin + ((maxHeight - impBut height) / 2)).			photoBut position: (impBut right + 4)@(yMargin + ((maxHeight - impBut height) / 2))].	separator _ TiledImageMorph new tileForm: (ScratchFrameMorph skinAt: #costumeSeparatorTile).	bin addMorph: (separator position: (xOffset + 17)@(yMargin + maxHeight + 5)).	y _ yMargin + maxHeight + 9.	n _ 0.	images _ media select: [:item | item isImage].	images do: [:item |		m _ MediaItemMorph new.		m scratchObj: self media: item; position: xOffset@y.		m setNumber: (n _ n + 1).		item = costume ifTrue: [m highlight: true].		bin addMorph: m.		y _ y + m height - 1.].	bin submorphs size > 0		ifTrue: [separator width: bin firstSubmorph width - 14]		ifFalse: [separator width: 240].	^ bin! !----SNAPSHOT----(3 June 2009 7:47:57 pm) priorSource: 8447874!----SNAPSHOT----(3 June 2009 7:49:54 pm) priorSource: 8452291!----QUIT----(3 June 2009 7:50:37 pm) priorSource: 8452355!----STARTUP----(3 June 2009 7:59:59 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!LibraryItemMorph methodsFor: 'event handling' stamp: 'jm 6/3/2009 20:01' prior: 39335694!mouseHold: evt	(target isKindOf: ScratchStageMorph) ifFalse: [self rightButtonMenu].! !----QUIT----(3 June 2009 8:20:24 pm) priorSource: 8452419!----STARTUP----(3 June 2009 10:44:37 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SNAPSHOT----(3 June 2009 10:45:11 pm) priorSource: 8452756!----SNAPSHOT----(3 June 2009 10:45:19 pm) priorSource: 8452912!----SAVEAS Scratch03Jun09----(3 June 2009 10:45:32 pm)!----STARTUP----(4 June 2009 10:32:18 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!BlockMorph methodsFor: 'processes' stamp: 'jm 6/4/2009 11:02' prior: 33743989!toggleProcessself beep.	self isRunning		ifTrue: [self stop]		ifFalse: [self start].! !!BlockMorph methodsFor: 'processes' stamp: 'jm 3/11/2004 17:43' prior: 42007708!toggleProcess	self isRunning		ifTrue: [self stop]		ifFalse: [self start].! !!EventHatMorph methodsFor: 'other' stamp: 'jm 6/4/2009 11:07' prior: 39338964!startForEvent: aScratchEvent	"Starts a process for this event hat triggered by the given event. Answer the process that was started or nil if no new process was started."	"Details: The current policy is to stop and re-start the script for all events except key-pressed. Key-pressed events are just ignored if the script for that event is already running."	| stage |	(aScratchEvent name = 'Scratch-KeyPressedEvent') ifFalse: [		scratchProc ifNotNil: [self stop]].  "non-key events stop currently running process, if any"	self isRunning ifTrue: [self beep. ^ nil].  "don't re-trigger if running"	scriptOwner ifNil: [^ nil].	(stage _ scriptOwner ownerThatIsA: ScratchStageMorph) ifNil: [^ nil].	scratchProc _ stage startProcessFor: self.	self changed.	^ scratchProc! !!EventHatMorph methodsFor: 'other' stamp: 'jm 6/4/2009 11:08' prior: 42008043!startForEvent: aScratchEvent	"Starts a process for this event hat triggered by the given event. Answer the process that was started or nil if no new process was started."	"Details: The current policy is to stop and re-start the script for all events except key-pressed. Key-pressed events are just ignored if the script for that event is already running."	| stage |	(aScratchEvent name = 'Scratch-KeyPressedEvent') ifFalse: [		scratchProc ifNotNil: [self beep. self stop]].  "non-key events stop currently running process, if any"	self isRunning ifTrue: [^ nil].  "don't re-trigger if running"	scriptOwner ifNil: [^ nil].	(stage _ scriptOwner ownerThatIsA: ScratchStageMorph) ifNil: [^ nil].	scratchProc _ stage startProcessFor: self.	self changed.	^ scratchProc! !!EventHatMorph methodsFor: 'other' stamp: 'jm 6/4/2009 11:08' prior: 42008903!startForEvent: aScratchEvent	"Starts a process for this event hat triggered by the given event. Answer the process that was started or nil if no new process was started."	"Details: The current policy is to stop and re-start the script for all events except key-pressed. Key-pressed events are just ignored if the script for that event is already running."	| stage |	(aScratchEvent name = 'Scratch-KeyPressedEvent') ifFalse: [		scratchProc ifNotNil: [self stop]].  "non-key events stop currently running process, if any"	self isRunning ifTrue: [^ nil].  "don't re-trigger if running"	scriptOwner ifNil: [^ nil].	(stage _ scriptOwner ownerThatIsA: ScratchStageMorph) ifNil: [^ nil].self beep. 	scratchProc _ stage startProcessFor: self.	self changed.	^ scratchProc! ! ScratchProcess blockHighlightMSecs!!ScratchStageMorph methodsFor: 'scratch processes/events' stamp: 'jm 6/4/2009 11:11' prior: 39338170!startProcessFor: aBlock	"Start a process to run the given block or stack of blocks. Return the new process."	| blockList proc |	blockList _ aBlock blockSequence.	aBlock isHatBlock ifTrue: [blockList _ blockList allButFirst].  "omit hat block"	proc _ ScratchProcess new		topBlock: aBlock;		expression: blockList.	processes addLast: proc.self halt.	^ proc! !!ScratchStageMorph methodsFor: 'scratch processes/events' stamp: 'jm 12/21/2008 12:24' prior: 42010684!startProcessFor: aBlock	"Start a process to run the given block or stack of blocks. Return the new process."	| blockList proc |	blockList _ aBlock blockSequence.	aBlock isHatBlock ifTrue: [blockList _ blockList allButFirst].  "omit hat block"	proc _ ScratchProcess new		topBlock: aBlock;		expression: blockList.	processes addLast: proc.	^ proc! !!ScratchNotePlayer methodsFor: 'playing' stamp: 'jm 6/4/2009 11:13' prior: 41945729!noteOff	"Turn of the currently sounding note, if any."Transcript show: 'on'; cr.	midiKey ifNotNil: [		midiPort ifNotNil: [midiPort midiCmd: 16r90 channel: (channel - 1) byte: midiKey byte: 0].		midiKey _ nil].	snd ifNotNil: [		snd stopGracefully.		snd _ nil].! !!ScratchNotePlayer methodsFor: 'playing' stamp: 'jm 6/4/2009 11:14' prior: 41968828!noteOn: aNumber	"Play the given note at the current volume level. The note number gives the piano key number where 60 is middle-C and there are 12 keys per octave.  The absolute value of the note number is used."	| vol |Transcript show: 'on'; cr.	midiKey _ aNumber rounded abs within: 0 and: 127.	midiPort		ifNil: [			snd _ FMSound organ1.			snd				setPitch: (AbstractSound pitchForMIDIKey: midiKey)				dur: 1000				loudness: ((volume / 100.0) within: 0.0 and: 1.0).			snd play]		ifNotNil: [			vol _ (1.27 * volume) rounded within: 0 and: 127.			midiPort midiCmd: 16r90 channel: (channel - 1) byte: midiKey byte: vol].! !!ScratchNotePlayer methodsFor: 'playing' stamp: 'jm 6/4/2009 11:14' prior: 42011600!noteOff	"Turn of the currently sounding note, if any."Transcript show: 'off'; cr.	midiKey ifNotNil: [		midiPort ifNotNil: [midiPort midiCmd: 16r90 channel: (channel - 1) byte: midiKey byte: 0].		midiKey _ nil].	snd ifNotNil: [		snd stopGracefully.		snd _ nil].! !!ScratchNotePlayer methodsFor: 'playing' stamp: 'jm 6/4/2009 11:15' prior: 42012685!noteOff	"Turn of the currently sounding note, if any."Transcript show: 'off'; cr.self halt.	midiKey ifNotNil: [		midiPort ifNotNil: [midiPort midiCmd: 16r90 channel: (channel - 1) byte: midiKey byte: 0].		midiKey _ nil].	snd ifNotNil: [		snd stopGracefully.		snd _ nil].! !!ScratchStackFrame methodsFor: 'accessing' stamp: 'jm 6/4/2009 11:17' prior: 37452857!stopMIDI	(self startValue isKindOf: ScratchNotePlayer) ifTrue: [		startValue noteOff.		startValue _ nil].! !!ScratchNotePlayer methodsFor: 'playing' stamp: 'jm 6/4/2009 11:17' prior: 42013046!noteOff	"Turn of the currently sounding note, if any."Transcript show: 'off'; cr.	midiKey ifNotNil: [		midiPort ifNotNil: [midiPort midiCmd: 16r90 channel: (channel - 1) byte: midiKey byte: 0].		midiKey _ nil].	snd ifNotNil: [		snd stopGracefully.		snd _ nil].! !!ScratchProcess methodsFor: 'entry points' stamp: 'jm 6/4/2009 11:29' prior: 41934623!stop	"Permanently terminates this process."Transcript show: 'stopping: ', self hash printString; cr.	stackFrame ifNotNil: [stackFrame stopMIDI; stopMotors; stopTalkThinkAsk].	readyToYield _ true.	readyToTerminate _ true.	topBlock ifNotNil: [topBlock clearProcess].! !!ScratchStageMorph methodsFor: 'scratch processes/events' stamp: 'jm 6/4/2009 11:30' prior: 42011157!startProcessFor: aBlock	"Start a process to run the given block or stack of blocks. Return the new process."	| blockList proc |	blockList _ aBlock blockSequence.	aBlock isHatBlock ifTrue: [blockList _ blockList allButFirst].  "omit hat block"	proc _ ScratchProcess new		topBlock: aBlock;		expression: blockList.	processes addLast: proc.Transcript show: 'starting: ', proc hash printString; cr.	^ proc! !!ScratchStageMorph methodsFor: 'scratch processes/events' stamp: 'jm 6/4/2009 11:32' prior: 39290916!removeTerminatedProcesses	"Remove terminated processes from the process list."	| runningProcesses |	runningProcesses _ processes species new: processes size.	processes do: [:p |		p isRunning			ifTrue: [runningProcesses addLast: p]			ifFalse: [p stop2]].	processes _ runningProcesses.! !!ScratchProcess methodsFor: 'entry points' stamp: 'jm 6/4/2009 11:32'!stop2	"Permanently terminates this process."Transcript show: 'stopping: ', self hash printString; cr.	stackFrame ifNotNil: [stackFrame stopMIDI; stopMotors; stopTalkThinkAsk].	readyToYield _ true.	readyToTerminate _ true.	topBlock ifNotNil: [topBlock clearProcess].! !!ScratchProcess methodsFor: 'entry points' stamp: 'jm 6/4/2009 11:32' prior: 42013980!stop	"Permanently terminates this process."	stackFrame ifNotNil: [stackFrame stopMIDI; stopMotors; stopTalkThinkAsk].	readyToYield _ true.	readyToTerminate _ true.	topBlock ifNotNil: [topBlock clearProcess].! !!EventHatMorph methodsFor: 'other' stamp: 'jm 12/21/2008 12:25' prior: 42009763!startForEvent: aScratchEvent	"Starts a process for this event hat triggered by the given event. Answer the process that was started or nil if no new process was started."	"Details: The current policy is to stop and re-start the script for all events except key-pressed. Key-pressed events are just ignored if the script for that event is already running."	| stage |	(aScratchEvent name = 'Scratch-KeyPressedEvent') ifFalse: [		scratchProc ifNotNil: [self stop]].  "non-key events stop currently running process, if any"	self isRunning ifTrue: [^ nil].  "don't re-trigger if running"	scriptOwner ifNil: [^ nil].	(stage _ scriptOwner ownerThatIsA: ScratchStageMorph) ifNil: [^ nil].	scratchProc _ stage startProcessFor: self.	self changed.	^ scratchProc! !!ScratchProcess methodsFor: 'accessing' stamp: 'jm 6/4/2009 11:34' prior: 41822928!isRunning	"Answer true if I am still running, have not encountered and error, and don't refer to any deleted objects."	topBlock scratchProc == self ifFalse: [self beep. ^ false].	^ (stackFrame notNil and:	   [errorFlag not and:	   [self includesDeletedReceiver not]])! !!ScratchProcess methodsFor: 'accessing' stamp: 'jm 5/14/2009 20:40' prior: 42016762!isRunning	"Answer true if I am still running, have not encountered and error, and don't refer to any deleted objects."	topBlock scratchProc == self ifFalse: [^ false].	^ (stackFrame notNil and:	   [errorFlag not and:	   [self includesDeletedReceiver not]])! !!ScratchProcess methodsFor: 'accessing' stamp: 'jm 2/6/2005 13:05' prior: 42017126!isRunning	"Answer true if I am still running, have not encountered and error, and don't refer to any deleted objects."	^ (stackFrame notNil and:	   [errorFlag not and:	   [self includesDeletedReceiver not]])! !!ScratchProcess methodsFor: 'accessing' stamp: 'jm 5/14/2009 20:40' prior: 42017478!isRunning	"Answer true if I am still running, have not encountered and error, and don't refer to any deleted objects."	topBlock scratchProc == self ifFalse: [^ false].	^ (stackFrame notNil and:	   [errorFlag not and:	   [self includesDeletedReceiver not]])! !!BlockMorph methodsFor: 'accessing' stamp: 'jm 6/4/2009 11:42'!scratchProc: aScratchProcess	scratchProc _ aScratchProcess.! !!ScratchStageMorph methodsFor: 'scratch processes/events' stamp: 'jm 6/4/2009 11:43' prior: 42014358!startProcessFor: aBlock	"Start a process to run the given block or stack of blocks. Return the new process."	| blockList proc |	blockList _ aBlock blockSequence.	aBlock isHatBlock