ast!!CommandBlockMorph methodsFor: 'accessing' stamp: 'jm 5/7/2009 13:18' prior: 40623367!defaultArgs: defaultValues	"Set the default values of my arguments from the given list."	1 to: (defaultValues size min: argMorphs size) do: [:i |		(argMorphs at: (argPermutation at: i)) defaultValueFromSpec: (defaultValues at: i)].! !!ArgMorph methodsFor: 'other' stamp: 'jm 5/7/2009 13:20'!defaultValueFromSpec: anObject	"Set my default value from a block specification."	self defaultValue: anObject.! !receiver stackFromTupleList: self tupleSequence receiver: receiver!submorphs last!----STARTUP----(7 May 2009 1:21:21 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!CommandBlockMorph methodsFor: 'accessing' stamp: 'jm 5/7/2009 13:28' prior: 40623367!defaultArgs: defaultValues	| arg defaultValue |	"Set the default values of my arguments from the given list."	1 to: (defaultValues size min: argMorphs size) do: [:i |		arg _ argMorphs at: (argPermutation at: i).		defaultValue _ defaultValues at: i.		arg defaultValue: defaultValue.		(('-' asUTF8 = defaultValue) and:		 [arg isKindOf: ExpressionArgMorph]) ifTrue: [			"special case for math ops: '-' creates an empty arg slot"			arg numExpression: ' ']].! !!CommandBlockMorph methodsFor: 'accessing' stamp: 'jm 5/7/2009 13:29' prior: 41676880!defaultArgs: defaultValues	"Set the default values of my arguments from the given list."	| arg defaultValue |	1 to: (defaultValues size min: argMorphs size) do: [:i |		arg _ argMorphs at: (argPermutation at: i).		defaultValue _ defaultValues at: i.		arg defaultValue: defaultValue.		(('-' asUTF8 = defaultValue) and:		 [arg isKindOf: ExpressionArgMorph]) ifTrue: [			"special case for math ops: '-' creates an empty arg slot"			arg numExpression: ' ']].! !!ExpressionArgMorph methodsFor: 'accessing' stamp: 'jm 5/7/2009 13:29' prior: 34645099!defaultValue: anObject	anObject isNumber ifTrue: [self numExpression: anObject].	(anObject isKindOf: String) ifTrue: [self stringExpression: anObject].! !!CommandBlockMorph methodsFor: 'private' stamp: 'jm 5/7/2009 13:34' prior: 40628464!argMorphToReplace: aMorph	"Answer a new argument morph to be used to replace the given morph. Answer nil if the given morph is not one of my argMorphs."	| i argSpecs spec argM defaults v |	i _ argMorphs indexOf: aMorph ifAbsent: [^ nil].	argSpecs _ (CommandBlockMorph parseCommandSpec: commandSpec) select: [:s | CommandBlockMorph isArgSpec: s].	i > argSpecs size ifTrue: [^ nil].	argM _ self argMorphFor: (argSpecs at: i).	(#setVar:to: = selector and: [(argSpecs at: i) = '%n']) ifTrue: [		^ argM stringExpression: '0'].	spec _ ScriptableScratchMorph blockSpecDict at: selector ifAbsent: [^ argM].	defaults _ spec copyFrom: 4 to: spec size.	i <= defaults size ifTrue: [		v _ defaults at: (argPermutation indexOf: i).		(v isKindOf: String)			ifTrue: [argM defaultValue: v localized]			ifFalse: [argM defaultValue: v].		((argM isKindOf: ExpressionArgMorph) and: ['-' asUTF8 = v]) ifTrue: [			"special case for math ops: '-' creates an empty arg slot"			argM numExpression: ' ']].	^ argM! !----QUIT----(7 May 2009 2:05:46 pm) priorSource: 8111946!----STARTUP----(7 May 2009 2:07:04 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ExpressionArgMorph methodsFor: 'accessing' stamp: 'jm 5/7/2009 13:13'!defaultValueFromSpec: anObject	"Like defaultValue:, but '-' in a block spec creates an empty number expression."	self defaultValue: anObject.	'-' asUTF8 = anObject ifTrue: [self numExpression: ' '].  "empty, evaluates to zero"! !!CommandBlockMorph methodsFor: 'private' stamp: 'ee 3/1/2009 18:06' prior: 41678237!argMorphToReplace: aMorph	"Answer a new argument morph to be used to replace the given morph. Answer nil if the given morph is not one of my argMorphs."	| i argSpecs spec argM defaults v |	i _ argMorphs indexOf: aMorph ifAbsent: [^ nil].	argSpecs _ (CommandBlockMorph parseCommandSpec: commandSpec) select: [:s | CommandBlockMorph isArgSpec: s].	i > argSpecs size ifTrue: [^ nil].	argM _ self argMorphFor: (argSpecs at: i).	(#setVar:to: = selector and: [(argSpecs at: i) = '%n']) ifTrue: [		^ argM stringExpression: '0'].	spec _ ScriptableScratchMorph blockSpecDict at: selector ifAbsent: [^ argM].	defaults _ spec copyFrom: 4 to: spec size.	i <= defaults size ifTrue: [		v _ defaults at: (argPermutation indexOf: i).		(v isKindOf: String)			ifTrue: [argM defaultValue: v localized]			ifFalse: [argM defaultValue: v]].	^ argM! !!CommandBlockMorph methodsFor: 'private' stamp: 'jm 5/7/2009 14:14' prior: 41679795!argMorphToReplace: aMorph	"Answer a new argument morph to be used to replace the given morph. Answer nil if the given morph is not one of my argMorphs."	| i argSpecs spec argM defaults v |	i _ argMorphs indexOf: aMorph ifAbsent: [^ nil].	argSpecs _ (CommandBlockMorph parseCommandSpec: commandSpec) select: [:s | CommandBlockMorph isArgSpec: s].	i > argSpecs size ifTrue: [^ nil].	argM _ self argMorphFor: (argSpecs at: i).	(#setVar:to: = selector and: [(argSpecs at: i) = '%n']) ifTrue: [		^ argM stringExpression: '0'].	spec _ ScriptableScratchMorph blockSpecDict at: selector ifAbsent: [^ argM].	defaults _ spec copyFrom: 4 to: spec size.	i <= defaults size ifTrue: [		v _ defaults at: (argPermutation indexOf: i).		(v isKindOf: String)			ifTrue: [				(argM isKindOf: ExpressionArgMorph)					ifTrue: [argM defaultValueFromSpec: v]					ifFalse: [argM defaultValue: v localized]]			ifFalse: [argM defaultValue: v]].	^ argM! !!CommandBlockMorph methodsFor: 'accessing' stamp: 'jm 5/7/2009 14:16' prior: 41677436!defaultArgs: defaultValues	"Set the default values of my arguments from the given list."	| argM defaultValue |	1 to: (defaultValues size min: argMorphs size) do: [:i |		argM _ argMorphs at: (argPermutation at: i).		defaultValue _ defaultValues at: i.		(argM  isKindOf: ExpressionArgMorph)			ifTrue: [argM defaultValueFromSpec: defaultValue]			ifFalse: [argM defaultValue: defaultValue]].! !self initFonts!----QUIT----(7 May 2009 2:18:25 pm) priorSource: 8124817!----STARTUP----(7 May 2009 2:22:12 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 4 May 2009 at 11:23:19 am'!!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'ee 5/4/2009 11:15' prior: 41598647!buildSpriteLabel	^ StringMorph new		font: (ScratchFrameMorph getFont: #Tab);		color: Color white;		contents: 'New sprite:' localized! !!ScratchTranslator class methodsFor: 'language translation' stamp: 'ee 5/4/2009 11:17' prior: 41556793!resetUITranslationSet	UITranslationSet _ Set new.		  #('Normal' 'new' 'New' 't' 'New sound:' 'New sprite:' 'New costume:' 'New Filename:' 'New background:' 'No' 'No motion blocks' 'OK' 'New Sprite' '3' 'No variables.' 'no scripts' 'm' 'normal readout' 'No serial ports found' 'No MIDI ports currently available.' 'Open' 'Off' 'f' 'Open Project' 'On' 'Preparing project...' 'or' 'Open a Scratch project' 'only face left-right' '10 ^' 'B' '10' 'play' 'Pictures' 'Password:' 'Project Notes' 'Project notes' 'Paint' 'pop' 'Project uploaded.' 'u' 'Project name' 'Please enter a number' 'Paint Editor' 'Projects' 'Paintbrush' 'pixelate' 'Project author:' 'Paint new sprite' 'Percent? (100 gives original size)' '4' 'n' 'abs' 'atan' 'Position the cross-hair to set the rotation center' 'asin' 'Quit' 'Quit Scratch' 'About Scratch' 'and' '-' 'acos' 'all' 'any' 'Brush size: ' 'g' '1 script' 'add comment' 'Animation' 'Art' 'add comment here' 'About this project:' 'Redo' 'right' 'resistance' 'backgrounds' 'Backgrounds' 'button pressed' 'Reference Guide' 'button' 'save picture of stage...' 'recording' 'Save As' 'record' 'Record' 'right arrow' '<' 'background' 'brightness' 'Remove viewer from stage' 'v' 're-record' 'set translation formatting...' 'reverse' 'Rotate clock-wise' 'Rotation degrees?' 'resize this sprite' 'rotate this spr