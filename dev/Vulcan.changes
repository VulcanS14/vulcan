s' action: #compressImages.	menu addLine.	workPane showMotorBlocks		ifTrue: [menu add: 'Hide Motor Blocks' action: #hideMotorBlocks]		ifFalse: [menu add: 'Show Motor Blocks' action: #showMotorBlocks].	menu localize.	#(2 3) do: [:n |		menu labels at: n put:			((menu labels at: n) copyFrom: 1 to: (menu labels at: n) size - 1), ScratchTranslator ellipsesSuffix].	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/13/2009 15:04'!shareMenu: aMenuTitleMorph	| menu |	menu _ CustomMenu new.	menu add: 'Share This Project Online' action: #share.	menu add: 'Go To Scratch Website' action: #launchScratchWebsite.	menu localize.	#(1 2) do: [:n |		menu labels at: n put:			((menu labels at: n) copyFrom: 1 to: (menu labels at: n) size - 1), ScratchTranslator ellipsesSuffix].	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/13/2009 15:04'!languageMenu: aMenuTitleMorph	self setLanguage.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/13/2009 15:05'!helpMenu: aMenuTitleMorph	| menu |	menu _ CustomMenu new.	menu add: 'About Scratch' action: #aboutScratch.	menu add: 'Getting Started' action: #launchGettingStarted.	menu add: 'Reference Guide' action: #launchReferenceGuide.	menu add: 'Help Screens' action: #launchAllHelpScreens.	menu add: 'Support Site' action: #launchSupportWebsite.	menu addLine.	ScratchProcess blockHighlightMSecs <= 1		ifTrue: [menu add: 'Start Single Stepping' action: #toggleSingleStepping]		ifFalse: [menu add: 'Stop Single Stepping' action: #toggleSingleStepping].	menu add: 'Set Single Stepping' action: #setSingleStepping.	menu localize.	#(2 3) do: [:n |		menu labels at: n put:			((menu labels at: n) copyFrom: 1 to: (menu labels at: n) size - 1), ' (PDF) '].	#(1 2 3 4 5 7) do: [:n |		menu labels at: n put:			((menu labels at: n) copyFrom: 1 to: (menu labels at: n) size - 1), ScratchTranslator ellipsesSuffix].	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/13/2009 15:05' prior: 40099417!languageMenu: aMenuTitleMorph	"Present a menu of possible languages for blocks."	| menu choice |	ScratchTranslator canRenderUnicode ifFalse: [		"try to find a Unicode plugin in case this is the first use after startup"		ScratchTranslator detectRenderPlugin].	menu _ CustomMenu new.	ScratchTranslator languageNames do: [:lang |		((ScratchTranslator isoCodeForName: lang) = (ScratchTranslator currentLanguage))			ifTrue: [menu add: ('• ', lang) action: lang]			ifFalse: [menu add: lang action: lang]].	choice _ menu startUp.	choice ifNil: [^ self].	self stopAll.	self setLanguage: choice.	self recordLanguage: (ScratchTranslator currentLanguage).! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/13/2009 15:06' prior: 40093056!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton buttonSpecs b |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu:		'Open, save, and share projects')		(Edit			editMenu:		'Undo the last delete')		(Share			shareMenu:		'Share this project online')		(Language		languageMenu:	'Switch languages')		(Help			helpMenu:		'Get help')	).	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	"buttonSpecs defines the save and share buttons"	buttonSpecs _ #(		"name			tool tip				selector"		(save			'Save this project'	saveScratchProjectNoDialog)		(share			'Share this project'	share)	).	buttonSpecs do: [:spec |		b _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver')			offForm: (ScratchFrameMorph skinAt: (spec at: 1), 'Button')			overForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver').		b			target: self;			actionSelector: (spec at: 3);			setBalloonText: (spec at: 2) localized;			actWhen: #buttonUp;			isMomentary: true.		menuPanel addMorphBack: b.		((spec at: 1) = 'save') ifTrue: [			menuPanel addMorphBack: (Morph new extent: (8@5); color: Color transparent)]].	menuPanel addMorphBack: (Morph new extent: ((stageFrame width - 140)@5); color: Color transparent).	self addViewModeButtonsTo: menuPanel.	TakeOverScreen ifTrue: [		closeButton _ IconicButton new			labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !ScratchFrameMorph removeSelector: #languageMenu!ScratchFrameMorph removeSelector: #helpMenu!ScratchFrameMorph removeSelector: #editMenu!ScratchFrameMorph removeSelector: #shareMenu!ScratchFrameMorph removeSelector: #fileMenu!ScratchFrameMorph removeSelector: #shareDisabled!ScratchFrameMorph removeSelector: #writeEndUserImageAndQuit!ScratchFrameMorph removeSelector: #makePresentationButton!Morph subclass: #ScratchFrameMorph	instanceVariableNames: 'topPane viewerPane scriptsPane stageFrame workPane titlePane libraryPane menuPanel buttonPanel readoutPane logoMorph projectTitleMorph flagButton fillScreenFlag paintingInProgress projectDirectory projectName projectInfo author loginName loginPassword watcherPositions shuffledCostumeNames justSaved viewModeButtons viewMode lastViewMode  '	classVariableNames: 'ClassmateDemo Clipboard DefaultSprite Fonts FontsXO IsXO MinHeight