n: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sound) & (sounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Sounds' action: #scratchSounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].! !!ScratchServer methodsFor: 'private-incoming commands' stamp: 'jm 3/26/2009 09:36'!resendAllVars	"Force all my global variables to be re-transmitted."	lastSentValues _ lastSentValues species new.! !!ScratchServer methodsFor: 'private-server' stamp: 'jm 3/26/2009 09:38' prior: 37330641!acceptNewConnections	"Accept new connections, if any. Also process any newly connected outgoing sockets."	| newSock |	serverSocket ifNil: [^ self].	[serverSocket isConnected] whileTrue: [		newSock _ serverSocket accept.		peerSockets addLast: (MessageSocket new on: newSock).		self resendAllVars].! !!ScratchPresenterMorph methodsFor: 'event handling' stamp: 'jm 12/3/2007 08:30' prior: 41072582!mouseDown: evt	"There are three possible cases: drag a sprite, and adjust a slider, and do nothing. To drag a sprite, set mouseFocus to the sprite and dragOffset to the cursor offset the sprite's position. To adjust a slider, set the mouseFocus to the slider and dragOffset to nil. To do nothing, set both to nil."	| p adjustedEvt rootM |	mouseFocus _ nil.	dragOffset _ nil.	clickWasHandled _ false.	mouseMoved _ false.	evt hand toolType: nil.	p _ mouseDownPoint _ stage adjustedCursorPoint.	adjustedEvt _ evt copy setCursorPoint: p.	rootM _ stage submorphs		detect: [:m | (m containsPoint: p) & m isHidden not]		ifNone: [			(stage containsPoint: p) ifTrue: [stage click: adjustedEvt].			clickWasHandled _ true.			^ self].	(rootM isKindOf: ScratchSpriteMorph) ifTrue: [		rootM draggable			ifTrue: [				rootM comeToFront.				mouseFocus _ rootM.				dragOffset _ rootM position - p]			ifFalse: [				rootM click: adjustedEvt.				clickWasHandled _ true].		^ self].	(rootM unlockedMorphsAt: p) do: [:m |		(m handlesMouseDown: adjustedEvt) ifTrue: [			mouseFocus _ m.			dragOffset _ nil.			mouseFocus mouseDown: adjustedEvt.			^ self]].! !!ScratchUploadProgressDialog methodsFor: 'private-other' stamp: 'jm 3/20/2009 15:20' prior: 41054936!createRequest	"Create the POST request body for my project."	| s contentSize header prefix |	"build contents"	s _ WriteStream on: (ByteArray new: 10000000).	self add: 'username' value: userName to: s.	self add: 'password' value: password to: s.	self add: 'scratchkey' value: 'ch4ng3me' to: s.	self add: 'project_name' value: projectName asUTF8 to: s.	self add: 'project_description' value: projectNotes asUTF8 to: s.	self add: 'project_history' value: self projectHistoryString asUTF8 to: s.	self add: 'tags' value: tags asUTF8 to: s.	self add: 'version' value: ScratchFrameMorph version asUTF8 to: s.	self add: 'version-date' value: ScratchFrameMorph versionDate asUTF8 to: s.	self addSpriteAndScriptCountsTo: s.	self addScriptsAndSensorBlockFlagsTo: s.	self addProjectDataTo: s.	self add: 'thumbnail_image'		filename: 'thumbnail.gif'		type: 'image/gif'		data: self thumbnailAsGIF		to: s.	self add: 'preview_image'		filename: 'preview.gif'		type: 'image/gif'		data: self previewAsGIF		to: s.	s nextPutString: '--', boundary, '--', String crlf.	contentSize _ s position.	"build the header"	header _ WriteStream on: (String new: 1000).	prefix _ ''.	ProxyServer ifNotNil: [prefix _ 'http://', hostName, ':80'].	header nextPutString: (		'POST ', prefix, servicePath, ' HTTP/1.1', String crlf,			'Host: ', hostName, String crlf,			'Content-Type: multipart/form-data; boundary=', boundary, String crlf,			'Content-Length: ').	header nextPutString: contentSize printString, String crlf, String crlf.	header _ header contents.	request _ ByteArray new: header size + contentSize.	request replaceFrom: 1 to: header size with: header.	request replaceFrom: header size + 1 to: request size with: s contents.	^ request! !ProxyServer!ProxyPort!self initialize!ProxyServer!	ProxyServer _ '85.15.233.44'.!ProxyPort!ProxyServer!ProxyServer!ProxyPort!	ProxyServer _ '89.207.246.129'.	ProxyPort _ 3128.!	ProxyServer _ '89.207.246.129'.	ProxyPort _ 3128.!!ScratchUploadProgressDialog methodsFor: 'private-other' stamp: 'jm 3/24/2009 13:39' prior: 41086760!createRequest	"Create the POST request body for my project."	| s contentSize header prefix |	"build contents"	s _ WriteStream on: (ByteArray new: 10000000).	self add: 'username' value: userName to: s.	self add: 'password' value: password to: s.	self add: 'scratchkey' value: 'ch4ng3me' to: s.	self add: 'project_name' value: projectName asUTF8 to: s.	self add: 'project_description' value: projectNotes asUTF8 to: s.	self add: 'project_history' value: self projectHistoryString asUTF8 to: s.	self add: 'tags' value: tags asUTF8 to: s.	self add: 'version' value: ScratchFrameMorph version asUTF8 to: s.	self add: 'version-date' value: ScratchFrameMorph versionDate asUTF8 to: s.	self addSpriteAndScriptCountsTo: s.	self addScriptsAndSensorBlockFlagsTo: s.	self addProjectDataTo: s.	self add: 'thumbnail_image'		filename: 'thumbnail.gif'		type: 'image/gif'		data: self thumbnailAsGIF		to: s.	self add: 'preview_image'		filename: 'preview.gif'		type: 'image/gif'		data: self previewAsGIF		to: s.	s nextPutString: '--', boundary, '--', String crlf.	contentSize _ s position.	"build the header"	header _ WriteStream on: (String new: 1000).	prefix _ ''.	ProxyServer ifNotNil: [prefix _ 'http://', hostName, ':80'].	header nextPutString: (		'POST ', prefix, servicePath, ' HTTP/1.1', String crlf,			'Host: ', hostName, String crlf,			'Connection: close', String crlf,			'Proxy-Connection: close', String crlf,			'Content-Type: multipart/form-data; boundary=', boundary, String crlf,			'Content-Length: ').	header nextPutString: contentSize printString, String crlf, String crlf.	header _ header contents.	request _ ByteArray new: header size + contentSize.	request replaceFrom: 1 to: header size with: header.	request replaceFrom: header size + 1 to: request size with: s contents.	^ request! !self initialize!self initialize!ProxyServer!self initialize!self initialize!ProxyPort!	ProxyServer _ '85.15.233.44'!ProxyServer!----SNAPSHOT----(26 March 2009 10:09:36 am) priorSource: 7521312!ProxyServer!self initialize!ProxyServer!ProxyPort!----QUIT----(26 March 2009 10:41:10 am) priorSource: 7536427!----STARTUP----(26 March 2009 8:14:27 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!self test!ProxyServer!ProxyServer!ProxyPort!----SNAPSHOT----(26 March 2009 8:36:05 pm) priorSource: 7536552!----STARTUP----(26 March 2009 8:36:26 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image! DialogBoxMorph askWithCancel: 'Save the current project?'.! DialogBoxMorph askWithCancel: 'Save the current project?'.! DialogBoxMorph askWithCancel: 'Save the current project?'. !DialogBoxMorph subclass: #ScratchCloseDialog	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Dialogs'!!ScratchCloseDialog methodsFor: 'no messages' stamp: 'jm 3/26/2009 20:40'!initialize	super initialize.! !!ScratchCloseDialog methodsFor: 'as yet unclassified' stamp: 'jm 3/26/2009 20:44' prior: 41091774!initialize	| spacer |	super initialize.	"Note: The button row morph was created by initialize; I just replace its contents with a new collection of buttons."	spacer _ Morph new extent: 10@5; color: Color transparent.	buttonRow removeAllMorphs.	buttonRow addMorphBack: (AlignmentMorph newSpacer: Color transparent).	buttonRow addMorphBack: spacer.	buttonRow addMorphBack: (self buttonLabel: 'Don''t save' localized action: #no).	buttonRow addMorphBack: spacer fullCopy.	buttonRow addMorphBack: (self buttonLabel: 'Cancel' localized action: #cancelled).	buttonRow addMorphBack