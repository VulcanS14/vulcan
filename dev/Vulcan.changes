'		shareDisabled	'Share your project on the web')		(Help			launchHelp		'Get help')	).	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '� ' asUTF8, (spec at: 1) localized, ' �' asUTF8].		(#(undoTool share launchHelp) includes: m selector) ifTrue: [m actOnMouseUp: true].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	self addViewModeButtonsTo: menuPanel.	closeButton _ IconicButton new		labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;		actionSelector: #quitScratch;		target: self;		actWhen: #buttonDown.	menuPanel addMorphBack: closeButton.	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'accessing' stamp: 'ee 12/12/2008 11:12' prior: 39152495!updatePanes	| p |	menuPanel delete.	self createMenuPanel.	scriptsPane tabPane delete.	scriptsPane createTabPane.	workPane sensorBoard owner		ifNil: [p _ nil]		ifNotNil: [p _ workPane sensorBoard position].	workPane resetSensorBoard.	p ifNotNil:[		self showSensorBoard		workPane sensorBoard position: p].	libraryPane clearLibrary.	self scratchWatchers do: [:w | w languageChanged].	self listWatchers do: [:w | w fixLayoutForNewLanguage].	World startSteppingSubmorphsOf: self.	self fixLayout.	scriptsPane fixLayout.	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/11/2008 14:11' prior: 39153136!fileMenu	| menu |	menu _ CustomMenu new.	menu add: 'new' action: #newScratchProject.	menu add: 'open' action: #openScratchProject.	menu add: 'save (s)' action: #saveScratchProjectNoDialog.	menu add: 'save as' action: #saveScratchProject.	menu addLine.	menu add: 'export sprite' action