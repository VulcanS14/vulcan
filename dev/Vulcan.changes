: 40822174!processNextChunk	| length chunkType chunkCrc crc |	length _ self uint32.	chunkType _ (self next: 4) asString.	chunk _ self next: length.	chunkCrc _ self uint32 bitXor: 16rFFFFFFFF.	crc _ self updateCrc: 16rFFFFFFFF from: 1 to: 4 in: chunkType.	crc _ self updateCrc: crc from: 1 to: length in: chunk.	crc = chunkCrc ifFalse: [		self error: 'PNGReadWriter crc error in chunk ', chunkType].	chunkType = 'IEND' ifTrue: [^ self].		"*should* be the last chunk"	chunkType = 'sBIT' ifTrue: [^ self processSBITChunk].	"could indicate unusual sample depth in original"	chunkType = 'gAMA' ifTrue: [^ self].	"indicates gamma correction value"	chunkType = 'bKGD' ifTrue: [^ self processBackgroundChunk].	chunkType = 'pHYs' ifTrue: [^ self processPhysicalPixelChunk].	chunkType = 'tRNS' ifTrue: [^ self processTransparencyChunk].	chunkType = 'IHDR' ifTrue: [^ self processIHDRChunk].	chunkType = 'PLTE' ifTrue: [^ self processPLTEChunk].	chunkType = 'IDAT' ifTrue: [		"Since the compressed data can span multiple chunks, stitch them all together first. Later, if memory is an issue, we need to figure out how to do this on the fly."		globalDataChunk _ globalDataChunk			ifNil: [chunk]			ifNotNil: [globalDataChunk,chunk].		^ self].	unknownChunks add: chunkType.! !!PNGReadWriter methodsFor: 'chunks' stamp: 'jm 3/17/2009 15:15' prior: 40872496!processNextChunk	| length chunkType chunkCrc crc |	length _ stream uint32.	chunkType _ (self next: 4) asString.	chunk _ self next: length.	chunkCrc _ stream uint32 bitXor: 16rFFFFFFFF.	crc _ self updateCrc: 16rFFFFFFFF from: 1 to: 4 in: chunkType.	crc _ self updateCrc: crc from: 1 to: length in: chunk.	crc = chunkCrc ifFalse: [		self error: 'PNGReadWriter crc error in chunk ', chunkType].	chunkType = 'IEND' ifTrue: [^ self].		"*should* be the last chunk"	chunkType = 'sBIT' ifTrue: [^ self processSBITChunk].	"could indicate unusual sample depth in original"	chunkType = 'gAMA' ifTrue: [^ self].	"indicates gamma correction value"	chunkType = 'bKGD' ifTrue: [^ self processBackgroundChunk].	chunkType = 'pHYs' ifTrue: [^ self processPhysicalPixelChunk].	chunkType = 'tRNS' ifTrue: [^ self processTransparencyChunk].	chunkType = 'IHDR' ifTrue: [^ self processIHDRChunk].	chunkType = 'PLTE' ifTrue: [^ self processPLTEChunk].	chunkType = 'IDAT' ifTrue: [		"Since the compressed data can span multiple chunks, stitch them all together first. Later, if memory is an issue, we need to figure out how to do this on the fly."		globalDataChunk _ globalDataChunk			ifNil: [chunk]			ifNotNil: [globalDataChunk,chunk].		^ self].	unknownChunks add: chunkType.! !!PNGReadWriter methodsFor: 'writing' stamp: 'jm 3/16/2009 22:16' prior: 40591616!writeType6DataOn: zStream	"Write RGBA data."	| transparentRGBA bits pix |	transparentRGBA _ #(0 0 0 0) asByteArray.	bits _ form bits.	form depth < 32 ifTrue: [bits _ (form asFormOfDepth: 32) bits].	1 to: bits size do: [:i |		(i \\ form width) = 1 ifTrue: [zStream nextPut: 0]. "insert filterType at start of each scanline"		pix _ bits at: i.		pix = 0			ifTrue: [zStream nextPutAll: transparentRGBA]			ifFalse: [				zStream nextPut: ((pix bitAnd: 16rFF0000) bitShift: -16).				zStream nextPut: ((pix bitAnd: 16rFF00) bitShift: -8).				zStream nextPut: (pix bitAnd: 16rFF).				zStream nextPut: 16rFF]].	zStream close.! !!PNGReadWriter methodsFor: 'chunks' stamp: 'jm 3/17/2009 15:20' prior: 40833222!processIHDRChunk	| s compression filterMethod |	s _ ReadStream on: chunk.	width _ s uint32.	height _ s uint32.	bitsPerChannel _ s next.	colorType _ s next.	compression _ s next.		"TODO - validate compression"	filterMethod _ s next.		"TODO - validate filterMethod"	interlaceMethod _ s next.	"TODO - validate interlace method"	(#(2 4 6) includes: colorType) ifTrue: [depth _ 32].	(#(0 3) includes: colorType) ifTrue: [		depth _ bitsPerChannel min: 8.		colorType = 0 ifTrue: [ "grayscale"			palette _ self grayColorsFor: depth]].