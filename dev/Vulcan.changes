) + (spaceWidth@0)))].		ScratchTranslator isRTL		ifTrue: [panel extent: ((labelX right) max: (labelY right))@(labelY bottom)]		ifFalse: [panel extent: ((readoutX right) max: (readoutY right))@(labelY bottom)].	^ panel! !!ScratchFrameMorph methodsFor: 'geometry' stamp: 'ee 2/19/2009 13:44' prior: 40300040!fixLayout	| stageExtent xyReadout |	stageExtent _		workPane isQuarterSize			ifTrue: [workPane extent // 2]			ifFalse: [workPane extent].	topPane		position: self topLeft;		width: self width;		height: (menuPanel height + 0 max: logoMorph height + 10).	stageFrame		extent: stageExtent + (14@42);		top: topPane bottom;		right: self right.	workPane position: stageFrame topLeft + (4@37).	titlePane		position: stageFrame topLeft + (0@1);		width: stageFrame width - 6;		height: 36.	self fixProjectTitleMorphLayout.	viewerPane position: topPane bottomLeft;		width: viewerPane catButtonsExtent x + 17;		height: self bottom - topPane bottom."Disable palette hiding:	self hidePalette: ((self width - (stageExtent x + viewerPane width)) < 180).xxx"	viewerPane owner isNil		ifTrue: [			scriptsPane position: topPane bottomLeft;				width: self width - stageFrame width;				height: self bottom - topPane bottom]		ifFalse: [			scriptsPane position: viewerPane topRight;				width: self width - (stageFrame width + viewerPane width);				height: self bottom - topPane bottom].	scriptsPane fixLayout.	libraryPane position: stageFrame bottomLeft;		width: (self right - scriptsPane right);		height: self bottom - libraryPane top.	menuPanel		left: logoMorph right + 18;		top: topPane top + ((topPane height - menuPanel height) // 2) + 2;		width: (self right - menuPanel left) - 15.	buttonPanel		position: (stageFrame left + 10)@(topPane bottom + 5);		height: (workPane top - stageFrame top) - 8;		width: stageFrame width - 28.	xyReadout _ readoutPane submorphs at: 1.	readoutPane		width: xyReadout width + 23;		height: xyReadout height + 15;		position: stageFrame bottomRight - ((readoutPane width + 6)@3).	xyReadout position: readoutPane position + (18@5).! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 2/18/2009 10:25' prior: 40301933!addViewModeButtonsTo: aMorph	| specs bName button |	viewModeButtons _ OrderedCollection new.	specs _ OrderedCollection new.	ScratchFrameMorph quarterModeEnabled ifTrue: [		specs add: #(quarter		enterQuarterMode	'Switch to small stage view')].	ScratchFrameMorph normalModeEnabled ifTrue: [		specs add: #(normal		enterNormalMode	'Switch to full stage view')].	specs add: #(presentation	enterPresentationMode	'Switch to presentation view').	specs do: [:spec |		bName _ spec first.		button _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOn')			offForm: (ScratchFrameMorph skinAt: bName, 'ViewMode')			overForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		aMorph			addMorphBack: button;			addMorphBack: (Morph new extent: 1@5; color: Color transparent).		viewModeButtons add: button].! !!ScratchFrameMorph class methodsFor: 'utilities' stamp: 'ee 2/21/2009 14:43' prior: 40302988!helpServer	"Answer the name of the Scratch help site server.  This is just a placeholder, and not being used right now"	^ ShareServer! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'ee 2/19/2009 11:40' prior: 40303230!saveScriptsToImage	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| scriptsPage bg scriptsForm fName saveForm |	scriptsPage _ pageViewerMorph contents fullCopy.	scriptsPage cleanUp; position: 0@0.	bg _ Morph new color: Color transparent.	scriptsPage submorphsDo: [:m | bg addMorph: m].	bg extent: bg fullBounds extent.	scriptsForm _ bg imageForm copy: (bg imageForm rectangleEnclosingPixelsNotOfColor: Color transparent).	"add a margin"	saveForm _ Form extent: (scriptsForm boundingBox extent + 40) depth: 32.	saveForm fillColor: Color transparent.	saveForm copy: scriptsForm boundingBox from: scriptsForm to: (20@20) rule: Form paint.	fName _ ScratchFileChooserDialog		chooseNewFileDefault: ''		title: 'Save Scripts Snapshot'		type: #scriptsSnapshot.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.gif') ifFalse: [fName _ fName, '.gif'].	saveForm writeGIFFileNamed: fName.! !!ScratchScriptEditorMorph methodsFor: 'private' stamp: 'ee 2/20/2009 13:14' prior: 40304301!addReadouts	"Add readouts for my target's position and direction."	| x y label readout s |	self deleteReadouts.	readoutMorphs _ OrderedCollection new.	x _ nameMorph left.	y _ nameMorph bottom + 5.	#(('x' xpos) ('y' ypos)('direction' heading)) do: [:spec |		(ScratchTranslator isRTL and: [(spec at: 1) = 'x' or: [(spec at: 1) = 'y']])			ifTrue: [s _ (':', spec first) asUTF8]			ifFalse: [s _ (spec first localized, ScratchTranslator colonSuffix)].		label _ StringMorph new			contents: s;			font: (ScratchFrameMorph getFont: #XYReadout);			position: x@y.		readout _ (UpdatingStringMorph on: self target selector: spec second)			font: (ScratchFrameMorph getFont: #XYReadoutBold);			forceUnicodeRendering: true;			color: (Color gray: 0.2);			contents: '-000';  "this sets the readout size"			growable: false;			stepTime: 100;			position: (label right + 4)@y.		ScratchTranslator isRTL ifTrue:[			readout rightJustify: true].		self addMorph: label; addMorph: readout.		readoutMorphs add: label; add: readout.		readout startStepping.		x _ readout right + 2].	ScratchTranslator isRTL ifTrue: [		readoutMorphs reversed do: [: m |			readoutMorphs remove: m.			readoutMorphs add: m]].	penReadout _ Morph new extent: 15@5.	penReadout position: (lockButton right + 4)@(nameMorph top + ((nameMorph height - penReadout height) / 2));		color: Color transparent.	self addMorph: penReadout.	readoutMorphs add: penReadout.	penReadout startStepping.	readoutMorphs _ readoutMorphs asArray.! !PaintColorPicker removeSelector: #drawOn:!ImageFrameMorph subclass: #PaintColorPicker	instanceVariableNames: 'selectedColor target selector selector2 shadePickerContainer colorPickerImage colorPickerContainer shadePickerImage '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-Paint'!ColorPicker _ SquareColorPicker _ nil!----QUIT----(23 February 2009 12:11:37 am) priorSource: 6731092!----STARTUP----(23 February 2009 6:46:05 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/23/2009 06:50' prior: 40056588!launchHelpFile: aFilename	| helpDir subDir |	(FileDirectory default directoryNames includes: 'Help') ifFalse: [^ self beep].  "no help folder"	self stopAll.	helpDir _ FileDirectory default directoryNamed: 'Help'.	"use the English subfolder by default if it exists"	(helpDir directoryNames includes: 'en') ifTrue: [subDir _ helpDir directoryNamed: 'en'].	"use subfolder for the current language if it exists"	(helpDir directoryNames includes: ScratchTranslator currentLanguage) ifTrue: [		subDir _ helpDir directoryNamed: ScratchTranslator currentLanguage].	subDir ifNotNil: [helpDir _ subDir].self halt.	(helpDir fileExists: aFilename)		ifTrue: [ScratchPlugin primOpenURL: helpDir pathName, FileDirectory slash, aFilename]		ifFalse: [DialogBoxMorph inform: 'Scratch help file not found.' localized].! !helpDir fileExists: aFilename!ScratchPlugin primOpenURL: helpDir pathName, FileDirectory slash, aFilename! helpDir pathName, FileDirectory slash, aFilename!ScratchPlugin primOpenURL: 'file://', helpDir pathName, FileDirectory slash, aFilename!'file://', helpDir pathName, FileDirectory slash, aFilename!ScratchPlugin primOpenURL: 'file://', helpDir pathName, FileDirectory slash, aFilename!ScratchPlugin primOpenURL: 'file:///Users/jmaloney