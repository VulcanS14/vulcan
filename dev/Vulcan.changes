odsFor: 'media' stamp: 'jm 4/10/2009 16:45' prior: 41378978!takePhoto	"Take a photo."	| dialog response n |	dialog _ ScratchCameraDialog new.	response _ dialog getUserResponse.	response = #cancelled ifTrue: [^ self].	n _ self unusedMediaNameFromBaseName: 'costume' localized.	self addMediaItem: (ImageMedia new mediaName: n; form: dialog getPhoto).! !----SNAPSHOT----(10 April 2009 4:45:33 pm) priorSource: 7824798!----SAVEAS CameraTest----(10 April 2009 4:45:41 pm)!----STARTUP----(13 April 2009 8:06:06 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/13/2009 20:07' prior: 41285217!addShortcutButtonsTo: rowMorph	| buttonSpecs b |	buttonSpecs _ #(		"name		tool tip				selector"		(save		'Save this project'	saveScratchProjectNoDialog)		(share		'Share this project'	share)	).	AllowSharing ifFalse: [		buttonSpecs _ buttonSpecs select: [:spec | spec first ~= #share]].	buttonSpecs do: [:spec |		b _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver')			offForm: (ScratchFrameMorph skinAt: (spec at: 1), 'Button')			overForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver').		b			target: self;			actionSelector: (spec at: 3);			setBalloonText: (spec at: 2) localized;			actWhen: #buttonUp;			isMomentary: true.		'share' = (spec at: 1) ifTrue: [  "add spaer between buttons if share is showing"			rowMorph addMorphBack: (Morph new extent: (8@5); color: Color transparent)].		rowMorph addMorphBack: b].	rowMorph addMorphBack: (Morph new extent: (10@5); color: Color transparent).! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/13/2009 20:07' prior: 41333579!createToolbar	"Create and add the toolbar."	| buttonSpecs bName button |	buttonSpecs _ #(		"name			selector"			"tooltip"		(copy			copyTool		'Duplicate')		(delete			cutTool			'Delete')		(zoomIn 		zoomInTool		'Grow sprite')		(zoomOut 		zoomOutTool		'Shrink sprite')	).	toolbarPanel _ AlignmentMorph new		centering: #center;		height: 20;		color: Color transparent.			buttonSpecs do: [:spec |		bName _ spec at: 1.		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (bName, 'ButtonPressed') asSymbol)			offForm: (ScratchFrameMorph skinAt: (bName, 'Button') asSymbol)			overForm: (ScratchFrameMorph skinAt: (bName, 'ButtonOver') asSymbol).		button			target: self;			actionSelector: (spec at: 2);			isMomentary: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		toolbarPanel addMorphBack: button].	self addMorph: toolbarPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/13/2009 20:10' prior: 41273072!createViewModeButtonsPanel	| specs bName button |	viewModeButtonsPanel _ AlignmentMorph newRow color: Color transparent.	viewModeButtons _ OrderedCollection new.	specs _ OrderedCollection new.	ScratchFrameMorph quarterModeEnabled ifTrue: [		specs add: #(quarter		enterQuarterMode	'Switch to small stage')].	ScratchFrameMorph normalModeEnabled ifTrue: [		specs add: #(normal		enterNormalMode	'Switch to full stage')].	specs add: #(presentation	enterPresentationMode	'Switch to presentation mode').	specs do: [:spec |		bName _ spec first.		button _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOn')			offForm: (ScratchFrameMorph skinAt: bName, 'ViewMode')			overForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		viewModeButtonsPanel			addMorphBack: button;			addMorphBack: (Morph new extent: 1@5; color: Color transparent).		viewModeButtons add: button].	self addMorph: viewModeButtonsPanel.! !self extent!self extent: 640@480!self extent: 800@480!self extent!self extent!self extent!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 4/13/2009 20:15' prior: 41015883!fileMenu: aMenuTitleMorph	| menu enableRenderingMenu |	menu _ CustomMenu new.	menu add: 'New' action: #newScratchProject.	menu add: 'Open' action: #openScratchProject.	menu add: 'Save' action: #saveScratchProjectNoDialog.	menu add: 'Save As' action: #saveScratchProject.	menu addLine.	menu add: 'Import Project' action: #importScratchProject.	menu add: 'Export Sprite' action: #exportSprite.	menu addLine.	menu add: 'Project Notes' action: #editNotes.	menu addLine.	menu add: 'Quit' action: #quitScratch.	Sensor shiftPressed ifFalse: [  "normal menu"		self addServerCommandsTo: menu].	Sensor shiftPressed ifTrue: [  "special menu"		enableRenderingMenu _ false.		enableRenderingMenu ifTrue: [			menu add: 'set translation formatting...' action: #renderingMenu.			menu addLine].		menu add: 'write project summary' action: #writeSummaryFile.		menu add: 'write multiple project summaries' action: #writeMultipleSummaries.].	menu localize.		#(2 4 5 6 7) do: [:n |		menu labels at: n put:			((menu labels at: n) copyFrom: 1 to: (menu labels at: n) size - 1), ScratchTranslator ellipsesSuffix].	menu invokeOn: self at: aMenuTitleMorph bottomLeft + (0@10).! !----SNAPSHOT----(13 April 2009 8:15:58 pm) priorSource: 7825376!!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'jm 4/13/2009 21:00' prior: 39160086!quarterModeEnabled	"QuarterModeEnabled _ true"	"QuarterModeEnabled _ false"	^ QuarterModeEnabled! !ScratchFrameMorph class removeSelector: #quarterModeEnabled:!!ScratchFrameMorph methodsFor: 'view mode' stamp: 'jm 4/13/2009 21:01' prior: 39310950!enterQuarterMode	"Go into quarter stage mode."	(viewMode = #quarter) ifTrue: [		self updateViewModeButtons.		^ self].	viewMode _ #quarter.	workPane isQuarterSize: true.	workPane isInWorld		ifTrue: [self fixLayout]		ifFalse: [self exitPresentationMode].	self updatePanes.	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/13/2009 21:03' prior: 41382139!createViewModeButtonsPanel	| specs bName button |	viewModeButtonsPanel _ AlignmentMorph newRow color: Color transparent.	viewModeButtons _ OrderedCollection new.	specs _ OrderedCollection new.	specs add: #(quarter			enterQuarterMode		'Switch to small stage').	specs add: #(normal			enterNormalMode		'Switch to full stage').	specs add: #(presentation	enterPresentationMode	'Switch to presentation mode').	specs do: [:spec |		bName _ spec first.		button _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOn')			offForm: (ScratchFrameMorph skinAt: bName, 'ViewMode')			overForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		viewModeButtonsPanel			addMorphBack: button;			addMorphBack: (Morph new extent: 1@5; color: Color transparent).		viewModeButtons add: button].	self addMorph: viewModeButtonsPanel.! !ScratchFrameMorph class removeSelector: #normalModeEnabled!ScratchFrameMorph class removeSelector: #normalModeEnabled:!ScratchFrameMorph class removeSelector: #quarterModeEnabled!!ScratchFrameMorph methodsFor: 'view mode' stamp: 'jm 4/13/2009 21:05' prior: 39309456!enterNormalMode	"Go into normal (full-stage) mode."	(viewMode = #normal) ifTrue: [		self updateViewModeButtons.		^ self].	viewMode _ #normal.	workPane isQuarterSize: false.	workPane isInWorld		ifTrue: [self fixLayout]		ifFalse: [self exitPresentationMode].	self updatePanes.	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'startup' stamp: 'jm 4/13/2009 21:05' prior: 40552277!startup	| startupFileNames fileName arg presentationMode |	HostSystemMenus startUp.	HostSystemMenus menuBarControler reviseHostMenus.	ScriptableScratchMorph randomInit.	ScratchTranslator detectRenderPlugin.	ScratchTranslator importLanguagesList.	TakeOverScreen ifTrue: [		Smalltalk fullScreenMode: true.		DisplayScreen startUp].	ScratchFrameMorph readShareServerEntry.	self processSettingsFile.	self readDefaultNotes.	self updateProjectName.	shuffledCostumeNames _ nil.	author _ ''.	loginName _ ''.	loginPassword _ ''.	justSaved _ true.	presentationMode _ false.	startupFileNames _ InputSensor startupFileNames asOrderedCollection.	2 to: 10 do: [:i |		arg _ Smalltalk getSystemAttribute: i.		(arg notNil and: [arg size > 0]) ifTrue: [			startupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !!ScratchFrameMorph class methodsFor: 'class initialization' stamp: 'jm 4/13/2009 21:05' prior: 40554971!initialize	"self initialize"	Clipboard _ nil.	WorkpaneExtent _ 480@360.	UseErrorCatcher _ true.	AllowSharing _ true.	DefaultNotes _ ''.	self initFonts.! !self initialize!Morph subclass: #ScratchFrameMorph	instanceVariableNames: 'topPane viewerPane scriptsPane stageFrame workPane titlePane libraryPane menuPanel stageButtonsPanel readoutPane logoMorph projectTitleMorph flagButton fillScreenFlag paintingInProgress projectDirectory projectName projectInfo author loginName loginPassword watcherPositions shuffledCostumeNames justSaved viewModeButtons viewMode lastViewMode 