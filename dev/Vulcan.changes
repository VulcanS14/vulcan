ameMorph removeSelector: #processIniFileSettings! ScratchFileChooserDialog getDefaultFolderForType: #project.	spacer _ Morph new extent: 5@5; color: Color transparent.	shortcutColumn removeAllMorphs.	shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Computer' action: #myComp icon: #folderIcon).	shortcutColumn addMorphBack: spacer fullCopy.	shortcutColumn addMorphBack: (self shortcutButtonLabel: self homeFolderLabel action: #myHome icon: #folderHouseIcon).	shortcutColumn addMorphBack: spacer fullCopy.	(self type = #project) & (projects isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Examples' action: #sampleProjects icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #costume) & (costumes isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Costumes' action: #scratchCostumes icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #background) & (backgrounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Backgrounds' action: #scratchBackgrounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sound) & (sounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Sounds' action: #scratchSounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sprite) | (self type = #stage) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Scratch' action: #scratchFolder icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].! !ScratchFileChooserDialog removeSelector: #userNameForHomeFolderOrNil!!ScratchFileChooserDialog methodsFor: 'initialization' stamp: 'jm 2/24/2009 16:35' prior: 40372077!addShortcutButtons	"Add these to my current shortcuts."	"Note: The shortcut column morph was created by initialize; I just add to its contents a new collection of shortcuts."	| backgrounds costumes sounds projects spacer |	backgrounds _ ScratchFileChooserDialog getDefaultFolderForType: #background.	costumes _ ScratchFileChooserDialog getDefaultFolderForType: #costume.	sounds _ ScratchFileChooserDialog getDefaultFolderForType: #sound.	projects _ ScratchFileChooserDialog getDefaultFolderForType: #project.	spacer _ Morph new extent: 5@5; color: Color transparent.	shortcutColumn removeAllMorphs.	shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Computer' action: #myComp icon: #folderIcon).	shortcutColumn addMorphBack: spacer fullCopy.	shortcutColumn addMorphBack: (self shortcutButtonLabel: self homeFolderLabel action: #myHome icon: #folderHouseIcon).	shortcutColumn addMorphBack: spacer fullCopy.	(self type = #project) & (projects isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Examples' action: #sampleProjects icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #costume) & (costumes isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Costumes' action: #scratchCostumes icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #background) & (backgrounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Backgrounds' action: #scratchBackgrounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sound) & (sounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Sounds' action: #scratchSounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].! !ScratchFileChooserDialog removeSelector: #scratchFolder!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 16:42'!sampleScratchProjectsDir	"Return the path sample projects in the Scratch folder."	(FileDirectory default directoryExists: 'Projects') ifTrue: [		^ FileDirectory default directoryNamed: 'Projects'].	^ FileDirectory default! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 16:42' prior: 40358315!getDefaultFolderForType: type	| f |	(type = #background) ifTrue: [f _ DefaultBackgroundFolder].	(type = #costume) ifTrue: [f _ DefaultCostumeFolder].	(type = #sprite) ifTrue: [f _ DefaultSpriteFolder].	(type = #stage) ifTrue: [f _ DefaultStageFolder].	(type = #sound) ifTrue: [f _ DefaultSoundFolder].	(type = #scratch) ifTrue: [f _ DefaultScratchFolder].	(type = #userProject) ifTrue: [f _ self userScratchProjectsDir].	(type = #sampleProject) ifTrue: [f _ self sampleScratchProjectsDir].	f ifNotNil: [		(f isKindOf: FileDirectory) ifTrue: [			(f parentDirectory directoryExists: f pathName) ifTrue: [^ f]]].	^ self homeDir! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 16:44'!userProjects	"Scratch Projects button was pressed."	| projects |	projects _ ScratchFileChooserDialog getDefaultFolderForType: #project.	projects ifNotNil: [list currentDirectory: projects].! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 16:45' prior: 40377333!userProjects	"Scratch Projects button was pressed."	| projects |	projects _ ScratchFileChooserDialog getDefaultFolderForType: #userProject.	projects ifNotNil: [list currentDirectory: projects].! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 16:46' prior: 40261002!sampleProjects	"Sample Projects button was pressed."	list currentDirectory: self class sampleScratchProjectsDir.! !ScratchFileChooserDialog removeSelector: #scratchProjects!ScratchSkin keys select: [:s | s endsWith: 'Icon']!!ScratchFileChooserDialog methodsFor: 'initialization' stamp: 'jm 2/24/2009 16:48' prior: 40374300!addShortcutButtons	"Add these to my current shortcuts."	"Note: The shortcut column morph was created by initialize; I just add to its contents a new collection of shortcuts."	| backgrounds costumes sounds projects spacer |