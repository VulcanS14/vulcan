]].	ch = $- ifTrue: [		(ch2 isDigit or: [ch2 = $.])			ifTrue: [				in skip: 1.				^ self readNumberFrom: in sign: -1]			ifFalse: [^ self readSymbolFrom: in]].	"unquoted string or boolean"	s _ self readSymbolFrom: in.	#true = s ifTrue: [^ true].	#false = s ifTrue: [^ false].	^ s! !ScratchParser new parseAndRun: 'print ''hello'''!ScratchParser new parseAndRun: 'print ''hello'''!ScratchParser new parseAndRun: 'print ''hello'''!!ScratchParser methodsFor: 'execution' stamp: 'jm 2/2/2009 12:38' prior: 39794627!parseAndRun: aString	"ScratchParser new parseAndRun: '3 + 4'"	"ScratchParser new parseAndRun: 'print ''hello'''"	"ScratchParser new parseAndRun: 'print (3 + 4)'"	"ScratchParser new parseAndRun: 'for i in 1 to 10	print i'"	vars _ Dictionary new.	^ self run: (ScratchParser new parse: aString)! !!ScratchParser methodsFor: 'ops' stamp: 'jm 2/2/2009 12:40'!forToDo: cmd	| v oldV |	v _ self eval: (cmd at: 2).	oldV _ vars at: v ifAbsent: [nil].	(self eval: (cmd at: 3)) to: (self eval: (cmd at: 4)) do: [:i |		self halt].	oldV ifNotNil: [vars at: v put: oldV].! !self eval: (cmd at: 3)!self eval: (cmd at: 4)!cmd at: 2!!ScratchParser methodsFor: 'ops' stamp: 'jm 2/2/2009 12:41' prior: 39797375!forToDo: cmd	| v oldV |	v _ cmd at: 2.	oldV _ vars at: v ifAbsent: [nil].	(self eval: (cmd at: 3)) to: (self eval: (cmd at: 4)) do: [:i |		self halt].	oldV ifNotNil: [vars at: v put: oldV].! !!ScratchParser methodsFor: 'ops' stamp: 'jm 2/2/2009 12:42' prior: 39797729!forToDo: cmd	| v oldV cmdList |	v _ cmd at: 2.	oldV _ vars at: v ifAbsent: [nil].	cmdList _ cmd at: 5.	(self eval: (cmd at: 3)) to: (self eval: (cmd at: 4)) do: [:i |		vars at: v put: i.		self run: cmdList].	oldV ifNotNil: [vars at: v put: oldV].! !ScratchParser new parseAndRun: 'for i in 1 to 10	print i'!ScratchParser new parseAndRun: 'for i in 1 to 10	print i'!ScratchParser new parseAndRun: 'for i in 1 to 10	print i'!ScratchParser new parseA