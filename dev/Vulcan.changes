addMorphBack: (Morph new color: Color transparent; extent: 2@5)]].	titlePane addMorph: stageButtonsPanel.! !s _ UTF32 with: 16r21BA!s _ UTF32 with: 16r21BA with: 16r21BB!m _ (StringMorph new contents: s) openInWorld!m font!m font: (StrikeFont fontName: 'VerdanaBold' size: 18)!m font: (StrikeFont fontName: 'VerdanaBold' size: 12)!m font: (StrikeFont fontName: 'VerdanaBold' size: 14)!s _ UTF32 with: 16r21BA with: 32 with: 16r21BB!m _ (StringMorph new contents: s) openInWorld!m font: (StrikeFont fontName: 'VerdanaBold' size: 14)!m font: (StrikeFont fontName: 'HelveticaBold' size: 14)!m font: (StrikeFont fontName: 'HelveticaBold' size: 36)!m font: (StrikeFont fontName: 'HelveticaBold' size: 36)!s _ UTF32 with: 16r21BA with: 32 with: 16r21BB!m _ (StringMorph new contents: s) openInWorld!m font: (StrikeFont fontName: 'HelveticaBold' size: 36)!m font: (StrikeFont fontName: 'TimesBold' size: 36)!m font: (StrikeFont fontName: 'TimesBold' size: 18)!m font: (StrikeFont fontName: 'TimesBold' size: 12)!m font: (StrikeFont fontName: 'TimesBold' size: 14)!s asUTF8!s asUTF8 asString!s asUTF8 !s asUTF8 asString!s asUTF8 asByteArray asString!(UTF32 with: 16r21BA) asUTF8 asByteArray asString!(UTF32 with: 16r21BB) asUTF8 asByteArray asString!!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'jm 4/21/2009 20:27' prior: 41294380!motorDirection	^ #('↻ this way' '↺ that way' reverse)! !CustomMenu removeSelector: #includesUTF8:!!CustomMenu methodsFor: 'construction' stamp: 'jm 4/21/2009 20:31' prior: 34475564!add: aString action: actionItem	"Add the given string as the next menu item. If it is selected, the given action (usually but not necessarily a symbol) will be returned to the client."	| utf8 s |	utf8 _ aString asUTF8.	s _ String new: utf8 size + 2.	s at: 1 put: Character space.	s replaceFrom: 2 to: s size - 1 with: utf8.	s at: s size put: Character space.	utf8 isUnicode ifTrue: [includesUTF8 _ true].	labe