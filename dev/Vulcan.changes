Form |	scriptsPage _ pageViewerMorph contents fullCopy.	scriptsPage cleanUp; position: 0@0.	bg _ Morph new color: Color transparent.	scriptsPage submorphsDo: [:m | bg addMorph: m].	bg extent: bg fullBounds extent.	scriptsForm _ bg imageForm copy: (bg imageForm rectangleEnclosingPixelsNotOfColor: Color transparent).	"add a margin"	saveForm _ Form extent: (scriptsForm boundingBox extent + 40) depth: 32.	saveForm fillColor: Color transparent.	saveForm copy: scriptsForm boundingBox from: scriptsForm to: (20@20) rule: Form paint.	fName _ ScratchFileChooserDialog		chooseNewFileDefault: ''		title: 'Save Scripts Snapshot'		type: #scriptsSnapshot.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.gif') ifFalse: [fName _ fName, '.gif'].	saveForm writeGIFFileNamed: fName.! !!ScratchScriptEditorMorph methodsFor: 'private' stamp: 'ee 2/20/2009 13:14' prior: 37299593!addReadouts	"Add readouts for my target's position and direction."	| x y label readout s |	self deleteReadouts.	readoutMorphs _ OrderedCollection new.	x _ nameMorph left.	y _ nameMorph bottom + 5.	#(('x' xpos) ('y' ypos)('direction' heading)) do: [:spec |		(ScratchTranslator isRTL and: [(spec at: 1) = 'x' or: [(spec at: 1) = 'y']])			ifTrue: [s _ (':', spec first) asUTF8]			ifFalse: [s _ (spec first localized, ScratchTranslator colonSuffix)].		label _ StringMorph new			contents: s;			font: (ScratchFrameMorph getFont: #XYReadout);			position: x@y.		readout _ (UpdatingStringMorph on: self target selector: spec second)			font: (ScratchFrameMorph getFont: #XYReadoutBold);			forceUnicodeRendering: true;			color: (Color gray: 0.2);			contents: '-000';  "this sets the readout size"			growable: false;			stepTime: 100;			position: (label right + 4)@y.		ScratchTranslator isRTL ifTrue:[			readout rightJustify: true].		self addMorph: label; addMorph: readout.		readoutMorphs add: label; add: readout.		readout startStepping.		x _ readout right + 2].	ScratchTranslator isRTL ifTrue: [		readoutMorphs reversed do: [: m |			readoutMorphs remove: m.			readoutMorphs add: m]].	penReadout _ Morph new extent: 15@5.	penReadout position: (lockButton right + 4)@(nameMorph top + ((nameMorph height - penReadout height) / 2));		color: Color transparent.	self addMorph: penReadout.	readoutMorphs add: penReadout.	penReadout startStepping.	readoutMorphs _ readoutMorphs asArray.! !PaintColorPicker removeSelector: #drawOn:!PaintColorPicker removeSelector: #drawOn:!ImageFrameMorph subclass: #PaintColorPicker	instanceVariableNames: 'selectedColor target selector selector2 shadePickerContainer colorPickerImage colorPickerContainer shadePickerImage '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-Paint'!self readSkinFrom: (FileDirectory default directoryNamed: 'ScratchSkin')!frameInFront!Morph subclass: #PaintColorPicker	instanceVariableNames: 'selectedColor target selector selector2 shadePickerContainer colorPickerImage colorPickerContainer shadePickerImage '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-Paint'!!PaintColorPicker methodsFor: 'initialization' stamp: 'jm 3/21/2008 13:59' prior: 40266302!initialize	super initialize.	selectedColor _ Color black.	target _ selector _ nil.	leftForm _ (ScratchFrameMorph skinAt: #paintColorPickerLeft).	middleForm _ (ScratchFrameMorph skinAt: #paintColorPickerMiddle).	rightForm _ (ScratchFrameMorph skinAt: #paintColorPickerRight).	self createColorPickers.	self extent: 20@20.! !!PaintColorPicker methodsFor: 'drawing' stamp: 'ee 11/12/2005 12:47' prior: 36292960!drawOn: aCanvas	| clipC w y |	super drawOn: aCanvas.	clipC _ aCanvas copyClipRect: (self bounds).	clipC translucentImage: leftForm at: self topLeft.	clipC translucentImage: rightForm at: (self topRight)-(rightForm width@0).	w _ middleForm width.	y _ self top.	(self left + leftForm width)		to: (self right - rightForm width)		by: w		do: [:x | clipC translucentImage: middleForm at: x@y].! !!PaintColorPicker methodsFor: 'drawing' stamp: 'ee 11/12/2005 12:47' prior: 40284152!drawOn: aCanvas	| clipC w y |	super drawOn: aCanvas.	clipC _ aCanvas copyClipRect: (self bounds).	clipC translucentImage: leftForm at: self topLeft.	clipC translucentImage: rightForm at: (self topRight)-(rightForm width@0).	w _ middleForm width.	y _ self top.	(self left + leftForm width)		to: (self right - rightForm width)		by: w		do: [:x | clipC translucentImage: middleForm at: x@y].! !Morph subclass: #PaintColorPicker	instanceVariableNames: 'selectedColor target selector selector2 shadePickerContainer colorPickerImage colorPickerContainer shadePickerImage leftForm middleForm rightForm '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-Paint'!ScratchFrameMorph skinAt: #paintColorPickerLeft!ColorPicker _ SquareColorPicker _ nil!----STARTUP----(23 February 2009 12:07:42 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SNAPSHOT----(23 February 2009 12:08:04 am) priorSource: 6708119!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 21 February 2009 at 2:43:19 pm'!Morph subclass: #BlockMorph	instanceVariableNames: 'isSpecialForm oldColor highlightColor1 highlightColor2 shadowColor scratchProc blockLayoutNeeded cachedForm cachedFeedbackForm copyTooltip '	classVariableNames: 'ArgFont CBlockBracketThickness DebugMenu LabelColor LabelFont PuzzleInset PuzzleWidth '	poolDictionaries: ''	category: 'Scratch-Blocks'!ImageFrameMorph subclass: #PaintColorPicker	instanceVariableNames: 'selectedColor target selector selector2 shadePickerContainer leftForm colorPickerImage colorPickerContainer rightForm middleForm shadePickerImage '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-Paint'!DialogBoxMorph subclass: #PaintFrame	instanceVariableNames: 'canvasMorph paletteMorph hScrollbar vScrollbar transformButtons canvasButtons fil