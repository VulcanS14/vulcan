hFolderName) ifFalse: [		homeDir createDirectory: scratchFolderName].	(homeDir directoryExists: scratchFolderName)		ifTrue: [^ homeDir directoryNamed: scratchFolderName]		ifFalse: [^ homeDir].! !!PaintFrame methodsFor: 'initialization' stamp: 'jm 2/25/2009 16:20' prior: 36304084!addSetRotationCenterButton	| setRotationLabel spacer font |	setRotationCenterMorph _ AlignmentMorph newRow		color: Color transparent;		centering: #center.	"make components"	setRotationCenterButton _ ToggleButton		onForm: (ScratchFrameMorph skinAt: #paintSetRotCenterButtonPressed)		offForm: (ScratchFrameMorph skinAt: #paintSetRotCenterButton).	setRotationCenterButton		target: paletteMorph;		actionSelector: #toggleRotationPoint;		setProperty: #balloonText toValue: 'Position the cross-hair to set the rotation center' localized.	spacer _ Morph new extent: 6@3; color: Color transparent.	setRotationLabel _ StringMorph contents: 'Set costume center' localized.	font _ (ScratchFrameMorph getFont: #PaintSetRotationCenter).	setRotationLabel font: font; color: Color gray darker.	"add components"	setRotationCenterMorph		addMorphBack: setRotationCenterButton;		addMorphBack: spacer;		addMorphBack: setRotationLabel.	"add bar to frame"	self addMorph: setRotationCenterMorph.! !self contents: '+ - *'!self contents: '+ - < = >'!self contents: 'Operations'!self contents: '123 ABC'!self contents: 'Numbers+'!self contents: 'Numbers +'!self contents: 'Numbers...'!self contents: 'Ops'!self contents: 'Operators'!----SNAPSHOT----(25 February 2009 4:34:30 pm) priorSource: 6882905!----SNAPSHOT----(25 February 2009 4:35:30 pm) priorSource: 6889593!----QUIT----(25 February 2009 4:35:39 pm) priorSource: 6889662!----STARTUP----(25 February 2009 4:37:37 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(25 February 2009 4:37:50 pm) priorSource: 6889731!----STARTUP----(25 February 2009 4:37:54 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SAVEAS Scratch25Feb09----(25 February 2009 4:38:06 pm)!----STARTUP----(25 February 2009 5:00:07 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(25 February 2009 8:47:40 pm) priorSource: 6889896!----STARTUP----(25 February 2009 10:56:10 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchUploadProgressDialog class methodsFor: 'proxy settings' stamp: 'jm 2/25/2009 22:58'!proxyServer: aStringOrNil	ProxyServer _ aStringOrNil.! !!ScratchUploadProgressDialog class methodsFor: 'proxy settings' stamp: 'jm 2/25/2009 22:59'!proxyPort: aString	ProxyPort _ aString.! !!ScratchUploadProgressDialog methodsFor: 'private-other' stamp: 'jm 2/25/2009 23:05' prior: 37594016!createRequest	"Create the POST request body for my project."	| s prefix lengthOffset contentStart end |	s _ WriteStream on: (ByteArray new: 10000000).	prefix _ ''.	ProxyServer ifNotNil: [prefix _ 'http://', hostName, ':80'].	s nextPutString: (		'POST ', prefix, servicePath, ' HTTP/1.1', String crlf,			'Host: ', hostName, String crlf,			'Content-Type: multipart/form-data; boundary=', boundary, String crlf,			'Content-Length: ').	lengthOffset _ s position. "content size is filled in below"	s nextPutString: (String new: 20 withAll: Character space). "leave room for content size string"	s nextPutString: String crlf, String crlf.	contentStart _ s position.	self add: 'username' value: userName to: s.	self add: 'password' value: password to: s.	self add: 'scratchkey' value: 'ch4ng3me' to: s.	self add: 'project_name' value: projectName asUTF8 to: s.	self add: 'project_description' value: projectNotes asUTF8 to: s.	self add: 'project_history' value: self projectHistoryString asUTF8 to: s.	self add: 'tags' value: tags asUTF8 to: s.	self add: 'version' value: ScratchFrameMorph version asUTF8 to: s.	self add: 'version-date' value: ScratchFrameMorph versionDate asUTF8 to: s.	self addSpriteAndScriptCountsTo: s.	self addScriptsAndSensorBlockFlagsTo: s.	self addProjectDataTo: s.	self add: 'thumbnail_image'		filename: 'thumbnail.gif'		type: 'image/gif'		data: self thumbnailAsGIF		to: s.	self add: 'preview_image'		filename: 'preview.gif'		type: 'image/gif'		data: self previewAsGIF		to: s.	s nextPutString: '--', boundary, '--', String crlf.	"patch the content length field"	end _ s position.	s position: lengthOffset.	s nextPutString: (end - contentStart) printString.	s position: end.	^ s contents! !!ScratchUploadProgressDialog class methodsFor: 'class initialization' stamp: 'jm 2/25/2009 23:08'!initialize	ProxyServer _ nil.	ProxyPort _ 8080.! !self initialize!ProxyServer!ProxyPort!!ScratchUploadProgressDialog methodsFor: 'private-uploading' stamp: 'jm 2/25/2009 23:12' prior: 37585698!connectToServer	"Open a connection to the FTP server on the primary socket. Keep trying until a connection is established."	| tries server port address |	self disconnectFromServer.	Socket initializeNetwork.	server _ hostName.	port _ 80.	ProxyServer ifNotNil: [		server _ ProxyServer.		port _ ProxyPort].	tries _ 0.	address _ nil.	[address isNil & (tries < 5)] whileTrue: [		address _ NetNameResolver addressForName: hostName timeout: 200.		address ifNil: [			tries _ tries + 1.			(Delay forMilliseconds: 1500) wait]].	address ifNil: [^ self abort: 'address not found'].	socket _ Socket new.	[socket isConnected] whileFalse: [		socket connectTo: address port: port.		[socket isWaitingForConnection] whileTrue: [self sleepAWhile].		socket isConnected ifFalse: [			socket destroy.			socket _ Socket new.			self sleepAWhile]].! !!ScratchUploadProgressDialog methodsFor: 'private-uploading' stamp: 'jm 2/25/2009 23:13' prior: 40447281!connectToServer	"Open a connection to the FTP server on the primary socket. Keep trying until a connection is established."	| tries server port address |	self disconnectFromServer.	Socket initializeNetwork.	server _ hostName.	port _ 80.	ProxyServer ifNotNil: [		server _ ProxyServer.		port _ ProxyPort].	tries _ 0.	address _ nil.	[address isNil & (tries < 5)] whileTrue: [		address _ NetNameResolver addressForName: server timeout: 200.		address ifNil: [			tries _ tries + 1.			(Delay forMilliseconds: 1500) wait]].	address ifNil: [^ self abort: 'address not found'].	socket _ Socket new.	[socket isConnected] whileFalse: [		socket connectTo: address port: port.		[socket isWaitingForConnection] whileTrue: [self sleepAWhile].		socket isConnected ifFalse: [			socket destroy.			socket _ Socket new.			self sleepAWhile]].! !!ScratchUploadProgressDialog class methodsFor: 'proxy settings' stamp: 'jm 2/25/2009 23:25'!test	"self test"	"self initialize"	ProxyServer _ '67.19.148.234'.	ProxyPort _ 3128.! !self test!ProxyServer!ProxyPort!!ScratchUploadProgressDialog class methodsFor: 'proxy settings' stamp: 'jm 2/25/2009 23:28' prior: 40449192!test	"self test"	"self initialize"	ProxyServer _ '174.129.225.131'.	ProxyPort _ 80.! !self test!request asString!!ScratchUploadProgressDialog methodsFor: 'private-uploading' stamp: 'jm 2/25/2009 23:35' prior: 37585032!checkServerResponse: aString	| i s endI |AAA _ aString.	i _ aString findString: '<scratchr-upload>'.	i = 0 ifTrue: [i _ aString findString: '<scratchr-admin_upload>'].	i = 0 ifTrue: [i _ 1].	s _ aString copyFrom: i to: aString size.	(s includesSubString: '<status>success</status>') ifTrue: [^ self].	i _ s findString: '<reason'.	i = 0 ifTrue: [^ self abort: 'Unknown reason'].	i _ s indexOf: $> startingAt: i.	i = 0 ifTrue: [i _ 8].	endI _ s findString: '</reason>' startingAt: i.	endI = 0 ifTrue: [endI _ s size + 1].	self abort: (s copyFrom: i + 1 to: endI - 1).! !AAA!AAA!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/25/2009 23:38' prior: 40390348!processSettingsFile	"Process settings from the Scratch.ini file."	| lang settings k |	self class setVisibleDrives: nil.	lang _ nil.	AllowSharing _ true.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		k _ assoc key.		k = 'language' ifTrue: [lang _ assoc value].		k = 'home' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		k = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value].		k = 'share' ifTrue: [(assoc value) = '0' ifTrue: [AllowSharing _ false]].		k = 'proxyserver' ifTrue: [ScratchUploadDialog proxyServer: assoc value].		k = 'proxyport' ifTrue: [ScratchUploadDialog proxyPort: assoc value asNumberNoError]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.! !----SNAPSHOT----(25 February 2009 11:43:29 pm) priorSource: 6890222!ProxyServer!self remoteAddress!ProxyServer!ProxyServer!NetNameResolver!NetNameResolver addressForName: 'scratch.mit.edu'!----QUIT----(26 February 2009 8:41:03 am) priorSource: 6896763!----STARTUP----(26 February 2009 3:49:18 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchViewerMorph methodsFor: 'initialization' stamp: 'jm 2/26/2009 15:51' prior: 39909869!rebuildCategorySelectors	| catList maxExtent buttons label offForm onForm overForm b pad leftColumnX rightColumnX x y |	catList _ #(		motion		control		looks		sensing		sound		numbers		pen			variables).	"First, delete the old category buttons"	submorphs do: [:m | (m isKindOf: ResizableToggleButton2) ifTrue: [m delete]].	"Create new buttons, keeping track of the maximum extent."	maxExtent _ 75@0.	buttons _ catList collect: [:cat |		label _ (ScratchTranslator translationFor: cat asString) capitalized.		cat = 'numbers' ifTrue: [			label _ ScratchTranslator translationFor: '+ - < = >'].		offForm _ (ScratchFrameMorph skinAt: cat).		onForm _ (ScratchFrameMorph skinAt: (cat, 'Pressed')).		overForm _ (ScratchFrameMorph skinAt: (cat, 'Over')).		ScratchTranslator isRTL			ifTrue:[				b _ ResizableToggleButton2 new					offForm:	(offForm flipBy: #horizontal centerAt: offForm center)					onForm:		(onForm flipBy: #horizontal centerAt: onForm center)					overForm:	(overForm flipBy: #horizontal centerAt: overForm center)]			ifFalse:[				b _ ResizableToggleButton2 new					offForm:	offForm					onForm:		onForm					overForm:	overForm].		b			label: label font: (ScratchFrameMorph getFont: #Category);			setLabelColor: Color white;			target: self;			actionSelector: #currentCategory:;			arguments: (Array with: cat);			toggleButtonMode: true;			toggleMode: false.		ScratchTranslator isRTL			ifTrue:[b rightJustifyInset: 10]			ifFalse:[b leftJustifyInset: 10].		maxExtent _ maxExtent max: (b extent + (3 @ -6)).		b].	"calculate catButtonsExtent"	pad _ 15. "padding on left, right, and betwen the button columns"	catButtonsExtent _ ((2 * maxExtent x) + (3 * pad)) @ (((catList size // 2) * (maxExtent y + 6)) + 25).	"place the buttons"	leftColumnX _ self left + 12 + pad.	rightColumnX _ leftColumnX + maxExtent x + pad.	x _ leftColumnX.	y _ self top + 17.	1 to: buttons size do: [:i |		b _ buttons at: i.		b extent: maxExtent.		self addMorph: (b position: x@y).		i even			ifTrue: [x _ leftColumnX. y _ y + b height + 6]			ifFalse: [x _ rightColumnX]].	self width: catButtonsExtent x.	pageViewer position: self position + (0@catButtonsExtent y).	topSectionHeight _ catButtonsExtent y - 4.! !!ScratchViewerMorph methodsFor: 'initialization' stamp: 'jm 2/26/2009 15:52' prior: 40451658!rebuildCategorySelectors	| catList maxExtent buttons label offForm onForm overForm b pad leftColumnX rightColumnX x y |	catList _ #(		motion		control		looks		sensing		sound		numbers		pen			variables).	"First, delete the old category buttons"	submorphs do: [:m | (m isKindOf: ResizableToggleButton2) ifTrue: [m delete]].	"Create new buttons, keeping track of the maximum extent."	maxExtent _ 75@0.	buttons _ catList collect: [:cat |		label _ (ScratchTranslator translati