+ 30]		ifFalse: [x _ libPane left + 8].	y _ libPane top + 7.	rMargin _ x + scrollPane width - 5.	libPane submorphs do: [:m |		(x + m width) > rMargin ifTrue: [			ScratchTranslator isRTL				ifTrue: [x _ libPane left + 30]				ifFalse: [x _ libPane left + 8].			y _ y + m height].		m position: x@y.		x _ x + m width].	stagePane submorphCount > 0 ifTrue: [		m _ stagePane firstSubmorph.		m position: stagePane topLeft + ((stagePane extent - stagePane firstSubmorph extent) // 2) + (0@15) - (0@topSectionHeight)].! !!ScratchPresenterMorph methodsFor: 'initialization' stamp: 'ee 12/5/2008 22:55' prior: 37253086!initialize	| button |	super initialize.	self color: Color black.	doubleSize _ false.	buttons _ #(		(goSmall	shoutGo		'Start green flag scripts')		(stopSmall	stopAll		'Stop everything')	) collect: [:spec |		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec first, 'Button'))			offForm: (ScratchFrameMorph skinAt: (spec first, 'Button'))			overForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonOver')).		button			target: self;			actionSelector: spec second;			isMomentary: true;			actWhen: #buttonDown;			setProperty: #balloonText toValue: spec third localized;			drawToolTipAbove: true;			off.		#shoutGo = spec second ifTrue: [			flagButton _ button.			flagButton				onForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonOver'))				offForm: (ScratchFrameMorph skinAt: (spec first, 'Button'))				overForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonOver'))].		button].	buttons do: [:b | self addMorph: b].	"view mode buttons"	normalModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #normalViewModeOn)		offForm: (ScratchFrameMorph skinAt: #normalViewMode)		overForm: (ScratchFrameMorph skinAt: #normalViewModeOver).	normalModeButton		target: self;		actionSelector: #exitPresentation:;		arguments: #(normal);		alphaOn: true.	quarterModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #quarterViewModeOn)		offForm: (ScratchFrameMorph skinAt: #quarterViewMode)		overForm: (ScratchFrameMorph skinAt: #quarterViewModeOver).	quarterModeButton		target: self;		actionSelector: #exitPresentation:;		arguments: #(quarter);		alphaOn: true.	presentationModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #presentationViewModeOn)		offForm: (ScratchFrameMorph skinAt: #presentationViewMode)		overForm: (ScratchFrameMorph skinAt: #presentationViewModeOver).	presentationModeButton		alphaOn: true;		on.	self		addMorphBack: normalModeButton;		addMorphBack: quarterModeButton;		addMorphBack: presentationModeButton.! !!ScratchPresenterMorph methodsFor: 'button actions' stamp: 'ee 12/5/2008 22:22'!exitPresentation: aSymbol	self delete.	frame exitPresentationMode: aSymbol.! !!ScratchPresenterMorph methodsFor: 'geometry' stamp: 'ee 12/5/2008 22:05' prior: 37255401!fixLayout	| stageExtent stageBox y totalW x |	stageExtent _ doubleSize ifTrue: [2 * stage extent] ifFalse: [stage extent].	stageBox _ Rectangle center: self center extent: stageExtent.	stage owner center: self center.	y _ stageBox top - 22.	buttons first position: (stageBox left + 5) @ y.  "exit presentation button"	"other buttons"	totalW _ (buttons collect: [:b | b width]) sum.	x _ stageBox right - totalW - (10 * (buttons size - 2)) - 5.	buttons do: [:b |		b position: x@y.		x _ x + b width + 10].	offscreenWorld redrawAll.	"view mode buttons"	quarterModeButton position: self topRight - (160@0) + (0@12).	normalModeButton position: quarterModeButton topRight + (5@0).	presentationModeButton position: normalModeButton topRight + (5@0).! !!ScratchPresenterMorph methodsFor: 'event handling' stamp: 'ee 12/5/2008 22:28' prior: 37258742!processKeyboardEvents	| evt ch |	World hands do: [:h |		[(evt _ h nextUnclaimedKeystrokeOrNil) notNil] whileTrue: [			ch _ evt keyValue.			(ch = 3) | (ch = 13) ifTrue: [^ self shoutGo].			ch = 27 ifTrue: [^ self exitPre