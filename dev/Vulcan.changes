connector goBehind].		^ self].	owner notNil & connector owner isNil ifTrue: [		owner addMorph: connector.		connector goBehind].	connector		color: self connectorColor;		dotMorphColor: anchor color.	ScratchTranslator isRTL		ifTrue: [			connector				from: (anchor left + 1) @(anchor top + 9)				to: (self right ) @ (self top + 8) .			(anchor isKindOf: HatBlockMorph)				ifTrue: [connector					from: (anchor left + 1) @(anchor top + 20)					to: (self right ) @ (self top + 6)]]		ifFalse: [			connector				from: (anchor right - 1) @(anchor top + 9)				to: (self left ) @ (self top + 8) .			(anchor isKindOf: HatBlockMorph)				ifTrue: [connector					from: (anchor right - 1) @(anchor top + 20)					to: (self left ) @ (self top + 6)]].! !!ScratchCommentMorph methodsFor: 'event handling' stamp: 'jm 6/30/2008 14:04' prior: 39921801!duplicate	self world activeHand attachMorph: self fullCopy.! !!ScratchCommentMorph methodsFor: 'event handling' stamp: 'jm 3/20/2009 13:58' prior: 40991353!duplicate	self world activeHand attachMorph: self fullCopy detach.! !!ScratchCommentMorph methodsFor: 'dropping/grabbing' stamp: 'jm 3/20/2009 14:03' prior: 40704458!attachTargetIn: newOwner	"Answer a CommandBlockMorph that is overlapped by the receiver, nil if none."	| candidates target overlap ratio |	(newOwner isKindOf: ScratchScriptsMorph) ifFalse: [^ nil].	candidates _ newOwner allMorphs select: [:each |		(each isKindOf: CommandBlockMorph) and:		[each hasComment not and:		[self bounds intersects: each bounds]]].	candidates isEmpty ifTrue: [^ nil].	target _ candidates first.	ratio _ (self bounds intersect: target bounds) area / target bounds area.	candidates do: [:each |		overlap _ ((self bounds intersect: each bounds) area / (each bounds area)).		overlap > ratio ifTrue: [			ratio _ overlap.			target _ each]].	^ target! !!ScratchCommentMorph methodsFor: 'dropping/grabbing' stamp: 'jm 3/20/2009 14:06' prior: 40991686!attachTargetIn: new