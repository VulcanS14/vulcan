'				-	playSound:)			('play sound %S until done'		s	doPlaySoundAndWait)			('stop all sounds'				-	stopAllSounds)			-			('play drum %D for %n beats'	t 	drum:duration:elapsed:from: 48 0.2)			('rest for %n beats'				t 	rest:elapsed:from: 0.2)			-			('play note %N for %n beats'	t	noteOn:duration:elapsed:from: 60 0.5)			('set instrument to %I'			- 	midiInstrument: 1)			-			('change volume by %n'		- 	changeVolumeBy: -10)			('set volume to %n%'			- 	setVolumeTo: 100)			('volume'						r 	volume)			-			('change tempo by %n'			- 	changeTempoBy: 20)			('set tempo to %n bpm'			- 	setTempoTo: 60)			('tempo'							r 	tempo)		'motor'			('turn motor %M on for %n secs'		-	motor:OnFor: 'A' 5)			('turn motor %M on'					-	motorOn: 'A')			('turn motor %M off'				-	motorOff: 'A')			('set motor %M direction %W'		-	motor:directon: 'A' 'reverse')			('set motor %M power %n'			-	motor:power: 'A' 100)		'variables'			('show variable %v'				-	showVariable:)			('hide variable %v'				-	hideVariable:)		'list'			('add %s to %L'					-	append:toList: 'thing')			-			('delete %y of %L'				-	deleteLine:ofList: 1)			('insert %s at %i of %L'			-	insert:at:ofList: 'thing' 1)			('replace item %i of %L with %s'		-	setLine:ofList:to: 1 'list' 'thing')			-			('item %i of %L'					r	getLine:ofList: 1)			('length of %L'					r	lineCountOfList:)			('%L contains %s'				b	list:contains: 'list' 'thing')	).	^ blocks, self obsoleteBlockSpecs! !!ScratchUploadProgressDialog methodsFor: 'private-other' stamp: 'jm 2/27/2009 11:21' prior: 37592555!addScriptsAndSensorBlockFlagsTo: s	"Add the full scripts of the project and flags indicating the use of sound or sensor blocks to the request."	| scriptsString hasSoundSensorBlocks hasSensorBlocks hasMotorBlocks |	scriptsString _ scratchFrame scriptsStringForUpload.	hasSoundSensorBlocks _ false.	#(soundLevel isLoud) do: [:cmd |		(scriptsString includesSubString: cmd) ifTrue: [hasSoundSensorBlocks _ true]].	hasSensorBlocks _ false.	#(sensor: sensorPressed:) do: [:cmd |		(scriptsString includesSubString: cmd) ifTrue: [hasSensorBlocks _ true]].	hasMotorBlocks _ false.	(scriptsString includesSubString: 'motor') ifTrue: [hasMotorBlocks _ true].	self add: 'allScripts' value: scriptsString to: s.	self add: 'hasSoundSensorBlocks' value: hasSoundSensorBlocks printString to: s.	self add: 'hasScratchBoardSensorBlocks' value: hasSensorBlocks printString to: s.	self add: 'hasMotorBlocks' value: hasMotorBlocks printString to: s.! !self scriptsStringForUpload includesSubString: 'motor'!self scriptsStringForUpload includesSubString: 'motor'!!ScratchFrameMorph methodsFor: 'uploading' stamp: 'jm 2/27/2009 11:28'!allBlocksString	| s stacks |	s _ WriteStream on: (String new: 10000).	((Array with: workPane), self scratchObjects) do: [:obj |		stacks _ obj blocksBin submorphs select: [:m | m isKindOf: BlockMorph].		stacks do: [:blocks | self printTupleList: blocks tupleSequence on: s. s cr].		s cr].	^ s contents! !self allBlocksString !self allBlocksString !!ScratchFrameMorph methodsFor: 'uploading' stamp: 'jm 2/27/2009 11:29' prior: 40501177!allBlocksString	| s stacks |	s _ WriteStream on: (String new: 10000).	((Array with: workPane), self scratchObjects) do: [:obj |		stacks _ obj blocksBin submorphs select: [:m | m isKindOf: BlockMorph].		stacks do: [:blocks | self printTupleList: blocks tupleSequence on: s. s cr; cr].		s cr].	^ s contents! !self allBlocksString!!ScratchFrameMorph methodsFor: 'uploading' stamp: 'jm 2/27/2009 11:31' prior: 40501627!allBlocksString	| s stacks |	s _ WriteStream on: (String new: 10000).	((Array with: workPane), self scratchObjects) do: [:obj |		stacks _ obj blocksBin submorphs select: [:m | m isKindOf: BlockMorph].		stacks size > 0 ifTrue: [			s nextPutAll: 'Stacks for ', obj objName, ':'; cr; cr.			stacks do: [:blocks | self printTupleList: blocks tupleSequence on: s. s cr; cr].			s cr]].	^ s contents! !self allBlocksString