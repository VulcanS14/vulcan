ition: self position + (7@0).	bin _ ScratchSpriteLibraryMorph new		color: Color transparent;		borderWidth: 0.	scrollPane _ ScrollFrameMorph2 new		color: Color transparent;		contents: bin;		showHorizontalScrollbar: false.	spritePane _ Morph new		color: Color gray;		position: self position.	spriteLabel _ StringMorph new contents: 'New sprite:' localized.	spriteLabel		font: (ScratchFrameMorph getFont: #Tab);		color: Color white.	buttonPane _ self makeNewSpriteButtons: (self ownerThatIsA: ScratchFrameMorph).	self addMorph: spritePane.	self addMorph: spriteLabel.	self addMorph: buttonPane.	self addMorph: scrollPane.	self addMorph: stagePane.! !!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'jm 5/1/2009 10:42' prior: 39887663!initialize	super initialize.	self buildPanes.	self		initFrontFromForm: (ScratchFrameMorph skinAt: 'spriteLibraryPaneFrameTransparent2')		topSectionHeight: (((spriteLabel stringHeight: 'New sprite:' localized) + 10) max: 40).	self middleBarLeftMargin: 0 rightMargin: 6.	self extent: 200@100.! !!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'jm 5/1/2009 10:45'!buildSpriteLabel	^ StringMorph new		font: (ScratchFrameMorph getFont: #Tab);		color: Color white;		contents: 'New sprite:' localized! !!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'jm 5/1/2009 10:45' prior: 41577998!buildPanes	"Build my scroll pane."	| bin |	stagePane _ Morph new		color: Color transparent;		position: self position + (7@0).	bin _ ScratchSpriteLibraryMorph new		color: Color transparent;		borderWidth: 0.	scrollPane _ ScrollFrameMorph2 new		color: Color transparent;		contents: bin;		showHorizontalScrollbar: false.	spritePane _ Morph new		color: Color gray;		position: self position.	spriteLabel _ self buildSpriteLabel.	buttonPane _ self makeNewSpriteButtons: (self ownerThatIsA: ScratchFrameMorph).	self addMorph: spritePane.	self addMorph: spriteLabel.	self addMorph: buttonPane.	self