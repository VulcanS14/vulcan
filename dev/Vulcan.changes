rame width - (95 + buttonsWidth))@5;		color: Color transparent).	self addViewModeButtonsTo: menuPanel.	TakeOverScreen ifTrue: [		closeButton _ IconicButton new			labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/24/2009 18:54' prior: 40412301!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton buttonSpecs b buttonsWidth |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu:		'Open, save, and share projects')		(Edit			editMenu:		'Undo the last delete')		(Share			shareMenu:		'Share this project online')		(Language		languageMenu:	'Switch languages')		(Help			helpMenu:		'Get help')	).	AllowSharing ifFalse: [		menuSpecs _ menuSpecs select: [:spec | spec second ~= #shareMenu:]].	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	"buttonSpecs defines the save and share buttons"	buttonSpecs _ #(		"name			tool tip				selector"		(save			'Save this project'	saveScratchProjectNoDialog)		(share			'Share this project'	share)	).	AllowSharing ifFalse: [		buttonSpecs _ buttonSpecs select: [:spec | spec first ~= #share]].	buttonsWidth _ 0.	buttonSpecs do: [:spec |	