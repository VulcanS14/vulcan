ing: contentSize printString, String crlf, String crlf.	header _ header contents.	request _ ByteArray new: header size + contentSize.	request replaceFrom: 1 to: header size with: header.	request replaceFrom: header size + 1 to: request size with: s contents.	^ request! !ShareServer!ShareServerPath!	chars _ ($0 to: $9), ($A to: $Z).	boundary _ '-----', ((String new: 15) collect: [:i | chars atRandom]) asString.!hostName _ 'scratch.mit.edu'.servicePath _ '/services/upload'.chars _ ($0 to: $9), ($A to: $Z).boundary _ '-----', ((String new: 15) collect: [:i | chars atRandom]) asString.	header _ WriteStream on: (String new: 1000).	prefix _ ''.	header nextPutString: (		'POST ', prefix, servicePath, ' HTTP/1.1', String crlf,			'Host: ', hostName, String crlf,			'Connection: close', String crlf,			'Proxy-Connection: close', String crlf,			'Content-Type: multipart/form-data; boundary=', boundary, String crlf,			'Content-Length: ').	header nextPutString: 12345 printString, String crlf, String crlf.	header _ header contents.!!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 17:22' prior: 41050497!updateMotorA	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorA ~= 0).	MotorA _ (MotorADirection * (MotorAPower + 27)) rounded within: -127 and: 127.	MotorAOn ifFalse: [MotorA _ 0].	(wasRunning and: [MotorA = 0]) ifTrue: [		MotorAStopTime _ Time millisecondClockValue].	self isOpen.	self sendStatus: 64 motorA: MotorA motorB: MotorB.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 17:22' prior: 41051034!updateMotorB	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorB ~= 0).	MotorB _ (MotorBDirection * (MotorBPower + 27)) rounded within: -127 and: 127.	MotorBOn ifFalse: [MotorB _ 0].	(wasRunning and: [MotorB = 0]) ifTrue: [		MotorBStopTime _ Time millisecondClockValue].	self isOpen.	self sendStatus: 64 motorA: MotorA motorB: MotorB.! !----QUIT----(24 March 2009 3:51:56 pm) priorSource: 7500180!----STARTUP----(24 March 2009 4:30:16 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!	form _ Form extent: 5@1 depth: 32.	form colorAt: 0@0 put: Color red.	form colorAt: 1@0 put: Color green.	form colorAt: 2@0 put: Color blue.	form colorAt: 3@0 put: Color black.	form colorAt: 4@0 put: Color white.!	(form magnifyBy: 20) display.!	form _ form asFormOfDepth: 8.!	(form magnifyBy: 20) display.!form!	PNGReadWriter putForm: form onFileNamed: 'test.8bitNoPalette.png'!	form _ Form extent: 5@1 depth: 32.	form colorAt: 0@0 put: Color red.	form colorAt: 1@0 put: Color green.	form colorAt: 2@0 put: Color blue.	form colorAt: 3@0 put: Color black.	form colorAt: 4@0 put: Color white.	form _ form asFormOfDepth: 4.	(form magnifyBy: 20) display.!	(form magnifyBy: 20) display.!	(form magnifyBy: 20) display.!	PNGReadWriter putForm: form onFileNamed: 'test.4bitNoPalette.png'!	form _ form asFormOfDepth: 2.!	(form magnifyBy: 20) display.!form _ Form fromFileNamed: '/Users/jmaloney/Desktop/MIT Squeak/hammy.jpg'.!form colorsUsed size!	(form magnifyBy: 20) display.!form display!	form _ form asFormOfDepth: 8.!form display!form _ Form fromFileNamed: '/Users/jmaloney/Desktop/MIT Squeak/hammy.jpg'.!form colorsUsed size!World submorphs select: [:m | (m isKindOf: SystemWindow) not]!self delete!!PNGReadWriter methodsFor: 'writing' stamp: 'jm 3/24/2009 16:40'!writeType6DataOnOLD: zStream	"Write RGBA data."	| scanline hack hackBlt cm miscBlt |	scanline _ ByteArray new: bytesPerScanline.	hack _ Form extent: width@1 depth: 32 bits: scanline.	form depth = 16 ifTrue: [		"Expand 16 -> 32"		miscBlt _ BitBlt toForm: hack.		miscBlt sourceForm: form.		miscBlt combinationRule: Form over.		miscBlt destOrigin: 0@0.		miscBlt width: width; height: 1].	hackBlt _ BitBlt toForm: hack.	hackBlt sourceForm: (miscBlt ifNil: [form] ifNotNil: [hack]).	hackBlt combinationRule: Form over.	hackBlt destOrigin: 0@0.	hackBlt width: width; height: 1.	bigEndian		ifTrue: [			cm _ ColorMap 				shifts: #(8 8 8 -24) 				masks: #(16rFF0000 16rFF00 16rFF 16rFF000000)]		ifFalse: [			cm _ ColorMap 				shifts: #(-16 0 16 0) 				masks: #(16rFF0000 16rFF00 16rFF 16rFF000000)].	hackBlt colorMap: cm.	0 to: height-1 do: [:i |		miscBlt			ifNil: [				hackBlt sourceOrigin: 0@i; copyBits]			ifNotNil: [				miscBlt sourceOrigin: 0@i; copyBits.				hack fixAlpha.				hackBlt copyBits].		zStream nextPut: 0. "filterType"		zStream nextPutAll: scanline.	].	zStream close.! !----SNAPSHOT----(24 March 2009 4:53:43 pm) priorSource: 7504233!!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'jm 3/24/2009 16:55'!promptInProgress	| s |	(s _ self ownerThatIsA: ScratchStageMorph) ifNil: [^ false].	s submorphsDo: [:m |		(m isKindOf: ScratchPrompterMorph) ifTrue: [^ true]].	^ false! !!ScratchProcess methodsFor: 'private-special forms' stamp: 'jm 3/24/2009 16:56' prior: 40004698!doAsk	"Ask the user a question and wait until the user types some text and hits the accept button."	| block args question prompter |	block _ stackFrame expression.	args _ stackFrame arguments.	"first time (args size = 0): open prompter"	args size = 0		ifTrue: [block receiver promptInProgress ifTrue: [self beep].			question _ block args first asString.			prompter _ block receiver promptForInput: question]		ifFalse: [			prompter _ args first].	"if all processes have stopped, pop this frame and we're done."	prompter isDone ifTrue: [^ self popStackFrame].	"Set up the wait loop. We need to:		1.  yield to another process		2.  evaluate the termination expression again	Push these onto stack in reverse order."	"2.  evaluate this block again"	"(Remove the current frame and replace it w