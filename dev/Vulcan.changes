tempo)		'variables'			('show variable %v'				-	showVariable:)			('hide variable %v'				-	hideVariable:)		'list'			('add %s to %L'					-	append:toList: 'thing')			-			('delete %y of %L'				-	deleteLine:ofList: 1)			('insert %s at %i of %L'			-	insert:at:ofList: 'thing' 1)			('replace item %i of %L with %s'		-	setLine:ofList:to: 1 'list' 'thing')			-			('item %i of %L'					r	getLine:ofList: 1)			('length of %L'					r	lineCountOfList:)			('%L contains %s'				b	list:contains: 'list' 'thing')			-			('add letters of %s to %L'		-	appendLettersOf:toList: 'thing' 'list')	).	^ blocks, self obsoleteBlockSpecs! !----SNAPSHOT----(28 January 2009 11:48:27 am) priorSource: 6003821!----SNAPSHOT----(28 January 2009 4:52:10 pm) priorSource: 6021816!self display!self display!self display!self display!self display!self display!self display!self display!self colorsUsed!bits asSet!self hibernate!bits size!----STARTUP----(28 January 2009 8:07:40 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!Smalltalk recompileAllFrom: 'AAAA'!Undeclared!DialogBoxMorph askWithCancel: 'File fileName?'!StringDialog askWithCancel: 'File fileName?'!!PresentationMorph methodsFor: 'menu' stamp: 'jm 1/28/2009 20:12' prior: 36733600!saveSlides	"Save a set of slides to a file."	| response |	response _ StringDialog askWithCancel: 'File fileName?' initialAnswer: fileName.	response size = 0 ifTrue: [^ self].	fileName _ response.	self storeOnFileNamed: fileName.! !!PresentationMorph methodsFor: 'menu' stamp: 'jm 1/28/2009 20:12' prior: 36731914!loadSlides	"Load a set of slides from a file, replacing the current slides."	| response f screensFromFile |	response _ StringDialog askWithCancel: 'File fileName?' initialAnswer: fileName.	response size = 0 ifTrue: [^ self].	fileName _ response.	f _ (FileStream readOnlyFileNamed: fileName) binary.	screensFromFile _ ObjStream new readObjFrom: f showProgress: true.	f close.	World submorph