ingNames _ Set new.	media do: [:m | m = aMedia ifFalse: [existingNames add: (UTF8 withAll: m mediaName)]].	(existingNames includes: (UTF8 withAll: nm)) ifFalse: [^ nm].	"remove trailing digits, if any"	i _ nm size.	[i > 1 and: [(nm at: i) isDigit]] whileTrue: [i _ i - 1].	[i > 1 and: [(nm at: i) = Character space]] whileTrue: [i _ i - 1].	nm _ nm copyFrom: 1 to: i.	greatestNum _ 1.	existingNames do: [:n |		i _ n size.		[i > 1 and: [(n at: i) isDigit]] whileTrue: [i _ i - 1].		(n copyFrom: 1 to: i) = nm ifTrue: [			greatestNum _ ((n copyFrom: i+1 to: n size) asNumber) max: greatestNum]].	^ nm, (greatestNum+1) printString! !----QUIT----(11 May 2009 11:22:28 am) priorSource: 8197074!----STARTUP----(11 May 2009 7:52:04 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFileChooserDialog class methodsFor: 'instance creation' stamp: 'jm 5/11/2009 20:11' prior: 39871516!chooseImageFileType: type title: aString	"ScratchFileChooserDialog chooseImageFileType: #costume title: 'Costume'"	| m |	ScratchFileChooserDialog deleteDuplicates.	m _ self new		createFileChooserLayout: false;		showThumbnails: true;		type: type;		extensions: #(gif jpeg jpg bmp png);		title: aString;		listExtent: 550@300.	"allow sprites to be imported into the paint editor:"	aString = 'Import Image' ifTrue: [		m extensions: #(gif jpeg jpg bmp png sprite)].	^ m getUserResponse! !!PaintCanvas methodsFor: 'button actions' stamp: 'jm 5/11/2009 20:16' prior: 36250584!import	"Import an image from the image library, or the current directory if there is not image library."	| fName f spriteOrStage type |	palette showRotationCenter: false.	spriteOrStage _ self owner originalObject.	(spriteOrStage isKindOf: ScratchStageMorph)		ifTrue: [type _ #background]		ifFalse: [type _ #costume].	fName _ ScratchFileChooserDialog		chooseImageFileType: type		title: 'Import Image'.	(fName isNil or: [fName = #cancelled]) ifTrue: [^ self].	(fName asLowercase endsWith: '.sprite')		ifTrue: [			f _ self importCostumeFromSprite: fName]		ifFalse: [			[f _ Form fromFileNamed: fName] ifError: [nil]].	f ifNil: [^ self].	f _ ScratchFrameMorph scaledFormForPaintEditor: f.	(owner isKindOf: PaintFrame) ifTrue: [owner scaleCanvas: 1].	self commitMove.  "commit previous move, if any"	palette mode: #move.	moveOrStampForm _ f.	selectionRect _ ((canvasForm extent - f extent) // 2) extent: f extent.! !!PaintCanvas methodsFor: 'private' stamp: 'jm 5/11/2009 20:16'!importCostumeFromSprite: fName	"Return the current costume from the give sprite file."! !----QUIT----(11 May 2009 8:21:40 pm) priorSource: 8206321!----STARTUP----(11 May 2009 8:29:55 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!PaintCanvas methodsFor: 'private' stamp: 'jm 5/11/2009 20:33' prior: 41762613!importCostumeFromSprite: fName	"Return the current costume from the give sprite file."	| data  f importedStage |	(FileDirectory default fileExists: fName) ifFalse: [^ self].	f _ (FileStream readOnlyFileNamed: fName) binary.	f ifNil: [^ self].	data _ f contentsOfEntireFile.	[importedStage _ self extractProjectFrom: data] ifError: [^ self].	importedStage submorphs do: [:m |		(m isKindOf: ScratchSpriteMorph) ifTrue: [			^ m costumeForm]].	^ nil! !moveOrStampForm!!PaintCanvas methodsFor: 'private' stamp: 'jm 5/11/2009 22:04' prior: 41762940!importCostumeFromSprite: fName	"Return the current costume from the give sprite file."	| data  f importedStage |	(FileDirectory default fileExists: fName) ifFalse: [^ nil].	f _ (FileStream readOnlyFileNamed: fName) binary.	f ifNil: [^ nil].	data _ f contentsOfEntireFile.	[importedStage _ self extractProjectFrom: data] ifError: [^ nil].	importedStage submorphs do: [:m |		(m isKindOf: ScratchSpriteMorph) ifTrue: [			^ m costumeForm]].	^ nil! !!PaintCanvas methodsFor: 'private' stamp: 'jm 5/11/2009 22:04' prior: 41763504!importCostumeFromSprite: fName	"Return the current costume from the give sprite file."	| data  f importedStage |self halt.	(FileDirectory default fileExists: fName) ifFalse: [^ nil].	f _ (FileStream readOnlyFileNamed: fName) binary.	f ifNil: [^ nil].	data _ f contentsOfEntireFile.	[importedStage _ self extractProjectFrom: data] ifError: [^ nil].	importedStage submorphs do: [:m |		(m isKindOf: ScratchSpriteMorph) ifTrue: [			^ m costumeForm]].	^ nil! !FileDirectory default fileExists: fName!	f _ (FileStream readOnlyFileNamed: fName) binary.	f!	data _ f contentsOfEntireFile.!!PaintCanvas methodsFor: 'private' stamp: 'jm 5/11/2009 22:06'!extractProjectFrom: aByteArray	"Answer a Scratch project (i.e. a ScratchStageMorph possibly containing sprites) from the given ByteArray. Answer nil if the project cannot be unpacked."	| s version proj |	s _ ReadStream on: aByteArray.	version _ ObjStream scratchFileVersionFrom: (s next: 10) asString.	version = 0 ifTrue: [		s position: 0.		proj _ ObjStream new readObjFrom: s showProgress: true].	(version = 1) | (version = 2) ifTrue: [		s skip: s uint32.  "skip header"		proj _ ObjStream new readObjFrom: s showProgress: true].	proj class = ScratchStageMorph ifFalse: [		version > 2			ifTrue: [self error: 'Project created by a later version of Scratch']			ifFalse: [self error: 'Problem reading project.'].		^ nil].	ScriptableScratchMorph buildBlockSpecDictionary.	proj allMorphsDo: [:m |		(m isKindOf: ScriptableScratchMorph) ifTrue: [  "covert to new blocks"			m convertStacksToTuples.			m convertTuplesToStacks]].	^ proj! !importedStage _ self extractProjectFrom: data!!PaintCanvas methodsFor: 'private' stamp: 'jm 5/11/2009 22:07' prior: 41764047!importCostumeFromSprite: fName	"Return the current costume from the give sprite file."	| data  f importedStage |	(FileDirectory default fileExists: fName) ifFalse: [^ nil].	f _ (FileStream readOnlyFileNamed: fName) binary.	f ifNil: [^ nil].	data _ f contentsOfEntireFile.	[importedStage _ self extractProjectFrom: data] ifError: [^ nil].	importedStage submorphs do: [:m |		(m isKindOf: ScratchSpriteMorph) ifTrue: [			^ m costumeForm]].	^ nil! !----QUIT----(11 May 2009 10:11:55 pm) priorSource: 8208272!----STARTUP----(12 May 2009 8:48:41 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SAVEAS temp2----(12 May 2009 8:48:48 am)!----STARTUP----(12 May 2009 2:28:01 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!WeDoPlugin isOpen!WeDoPlugin isOpen!buf _ ByteArray new: 10.!WeDoPlugin readInto: buf!WeDoPlugin readInto: buf!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!buf _ ByteArray new: 100.!(1 to: 10) collect: [:i | WeDoPlugin writeFrom: buf]!(1 to: 10) collect: [:i | WeDoPlugin writeFrom: buf]!----QUIT----(12 May 2009 2:53:11 pm) priorSource: 8211832!----STARTUP----(12 May 2009 2:58:16 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!WeDoPlugin isOpen!buf _ ByteArray new: 100.!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin writeFrom: buf]!!WeDoPlugin class methodsFor: 'private' stamp: 'jm 5/12/2009 14:59' prior: 40738466!sendStatus: status motorA: motorA motorB: motorB	| buf |	buf _ ByteArray new: 8.	buf at: 1 put: status.	buf at: 2 put: (motorA >= 0 ifTrue: [motorA] ifFalse: [256 + motorA]).	buf at: 3 put: (motorB >= 0 ifTrue: [motorB] ifFalse: [256 + motorB]).	self writeFrom: buf.! !WeDoPlugin reset!buf _ ByteArray new: 300.!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!!WeDoPlugin class methodsFor: 'private' stamp: 'jm 5/12/2009 15:02' prior: 41042178!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is available."	"Note: read as much data as available and take the last 8 bytes read to get the most recent values."	"Note: ID's are meaningless while the motor is running and for about a second after it has been turned off."	"self readInputs"	| buf n |	self isOpen ifFalse: [^ nil].	buf _ ByteArray new: 500.	n _ WeDoPlugin readInto: buf.	n < 8 ifTrue: [^ self]. "no data"			buf _ buf copyFrom: n - 7 to: n.	self motorAIsOff ifTrue: [		PortAID _ self mapID: (buf at: 4).		PortAValue _ buf at: 3].	self motorBIsOff ifTrue: [		PortBID _ self mapID: (buf at: 6).		PortBValue _ buf at: 5].	^ {PortAID. PortBID. PortAValue. PortBValue }! !WeDoPlugin readInputs!WeDoPlugin reset!!WeDoPlugin class methodsFor: 'private' stamp: 'jm 5/12/2009 15:08'!resetWeDo	"self resetWeDo"	self sendStatus: 128 motorA: 0 motorB: 0.	self sendStatus: 8 motorA: 0 motorB: 0.	self sendStatus: 64 motorA: 0 motorB: 0.	self initialize.  "reset motor state"	MotorAStopTime _ MotorBStopTime _ Time millisecondClockValue.! !!ScratchStageMorph methodsFor: 'scratch processes/events' stamp: 'jm 5/12/2009 15:08' prior: 40749339!stopAll	"Stop all processes and make sure I am stepping."	| sFrame |	World hands do: [:h | h newKeyboardFocus: nil; clearUnclaimedKeystrokes].	Sensor clearKeystate.	SoundPlayer stopPlayingAll.	self class stopSoundRecorder.	self stopAllProcesses.	self stopAsks.	self deleteAllClones.	self midiAllNotesOff.	WeDoPlugin resetWeDo.	self stopPlaying.	self allMorphsDo: [:m |		(m isKindOf: ScriptableScratchMorph) ifTrue: [m stopPlaying]].	(sFrame _ self ownerThatIsA: ScratchFrameMorph) ifNotNil: [		sFrame scriptsPane allMorphsDo: [:m |			(m respondsTo: #stop) ifTrue: [m stop].			(m respondsTo: #litUp:) ifTrue: [m litUp: false]].		World startSteppingSubmorphsOf: sFrame].	World startSteppingSubmorphsOf: self.! !WeDoPlugin class removeSelector: #reset!WeDoPlugin motorAOn: true!WeDoPlugin motorAOn: false!WeDoPlugin motorBOn: true!WeDoPlugin motorBOn: false!WeDoPlugin motorBOn: true!WeDoPlugin motorBOn: false!!WeDoPlugin methodsFor: 'translated prims' stamp: 'jm 5/12/2009 15:14'!primClosePort	"Close the WeDo port."	self export: true.	interpreterProxy success: (self cCode: 'WeDoClosePort()').	^ 0! !!WeDoPlugin class methodsFor: 'translation' stamp: 'jm 5/12/2009 15:14' prior: 39129496!declareCVarsIn: aCCodeGenerator	"self translate"	super declareCVarsIn: aCCodeGenerator.	aCCodeGenerator cExtras: '/* WeDo Functions */int WeDoOpenPort(void);int WeDoClosePort(void);int WeDoRead(char *bufPtr, int bufSize);int WeDoWrite(char *bufPtr, int bufSize);'.! !self translate!----QUIT----(12 May 2009 3:14:31 pm) priorSource: 8212551!----STARTUP----(12 May 2009 3:20:09 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!WeDoPlugin isOpen!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin writeFrom: buf]!WeDoPlugin resetWeDo!WeDoPlugin readInputs!!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 5/12/2009 15:23'!closePort	"Close the WeDo port. Do nothing if the port is already closed."	"self closePort"	<primitive: 'primClosePort' module: 'WeDoPlugin'>	^ nil! !WeDoPlugin closePort!WeDoPlugin closePort!----QUIT----(12 May 2009 3:24:08 pm) priorSource: 8216226!----STARTUP----(12 May 2009 3:24:56 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!WeDoPlugin closePort!WeDoPlugin closePort!WeDoPlugin isOpen!WeDoPlugin closePort!----QUIT----(12 May 2009 3:25:17 pm) priorSource: 8216832!----STARTUP----(12 May 2009 3:38:36 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!WeDoPlugin isOpen!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin writeFrom: buf]!WeDoPlugin resetWeDo!WeDoPlugin closePort!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin writeFrom: buf]!WeDoPlugin isOpen!(1 to: 10) collect: [:i | WeDoPlugin readInto: buf]!(1 to: 10) collect: [:i | WeDoPlugin writeFrom: buf]!WeDoPlugin isOpen!WeDoPl