rimitives' stamp: 'jm 3/23/2009 14:08' prior: 40739295!openPort	"Open the WeDo port. Return nil if the port could not be opened. Does nothing if the port is already open."	"self openPort"	<primitive: 'primOpenPort' module: 'WeDoPlugin'>	^ nil! !!WeDoPlugin class methodsFor: 'class initialization' stamp: 'jm 3/23/2009 14:09' prior: 40733959!initialize	"self initialize"	MotorA _ 0.	MotorB _ 0.	MotorAStopTime _ 0.	MotorBStopTime _ 0.	PortAID _ 0.	PortAValue _ 0.	PortBID _ 0.	PortBValue _ 0.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:13' prior: 41036345!isOpen	"Answer true if the WeDo port is open. If it is not open, try to open it."	^ self openPort notNil! !----QUIT----(23 March 2009 2:14:21 pm) priorSource: 7481646!----STARTUP----(23 March 2009 2:14:25 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:15' prior: 40735209!motorAPower: n	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |self beep.	wasRunning _ (MotorA ~= 0).	MotorA _ (n + (27 * n sign)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	(wasRunning and: [MotorA = 0]) ifTrue: [		MotorAStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/6/2008 20:36' prior: 41037455!motorAPower: n	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorA ~= 0).	MotorA _ (n + (27 * n sign)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	(wasRunning and: [MotorA = 0]) ifTrue: [		MotorAStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'class initialization' stamp: 'jm 3/23/2009 14:21' prior: 41036849!initialize	"self initialize"	MotorA _ 0.	MotorB _ 0.	MotorADirection _ 0.	MotorBDirection _ 0.	MotorAPower _ 0.	MotorBPower _ 0.	MotorAStopTime _ 0.	MotorBStopTime _ 0.	PortAID _ 0.	PortAValue _ 0.	PortBID _ 0.	PortBValue _ 0.! !!WeDoPlugin class methodsFor: 'class initialization' stamp: 'jm 3/23/2009 14:22' prior: 41038441!initialize	"self initialize"	MotorA _ 0.	MotorB _ 0.	MotorADirection _ 1.	MotorBDirection _ 1.	MotorAPower _ 0.	MotorBPower _ 0.	MotorAStopTime _ 0.	MotorBStopTime _ 0.	PortAID _ 0.	PortAValue _ 0.	PortBID _ 0.	PortBValue _ 0.! !self initialize!!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:23'!setPowerMotorA: aNumber	"Set the power level for motor A, 0-100."	MotorAPower _ aNumber.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:26' prior: 41039122!setPowerMotorA: aNumber	"Set the power level for motor A, 0-100."	MotorAPower _ aNumber abs.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:29'!updateMotorA	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorA ~= 0).	MotorA _ (MotorADirection * (MotorAPower + 27)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	(wasRunning and: [MotorA = 0]) ifTrue: [		MotorAStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:29'!updateMotorB	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorA ~= 0).	MotorB _ (MotorBDirection * (MotorBPower + 27)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorB motorB: MotorB.	(wasRunning and: [MotorB = 0]) ifTrue: [		MotorBStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:29' prior: 41039960!updateMotorB	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorB ~= 0).	MotorB _ (MotorBDirection * (MotorBPower + 27)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorB motorB: MotorB.	(wasRunning and: [MotorB = 0]) ifTrue: [		MotorBStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:29' prior: 41040458!updateMotorB	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorB ~= 0).	MotorB _ (MotorBDirection * (MotorBPower + 27)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	(wasRunning and: [MotorB = 0]) ifTrue: [		MotorBStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:33'!motorAIsOff	"Answer true if motor A has not run in the past second."	| now |	MotorA ~= 0 ifTrue: [^ false].  "currently running"	now _ Time millisecondClockValue.	(MotorAStopTime isNil or:	 [now < MotorAStopTime]) ifTrue: [		MotorAStopTime _ 0].	^ (now - MotorAStopTime) > 1000! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:33'!motorBIsOff	"Answer true if motor B has not run in the past second."	| now |	MotorB ~= 0 ifTrue: [^ false].  "currently running"	now _ Time millisecondClockValue.	(MotorBStopTime isNil or:	 [now < MotorBStopTime]) ifTrue: [		MotorBStopTime _ 0].	^ (now - MotorBStopTime) > 1000! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 3/23/2009 14:33' prior: 41035282!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is available."	"Note: read as much data as available (it will be multiple of 9 bytes) and take the last 9 bytes read to get the most recent values."	"Note: ID's are meaningless while the motor is running and for about a second after it has been turned off."	"self readInputs"	| buf n |	self isOpen ifFalse: [^ nil].	buf _ ByteArray new: 288. "32 * 9"	n _ WeDoPlugin readInto: buf.	n < 9 ifTrue: [^ self]. "no data"			buf _ buf copyFrom: n - 8 to: n.	self motorAIsOff ifTrue: [		PortAID _ self mapID: (buf at: 5).		PortAValue _ buf at: 4].	self motorBIsOff ifTrue: [		PortBID _ self mapID: (buf at: 7).		PortBValue _ buf at: 6].	^ {PortAID. PortBID. PortAValue. PortBValue }! !WeDoPlugin class removeSelector: #motorAStopped!WeDoPlugin class removeSelector: #motorBStopped!!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:39' prior: 41039309!setPowerMotorA: aNumber	"Set the power level for motor A, 0-100."	MotorAPower _ aNumber abs.	self updateMotorA.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:39'!setPowerMotorB: aNumber	"Set the power level for motor B, 0-100."	MotorBPower _ aNumber abs.	self updateMotorB.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:39' prior: 41043358!setPowerMotorB: aNumber	"Set the power level for motor B, 0-100."	MotorBPower _ aNumber abs.	self updateMotorB.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:40' prior: 41043162!setPowerMotorA: aNumber	"Set the power level for motor A, 0-100."	MotorAPower _ aNumber abs.	self updateMotorA.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:41'!setMotorADirection: aNumber	MotorADirection _ (aNumber >= 0) ifTrue: [1] ifFalse: [0].	self updateMotorA.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:42'!setMotorBDirection: aNumber	MotorBDirection _ (aNumber >= 0) ifTrue: [1] ifFalse: [0].	self updateMotorB.! !!WeDoPlugin class methodsFor: 'motor control' stamp: 'jm 3/23/2009 14:42' prior: 41044164!setMotorBDirection: aNumber	MotorBDirection _ (aNumber< 0) ifTrue: [-1] ifFalse: [1].	self updateMotorB.! !!WeDoPlugin class 