terViewModeOver).	quarterModeButton		target: self;		actionSelector: #exitPresentation:;		arguments: #(quarter);		alphaOn: true.	presentationModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #presentationViewModeOn)		offForm: (ScratchFrameMorph skinAt: #presentationViewMode)		overForm: (ScratchFrameMorph skinAt: #presentationViewModeOver).	presentationModeButton		alphaOn: true;		on.	self		addMorphBack: normalModeButton;		addMorphBack: quarterModeButton;		addMorphBack: presentationModeButton.! !!ScratchPresenterMorph methodsFor: 'initialization' stamp: 'jm 12/7/2008 21:29' prior: 39191822!initialize	| button |	super initialize.	self color: Color black.	doubleSize _ false.	buttons _ #(		(goSmall	shoutGo		'Start green flag scripts')		(stopSmall	stopAll		'Stop everything')	) collect: [:spec |		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonPressed'))			offForm: (ScratchFrameMorph skinAt: (spec first, 'Button')).		button			target: self;			actionSelector: spec second;			isMomentary: true;			actWhen: #buttonDown;			setProperty: #balloonText toValue: spec third localized;			drawToolTipAbove: true;			off.		#shoutGo = spec second ifTrue: [flagButton _ button].		button].	buttons do: [:b | self addMorph: b].	"view mode buttons"	normalModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #normalViewModeOn)		offForm: (ScratchFrameMorph skinAt: #normalViewMode)		overForm: (ScratchFrameMorph skinAt: #normalViewModeOver).	normalModeButton		target: self;		actionSelector: #exitPresentation:;		arguments: #(normal);		alphaOn: true.	quarterModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #quarterViewModeOn)		offForm: (ScratchFrameMorph skinAt: #quarterViewMode)		overForm: (ScratchFrameMorph skinAt: #quarterViewModeOver).	quarterModeButton		target: self;		actionSelector: #exitPresentation:;		arguments: #(quarter);		alphaOn: true.	presentationModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #presentationViewModeOn)		offForm: (ScratchFrameMorph skinAt: #presentationViewMode)		overForm: (ScratchFrameMorph skinAt: #presentationViewModeOver).	presentationModeButton		alphaOn: true;		on.	self		addMorphBack: normalModeButton;		addMorphBack: quarterModeButton;		addMorphBack: presentationModeButton.! !!ScratchPresenterMorph methodsFor: 'initialization' stamp: 'jm 12/7/2008 21:30' prior: 39193888!initialize	| button |	super initialize.	self color: Color black.	doubleSize _ false.	buttons _ #(		(goSmall	shoutGo		'Start green flag scripts')		(stopSmall	stopAll		'Stop everything')	) collect: [:spec |		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonPressed'))			offForm: (ScratchFrameMorph skinAt: (spec first, 'Button')).		button			target: self;			actionSelector: spec second;			isMomentary: true;			actWhen: #buttonUp;			setProperty: #balloonText toValue: spec third localized;			drawToolTipAbove: true;			off.		#shoutGo = spec second ifTrue: [flagButton _ button].		button].	buttons do: [:b | self addMorph: b].	"view mode buttons"	normalModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #normalViewModeOn)		offForm: (ScratchFrameMorph skinAt: #normalViewMode)		overForm: (ScratchFrameMorph skinAt: #normalViewModeOver).	normalModeButton		target: self;		actionSelector: #exitPresentation:;		arguments: #(normal);		alphaOn: true.	quarterModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #quarterViewModeOn)		offForm: (ScratchFrameMorph skinAt: #quarterViewMode)		overForm: (ScratchFrameMorph skinAt: #quarterViewModeOver).	quarterModeButton		target: self;		actionSelector: #exitPresentation:;		arguments: #(quarter);		alphaOn: true.	presentationModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #presentationViewModeOn)		offForm: (ScratchFrameMorph skinAt: #presentationViewMode)		overForm: