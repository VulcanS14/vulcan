lf extent depth: 32].	r _ aCanvas clipRect intersect: (bounds origin extent: bounds extent // 2).	srcR _ ((r origin - bounds origin) * 2.0) truncated extent: (r extent * 2.0) rounded.	c _ (FormCanvas on: cachedForm)		copyOrigin: self position negated		clipRect: srcR.	super fullDrawOn: c.	ScratchPlugin halfSize: cachedForm into: Display srcPoint: srcR origin dstRect: r."xxx	cachedForm unhibernate.	LowResPlugin		primHalf2Average: cachedForm bits w: cachedForm width h: cachedForm height		into: Display bits w: Display width h: Display height		srcX: srcR left srcY: srcR top		dstX: r left dstY: r top dstW: r width dstH: r height.	(WarpBlt toForm: Display)		sourceForm: cachedForm;		combinationRule: Form over;		clipRect: aCanvas clipRect;		cellSize: 2;		copyQuad: srcR corners toRect: r.xxx"	"the following scales down entire stage:""	LowResPlugin scale: cachedForm into: aCanvas form at: aCanvas origin + self position."! !!ScriptableScratchMorph class methodsFor: 'scratch' stamp: 'jm 1/23/2009 11:15' prior: 39493354!blockSpecs	"Answer a collection of block specifications for the blocks that are common to all objects. Block specificatons (Arrays) are interspersed with category names (Strings). A block specification is an Array of the form: (<block spec string> <block type> <selector> [optional initial argument values]).	Explanation of flags:		-	no flags		b	boolean reporter		c	c-shaped block containing a sequence of commands (always special form)		r	reporter		s	special form command with its own evaluation rule		t	timed command, like wait or glide		E	message event hat		K	key event hat		M	mouse-click event hat		S	start event hat		W	when <condition> hat (obsolete)"	| blocks |	blocks _ #(		'control'			('when %m clicked'				S	-)			('when %k key pressed'			K	-)			('when %m clicked'				M	-)			-			('wait %n secs'					t	wait:elapsed:from: 1)			-			('forever'						c	doForever)			('repeat %n'						c	doRepeat 10)			-			('broadcast %e'					-	broadcast:)			('broadcast %e and wait'			s	doBroadcastAndWait)			('when I receive %e'			E	-)			-			('forever if %b'					c	doForeverIf)			('if %b'							c	doIf)			('if %b'							c	doIfElse)			('wait until %b'					s	doWaitUntil)			('repeat until %b'				c	doUntil)			-			('stop script'					s	doReturn)			('stop all'						-	stopAll)		'numbers'			('%n + %n'						r	+ - -)			('%n - %n'						r	- - -)			('%n * %n'						r	* - -)			('%n / %n'						r	/ - -)			-			('pick random %n to %n'		r	randomFrom:to: 1 10)			-			('%s < %s'						b	< '' '')			('%s = %s'						b	= - -)			('%s > %s'						b	> - -)			-			('%s with %s'					r	concatenate:with: 'Hi, ' 'Gobo!!')			-			('%b and %b'					b	&)			('%b or %b'						b	|)			('not %b'						b	not)			-			('%n mod %n'					r	\\ - -)			('round %n'						r	rounded -)			-			('%f of %n'						r	computeFunction:of: 'sqrt' 10)		'sound'			('play sound %S'				-	playSound:)			('play sound %S until done'		s	doPlaySoundAndWait)			('stop all sounds'				-	stopAllSounds)			-			('play drum %D for %n beats'	t 	drum:duration:elapsed:from: 48 0.2)			('rest for %n beats'				t 	rest:elapsed:from: 0.2)			-			('play note %N for %n beats'	t	noteOn:duration:elapsed:from: 60 0.5)			('set instrument to %I'			- 	midiInstrument: 1)			-			('change volume by %n'		- 	changeVolumeBy: -10)			('set volume to %n%'			- 	setVolumeTo: 100)			('volume'						r 	volume)			-			('change tempo by %n'			- 	changeTempoBy: 20)			('set tempo to %n bpm'			- 	setTempoTo: 60)			('tempo'							r 	tempo)		'variables'			('show variable %v'				-	showVariable:)			('hide variable %v'				-	hideVariable:)		'list'			('add %s to %L'					-	append:toList: 'thing')			-			('delete %y of %L'				-	deleteLine:ofList: 1)			('insert %s at %i of %L'			-	insert:at:ofList: 'thing' 1)			('replace item %i of %L with %s'		-	setLine:ofList:to: 1 'list' 'thing')			-			('item %i of %L'					r	getLine:ofList: 1)			('length of %L'						r	lineCountOfList:)	).	^ blocks, self obsoleteBlockSpecs! !!ScriptableScratchMorph class methodsFor: 'scratch' stamp: 'jm 1/23/2009 11:18' prior: 39508673!blockSpecs	"Answer a collection of block specifications for the blocks that are common to all objects. Block specificatons (Arrays) are interspersed with category names (Strings). A block specification is an Array of the form: (<block spec string> <block type> <selector> [optional initial argument values]).	Explanation of flags:		-	no flags		b	boolean reporter		c	c-shaped block containing a sequence of commands (always special form)		r	reporter		s	special form command with its own evaluation rule		t	timed command, like wait or glide		E	message event hat		K	key event hat		M	mouse-click event hat		S	start event hat		W	when <condition> hat (obsolete)"	| blocks |	blocks _ #(		'control'			('when %m clicked'				S	-)			('when %k key pressed'			K	-)			('when %m clicked'				M	-)			-			('wait %n secs'					t	wait:elapsed:from: 1)			-			('forever'						c	doForever)			('repeat %n'						c	doRepeat 10)			-			('broadcast %e'					-	broadcast:)			('broadcast %e and wait'			s	doBroadcastAndWait)			('when I receive %e'			E	-)			-			('forever if %b'					c	doForeverIf)			('if %b'							c	doIf)			('if %b'							c	doIfElse)			('wait until %b'					s	doWaitUntil)			('repeat until %b'				c	doUntil)			-			('stop script'					s	doReturn)			('stop all'						-	stopAll)		'numbers'			('%n + %n'						r	+ - -)			('%n - %n'						r	- - -)			('%n * %n'						r	* - -)			('%n / %n'						r	/ - -)			-			('pick random %n to %n'		r	randomFrom:to: 1 10)			-			('%s < %s'						b	< '' '')			('%s = %s'						b	= '' '')			('%s > %s'						b	> '' '')			-			('%s with %s'					r	concatenate:with: 'blue' 'fish')			-			('%b and %b'					b	&)			('%b or %b'						b	|)			('not %b'						b	not)			-			('%n mod %n'					r	\\ - -)			('round %n'						r	rounded -)			-			('%f of %n'						r	computeFunction:of: 'sqrt' 10)		'sound'			('play sound %S'				-	playSound:)			('play sound %S until done'		s	doPlaySoundAndWait)			('stop all sounds'				-	stopAllSounds)			-			('play drum %D for %n beats'	t 	drum:duration:elapsed:from: 48 0.2)			('rest for %n beats'				t 	rest:elapsed:from: 0.2)			-			('play note %N for %n beats'	t	noteOn:duration:elapsed:from: 60 0.5)			('set instrument to %I'			- 	midiInstrument: 1)			-			('change volume by %n'		- 	changeVolumeBy: -10)			('set volume to %n%'			- 	setVolumeTo: 100)			('volume'						r 	volume)			-			('change tempo by %n'			- 	changeTempoBy: 20)			('set tempo to %n bpm'			- 	setTempoTo: 60)			('tempo'							r 	tempo)		'variables'			('show variable %v'				-	showVariable:)			('hide variable %v'				-	hideVariable:)		'list'			('add %s to %L'					-	append:toList: 'thing')			-			('delete %y of %L'				-	deleteLine:ofList: 1)			('insert %s at %i of %L'			-	insert:at:ofList: 'thing' 1)			('replace item %i of %L with %s'		-	setLine:ofList:to: 1 'list' 'thing')			-			('item %i of %L'					r	getLine:ofList: 1)			('length of %L'						r	lineCountOfList:)	).	^ blocks, self obsoleteBlockSpecs! !----QUIT----(23 January 2009 11:53:57 am) priorSource: 5951787!----STARTUP----(23 January 2009 12:18:02 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 23 January 2009 at 12:16:00 pm'!Object subclass: #ScratchPrinter	instanceVariableNames: 'stream indent '	classVariableNames: 'BooleanReporters Specs '	poolDictionaries: ''	category: 'Scratch-Blox'!!ScratchPrinter methodsFor: 'entry point' stamp: 'jm 1/15/2009 16:41'!printTuple: anArray	"Return a formated representation of the given block stack represented as a tuple."	stream _ WriteStream on: (String new: 1000).	indent _ 0.	self printSequence: anArray.	^ stream contents! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/15/2009 16:52'!hexFor: aNumber	"Answer a string representing the given number, rounded, in hexadecimal."	| s |	s _ (255.0 * aNumber) rounded hex.	s _ s copyFrom: 4 to: s size.	s _ (String new: 2 - s size withAll: $0), s.  "pad to two digits"	^ s! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/15/2009 17:01'!printArg: anObject	"Print the given argument on my stream."	| i spec |	(anObject isKindOf: Number) ifTrue: [		stream nextPutAll: anObject printString.		^ self].	(anObject isKindOf: String) ifTrue: [		stream nextPutAll: '"', anObject, '"'.		^ self].	(anObject isKindOf: Boolean) ifTrue: [		stream nextPutAll: anObject printString.		^ self].	(anObject isKindOf: Color) ifTrue: [		stream nextPutAll: 'c[',			(self hexFor: anObject red),			(self hexFor: anObject green),			(self hexFor: anObject blue),			']'.		^ self].	"reporter"	(anObject isKindOf: Array) ifTrue: [		stream nextPut: $(.		i _ 1.		spec _ Specs at: anObject first ifAbsent: [Array with: anObject first].		spec do: [:token |			(token beginsWith: '%')				ifTrue: [					(i _ i + 1) <= anObject size ifTrue: [self printArg: (anObject at: i)]]				ifFalse: [					'?' = token ifTrue: [stream skip: -1].  "remove space before ?"					stream nextPutAll: token].			stream space].		stream skip: -1. "remove final space"		stream nextPut: $).		^ self].	self error: 'unknown argument type'.! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/15/2009 16:49'!printCommand: anArray	"Print the given command on my stream."	| cmd spec seq i |	cmd _ anArray first.	(#(EventHatMorph KeyEventHatMorph MouseClickEventHatMorph WhenHatMorph)		includes: cmd) ifTrue: [			^ self printHat: anArray].	spec _ Specs at: cmd ifAbsent: [Array with: cmd].	#doForever = cmd ifTrue: [		stream nextPutAll: spec first; cr.		^ self printSubsequence: (anArray at: 2)].	(#(doForeverIf doIf doRepeat doUntil) includes: cmd) ifTrue: [		stream nextPutAll: spec first; space.		self printArg: (anArray at: 2).		stream cr.		^ self printSubsequence: (anArray at: 3)].	#doIfElse = cmd ifTrue: [		stream nextPutAll: spec first; space.		self printArg: (anArray at: 2).		stream cr.		seq _ anArray at: 3.		self printSubsequence: seq.		(seq notNil and: [seq size > 0]) ifTrue: [stream cr].		self printIndent.		stream nextPutAll: 'else'; cr.		^ self printSubsequence: (anArray at: 4)].	"normal command block"	i _ 1.	spec do: [:token |		(token beginsWith: '%')			ifTrue: [				(i _ i + 1) <= anArray size ifTrue: [self printArg: (anArray at: i)]]			ifFalse: [				stream nextPutAll: token].		stream space].	stream skip: -1. "remove final space"	stream cr.! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/15/2009 16:42'!printHat: anArray	"Print a hat block on my stream and increase the indent level."	| cmd evt |	cmd _ anArray first.	evt _ anArray at: 2.	cmd = #EventHatMorph ifTrue: [		'Scratch-StartClicked' = evt			ifTrue: [stream nextPutAll: 'when green flag clicked']			ifFalse: [stream nextPutAll: 'when I receive '. self printArg: evt]].	cmd = #KeyEventHatMorph ifTrue: [		stream nextPutAll: 'when '.		self printArg: evt.		stream nextPutAll:' key pressed'].	cmd = #MouseClickEventHatMorph ifTrue: [		stream nextPutAll: 'when sprite clicked'].	cmd = #WhenHatMorph ifTrue: [		stream nextPutAll: 'when '.		self printArg: evt].	indent _ indent + 1.	stream cr.! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/15/2009 13:19'!printIndent	indent timesRepeat: [stream nextPutAll: '    '].! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/15/2009 13:20'!printSequence: anArray	"Print the given block sequence on my stream."	anArray ifNil: [^ self].  "empty sequence"	anArray do: [:cmd |		self printIndent.		self printCommand: cmd].! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/15/2009 16:39'!printSubsequence: anArray	"Print the given indented block subsequence (e.g. the blocks inside a C-block)."	indent _ indent + 1.	self printSequence: anArray.	indent _ indent - 1.! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ScratchPrinter class	instanceVariableNames: ''!!ScratchPrinter class methodsFor: 'class initialization' stamp: 'jm 1/22/2009 11:59'!initialize	"self initialize"	| spec sel |	Specs _ Dictionary new.	BooleanReporters _ Set new.	ScratchSpriteMorph blockSpecs, ScratchStageMorph blockSpecs,		ScriptableScratchMorph blockSpecs, ScriptableScratchMorph obsoleteBlockSpecs do: [:el |			(el isKindOf: Array) ifTrue: [				spec _ el at: 1.				sel _ el at: 3.				'b' = (el at: 2) ifTrue: [BooleanReporters add: sel].				Specs at: sel put: (self parseCommandSpec: spec)]].! !!ScratchPrinter class methodsFor: 'class initialization' stamp: 'jm 1/22/2009 12:05'!javaBooleanTable	"Generate a Java specifications array."	"self javaBooleanTable"	| s |	self initialize.	s _ WriteStream on: String new.	s nextPutAll: '{'; cr.	(BooleanReporters asArray sort) do: [:sel |		s nextPutAll: '"', sel, '", '].	s skip: -2.	s nextPutAll: '}'; cr.	^ s contents! !!ScratchPrinter class methodsFor: 'class initialization' stamp: 'jm 1/15/2009 17:12'!javaSpecTable	"Generate a Java specifications array."	"self javaSpecTable"	| s |	self initialize.	s _ WriteStream on: String new.	s nextPutAll: '{'; cr.	(Specs keys asArray sort) do: [:k |		s tab; tab; nextPutAll: '{'.		s nextPutAll: '"', k, '", '.		(Specs at: k) do: [:token |			s nextPutAll: '"', token, '", '].		s skip: -2.		s nextPutAll: '},'; cr].	s tab; nextPutAll: '}'; cr.	^ s contents! !!ScratchPrinter class methodsFor: 'class initialization' stamp: 'jm 1/15/2009 13:06'!parseCommandSpec: aString	"Answer an array of token strings containing my keywords and argument specs."	| spec result len i j |	result _ OrderedCollection new.	spec _ aString.	(spec isKindOf: UTF8) ifTrue: [spec _ String withAll: spec].	len _ spec size.	i _ 1.	[(i < len) and: [(spec at: i) isSeparator]] whileTrue: [i _ i + 1].	[i <= len] whileTrue: [		j _ spec indexOf: $% startingAt: i.		j > 0			ifTrue: [				j > i ifTrue: [result addLast: (spec copyFrom: i to: j - 1)].				j < len					ifTrue: [result addLast: (spec copyFrom: j to: j + 1)]					ifFalse: [result addLast: '%'].				i _ j + 2]			ifFalse: [				result addLast: (spec copyFrom: i to: len).				i _ len + 1]].	^ result asArray collect: [:s | s withBlanksTrimmed]! !ScratchPrinter initialize!----SNAPSHOT----(23 January 2009 12:20:04 pm) priorSource: 5960311!----SNAPSHOT----(23 January 2009 12:21:49 pm) priorSource: 5967540!----QUIT----(23 January 2009 12:23:05 pm) priorSource: 5967609!----STARTUP----(23 January 2009 12:24:45 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFrameMorph methodsFor: 'stepping' stamp: 'jm 12/30/2008 19:05' prior: 37055027!step	"Run each process until it gives up control, then filter out any processes that have terminated."	| screenExtent oldJustSaved |	fillScreenFlag ifTrue: [		screenExtent _ Display extent.		((self position = (0@0)) and: [self extent = screenExtent]) ifFalse: [			oldJustSaved _ justSaved.			self position: 0@0.			self extent: screenExtent.			scriptsPane currentCategory: scriptsPane currentCategory.			justSaved _ oldJustSaved.			^ self]].	workPane ifNotNil: [		ScriptableScratchMorph scratchOrigin: workPane center.		viewerPane target isNil 			ifTrue: [workPane viewBlocksAndScripts]			ifFalse: [viewerPane target isInWorld ifFalse: [workPane viewBlocksAndScripts]]].	Sensor processOSMenuEvents.	paintingInProgress ifTrue: [^ self].	workPane scratchServer ifNotNil: [workPane scratchServer stepServer].	self processWhenConditions.	self processKeyboardEvents.	workPane stepProcesses.	workPane scratchServer ifNotNil: [workPane scratchServer stepServer].	self processDroppedFiles.	workPane processesToRun size > 0		ifTrue: [flagButton on]		ifFalse: [flagButton off].! !----SNAPSHOT----(23 January 2009 12:26:21 pm) priorSource: 5967678!----QUIT----(23 January 2009 12:32:10 pm) priorSource: 5969033!----STARTUP----(23 