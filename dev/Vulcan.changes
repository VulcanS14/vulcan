ds'].		(media directoryExists: 'Costumes') ifTrue: [			DefaultCostumeFolder _ media directoryNamed: 'Costumes'.			DefaultSpriteFolder _ media directoryNamed: 'Costumes'].		(media directoryExists: 'Sounds') ifTrue: [			DefaultSoundFolder _ media directoryNamed: 'Sounds']].	(FileDirectory default directoryExists: 'Projects') ifTrue: [		DefaultProjectFolder _ FileDirectory default directoryNamed: 'Projects'].! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/19/2009 19:45' prior: 40221055!setDefaultUserProjectFolder: aStringOrNil	"Set the default projects folder for this user."	aStringOrNil ifNil: [		DefaultUserProjectsFolder _ nil.		^ self].	DefaultUserProjectsFolder _ FileDirectory on: aStringOrNil.! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/19/2009 19:48' prior: 40220563!myScratchProjects	"My Scratch Projects button was pressed."	| dir |self beep.	dir _ DefaultUserProjectsFolder.	dir ifNil: [		dir _ FileDirectory on: (ScratchPlugin primGetFolderPath: 1).		(dir directoryExists: 'Scratch') ifTrue: [			dir _ dir directoryNamed: 'Scratch']].	list currentDirectory: dir.! !----QUIT----(20 February 2009 9:58:50 am) priorSource: 6661318!----STARTUP----(22 February 2009 2:11:01 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!#(1452 1133 1684) collect: [:n | n hex]!560 hex!49176 hex!33346 hex!----STARTUP----(22 February 2009 9:25:51 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFileChooserDialog methodsFor: 'initialization' stamp: 'jm 2/22/2009 21:27' prior: 40216911!addShortcutButtons	"Add these to my current shortcuts."	"Note: The shortcut column morph was created by initialize; I just add to its contents a new collection of shortcuts."	| spacer backgrounds costumes sounds projects |	backgrounds _ ScratchFileChooserDialog getDefaultFolderForType: #background.	costumes _ ScratchFileChooserDialog getDefaultFolderForType: #costume.	sounds _ ScratchFil