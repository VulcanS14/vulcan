wImage: f2 at: self position."	f2 displayOn: Display at: self position rule: Form over.	Display forceToScreen: (self position extent: f2 extent)."! !----QUIT----(18 November 2008 8:28:52 pm) priorSource: 5535630!----STARTUP----(19 November 2008 1:43:47 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!self extent: 800@480!self extent: 720@420!TakeOverScreen!TakeOverScreen _ true!TakeOverScreen _ false!ClassmateDemo!----STARTUP----(20 November 2008 5:24:30 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!CameraSensorTestMorph open!self videoTest!self videoTest!self videoTest!----STARTUP----(20 November 2008 5:33:13 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SNAPSHOT----(20 November 2008 5:33:43 pm) priorSource: 5536981!CameraPlugin videoTest!----STARTUP----(20 November 2008 5:35:44 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!CameraPlugin videoTest!----STARTUP----(20 November 2008 5:38:58 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!CameraPlugin videoTest!CameraPlugin videoTest!CameraPlugin videoTest!----STARTUP----(20 November 2008 5:44:20 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!CameraPlugin videoTest!----STARTUP----(20 November 2008 5:50:42 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!CameraPlugin videoTest!----STARTUP----(20 November 2008 5:52:40 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!CameraPlugin videoTest!!CameraPlugin class methodsFor: 'camera ops' stamp: 'jm 11/20/2008 17:53' prior: 33977556!videoTest	"A quick test of video input. Displays video on the screen until the mouse is pressed."	"self videoTest"	| f n startTime frameCount msecs fps |	CameraPlugin openCamera: 1 width: 320 height: 240.	(self frameExtent: 1) x = 0 ifTrue: [^ self inform: 'no camera'].	f _ Form extent: (CameraPlugin frameExtent: 0) depth: 32.	frameCount _ 0.	startTime _ nil.	[Sensor anyButtonPressed] whileFalse: [		n _ CameraPlugin getFrameForCamera: 1 into: f bits.		n > 0 ifTrue: [			startTime ifNil: [startTime _ Time millisecondClockValue].			frameCount _ frameCount + 1.			f display]].	Sensor waitNoButton.	msecs _ Time millisecondClockValue - startTime.	CameraPlugin closeCamera: 1.	fps _ (frameCount * 1000) // msecs.	self inform: frameCount printString, ' frames at ', fps printString, ' frames/sec'.! !self videoTest!!CameraPlugin class methodsFor: 'camera ops' stamp: 'jm 11/20/2008 17:54' prior: 39092847!videoTest	"A quick test of video input. Displays video on the screen until the mouse is pressed."	"self videoTest"	| f n startTime frameCount msecs fps |	CameraPlugin openCamera: 1 width: 320 height: 240.	(self frameExtent: 1) x = 0 ifTrue: [^ self inform: 'no camera'].	f _ Form extent: (CameraPlugin frameExtent: 0) depth: 32.	frameCount _ 0.	startTime _ nil.	[Sensor anyButtonPressed] whileFalse: [		n _ CameraPlugin getFrameForCamera: 1 into: f bits.		n > 0 ifTrue: [			startTime ifNil: [startTime _ Time millisecondClockValue].			frameCount _ frameCount + 1.			f display]].	Sensor waitNoButton.	msecs _ Time millisecondClockValue - startTime.	CameraPlugin closeCamera: 1.	fps _ (frameCount * 1000) // msecs.	^ frameCount printString, ' frames at ', fps printString, ' frames/sec'! !self videoTest!self videoTest!----SNAPSHOT----(20 November 2008 5:59:06 pm) priorSource: 5537554!!CameraPlugin class methodsFor: 'camera ops' stamp: 'jm 11/20/2008 17:59' prior: 39093775!videoTest	"A quick test of video input. Displays video on the screen until the mouse is pressed."	"self videoTest"	| f n startTime frameCount msecs fps |	CameraPlugin openCamera: 1 width: 640 height: 480.	(self frameExtent: 1) x = 0 ifTrue: [^ self inform: 'no camera'].	f _ Form extent: (CameraPlugin frameExtent: 0) depth: 32.	frameCount _ 0.	startTime _ nil.	[Sensor anyButtonPressed] whileFalse: [		n _ CameraPlugin getFrameForCamera: 1 into: f bits.		n > 0 ifTrue: 