Addr).	(wanAddr notNil and: [wanAddr ~= localAddr]) ifTrue: [		msg _ msg, String cr, 'Internet:   ', (NetNameResolver stringFromAddress: wanAddr)].	DialogBoxMorph inform: msg title: 'IP Address'.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 5/1/2009 11:05' prior: 41589697!showNetworkAddress	"Display my IP address. This is a temporary feature to allow connected multiple Scratch computers in a peer-to-peer configuration without the help of a presence server."	| localAddr wanAddr msg |	Socket initializeNetwork.	localAddr _ NetNameResolver localHostAddress."	wanAddr _ ScratchServer getIPAddressFromServer."	msg _ 'Local: ', (NetNameResolver stringFromAddress: localAddr).	(wanAddr notNil and: [wanAddr ~= localAddr]) ifTrue: [		msg _ msg, String cr, 'Internet:   ', (NetNameResolver stringFromAddress: wanAddr)].	DialogBoxMorph inform: msg title: 'IP Address'.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 5/1/2009 11:05' prior: 41590401!showNetworkAddress	"Display my IP address. This is a temporary feature to allow connected multiple Scratch computers in a peer-to-peer configuration without the help of a presence server."	| localAddr wanAddr msg |	Socket initializeNetwork.	localAddr _ NetNameResolver localHostAddress."	wanAddr _ ScratchServer getIPAddressFromServer."	msg _ 'Local: ', (NetNameResolver stringFromAddress: localAddr).	(wanAddr notNil and: [wanAddr ~= localAddr]) ifTrue: [		msg _ msg, String cr, 'Internet:   ', (NetNameResolver stringFromAddress: wanAddr)].	DialogBoxMorph inform: msg title: 'IP Address'.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 5/1/2009 11:06' prior: 41591105!showNetworkAddress	"Display my IP address. This is a temporary feature to allow connected multiple Scratch computers in a peer-to-peer configuration without the help of a presence server."	| localAddr wanAddr msg |	Socket initializeNetwork.	localAddr _ NetNameResolver localHostAddress.	wanAddr _ nil."	wanAddr _ ScratchServer getIPAddressFromServer."	msg _ 'Local: ', (NetNameResolver stringFromAddress: localAddr).	(wanAddr notNil and: [wanAddr ~= localAddr]) ifTrue: [		msg _ msg, String cr, 'Internet:   ', (NetNameResolver stringFromAddress: wanAddr)].	DialogBoxMorph inform: msg title: 'IP Address'.! !!ScratchFrameMorph methodsFor: '-- all --' stamp: 'jm 5/1/2009 11:08' prior: 41553667!aboutScratch	| dialogBox |	dialogBox _ DialogBoxMorph new		title: 'About Scratch';		withButtonsForYes: false no: false okay: true cancel: false.	dialogBox		message: 'Scratch ', Version, 'Copyright � 2009 Massachusetts Institute of Technology.All rights reserved.Developed by the Lifelong Kindergarten Group at the MIT Media Lab,with support from the National Science Foundation, Microsoft, Intel,Nokia, and MIT Media Lab research consortia.For more information, see http://scratch.mit.eduFor license information, see license.txt in Scratch folder.'		font: (ScratchFrameMorph getFont: #AboutScratch).	dialogBox getUserResponse.! !!ScratchFrameMorph methodsFor: '-- all --' stamp: 'jm 5/1/2009 11:08' prior: 41592519!aboutScratch	| dialogBox |	dialogBox _ DialogBoxMorph new		title: 'About Scratch';		withButtonsForYes: false no: false okay: true cancel: false.	dialogBox		message: 'Scratch ', Version, 'Copyright � 2009 Massachusetts Institute of Technology.All rights reserved.Developed by the Lifelong Kindergarten Group at the MIT Media Lab,with support from the National Science Foundation, Microsoft, Intel,Nokia, and MIT Media Lab research consortia.For more information, see http://scratch.mit.eduFor license details, see license.txt in Scratch folder.'		font: (ScratchFrameMorph getFont: #AboutScratch).	dialogBox getUserResponse.! !!ScratchFrameMorph methodsFor: '-- all --' stamp: 'jm 5/1/2009 11:09' prior: 41593258!aboutScratch	| dialogBox |	dialogBox _ DialogBoxMorph new		title: 'About Scratch';		withButtonsForYes: