or"	spec _ '%n ', choice, ' %n'.	'\\' = choice	ifTrue: [spec _ ScratchTranslator translationFor: '%n mod %n'].	'&' = choice	ifTrue: [spec _ ScratchTranslator translationFor: '%b and %b'].	'|' = choice	ifTrue: [spec _ ScratchTranslator translationFor: '%b or %b'].	self commandSpec: spec.	self selector: choice.! !----SNAPSHOT----(14 March 2009 12:20:56 pm) priorSource: 7236162!Smalltalk garbageCollect.Smalltalk obsoleteClasses size!Smalltalk obsoleteClasses!Smalltalk removeClassNamed: #ScratchPrinter!Smalltalk removeClassNamed: #ScratchParser!Smalltalk garbageCollect.Smalltalk obsoleteClasses size!Smalltalk garbageCollect.Smalltalk obsoleteClasses!----STARTUP----(14 March 2009 12:22:21 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SNAPSHOT----(14 March 2009 12:24:54 pm) priorSource: 7238373!Smalltalk garbageCollect.Smalltalk obsoleteClasses size!Smalltalk garbageCollect.Smalltalk obsoleteClasses!----STARTUP----(14 March 2009 12:25:58 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!Smalltalk garbageCollect.Smalltalk obsoleteClasses!Smalltalk garbageCollect.Smalltalk obsoleteClasses!----SNAPSHOT----(14 March 2009 12:26:32 pm) priorSource: 7238829!----SNAPSHOT----(14 March 2009 12:26:41 pm) priorSource: 7239215!Smalltalk removeClassNamed: #ScratchPrinter!Smalltalk removeClassNamed: #ScratchParser!Smalltalk garbageCollect.Smalltalk obsoleteClasses size!Smalltalk garbageCollect.Smalltalk obsoleteClasses!----STARTUP----(14 March 2009 12:27:16 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!ChangeSorter removeChangeSetsBefore: 'John-Feb2'!Smalltalk garbageCollect.Smalltalk obsoleteClasses size!Smalltalk removeClassNamed: #ScratchPrinter!Smalltalk removeClassNamed: #ScratchParser!Smalltalk garbageCollect.Smalltalk obsoleteClasses size!----STARTUP----(14 March 2009 12:29:00 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!ChangeSorter removeChangeSetsBefore: 'Joh