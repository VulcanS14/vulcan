(owner orientation = #horizontal)			ifTrue: [ ^subMenu				popUpAt: self bottomLeft + 10				forHand: aHand 				from: self]].		subMenu			popUpAdjacentTo: (Array with: self bounds topRight + (10@0)									with: self bounds topLeft)			forHand: aHand			from: self].! !|main sub|sub _ MenuMorph new.1 to: 5 do: [:i|	sub add: 'entry', i printString action: #yourself ].main _ MenuMorph new.main orientation: #horizontal;	color: Color veryLightGray;	borderColor: main color;	stayUp: true.1 to: 5 do: [:i|	main add: 'submenu', i printString subMenu: sub ].main popUpNearHand!!MenuMorph methodsFor: 'accessing' stamp: 'jm 2/17/2009 11:59'!updateFont: aStrikeFont	"Update the font of my top-level menu items to use the given font."	self items do: [:item | item font: aStrikeFont].! !StrikeFont fontName: 'ComicBold' size: 48!|main sub|sub _ MenuMorph new.1 to: 5 do: [:i|	sub add: 'entry', i printString action: #yourself ].main _ MenuMorph new.main orientation: #horizontal;	color: Color veryLightGray;	borderColor: main color;	stayUp: true.1 to: 5 do: [:i|	main add: 'submenu', i printString subMenu: sub].main updateFont: (StrikeFont fontName: 'ComicBold' size: 48).main popUpNearHand!| main sub |sub _ MenuMorph new.1 to: 5 do: [:i | sub add: 'entry', i printString action: #yourself ].main _ MenuMorph new.main orientation: #horizontal;	color: Color veryLightGray;	borderColor: main color;	stayUp: true.main updateFont: (StrikeFont fontName: 'ComicBold' size: 48).1 to: 5 do: [:i | main add: 'submenu', i printString subMenu: sub].main popUpNearHand!----STARTUP----(17 February 2009 1:34:45 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!self buildBlockTableCSV!'glide %n secs to x:%n y:%n'!self findTokens: ' '!self select: [:r | (r at: 2) includes: $%]!!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/17/2009 13:43' prior: 40028642!formatLabel: aString	| s |	s _ WriteStream on: String new.	(aString findTokens: ' ') do: [:el |		(el size > 1 and: [el first = $%])			ifTrue: [s nextPut: $_]			ifFalse: [s nextPutAll: el]].	^ s contents! !self buildBlockTableCSV!self select: [:r | (r at: 2) includes: $%]!!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/17/2009 13:51' prior: 40164427!formatLabel: aString	| s |	s _ WriteStream on: String new.	(aString findTokens: ' ') do: [:el |		(el size > 1 and: [el includes: $%])			ifTrue: [				el first = $% ifTrue: [s nextPut: $_] ifFalse: [Transcript show: el; cr].				(el at: el size - 2) = $% ifTrue: [s nextPutAll: (el copyFrom: 1 to: el size - 3), '_']]			ifFalse: [s nextPutAll: el]].	^ s contents! !!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/17/2009 13:55' prior: 40164813!formatLabel: aString	| s |	s _ WriteStream on: String new.	(aString findTokens: ' ') do: [:el |		(el includes: $%) ifTrue: [			((el size = 2) & (el first = $%))				ifTrue: [s nextPut: $_]				ifFalse: [					((el size > 2) and: [el at: el size - 2]) = $%						ifTrue: [s nextPutAll: (el copyFrom: 1 to: el size - 3), '_']						ifFalse: [Transcript show: el; cr]]]			ifFalse: [s nextPutAll: el]].	^ s contents! !self buildBlockTableCSV!self select: [:r | (r at: 2) includes: $%]!!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/17/2009 13:56' prior: 40165287!formatLabel: aString	| s |	s _ WriteStream on: String new.	(aString findTokens: ' ') do: [:el |		(el includes: $%)			ifTrue: [				((el size = 2) & (el first = $%))					ifTrue: [s nextPut: $_]					ifFalse: [						((el size > 2) and: [el at: el size - 2]) = $%							ifTrue: [s nextPutAll: (el copyFrom: 1 to: el size - 3), '_']]]			ifFalse: [				s nextPutAll: el]].	^ s contents! !self buildBlockTableCSV!self select: [:r | (r at: 2) includes: $%]!self buildBlockTableCSV!!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/17/2009 13:58' prior: 40043126!buildBlockTableCSV	"Create a table mapping internal to external block names. Format the result as a comma-separated value (CSV) file."	"self buildBlockTableCSV"	"| f | f _ FileStream newFileNamed: 'table.txt'. f nextPutAll: self buildBlockTableCSV. f close"	| specRecords isObsolete category r s internalName label |	specRecords _ OrderedCollection new.	isObsolete _ false.	category _ ''.	ScriptableScratchMorph blockSpecs,	  ScratchSpriteMorph blockSpecs,	  ScratchStageMorph blockSpecs do: [:spec |		((spec isKindOf: String) and:		 [#- ~= spec and:		 [#~ ~= spec]]) ifTrue: [			category _ spec.			isObsolete _ category asLowercase includesSubString: 'obsolete'].		(spec isKindOf: Array) ifTrue: [			internalName _ self formatInternalName: (spec at: 3).			label _ self formatLabel: (spec at: 1)."			(spec at: 3) isInfix ifTrue: [internalName _ label _ (spec at: 3)]."			r _ {internalName. label. category. isObsolete}.			(specRecords includes: r) ifFalse: [				specRecords add: r]]].	specRecords _ specRecords asArray sort: [:r1 :r2 | r1 first < r2 first].true ifTrue: [^ specRecords].	s _WriteStream on: (String new: 10000).	specRecords do: [:rec |		s nextPutAll: (rec at: 1).		s nextPut: $,.		s nextPutAll: (rec at: 2).		s nextPut: $,.		s nextPutAll: (rec at: 3).		s nextPut: $,.		s nextPutAll: ((rec at: 4) ifTrue: ['1'] ifFalse: ['0']).		s nextPut: $,.		s crlf].	^ s contents! !self buildBlockTableCSV!self buildBlockTableCSV!!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/17/2009 13:58' prior: 40166477!buildBlockTableCSV	"Create a table mapping internal to external block names. Format the result as a comma-separated value (CSV) file."	"self buildBlockTableCSV"	"| f | f _ FileStream newFileNamed: 'table.txt'. f nextPutAll: self buildBlockTableCSV. f close"	| specRecords isObsolete category r s internalName label |	specRecords _ OrderedCollection new.	isObsolete _ false.	category _ ''.	ScriptableScratchMorph blockSpe