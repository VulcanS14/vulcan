Name _ self uniqueSummaryFileName].	f _ StandardFileStream newScratchFileNamed: fName.	f ifNil: [^ self].	f nextPutAll: s contents.	f close.! !!ScratchListMorph methodsFor: 'import/export' stamp: 'jm 2/24/2009 14:58'!uniqueListFileName	| baseName fileName n |	baseName _ titleMorph contents.	baseName size <= 1 ifTrue: [baseName _ 'newList'].	fileName _ baseName, '.txt'.	n _ 1.	[FileDirectory default fileExists: fileName] whileTrue: [		fileName _ baseName, n printString, '.txt'.		n _ n + 1].	^ fileName! !!ScratchListMorph methodsFor: 'import/export' stamp: 'jm 2/24/2009 15:00' prior: 37160444!exportList	| s fName f |	s _ WriteStream on: (String new: 10000).	cellMorphs do: [:m |		s nextPutAll: m firstSubmorph contents; crlf].	fName _ titleMorph contents.	fName size <= 1 ifTrue: [fName _ 'newList'].	fName _ fName, '.txt'.	fName _ ScratchFileChooserDialog		chooseNewFileDefault: self uniqueListFileName		title: 'File Name?'		type: #listExport.	f _ StandardFileStream newScratchFileNamed: fName.	f ifNil: [^ self].	f nextPutAll: s contents.	f close.! !ScratchListMorph removeSelector: #uniqueSummaryFileName!!ScratchListMorph methodsFor: 'import/export' stamp: 'jm 2/24/2009 15:08' prior: 40347105!exportList	| s fName f |	s _ WriteStream on: (String new: 10000).	cellMorphs do: [:m |		s nextPutAll: m firstSubmorph contents; crlf].	fName _ titleMorph contents.	fName size <= 1 ifTrue: [fName _ 'newList'].	fName _ fName, '.txt'.	fName _ ScratchFileChooserDialog		chooseNewFileDefault: fName		title: 'File Name?'		type: #listExport.	f _ StandardFileStream newScratchFileNamed: fName.	f ifNil: [^ self].	f nextPutAll: s contents.	f close.! !ScratchListMorph removeSelector: #uniqueListFileName!!ScratchListMorph methodsFor: 'import/export' stamp: 'jm 2/24/2009 15:09' prior: 40347735!exportList	| s fName f |	s _ WriteStream on: (String new: 10000).	cellMorphs do: [:m |		s nextPutAll: m firstSubmorph contents; crlf].