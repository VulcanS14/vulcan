,			(self hexFor: anObject green),			(self hexFor: anObject blue),			']'.		^ self].	"reporter"	(anObject isKindOf: Array) ifTrue: [		stream nextPut: $(.		i _ 1.		spec _ Specs at: anObject first ifAbsent: [Array with: anObject first].		spec do: [:token |			((token size > 1) and: [token first = $%])				ifTrue: [					(i _ i + 1) <= anObject size ifTrue: [self printArg: (anObject at: i)]]				ifFalse: [					'?' = token ifTrue: [stream skip: -1].  "remove space before ?"					stream nextPutAll: token].			stream space].		stream skip: -1. "remove final space"		stream nextPut: $).		^ self].	self error: 'unknown argument type'.! !!ScratchPrinter methodsFor: 'private' stamp: 'jm 1/26/2009 14:30' prior: 39537170!printArg: anObject	"Print the given argument on my stream."	| i spec delimiters |	(anObject isKindOf: Number) ifTrue: [		stream nextPutAll: anObject printString.		^ self].	(anObject isKindOf: String) ifTrue: [		stream nextPutAll: '"', anObject, '"'.		^ self].	(anObject isKindOf: Boolean) ifTrue: [		stream nextPutAll: anObject printString.		^ self].	(anObject isKindOf: Color) ifTrue: [		stream nextPutAll: 'c[',			(self hexFor: anObject red),			(self hexFor: anObject green),			(self hexFor: anObject blue),			']'.		^ self].	"reporter"	((anObject isKindOf: Array) and: [anObject size > 0]) ifTrue: [		delimiters _ (BooleanReporters at: anObject first) ifTrue: ['<>'] ifFalse: ['()'].		stream nextPut: delimiters first.		i _ 1.		spec _ Specs at: anObject first ifAbsent: [Array with: anObject first].		spec do: [:token |			((token size > 1) and: [token first = $%])				ifTrue: [					(i _ i + 1) <= anObject size ifTrue: [self printArg: (anObject at: i)]]				ifFalse: [					'?' = token ifTrue: [stream skip: -1].  "remove space before ?"					stream nextPutAll: token].			stream space].		stream skip: -1. "remove final space"		stream nextPut: delimiters second.		^ self].	self error: 'unknown argument type'.! !BooleanRep