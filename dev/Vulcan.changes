hBack: button.		bName = #go ifTrue: [			flagButton _ button.			buttonPanel addMorphBack: (Morph new color: Color transparent; extent: 2@5)]].	self addMorph: buttonPanel.! !self owner owner!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 2/3/2009 13:25' prior: 40365282!createButtonPanel	"Create and add a panel containing the project title, green flag, and stop buttons."	| buttonSpecs bName button |	"create panel"	buttonPanel _ AlignmentMorph new		"color: (Color r: 0.753 g: 0.764 b: 0.776);"		color: Color transparent;		centering: #center;		height: 20.	projectTitleMorph _ StringMorph new		forceUnicodeRendering: true;		contents: '';		font: (ScratchFrameMorph getFont: #FrameMorphProjectTitle).	buttonPanel		addMorphBack: projectTitleMorph;		addMorphBack: (AlignmentMorph newSpacer: Color transparent).	"buttonSpecs defines the toolbar buttons; first is icon name, second is selector"	buttonSpecs _ #(		"name	selector		tool tip"		(go		shoutGo		'Start green flag scripts')		(stop	stopAll		'Stop everything')).	buttonSpecs do: [:spec |		bName _ spec first.		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (bName, 'ButtonGrayPressed') asSymbol)			offForm: (ScratchFrameMorph skinAt: (bName, 'ButtonGray') asSymbol)			overForm: (ScratchFrameMorph skinAt: (bName, 'ButtonGrayPressed') asSymbol).		button			target: self;			actionSelector: (spec at: 2);			isMomentary: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		buttonPanel addMorphBack: button.		bName = #go ifTrue: [			flagButton _ button.			buttonPanel addMorphBack: (Morph new color: Color transparent; extent: 2@5)]].	self addMorph: buttonPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/24/2009 16:23' prior: 40366773!createButtonPanel	"Create and add a panel containing the project title, green flag, and stop buttons."	| buttonSpecs bName button |	"create panel"	buttonPanel _ AlignmentMorph new		"color: (Color r: 0.7