ior: 37473958!stepProcessesTurbo	"Run each Scratch process until it gives up control, then filter out any processes that have terminated. Do this repeatedly until time is up."	| sliceMSecs startMSecs now proc |	sliceMSecs _ 100.	inProcessStep ifTrue: [^ self].	inProcessStep _ true.	startMSecs _ Time millisecondClockValue.	[		[now _ Time millisecondClockValue.		 processes size > 0 and:		  [(now >= startMSecs) and: [(now - startMSecs) < sliceMSecs]]] whileTrue: [			self processesToRun do: [:p | (proc _ p) runStepFor: self].			self removeTerminatedProcesses].	] ifError: [proc errorFlag: true].	inProcessStep _ false.! !----SNAPSHOT----(12 December 2008 2:09:15 pm) priorSource: 5736780!!ScratchProcess methodsFor: 'entry points' stamp: 'jm 12/12/2008 14:45' prior: 39290629!stop	"Permanently terminates this process."	stackFrame ifNotNil: [stackFrame stopMIDI].	readyToYield _ true.	readyToTerminate _ true.	topBlock ifNotNil: [topBlock clearProcess].! !----SNAPSHOT----(12 December 2008 2:59:17 pm) priorSource: 5738483!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 12 December 2008 at 11:13:36 am'!Morph subclass: #ScratchPresenterMorph	instanceVariableNames: 'frame stage buttons flagButton offscreenWorld doubleSize mouseFocus mouseDownPoint dragOffset clickWasHandled mouseMoved quarterModeButton presentationModeButton normalModeButton viewModeButtons '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Panes'!!LibraryItemMorph methodsFor: 'drawing' stamp: 'ee 12/12/2008 11:02' prior: 39148583!updateNameAndInfo	| w y |	self		setProperty: #balloonText		toValue: ((target objName asUTF8, ' (' asUTF8, 'Scripts' localized, ScratchTranslator colonSuffix, ' ' asUTF8, target scripts size printString asUTF8,')' asUTF8) asUTF8).	nameMorph ifNotNil:[		scriptCountMorph ifNotNil: [	(target isKindOf: ScriptableScratchMorph) ifFalse: [		nameMorph contents: '<no object>'.		scriptCountMorph contents: ''.		^ self].	nameMorph contents = target objName ifFalse: [		nameMorph contents: self truncatedLabel.		nameMorph left: self left + ((self width - nameMorph width) // 2)].	w _ 0.	target scripts size > 0		ifTrue: [			w > 0 ifTrue: [w _ w + 2].			scriptCountMorph contents: 'Scripts' localized, ScratchTranslator colonSuffix, ' ', target scripts size printString.			w _ w + scriptCountMorph width + 2]		ifFalse: [			scriptCountMorph contents: ''].	"layout info morph row"	y _ nameMorph bottom.	w > 0 ifTrue: [		scriptCountMorph position: (self left + ((self width - (scriptCountMorph width)) // 2))@y]]].! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 12/12/2008 11:01' prior: 39150597!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu		'Open, save, and share projects')		(Undo			undoTool		'Undo the last delete')		(Language		languageMenu	'Switch languages')		(Extras			extraMenu		'Extra operations')		('Share!!'		shareDisabled	'Share your project on the web')		(Help			launchHelp		'Get help')	).	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '� ' asUTF8, (spec at: 1) localized, ' �' asUTF8].		(#(undoTool share launchHelp) includes: m selector) ifTrue: [m actOnMouseUp: true].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	self addViewModeButtonsTo: menuPanel.	closeButton _ IconicButton new		labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;		actionSelector: #quitScratch;		target: self;		actWhen: #buttonDown.	menuPanel addMorphBack: closeButton.	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'accessing' stamp: 'ee 12/12/2008 11:12' prior: 39152495!updatePanes	| p |	menuPanel delete.	self createMenuPanel.	scriptsPane tabPane delete.	scriptsPane createTabPane.	workPane sensorBoard owner		ifNil: [p _ nil]		ifNotNil: [p _ workPane sensorBoard position].	workPane resetSensorBoard.	p ifNotNil:[		self showSensorBoard		workPane sensorBoard position: p].	libraryPane clearLibrary.	self scratchWatchers do: [:w | w languageChanged].	self listWatchers do: [:w | w fixLayoutForNewLanguage].	World startSteppingSubmorphsOf: self.	self fixLayout.	scriptsPane fixLayout.	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/11/2008 14:11' prior: 39153136!fileMenu	| menu |	menu _ CustomMenu new.	menu add: 'new' action: #newScratchProject.	menu add: 'open' action: #openScratchProject.	menu add: 'save (s)' action: #saveScratchProjectNoDialog.	menu add: 'save as' action: #saveScratchProject.	menu addLine.	menu add: 'export sprite' action: #exportSprite.	menu addLine.	menu add: 'notes' action: #editNotes.	menu localize.	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/12/2008 10:26' prior: 39213651!newScratchProject	"Make a new, blank Scratch project."	| response newProject sprite |	self closeMediaEditorsAndDialogs ifFalse: [^ self].	self stopAll.	(justSaved or: [self projectIsEmpty]) ifFalse: [		"ask the user if they want to save the current project"		response _ DialogBoxMorph askWithCancel: 'Save the current project?'.		response = #cancelled ifTrue: [^ self].		response ifTrue: [self saveScratchProjectNoDialog.			justSaved ifFalse: [^ self]]].	projectDirectory _ ScratchFileChooserDialog getDefaultFolderForType: #project.	projectName _ ''.	projectInfo _ Dictionary new.	newProject _ ScratchStageMorph new.	sprite _ ScratchFrameMorph defaultSprite fullCopy.	sprite position: (241@181) - sprite extent.	newProject addMorph: sprite.	self installNewProject: newProject.	self initializeWatcherPositions.	justSaved _ true.	self enterNormalMode.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/12/2008 10:36' prior: 39156741!enterNormalMode	"Go into normal (full-stage) mode."	(viewMode = #normal) ifTrue: [		self updateViewModeButtons.		^ self].	NormalModeEnabled ifFalse:[		self enterQuarterMode.		^ self].	viewMode _ #normal.	workPane isQuarterSize: false.	workPane isInWorld		ifTrue: [self fixLayout]		ifFalse: [self exitPresentationMode].	self updatePanes.	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/12/2008 10:42' prior: 39273061!enterPresentationMode	"Go into presentation mode."	| presenter |	ScratchPlugin pluginAvailable ifFalse: [		self updateViewModeButtons.		^ self beep].	(viewMode = #presentation) ifTrue: [^ self].	viewMode _ #presentation.	self closeDialogBoxes.	presenter _ ScratchPresenterMorph new frame: self.	self delete.	Display fillBlack.	Smalltalk fullScreenMode: true.	World restoreDisplay.	Display fillBlack.	World assuredCanvas.  "re-allocate canvas after entering full-screen mode"	((Display width >= 965) & (Display height >= 750))		ifTrue: [presenter beDoubleSize].	presenter extent: Display extent.	World addMorphFront: presenter.	World startSteppingSubmorphsOf: presenter.	World activeHand newKeyboardFocus: nil.	self updatePenPositions.	self updateViewModeButtons.	World assuredCanvas.  "re-allocate canvas after entering full-screen mode"	World fullRepaintNeeded.	World displayWorldSafely.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/12/2008 10:36' prior: 39158050!enterQuarterMode	"Go into quarter stage mode."	(viewMode = #quarter) ifTrue