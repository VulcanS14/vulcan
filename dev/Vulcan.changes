"Export my image to a file with the given name. Save sprite costumes as GIF's, dropping color resolution if necessary."	| myForm f fName |	myForm _ self compositeForm.	"save as GIF if image has under 256 colors"	myForm couldBeColorReduced ifTrue: [		f _ myForm colorReduced8Bit.		(fileName asLowercase endsWith: '.gif')			ifTrue: [fName _ fileName]			ifFalse: [fName _ fileName, '.gif'].		GIFReadWriter putForm: f onFileNamed: fName.		^ self].	"otherwise, save as BMP to retain color resolution"	(fileName asLowercase endsWith: '.bmp')		ifTrue: [fName _ fileName]		ifFalse: [fName _ fileName, '.bmp'].	(stageOrSprite isKindOf: ScratchSpriteMorph)		ifTrue: [			f _ Form extent: myForm extent depth: 32.			f fillColor: Color white.  "BMP cannot handle transparency; use white as BG color"			myForm displayOn: f at: form offset negated rule: Form paint]		ifFalse: [			f _ myForm asFormOfDepth: 32].	f writeBMPFileNamed: fileName.! !form couldBeColorReduced!form colorsUsed!form colorsUsed size!form colorReduced8Bit!form colorReduced8Bit display!!ImageMedia methodsFor: 'other' stamp: 'jm 5/19/2009 13:20' prior: 41844059!exportFilename: fileName for: stageOrSprite	"Export my image to a file with the given name. Save sprite costumes as GIF's, dropping color resolution if necessary."	| myForm f fName |	myForm _ self compositeForm.	"save as GIF if image has under 256 colors"	((myForm depth <= 8) or: [myForm couldBeColorReduced]) ifTrue: [		f _ myForm colorReduced8Bit.		(fileName asLowercase endsWith: '.gif')			ifTrue: [fName _ fileName]			ifFalse: [fName _ fileName, '.gif'].		GIFReadWriter putForm: f onFileNamed: fName.		^ self].	"otherwise, save as BMP to retain color resolution"	(fileName asLowercase endsWith: '.bmp')		ifTrue: [fName _ fileName]		ifFalse: [fName _ fileName, '.bmp'].	(stageOrSprite isKindOf: ScratchSpriteMorph)		ifTrue: [			f _ Form extent: myForm extent depth: 32.			f fillColor: Color white.  "BMP cannot handle transparency; use white as BG color"			myForm displayOn: f at: form offset negated rule: Form paint]		ifFalse: [			f _ myForm asFormOfDepth: 32].	f writeBMPFileNamed: fileName.! !----QUIT----(19 May 2009 1:22:23 pm) priorSource: 8289485!----STARTUP----(19 May 2009 1:22:27 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(19 May 2009 1:22:32 pm) priorSource: 8291861!----STARTUP----(19 May 2009 1:23:36 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SNAPSHOT----(19 May 2009 1:47:40 pm) priorSource: 8292016!!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'jm 5/19/2009 13:48' prior: 41682525!buildSpriteLabel	^ StringMorph new		font: (ScratchFrameMorph getFont: #Tab);		color: Color white;		contents: 'New sprite:' localized! !!PaintCanvas methodsFor: 'private' stamp: 'jm 5/19/2009 13:54' prior: 41765802!importCostumeFromSprite: fName	"Return the current costume from the give sprite file."	| data  f importedStage |	(FileDirectory default fileExists: fName) ifFalse: [^ nil].	f _ (FileStream readOnlyFileNamed: fName) binary.	f ifNil: [^ nil].	data _ f contentsOfEntireFile.	[importedStage _ self extractProjectFrom: data] ifError: [^ nil].	importedStage submorphs do: [:m |		(m isKindOf: ScratchSpriteMorph) ifTrue: [			^ m costumeForm]].	^ nil! !----SNAPSHOT----(19 May 2009 2:04:40 pm) priorSource: 8292171!----QUIT----(19 May 2009 2:04:46 pm) priorSource: 8293014!----STARTUP----(19 May 2009 2:04:54 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(19 May 2009 2:05:08 pm) priorSource: 8293078!----STARTUP----(19 May 2009 2:05:15 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SAVEAS Scratch19May09----(19 May 2009 2:05:36 pm)!----STARTUP----(19 May 2009 6:40:39 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFrameMorph class methodsFor: 'instance creation' stamp: 'jm 5/19/2009 22:04' prior: 37097945!new	"Answer a new instance of