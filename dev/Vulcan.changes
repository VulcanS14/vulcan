/24/2009 19:41'!handleQutEvent	"Handle a window close or quit event."! !!ScratchFrameMorph methodsFor: 'stepping' stamp: 'jm 12/30/2008 19:05' prior: 40213553!step	"Run each process until it gives up control, then filter out any processes that have terminated."	| screenExtent oldJustSaved |	fillScreenFlag ifTrue: [		screenExtent _ Display extent.		((self position = (0@0)) and: [self extent = screenExtent]) ifFalse: [			oldJustSaved _ justSaved.			self position: 0@0.			self extent: screenExtent.			scriptsPane currentCategory: scriptsPane currentCategory.			justSaved _ oldJustSaved.			^ self]].	workPane ifNotNil: [		ScriptableScratchMorph scratchOrigin: workPane center.		viewerPane target isNil 			ifTrue: [workPane viewBlocksAndScripts]			ifFalse: [viewerPane target isInWorld ifFalse: [workPane viewBlocksAndScripts]]].	Sensor processOSMenuEvents.	paintingInProgress ifTrue: [^ self].	workPane scratchServer ifNotNil: [workPane scratchServer stepServer].	self processWhenConditions.	self processKeyboardEvents.	workPane stepProcesses.	workPane scratchServer ifNotNil: [workPane scratchServer stepServer].	self processDroppedFiles.	workPane processesToRun size > 0		ifTrue: [flagButton on]		ifFalse: [flagButton off].! !!ScratchPresenterMorph methodsFor: 'stepping' stamp: 'jens 9/19/2008 22:43' prior: 40214766!step	"Run each process until it gives up control, then filter out any processes that have terminated."	| screenExtent |	screenExtent _ DisplayScreen actualScreenSize.	((self position = (0@0)) and: [self extent = screenExtent]) ifFalse: [		self position: 0@0.		^ self extent: screenExtent].	ScriptableScratchMorph scratchOrigin: stage center.	stage scratchServer ifNotNil: [stage scratchServer stepServer].	self processWhenConditions.	self processKeyboardEvents.	stage stepProcesses.	stage step.	stage submorphsDo: [:m | m allMorphsDo: [:subM | subM step]].	offscreenWorld incrRedrawDouble: doubleSize.	stage processesToRun size > 0		ifTrue: [flagButton on]		ifFalse: [flagButton off].! !!HandMorph methodsFor: 'event handling' stamp: 'jm 2/24/2009 19:47' prior: 40418501!handleQutEvent	"Dispatch a closeWindow event. First drop any carried morphs, to allow responding to a pop-up dialogs."	"if carrying morphs, just drop them"	"self hasSubmorphs ifTrue: [^ self dropMorphsEvent: evt]."	Preferences noviceMode ifFalse: [self quitSession].	World allMorphsDo: [:m |		(m isKindOf: ScratchFrameMorph) ifTrue: [			m quitFromMenu]].! !ScratchFrameMorph removeSelector: #checkForQuit!ScratchPresenterMorph removeSelector: #checkForQuit!InputSensor removeSelector: #windowCloseReceived!!HandMorph methodsFor: 'event handling' stamp: 'jm 2/24/2009 19:48' prior: 40420639!handleQutEvent	"Dispatch a closeWindow event. First drop any carried morphs, to allow responding to a pop-up dialogs."	"if carrying morphs, just drop them"	"self hasSubmorphs ifTrue: [^ self dropMorphsEvent: evt]."	Preferences noviceMode ifFalse: [^ self quitSession].	World allMorphsDo: [:m |		(m isKindOf: ScratchFrameMorph) ifTrue: [			m quitFromMenu]].! !World activeHand attachMorph: Morph new!!HandMorph methodsFor: 'event handling' stamp: 'jm 2/24/2009 19:51' prior: 40421249!handleQutEvent	"Dispatch a closeWindow event. First drop any carried morphs, to allow responding to a pop-up dialogs."	self hasSubmorphs ifTrue: [		self dropMorphsEvent: (MorphicEvent new setCursorPoint: Sensor cursorPoint)].	Cursor normal show.	Preferences noviceMode ifFalse: [^ self quitSession].	World allMorphsDo: [:m |		(m isKindOf: ScratchFrameMorph) ifTrue: [			m quitFromMenu]].! !!HandMorph methodsFor: 'event handling' stamp: 'jm 2/24/2009 19:53' prior: 40421748!handleQutEvent	"Dispatch a closeWindow event. First drop any carried morphs and reset the cursor, to allow responding to a pop-up dialogs."	self hasSubmorphs ifTrue: [		self dropMorphsEvent: (MorphicEvent new setCursorPoint: Sensor cursorPoint)].	self showTemporaryCursor: nil.	Preferences noviceMode ifFalse: [^ self quitSession].	World allMorphsDo: [:m |		(m isKindOf: ScratchFrameMorph) ifTrue: [			m quitFromMenu]].! !----SNAPSHOT----(24 February 2009 7:53:26 pm) priorSource: 6863173!World activeHand attachMorph: Morph new!!HandMorph methodsFor: 'event handling' stamp: 'jm 2/24/2009 19:53' prior: 40422237!handleQutEvent	"Dispatch a closeWindow event. First drop any carried morphs and reset the cursor, to allow responding to a pop-up dialogs."	self hasSubmorphs ifTrue: [		self dropMorphsEvent: (MorphicEvent new setCursorPoint: 30@30)].	self showTemporaryCursor: nil.	Preferences noviceMode ifFalse: [^ self quitSession].	World allMorphsDo: [:m |		(m isKindOf: ScratchFrameMorph) ifTrue: [			m quitFromMenu]].! !World activeHand attachMorph: Morph new!!HandMorph methodsFor: 'event handling' stamp: 'jm 2/24/2009 19:54' prior: 40422869!handleQutEvent	"Dispatch a closeWindow event. First drop any carried morphs and reset the cursor, to allow responding to a pop-up dialogs.""	self hasSubmorphs ifTrue: [		self dropMorphsEvent: (MorphicEvent new setCursorPoint: 30@30)]."	self showTemporaryCursor: nil.	Preferences noviceMode ifFalse: [^ self quitSession].	World allMorphsDo: [:m |		(m isKindOf: ScratchFrameMorph) ifTrue: [			m quitFromMenu]].! !World activeHand attachMorph: Morph new!!HandMorph methodsFor: 'event handling' stamp: 'jm 2/24/2009 19:55' prior: 40423419!handleQutEvent	"Dispatch a closeWindow event."	self showTemporaryCursor: nil.	Preferences noviceMode ifFalse: [^ self quitSession].	World allMorphsDo: [:m |		(m isKindOf: ScratchFrameMorph) ifTrue: [			^ m quitFromMenu]].	self quitSession.! !----SNAPSHOT----(24 February 2009 7:56:01 pm) priorSource: 6868240!----QUIT----(24 February 2009 7:56:06 pm) priorSource: 6869792!----STARTUP----(24 February 2009 7:56:28 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(24 February