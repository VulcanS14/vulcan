hasSubmorphs ifTrue: [^ self dropMorphsEvent: evt].	clickState ~~ #idle ifTrue: [^ self checkForDoubleClick: evt].	(keyboardFocus notNil and: [Preferences noviceMode]) ifTrue: [		"clear keyboard focus if click is outside the focus morph (needed for Scratch)"		p _ (keyboardFocus transformFromWorld) transform: evt cursorPoint.		(keyboardFocus bounds containsPoint: p) ifFalse: [			self newKeyboardFocus: nil]].	m _ self recipientForMouseDown:		(grid  "Don't grid when determining recipient"			ifNil: [evt]			ifNotNil: [  "Should really use original cursorPoint, but this will do"				evt copy setCursorPoint: Sensor cursorPoint]).	m ifNotNil: [		(m isKindOf: SpriteHandleMorph) ifFalse: [SpriteHandleMorph vanish]. "needed for Scratch"		aHalo _ self world haloMorphOrNil.		(aHalo isNil or: [aHalo staysUpWhenMouseIsDownIn: m])			ifFalse: [self world abandonAllHalos].		m deleteBalloon.		(m handlesMouseDown: evt)			ifTrue:				["start a mouse transaction on m"				(self newMouseFocus: m) ifNil: [^ self].				localEvt _ self transformEvent: evt.				targetOffset _ localEvt cursorPoint - m position.				m mouseDown: localEvt.				clickState == #firstClickDown ifFalse: [					"ensure that at least one mouseMove: is reported for each mouse transaction:"					(mouseDownMorph == m) ifTrue: [						m mouseMove: (localEvt copy setType: #mouseMove)].					(m handlesMouseOverDragging: localEvt) ifTrue:						["If m also handles dragOver, enter it in the list"						dragOverMorphs add: m.						mouseOverMorphs remove: m ifAbsent: []]]]			ifFalse:				["grab m by the appropriate root"				menuTargetOffset _ targetOffset _ evt cursorPoint.				rootForGrab _ m rootForGrabOf: m.				rootForGrab ifNotNil: [self grabMorph: rootForGrab]].		mouseOverTimes removeKey: m ifAbsent: []].! !!ScratchSpriteMorph methodsFor: 'right button menu' stamp: 'jens 11/28/2008 15:25' prior: 37438212!rightButtonMenu	"Present the right button menu."	| menu |	menu _ CustomMenu new.	menu add: 'grab screen region for new costume' action: #grabFromScreen.	menu add: 'export this sprite' action: #exportObject.	menu addLine.	menu add: 'duplicate' action: #duplicate.	menu add: 'delete' action: #undoableDeleteSprite.	menu addLine.	menu add: 'resize this sprite' action: #resizeHandle.	menu add: 'rotate this sprite' action: #rotateHandle.	menu localize; invokeOn: self.! !!ScratchSpriteMorph methodsFor: 'handle ops' stamp: 'jens 10/27/2008 10:58'!resizeHandle	SpriteHandleMorph resize: self! !!ScratchSpriteMorph methodsFor: 'handle ops' stamp: 'jens 10/27/2008 12:53'!rotateHandle	SpriteHandleMorph rotate: self! !!SpriteHandleMorph methodsFor: 'initialization' stamp: 'jens 11/27/2008 18:46'!initialize	super initialize.	reversed _ false.	self		color: Color transparent;		addMorph: ImageMorph new.! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 13:38'!handlesMouseDown: evt	"Return true if this morph wants to receive mouseDown events" 	^true! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 14:02'!handlesMouseOver: evt	^ true! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 12/4/2008 15:23'!mouseDown: evt	#resize = type		ifTrue: [			offset _ evt hand cursorPoint x - self left.			^self ].		offset _ self targetBounds center dist: self center.! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 14:05'!mouseEnter: evt	(#resize = type)		ifTrue: [self form: (ScratchFrameMorph skinAt: #rotStyleFlipOver)]		ifFalse: [self form: (ScratchFrameMorph skinAt: #rotStyleSmoothOver)].! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 14:06'!mouseLeave: evt	(#resize = type)		ifTrue: [self form: (ScratchFrameMorph skinAt: #rotStyleFlip)]		ifFalse: [self form: (ScratchFrameMorph skinAt: #rotStyleSmooth)].! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 12/4/2008 16:06'!mouseMove: evt	| dist tc |	offset ifNil: [^self].	#resize = type 		ifTrue: [			dist _ evt hand cursorPoint x - offset - self left.			reversed				ifTrue: [((dist negative & self atMax) | 					(dist negative not & self atMin)) ifTrue: [^self ]]				ifFalse: [((dist negative & self atMin) | 					(dist negative not & self atMax)) ifTrue: [^self ]].			^self 				left: self left + dist;				resizeTarget ].	tc _ self targetBounds center.	self 		center: (tc + (Point r: offset degrees: (evt cursorPoint - tc)			 theta radiansToDegrees rounded));		rotateTarget! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 10:17'!mouseUp: evt	offset _ nil! !!SpriteHandleMorph methodsFor: 'accessing' stamp: 'jens 12/4/2008 15:59'!target: aSprite	"show me"	| stage  tb x |	target _ aSprite.	stage _ target ownerThatIsA: ScratchStageMorph.	tb _ self targetBounds.	"make sure the target sprite is onstage"	stage notNil & stage fullContainsPoint: target center.	(stage notNil and: [stage bounds containsPoint: target center]) ifFalse: [		target referencePosition: 0@0].	self	openInWorld.	#resize = type 		ifTrue: [ 			target xpos > 0				ifTrue: [					reversed _ true.					x _ tb left ]				ifFalse: [ x _ tb right ].			^self center: x @ tb center y].	(target xpos > 0 & (target heading > 0))		ifTrue: [			reversed _ true.			self position: (tb center + (Point r: (tb width/2) degrees: target rotationDegrees + 180))]		ifFalse: [ self center: (tb center + (Point r: (tb width/2) degrees: target rotationDegrees)) ]! !!SpriteHandleMorph methodsFor: 'private' stamp: 'jens 10/27/2008 08:18'!form: aForm	(self submorphs at: 1) form: aForm.	self extent: (self submorphs at: 1) extent.! !!SpriteHandleMorph methodsFor: 'private' stamp: 'jens 12/4/2008 14:11'!targetBounds	"private - answer the target's bounds as it displayed on screen, i.e. in q-size mode"	| stage ratio home center |	ratio _ 1.	stage _ target ownerThatIsA: ScratchStageMorph.	stage notNil & stage isQuarterSize ifTrue: [ratio _ 0.5 ].	home_ 0 @ 0.	stage ifNotNil: [home _ stage position ].	center _ target center - home * ratio + home.	^Rectangle center: center extent: target extent * ratio! !!SpriteHandleMorph methodsFor: 'private' stamp: 'jens 10/27/2008 12:51'!type: aSymbol	"#resize / #rotate"	type _ aSymbol.! !!SpriteHandleMorph methodsFor: 'sprite handling' stamp: 'jens 12/4/2008 15:29'!resizeTarget	| factor  tb|	tb _ self targetBounds.	reversed		ifTrue: [ factor _ (self center x - tb center x) / (tb left - tb center x) ]		ifFalse: [ factor _ (self center x - tb center x) / (tb right - tb center x) ].	target multiplySizeBy: factor! !!SpriteHandleMorph methodsFor: 'sprite handling' stamp: 'jens 12/4/2008 14:13'!rotateTarget	reversed		ifTrue: [target rotationDegrees: (self center - self targetBounds center) 			theta radiansToDegrees rounded + 180 ]		ifFalse: [target rotationDegrees: (self center - self targetBounds center) 			theta radiansToDegrees rounded ]! !!SpriteHandleMorph methodsFor: 'testing' stamp: 'jens 12/4/2008 15:50'!atMax	"answer true if the target sprite cannot be made any bigger"	| maxExtent |	maxExtent _ ScratchFrameMorph workpaneExtent asFloatPoint * 1.5.	^(target extent x >= maxExtent x) or:		[target extent y >= maxExtent y]! !!SpriteHandleMorph methodsFor: 'testing' stamp: 'jens 12/4/2008 15:47'!atMin	"answer true if the target sprite cannot be made any smaller"	| minExtent|	minExtent _ target costumeForm extent min: 10@10.	^(target extent x <= minExtent x) or: [target extent y <= minExtent y].! !!SpriteHandleMorph class methodsFor: 'accessing' stamp: 'jens 10/27/2008 11:30'!vanish	"delete my single instance"	Current ifNotNil: [		Current delete.		Current _ nil ]! !!SpriteHandleMorph class methodsFor: 'instance creation' stamp: 'jens 10/27/2008 12:58'!resize: aSprite	"create my single instance and set it to resize aSprite"		self vanish.	Current _ self new 		type: #resize;		form: (ScratchFrameMorph skinAt: #rotStyleFlip); 		target: aSprite;		setBalloonText: 'slide to resize' localized, ' ', aSprite objName.	^Current! !!SpriteHandleMorph class methodsFor: 'instance creation' stamp: 'jens 10/27/2008 12:57'!rotate: aSprite	"create my single instance and set it to rotate aSprite"		self vanish.	Current _ self new 		type: #rotate;		form: (ScratchFrameMorph skinAt: #rotStyleSmooth); 		target: aSprite;		setBalloonText: 'drag to rotate' localized, ' ', aSprite objName.	^Current! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 12/8/2008 12:03' prior: 37021912!addSpriteMorph	| result f m el |	self world activeHand toolType: nil.	self paintingInProgress ifTrue: [^ self beep].	result _ ScratchFileChooserDialog chooseSpriteCostumeFor: self.	result = #cancelled ifTrue: [^ self].	(result asLowercase endsWith: '.sprite')		ifTrue: [^ self importSpriteOrProject: result].	[f _ Form fromFileNamed: result] ifError: [^ self].	el _ ImageMedia new form: (ScratchFrameMorph scaledFormForPaintEditor: f).	m _ ScratchSpriteMorph new soleCostume: el.	el mediaName: (m unusedMediaNameFromBaseName: (FileDirectory localNameFor: result)).	self addAndView: m.! !ClassmateDemo!ScratchFrameMorph class removeSelector: #classmateDemo:!!ScratchFrameMorph class methodsFor: 'utilities' stamp: 'jm 12/8/2008 12:04' prior: 37105312!defaultSprite"Return the default sprite if one was set, or the cat otherwise"	DefaultSprite		ifNotNil: [^ DefaultSprite]		ifNil: [^ ScratchSpriteMorph new			addMediaItem: (ImageMedia new				mediaName: ('costume' localized, '1');				form: (ScratchFrameMorph skinAt: #defaultSpriteCostume));			addMediaItem: (ImageMedia new				mediaName: ('costume' localized, '2');				form: (ScratchFrameMorph skinAt: #defaultSpriteCostume2));			addMediaItem: (SoundMedia new				mediaName: 'meow' localized;				sound: ScratchSpriteMorph meowSound);			lookLike: ('costume' localized, '1')].! !!ScratchFrameMorph class methodsFor: 'class initialization' stamp: 'jm 12/8/2008 12:04' prior: 39159467!initialize	"self initialize"	Clipboard _ nil.	MinWidth _ 680.	MinHeight _ 370.	WorkpaneExtent _ 480@360.	UseErrorCatcher _ true.	QuarterModeEnabled _ true.	NormalModeEnabled _ true.	self initFonts.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 12/8/2008 12:04' prior: 39153587!newScratchProject	"Make a new, blank Scratch project."	| response newProject sprite |	self closeMediaEditorsAndDialogs ifFalse: [^ self].	self stopAll.	(justSaved or: [self projectIsEmpty]) ifFalse: [		"ask the user if they want to save the current project"		response _ DialogBoxMorph askWithCancel: 'Save the current project?'.		response = #cancelled ifTrue: [^ self].		response ifTrue: [self saveScratchProjectNoDialog.			justSaved ifFalse: [^ self]]].	projectDirectory _ ScratchFileChooserDialog getDefaultFolderForType: #project.	projectName _ ''.	projectInfo _ Dictionary new.	newProject _ ScratchStageMorph new.	sprite _ ScratchFrameMorph defaultSprite fullCopy.	sprite position: (241@181) - sprite extent.	newProject addMorph: sprite.	self installNewProject: newProject.	self initializeWatcherPositions.	justSaved _ true.	"self enterNormalMode."! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 12/8/2008 12:05' prior: 37026430!paintSpriteMorph	| m |	m _ ScratchSpriteMorph new soleCostume: ImageMedia new.	self addAndView: m.	m editDrawingOldCostumeName: m costume mediaName deleteOnCancel: true.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 12/8/2008 12:05' prior: 37030689!surpriseSpriteMorph	| fileName f el m e |	self world activeHand toolType: nil.	self paintingInProgress ifTrue: [^ self beep].	fileName _ self nextSurpriseCostumeName.	fileName ifNil: [		^ self addAndView: ScratchFrameMorph defaultSprite fullCopy].	[f _ Form fromFileNamed: fileName] ifError: [^ self].	el _ ImageMedia new form: (ScratchFrameMorph scaledFormForPaintEditor: f).	m _ ScratchSpriteMorph new soleCostume: el.	el mediaName: (m unusedMediaNameFromBaseName: (FileDirectory localNameFor: fileName)).	self addAndView: m.	e _ (workPane extent - m extent) abs // 2.	m referencePosition: ((e x negated) to: e x) atRandom @ ((e y negated) to: e y) atRandom.! !Rectangle fromUser extent!(360 * 2) + 35!(480@360) * 2!!ScratchFrameMorph methodsFor: 'view mode' stamp: 'jm 12/8/2008 12:09' prior: 39157143!enterPresentationMode	"Go into presentation mode."	| presenter |	ScratchPlugin pluginAvailable ifFalse: [^ self beep].	viewMode _ #presentation.	self closeDialogBoxes.	presenter _ ScratchPresenterMorph new frame: self.	self delete.	Display fillBlack.	Smalltalk fullScreenMode: true.	DisplayScreen startUp.	Display fillBlack.	((Display width >= 965) & (Display height >= 750))		ifTrue: [presenter beDoubleSize].	presenter extent: Display extent.	World addMorphFront: presenter.	World startSteppingSubmorphsOf: presenter.	World activeHand newKeyboardFocus: nil.	self updatePenPositions.	self updateViewModeButtons.	World fullRepaintNeeded.	World displayWorldSafely.	World fullRepaintNeeded.	presenter buttons do: [:b | b changed].  "force buttons to redisplay"! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'jm 12/8/2008 12:12' prior: 39215740!enterPresentationMode	"Go into presentation mode."	| presenter |	ScratchPlugin pluginAvailable ifFalse: [^ self beep].	viewMode _ #presentation.	self closeDialogBoxes.	presenter _ ScratchPresenterMorph new frame: self.	self delete.	Display fillBlack.	Smalltalk fullScreenMode: true.	DisplayScreen startUp.	Display fillBlack.	((Display width >= 965) & (Display height >= 750))		ifTrue: [presenter beDoubleSize].	presenter extent: Display extent.	World addMorphFront: presenter.	World startSteppingSubmorphsOf: presenter.	World activeHand newKeyboardFocus: nil.	self updatePenPositions.	self updateViewModeButtons.