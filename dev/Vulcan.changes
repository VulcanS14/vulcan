 ) @ (self top + 8) .			(anchor isKindOf: HatBlockMorph)				ifTrue: [connector					from: (anchor right - 1) @(anchor top + 20)					to: (self left ) @ (self top + 6)]].! !s _ (FileStream oldFileNamed: 'fixFromJens.cs') contentsOfEntireFile.!s asByteArray select: [:c | c > 127]!ScriptableScratchMorph removeSelector: #asPathRelativeToProject:!s _ (FileStream oldFileNamed: 'fixFromJens.cs') contentsOfEntireFile.!s asByteArray select: [:c | c > 127]!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 6 March 2009 at 12:34:36 am'!!ScriptableScratchMorph methodsFor: 'blocks' stamp: 'jens 3/6/2009 00:31' prior: 40714573!blockFromTuple: tuple receiver: scriptOwner	"Answer a new block for the given tuple."	| k spec blockColor block argCount arg argBlock |	k _ tuple first.	(#(readVariable changeVariable) includes: k) ifTrue: [		^ self variableBlockFromTuple: tuple receiver: scriptOwner].	#contentsOfList: = k ifTrue: [		^ ListContentsBlockMorph new			color: ScriptableScratchMorph listBlockColor;			receiver: scriptOwner;			commandSpec: tuple second;			selector: #contentsOfList:].	(#(EventHatMorph KeyEventHatMorph MouseClickEventHatMorph WhenHatBlockMorph) includes: k) ifTrue: [		block _ self hatBlockFromTuple: tuple receiver: scriptOwner.		(block isKindOf: WhenHatBlockMorph) ifTrue: [block color: Color red].		^ block].	#scratchComment = k ifTrue: [		block _ ScratchCommentMorph new.		tuple size > 1 ifTrue: [block commentMorph contents: (tuple at: 2)].		tuple size > 2 ifTrue: [(tuple at: 3) ifFalse: [block toggleShowing]].		tuple size > 3 ifTrue: [block width: (tuple at: 4)].		tuple size > 4 ifTrue: [block anchor: (self blockWithID: (tuple at: 5))].		^ block].	#comment: = k ifTrue: [		block _ CommentBlockMorph new.		tuple size > 1 ifTrue: [block comment: (tuple at: 2)].		tuple size > 2 ifTrue: [(tuple at: 3) ifFalse: [block toggleShowing]].		block color: (Color r: 0.8 g: 0 b: 0).  "obsolete"		^ block].	spec _ BlockSpecDict at: k ifAbsent: [nil].	spec ifNil: [		^ scriptOwner			blockFromSpec: #('obsolete!!' - yourself)			color: Color red].	blockColor _ BlockColorDict at: k ifAbsent: [Color red].	block _ scriptOwner blockFromSpec: spec color: blockColor.	(block isKindOf: CommandBlockMorph) ifTrue: [		argCount _ block argumentCount min: tuple size - 1.		1 to: argCount do: [:i |			((#(+ - / * =) includes: block selector) and: [ScratchTranslator isRTLMath]) "RTLMath operators are RTL"				ifTrue: [arg _ tuple at: ((argCount + 1) - (i - 1))]				ifFalse: [arg _ tuple at: i + 1].			(arg isKindOf: Array)				ifTrue: [  "argument is a block"					((arg size = 1) and: [arg first isKindOf: Array]) ifTrue: [arg _ arg first].					argBlock _ self blockFromTuple: arg receiver: scriptOwner.					block replaceArgMorph: (block argumentAt: i) by: argBlock]				ifFalse: [  "argument is a value"					(block argumentAt: i) defaultValue: arg]].		(block isKindOf: CBlockMorph) ifTrue: [			(tuple last isKindOf: Array) ifTrue: [				block firstBlockList: (self stackFromTupleList: tuple last receiver: scriptOwner)]].		(block isKindOf: IfElseBlockMorph) ifTrue: [			arg _ tuple at: tuple size - 1.			(arg isKindOf: Array) ifTrue: [				block trueBlock: (self stackFromTupleList: arg receiver: scriptOwner)].			arg _ tuple at: tuple size.			(arg isKindOf: Array) ifTrue: [				block falseBlock: (self stackFromTupleList: arg receiver: scriptOwner)]].		(block isKindOf: ReporterBlockMorph) ifTrue: [			((spec at: 2) includes: $b) ifTrue: [block isBoolean: true]]].	^ block! !!ScriptableScratchMorph methodsFor: 'blocks' stamp: 'jens 3/6/2009 00:31'!hatBlockFromTuple: tuple receiver: scriptOwner	"Answer a new block for the given variable reference tuple."	| blockClass block eventName arg |	blockClass _ Smalltalk at: tuple first.	block _ blockClass new scriptOwner: scriptOwner.	blockClass = EventHatMorph ifTrue: [		eventName _ tuple at: 2.		eventName = 'Scratch-StartClicked'			ifTrue: [block forStartEvent; scriptOwner: scriptOwner]			ifFalse: [block eventName: eventName]].	blockClass = KeyEventHatMorph ifTrue: [		block choice: (tuple at: 2)].	blockClass = WhenHatBlockMorph ifTrue: [		(tuple at: 2) ~= false ifTrue: [			arg _ self blockFromTuple: (tuple at: 2) receiver: scriptOwner.			block replaceArgMorph: block argMorph by: arg]].	^ block! !!ScriptableScratchMorph methodsFor: 'blocks' stamp: 'jens 3/6/2009 00:29'!variableBlockFromTuple: tuple receiver: scriptOwner	"Answer a new block for the given variable reference tuple."	| varName rcvr bg selector block arg argBlock |	varName _ tuple at: 2.	rcvr _ scriptOwner.	(scriptOwner varNames includes: varName) ifFalse: [		bg _ scriptOwner ownerThatIsA: ScratchStageMorph.		bg			ifNil: [scriptOwner addVariable: varName]			ifNotNil: [				bg addVariable: varName.				rcvr _ bg]].	tuple first = #readVariable ifTrue: [		^ VariableBlockMorph new			commandSpec: varName;			receiver: rcvr].	tuple first = #changeVariable ifTrue: [		selector _ tuple at: 3.		"update selector if necessary (backward compatibility):"		(selector = #set:to:) ifTrue: [selector _ #setVar:to:].		block _ SetterBlockMorph new receiver: rcvr.		selector = #setVar:to:			ifTrue: [block initSetterForVar: varName]			ifFalse: [block initChangerForVar: varName].		arg _ tuple at: 4.		(arg isKindOf: Array)			ifTrue: [  "argument is a block"				((arg size = 1) and: [arg first isKindOf: Array]) ifTrue: [arg _ arg first].				argBlock _ self blockFromTuple: arg receiver: scriptOwner.				block replaceArgMorph: block expressionArg by: argBlock]			ifFalse: [ "argument is a value"				block expressionArg defaultValue: arg].		^ block].	self error: 'unknown variable spec'! !ScriptableScratchMorph class removeSelector: #hatBlockFromTuple:receiver:!ScriptableScratchMorph class removeSelector: #hatBlockFromTuple:receiver:!ScriptableScratchMorph class removeSelector: #variableBlockFromTuple:receiver:!ScriptableScratchMorph class removeSelector: #variableBlockFromTuple:receiver:!!ScratchCommentMorph methodsFor: 'private' stamp: 'jens 3/6/2009 00:36' prior: 40706524!align	"position the receiver near the block it is sticked to"	| rect |	ScratchTranslator isRTL ifTrue: [^ self alignLeft].	connector ifNotNil: [connector hideDotMorph].	self position: (anchor right + self distanceToAnchor) @ (anchor top + 1).	(anchor isKindOf: HatBlockMorph)		ifTrue: [self position: (anchor right + self distanceToAnchor) @ (anchor top + 14)].	isShowing ifFalse: [^ self].	(anchor topBlock allMorphs select: [:sm | sm isKindOf: BlockMorph])	,self stickedToMyStack do: [:m|		rect _ m bounds.		(m isKindOf: ReporterBlockMorph) ifFalse: [			rect _ rect withHeight: (rect height - 4)].		(rect intersects: self bounds) ifTrue: [			connector ifNotNil: [connector showDotMorph].			self position: (m right + self distanceToAnchor) @ self top]].! !!ScratchCommentMorph methodsFor: 'private' stamp: 'jens 3/6/2009 00:36' prior: 40707344!alignLeft	"position the receiver near the block it is sticked to"	| rect |	connector ifNotNil: [connector hideDotMorph].	self position: (anchor left - self width - self distanceToAnchor) @ (anchor top + 1).	(anchor isKindOf: HatBlockMorph)		ifTrue: [self position: (anchor left - self width - self distanceToAnchor) @ (anchor top + 14)].	isShowing ifFalse: [^ self].	(anchor topBlock allMorphs select: [:sm | sm isKindOf: BlockMorph])	,self stickedToMyStack do: [:m|		rect _ m bounds.		(m isKindOf: ReporterBlockMorph) ifFalse: [			rect _ rect withHeight: (rect height - 4)].		(rect intersects: self bounds) ifTrue: [			connector ifNotNil: [connector showDotMorph].			self position: (m left - self width - self distanceToAnchor) @ self top]].! !----SNAPSHOT----(6 March 2009 11:41:14 am) priorSource: 7168452!----QUIT----(6 March 2009 11:49:48 am) priorSource: 7177850!----STARTUP----(6 March 2009 11:50:24 am) as /Users/jmaloney/Desktop/Extra Stuff/MIT Squeak/MITBase.image!----SNAPSHOT----(6 March 2009 11:51:31 am) priorSource: 7177916!----SNAPSHOT----(6 March 2009 11:51:37 am) priorSource: 7178087!----SAVEAS Scratch06Mar09----(6 March 2009 11:51:47 am)!----STARTUP----(11 March 2009 8:33:24 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 3/11/2009 08:34' prior: 39875936!createLogo	"Create and the Scratch logo."	logoMorph _ SketchMorph withForm: (ScratchFrameMorph skinAt: #scratchLogoBeta).	logoMorph position: topPane position + (12@8).	topPane addMorph: logoMorph.! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 3/8/2009 07:34' prior: 40358315!getDefaultFolderForType: type	| f |	(type = #costume) ifTrue: [f _ DefaultCostumeFolder].	(type = #background) ifTrue: [f _ DefaultBackgroundFolder].	(type = #project) ifTrue: [f _ self userScratchProjectsDir].	(type = #sprite) ifTrue: [f _ DefaultSpriteFolder].	(type = #stage) ifTrue: [f _ DefaultStageFolder].	(type = #sound) ifTrue: [f _ DefaultSoundFolder].	(type = #scratch) ifTrue: [f _ DefaultScratchFolder].	f ifNotNil: [		(f isKindOf: FileDirectory) ifTrue: [			(f parentDirectory directoryExists: f pathName) ifTrue: [^ f]]].	^ FileDirectory on: self homeDir! !----SNAPSHOT----(11 March 2009 8:35:55 am) priorSource: 7178153!!WeDoPlugin class methodsFor: 'class initialization' stamp: 'jm 12/5/2008 13:57' prior: 39140399!initialize	"self initialize"	IsOpen _ false.	MotorA _ 0.	MotorB _ 0.	MotorAStopTime _ 0.	MotorBStopTime _ 0.	PortAID _ 0.	PortAValue _ 0.	PortBID _ 0.	PortBValue _ 0.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 12:46' prior: 39144130!distance	"Answer the value of the distance sensor."	| id v |	id _ 9. "distance sensor ID"	self readInputs.	v _ nil.	PortAID = id ifTrue: [v _ PortAValue].	PortBID = id ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	"add scaling code here..."	^ v! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 12:59'!isOpen	"Answer true if the WeDo port is open. If it is not open, try to open it."	IsOpen ifTrue: [^ true].	self openPort ifNil: [^ false].	self reset.	^ IsOpen _ true! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 11:09' prior: 39142917!mapID: n	"Covert a raw ID value into a device index. Some device ID's:		2 - tilt sensor		9 - proximity sensor		10 - light brick		13 - motor"	| rangeMap |	rangeMap _ #(9 27 47 67 87 109 131 152 169 190 211 224 233 246 256).	1 to: rangeMap size do: [:i |		n < (rangeMap at: i) ifTrue: [^ i - 1]].	^ rangeMap size! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/6/2008 20:36'!motorAPower: n	"Set the power of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorA ~= 0).	MotorA _ (n + (27 * n sign)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	(wasRunning and: [MotorA = 0]) ifTrue: [		MotorAStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/5/2008 13:58'!motorAStopped	"Answer true if motor A has not run in the past second."	| now |	MotorA ~= 0 ifTrue: [^ false].  "currently running"	now _ Time millisecondClockValue.	(MotorAStopTime isNil or:	 [now < MotorAStopTime]) ifTrue: [		MotorAStopTime _ 0].	^ (now - MotorAStopTime) > 1000! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/6/2008 20:36'!motorBPower: n	"Set the power of motor B. Range is -100 to 100, where 0 is off and the sign determines the direction. Positive is clockwise."	| wasRunning |	wasRunning _ (MotorB ~= 0).	MotorB _ (n + (27 * n sign)) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	(wasRunning and: [MotorB = 0]) ifTrue: [		MotorBStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/5/2008 14:00'!motorBStopped	"Answer true if motor B has not run in the past second."	| now |	MotorB ~= 0 ifTrue: [^ false].  "currently running"	now _ Time millisecondClockValue.	(MotorBStopTime isNil or:	 [now < MotorBStopTime]) ifTrue: [		MotorBStopTime _ 0].	^ (now - MotorBStopTime) > 1000! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 13:12'!proximity	"Answer the value of the proximity sensor."	| id v |	id _ 9. "proximity sensor ID"	self readInputs.	v _ nil.	PortAID = id ifTrue: [v _ PortAValue].	PortBID = id ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	v _ ((100 * (v - 70)) // 140) within: 0 and: 100.	^ v! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/5/2008 13:59' prior: 39139426!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is available."	"Note: read as much data as available (it will be multiple of 9 bytes) and take the last 9 bytes read to get the most recent values."	"Note: ID's are meaningless while the motor is running and for about a second after it has been turned off."	"self readInputs"	| buf n |	self isOpen ifFalse: [^ nil].	buf _ ByteArray new: 288. "32 * 9"	n _ WeDoPlugin readInto: buf.	n < 9 ifTrue: [ "no data -- may be disconnected"		self initialize.		^ nil].	buf _ buf copyFrom: n - 8 to: n.	self motorAStopped ifTrue: [		PortAID _ self mapID: (buf at: 5).		PortAValue _ buf at: 4].	self motorBStopped ifTrue: [		PortBID _ self mapID: (buf at: 7).		PortBValue _ buf at: 6].	^ {PortAID. PortBID. PortAValue. PortBValue }! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 12:56' prior: 39140686!reset	"self reset"	self sendStatus: 128 motorA: 0 motorB: 0.	self sendStatus: 8 motorA: 0 motorB: 0.	self sendStatus: 64 motorA: 0 motorB: 0.	MotorA _ 0.	MotorB _ 0.	MotorStopTime _ Time millisecondClockValue.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 14:23' prior: 39131478!sendStatus: status motorA: motorA motorB: motorB	| buf |	buf _ ByteArray new: 9.	buf at: 2 put: status.	buf at: 3 put: (motorA >= 0 ifTrue: [motorA] ifFalse: [256 + motorA]).	buf at: 4 put: (motorB >= 0 ifTrue: [motorB] ifFalse: [256 + motorB]).	self writeFrom: buf.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 16:14' prior: 39143329!tilt	"Answer the value of the tilt sensor:		0 - no tilt or tilt sensor not available		1-4 - tilt direction"	| id v |	id _ 2. "tilt sensor ID"	self readInputs.	v _ nil.	PortAID = id ifTrue: [v _ PortAValue].	PortBID = id ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	v < 49 ifTrue: [^ 3].	v < 100 ifTrue: [^ 2].	v < 154 ifTrue: [^ 0].	v < 205 ifTrue: [^ 1].	^ 4! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/4/2008 12:51' prior: 39122401!openPort	"Open the WeDo port. Return nil if the port could not be opened."	"self openPort"	<primitive: 'primOpenPort' module: 'WeDoPlugin'>	^ nil! !----SNAPSHOT----(11 March 2009 8:41:55 am) priorSource: 7179362!----SNAPSHOT----(11 March 2009 8:42:31 am) priorSource: 7185017!!ScratchProcess methodsFor: 'entry points' stamp: 'jm 3/11/2009 08:45' prior: 39293074!stop	"Permanently terminates this process."	stackFrame ifNotNil: [stackFrame stopMIDI; stopMotors].	readyToYield _ true.	readyToTerminate _ true.	topBlock ifNotNil: [topBlock clearProcess].! !!ScratchStackFrame methodsFor: 'accessing' stamp: 'jm 12/5/2008 14:34'!stopMotors	| m |	(expression isKindOf: CommandBlockMorph) ifTrue: [		#setMotor:power:duration:elapsed:from: = expression selector ifTrue: [			m _ arguments first.			expression receiver setMotor: m power: 0]].! !!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'jm 12/4/2008 13:04' prior: 37639450!hookupSensorNames	| sensorNames stage virtualSensors |	sensorNames _ #(		'slider'		'light'		'sound'		'resistance'	).	WeDoPlugin isOpen ifTrue: [		sensorNames _ sensorNames, #('-' tilt proximity)].	(stage _ self ownerThatIsA: ScratchStageMorph) ifNotNil: [		stage scratchServer ifNotNil: [			virtualSensors _ stage scratchServer sensorNames.			virtualSensors size > 0 ifTrue: [				^ sensorNames, {'-'}, stage scratchServer sensorNames]]].	^ sensorNames! !!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'jm 12/4/2008 13:07' prior: 37642171!sensor: sensorName	"Answer the value of the given sensor, or zero if the sensorboard is not available."	| stage v sb |	(stage _ self ownerThatIsA: ScratchStageMorph) ifNil: [^ 0].	stage scratchServer ifNotNil: [		v _ stage scratchServer sensorValueFor: sensorName.		v ifNotNil: [^ v]].	'tilt' = sensorName ifTrue: [^ WeDoPlugin tilt].	'proximity' = sensorName ifTrue: [^ WeDoPlugin proximity].	sb _ stage sensorBoard.	sb tryToOpenPort ifFalse: [^ 0].  "could not open"	^ sb sensor: (self indexForSensorName: sensorName)! !!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'jm 3/11/2009 08:52'!motor: motorName onFor: secs	"Turn the given motor on for the given number of seconds."! !!ScriptableScratchMorph class methodsFor: 'block specs' stamp: 'jm 3/11/2009 08:52' prior: 40691867!blockSpecs	"Answer a collection of block specifications for the blocks that are common to all objects. Block specificatons (Arrays) are interspersed with category names (Strings). A block specification is an Array of the form: (<block spec string> <block type> <selector> [optional initial argument values]).	Explanation of flags:		-	no flags		b	boolean reporter		c	c-shaped block containing a sequence of commands (always special form)		r	reporter		s	special form command with its own evaluation rule		t	timed command, like wait or glide		E	message event hat		K	key event hat		M	mouse-click event hat		S	start event hat		W	when <condition> hat (obsolete)"	| blocks |	blocks _ #(		'control'			('when %m clicked'				S	-)			('when %k key pressed'			K	-)			('when %m clicked'				M	-)			-			('wait %n secs'					t	wait:elapsed:from: 1)			-			('forever'						c	doForever)			('repeat %n'						c	doRepeat 10)			-			('broadcast %e'					-	broadcast:)			('broadcast %e and wait'			s	doBroadcastAndWait)			('when I receive %e'			E	-)			-			('forever if %b'					c	doForeverIf)			('if %b'							c	doIf)			('if %b'							c	doIfElse)			('wait until %b'					s	doWaitUntil)			('repeat until %b'				c	doUntil)			-			('stop script'					s	doReturn)			('stop all'						-	stopAll)		'numbers'			('%n + %n'						r	+ - -)			('%n - %n'						r	- - -)			('%n * %n'						r	* - -)			('%n / %n'						r	/ - -)			-			('pick random %n to %n'		r	randomFrom:to: 1 10)			-			('%s < %s'						b	< '' '')			('%s = %s'						b	= '' '')			('%s > %s'						b	> '' '')			-			('%b and %b'					b	&)			('%b or %b'						b	|)			('not %b'						b	not)			-			('%s & %s'						r	concatenate:with: 'blue' 'fish')			('letter %n of %s'				r	letter:of: 2 'fish')			('length of %s'					r	stringLength: 'fish')			-			('%n mod %n'					r	\\ - -)			('round %n'						r	rounded -)			-			('%f of %n'						r	computeFunction:of: 'sqrt' 10)		'sound'			('play sound %S'				-	playSound:)			('play sound %S until done'		s	doPlaySoundAndWait)			('stop all sounds'				-	stopAllSounds)			-			('play drum %D for %n beats'	t 	drum:duration:elapsed:from: 48 0.2)			('rest for %n beats'				t 	rest:elapsed:from: 0.2)			-			('play note %N for %n beats'	t	noteOn:duration:elapsed:from: 60 0.5)			('set instrument to %K'			- 	setInstrument: 1)			-			('set volume to %n%'			- 	setVolumeTo: 100)			('volume'						r 	volume)			-			('set tempo to %n bpm'			- 	setTempoTo: 60)			('tempo'							r 	tempo)		'motor'			('turn motor %M on for %n secs'		-	motor:onFor: 'A' 5)			('turn motor %M on'				-	motorOn: 'A')			('turn motor %M off'			-	motorOff: 'A')			('set motor %M direction %W'	-	motor:directon: 'A' 'reverse')			('set motor %M power %n'		-	motor:power: 'A' 100)		'variables'			('show variable %v'				-	showVariable:)			('hide variable %v'				-	hideVariable:)		'list'			('add %s to %L'					-	append:toList: 'thing')			-			('delete %y of %L'				-	deleteLine:ofList: 1)			('insert %s at %i of %L'			-	insert:at:ofList: 'thing' 1)			('replace item %i of %L with %s'		-	setLine:ofList:to: 1 'list' 'thing')			-			('item %i of %L'					r	getLine:ofList: 1)			('length of %L'					r	lineCountOfList:)			('%L contains %s'				b	list:contains: 'list' 'thing')	).	^ blocks, self obsoleteBlockSpecs! !!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'jm 3/11/2009 08:53'!motorOn: motorName	"Turn the given motor on."! !!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'jm 3/11/2009 08:53'!motorOff: motorName	"Turn the given motor off."! !!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'jm 3/11/2009 08:53'!motor: motorName direction: directionName	"Set the direction of the given motor."! !!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'jm 3/11/2009 08:54'!motor: motorName power: powerLevel	"Set the power level of the given motor (0-100)."! !!ScriptableScratchMorph class methodsFor: 'block specs' stamp: 'jm 3/11/2009 08:54' prior: 40741636!blockSpecs	"Answer a collection of block specifications for the blocks that are common to all objects. Block specificatons (Arrays) are interspersed with category names (Strings). A block specification is an Array of the form: (<block spec string> <block type> <selector> [optional initial argument values]).	Explanation of flags:		-	no flags		b	boolean reporter		c	c-shaped block containing a sequence of commands (always special form)		r	reporter		s	special form command with its own evaluation rule		t	timed command, like wait or glide		E	message event hat		K	key event hat		M	mouse-click event hat		S	start event hat		W	when <condition> hat (obsolete)"	| blocks |	blocks _ #(		'control'			('when %m clicked'				S	-)			('when %k key pressed'			K	-)			('when %m clicked'				M	-)			-			('wait %n secs'					t	wait:elapsed:from: 1)			-			('forever'						c	doForever)			('repeat %n'						c	doRepeat 10)			-			('broadcast %e'					-	broadcast:)			('broadcast %e and wait'			s	doBroadcastAndWait)			('when I receive %e'			E	-)			-			('forever if %b'					c	doForeverIf)			('if %b'							c	doIf)			('if %b'							c	doIfElse)			('wait until %b'					s	doWaitUntil)			('repeat until %b'				c	doUntil)			-			('stop script'					s	doReturn)			('stop all'						-	stopAll)		'numbers'			('%n + %n'						r	+ - -)			('%n - %n'						r	- - -)			('%n * %n'						r	* - -)			('%n / %n'						r	/ - -)			-			('pick random %n to %n'		r	randomFrom:to: 1 10)			-			('%s < %s'						b	< '' '')			('%s = %s'						b	= '' '')			('%s > %s'						b	> '' '')			-			('%b and %b'					b	&)			('%b or %b'						b	|)			('not %b'						b	not)			-			('%s & %s'						r	concatenate:with: 'blue' 'fish')			('letter %n of %s'				r	letter:of: 2 'fish')			('length of %s'					r	stringLength: 'fish')			-			('%n mod %n'					r	\\ - -)			('round %n'						r	rounded -)			-			('%f of %n'						r	computeFunction:of: 'sqrt' 10)		'sound'			('play sound %S'				-	playSound:)			('play sound %S until done'		s	doPlaySoundAndWait)			('stop all sounds'				-	stopAllSounds)			-			('play drum %D for %n beats'	t 	drum:duration:elapsed:from: 48 0.2)			('rest for %n beats'				t 	rest:elapsed:from: 0.2)			-			('play note %N for %n beats'	t	noteOn:duration:elapsed:from: 60 0.5)			('set instrument to %K'			- 	setInstrument: 1)			-			('set volume to %n%'			- 	setVolumeTo: 100)			('volume'						r 	volume)			-			('set tempo to %n bpm'			- 	setTempoTo: 60)			('tempo'							r 	tempo)		'motor'			('turn motor %M on for %n secs'		-	motor:onFor: 'A' 5)			('turn motor %M on'				-	motorOn: 'A')			('turn motor %M off'			-	motorOff: 'A')			('set motor %M direction %W'	-	motor:direction: 'A' 'reverse')			('set motor %M power %n'		-	motor:power: 'A' 100)		'variables'			('show variable %v'				-	showVariable:)			('hide variable %v'				-	hideVariable:)		'list'			('add %s to %L'					-	append:toList: 'thing')			-			('delete %y of %L'				-	deleteLine:ofList: 1)			('insert %s at %i of %L'			-	insert:at:ofList: 'thing' 1)			('replace item %i of %L with %s'		-	setLine:ofList:to: 1 'list' 'thing')			-			('item %i of %L'					r	getLine:ofList: 1)			('length of %L'					r	lineCountOfList:)			('%L contains %s'				b	list:contains: 'list' 'thing')	).	^ blocks, self obsoleteBlockSpecs! !!ScriptableScratchMorph methodsFor: 'motor ops' stamp: 'jm 3/11/2009 08:56' prior: 40745442!motor: motorName power: power	"Set the power level of the given motor (0-100)."	'A' = motorName ifTrue: [WeDoPlugin motorAPower: power].	'B' = motorName ifTrue: [WeDoPlugin motorBPower: power].! !!ScratchStageMorph methodsFor: 'scratch processes/events' stamp: 'jm 3/11/2009 08:59' prior: 40480489!stopAll	"Stop all processes and make sure I am stepping."	| sFrame |	World hands do: [:h | h newKeyboardFocus: nil; clearUnclaimedKeystrokes].	Sensor clearKeystate.	SoundPlayer stopPlayingAll.	self class stopSoundRecorder.	self stopAllProcesses.	self stopAsks.	self deleteAllClones.	self midiAllNotesOff.	WeDoPlugin reset.	self stopPlaying.	self allMorphsDo: [:m |		(m isKindOf: ScriptableScratchMorph) ifTrue: [m stopPlaying]].	(sFrame _ self ownerThatIsA: ScratchFrameMorph) ifNotNil: [		sFrame scriptsPane allMorphsDo: [:m |			(m respondsTo: #stop) ifTrue: [m stop].			(m respondsTo: #litUp:) ifTrue: [m litUp: false]].		World startSteppingSubmorphsOf: sFrame].	World startSteppingSubmorphsOf: self.! !----QUIT----(11 March 2009 8:59:37 am) priorSource: 7185083!----STARTUP----(11 March 2009 9:00:23 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!DialogBoxMorph methodsFor: 'accessing' stamp: 'jm 3/11/2009 09:02' prior: 34557307!shortcutButtonLabel: labelString action: actionSelector icon: aSymbol	"Answer a new shortcut button with the given label and selector. A shortcut button has a folder icon on it. The button target will be me and it will use my button forms. Icon can be: #folderIcon, #folderCatIcon, #folderHouseIcon #folderPicIcon, #folderSoundIcon"	"(DialogBoxMorph new shortcutButtonLabel: 'Yes' action: #beep isCat: true) openInWorld"	| onForm offForm overForm button |	onForm _ ScratchFrameMorph skinAt: #dialogButtonFrameOver.	offForm _ ScratchFrameMorph skinAt: #dialogButtonFrame.	overForm _ ScratchFrameMorph skinAt: #dialogButtonFrameOver.	button _ ResizableToggleButton2 new		offForm: offForm		onForm: onForm.	button label forceUnicodeRendering: true.	button addMorph: (ImageMorph new form: (ScratchFrameMorph skinAt: aSymbol)).	^ (button		label: labelString localized font: (ScratchFrameMorph getFont: #FolderShortcut);		target: self;		actionSelector: actionSelector;		setLabelColor: (Color gray: 0.15)).! !----QUIT----(11 March 2009 9:03:04 am) priorSource: 7195636!----STARTUP----(14 March 2009 9:38:25 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!DialogBoxMorph methodsFor: 'accessing' stamp: 'ee 6/25/2008 19:04' prior: 40750313!shortcutButtonLabel: labelString action: actionSelector icon: aSymbol	"Answer a new shortcut button with the given label and selector. A shortcut button has a folder icon on it. The button target will be me and it will use my button forms. Icon can be: #folderIcon, #folderCatIcon, #folderHouseIcon #folderPicIcon, #folderSoundIcon"	"(DialogBoxMorph new shortcutButtonLabel: 'Yes' action: #beep isCat: true) openInWorld"	| onForm offForm overForm button |	onForm _ ScratchFrameMorph skinAt: #dialogButtonFrameOver.	offForm _ ScratchFrameMorph skinAt: #dialogButtonFrame.	overForm _ ScratchFrameMorph skinAt: #dialogButtonFrameOver.	button _ ResizableToggleButton2 new		offForm: offForm		onForm: onForm.	button addMorph: (ImageMorph new form: (ScratchFrameMorph skinAt: aSymbol)).	^ (button		label: labelString localized font: (ScratchFrameMorph getFont: #FolderShortcut);		target: self;		actionSelector: actionSelector;		setLabelColor: (Color gray: 0.15)).! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 3/14/2009 09:40' prior: 40394618!userNameForHomeFolderOrNil	"Answer the name to use for the home folder. This is the user name unless the home folder location has been overridden by an entry in the Scratch.ini file."	| home delimiter |	home _ ScratchPlugin primGetFolderPathOrNil: 1.	UserHomeFolder ifNotNil: [home _ UserHomeFolder pathName]. 	home ifNil: [^ nil].	delimiter _ FileDirectory pathNameDelimiter asString.	^ UTF8 withAll: (home findTokens: delimiter) last! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 1/27/2009 13:21' prior: 40732899!createLogo	"Create and the Scratch logo."	logoMorph _ SketchMorph withForm: (ScratchFrameMorph skinAt: #scratchLogo).	logoMorph position: topPane position + (12@8).	topPane addMorph: logoMorph.! !!BloxDefs methodsFor: 'initialization' stamp: 'jm 3/14/2009 09:43' prior: 33759289!addDefaultBlockSpecs	"Answer a collection of block specifications for the blocks that are common to all objects. Block specificatons (Arrays) are interspersed with category names (Strings). A block specification is an Array of the form: (<block spec string> <block type> <selector> [optional initial argument values]).	Explanation of flags:		-	no flags		b	boolean reporter		c	c-shaped block containing a sequence of commands (always a special form)		r	reporter		s	special form command with own evaluation rule		t	timed command (e.g. 'wait 3 secs')		E	message event hat		K	key event hat		M	mouse-click event hat		S	start event hat		W	when <condition> hat"	blockSpecs _ #(		'control'			('when %m clicked'				S	-)			('when %k key pressed'			K	-)			('when %m clicked'				M	-)			-			('wait %n secs'					t	wait:elapsed:from: 1)			-			('forever'						c	doForever)			('repeat %n'						c	doRepeat 10)			-			('broadcast %e'					-	broadcast:)			('broadcast %e and wait'			s	doBroadcastAndWait)			('when I receive %e'			E	-)			-			('forever if %b'					c	doForeverIf)			('if %b'							c	doIf)			('if %b'							c	doIfElse)			('wait until %b'					s	doWaitUntil)			('repeat until %b'				c	doUntil)			-			('stop script'					s	doReturn)			('stop all'						-	stopAll)		'operators'			('%n + %n'						r	+ - -)			('%n - %n'						r	- - -)			('%n * %n'						r	* - -)			('%n / %n'						r	/ - -)			-			('pick random %n to %n'		r	randomFrom:to: 1 10)			-			('%n < %n'						b	< - -)			('%n = %n'						b	= - -)			('%n > %n'						b	> - -)			-			('%b and %b'					b	&)			('%b or %b'						b	|)			('not %b'						b	not)			-			('%n mod %n'					r	\\ - -)			('abs %n'						r	abs -)			('round %n'						r	rounded -)	).! !!BloxDefs methodsFor: 'accessing' stamp: 'jm 3/14/2009 09:43' prior: 33762001!blockColorFor: aCategory	"Answer the block color for the given category."	'control' = aCategory ifTrue: [^ (Color h: 41 s: 0.85 v: 0.9)].	'motion' = aCategory ifTrue: [^ ( Color h: 225 s: 0.65 v: 0.83)].	'looks' = aCategory ifTrue: [^ (Color h: 264 s: 0.62 v: 0.89)].	'pen' = aCategory ifTrue: [^ (Color h: 165 s: 1 v: 0.63)].	'operators' = aCategory ifTrue: [^ (Color h: 93 s: 0.9 v: 0.76)].	'sound' = aCategory ifTrue: [^ (Color h: 296 s: 0.66 v: 0.85)].	'sensing' = aCategory ifTrue: [^ (Color h: 200 s: 0.98 v: 0.86)].	'variables' = aCategory ifTrue: [^ (Color h: 25 s: 0.88 v: 0.95)].	^ (Color h: 0 s: 0.81 v: 0.83)  "a shade of red"! !!ScratchTranslator class methodsFor: 'Unicode rendering' stamp: 'jm 3/14/2009 09:43' prior: 37545991!renderHintString	"Answer a string to be used as an example button lable to adjust button size and label centering."	"self renderHintString"	"self showHintString"	| result srcs |	result _ RenderHintString.	result ifNil: [		result _ UTF8 new.		srcs _ #('New' 'Open' 'Save' 'Save As' 'Share!!' 'Undo' 'Language' 'Extras' 'Want Help?' 'motion' 'looks' 'sound' 'pen' 'control' 'sensing' 'operators' 'variables').		srcs do: [: s |			result _ result, (self translationFor: s)]].	RenderWithSqueak ifTrue: [result _ String withAll: result].	^ result! !!ScratchViewerMorph methodsFor: 'initialization' stamp: 'jm 2/26/2009 15:55' prior: 40657307!rebuildCategorySelectors	| catList maxExtent buttons label offForm onForm overForm b pad leftColumnX rightColumnX x y |	catList _ #(		motion		control		looks		sensing		sound		numbers		pen			variables).	"First, delete the old category buttons"	submorphs do: [:m | (m isKindOf: ResizableToggleButton2) ifTrue: [m delete]].	"Create new buttons, keeping track of the maximum extent."	maxExtent _ 75@0.	buttons _ catList collect: [:cat |		label _ (ScratchTranslator translationFor: cat asString) capitalized.		cat = 'numbers' ifTrue: [			label _ ScratchTranslator translationFor: '+ - < ='].		offForm _ (ScratchFrameMorph skinAt: cat).		onForm _ (ScratchFrameMorph skinAt: (cat, 'Pressed')).		overForm _ (ScratchFrameMorph skinAt: (cat, 'Over')).		ScratchTranslator isRTL			ifTrue:[				b _ ResizableToggleButton2 new					offForm:	(offForm flipBy: #horizontal centerAt: offForm center)					onForm:		(onForm flipBy: #horizontal centerAt: onForm center)					overForm:	(overForm flipBy: #horizontal centerAt: overForm center)]			ifFalse:[				b _ ResizableToggleButton2 new					offForm:	offForm					onForm:		onForm					overForm:	overForm].		b			label: label font: (ScratchFrameMorph getFont: #Category);			setLabelColor: Color white;			target: self;			actionSelector: #currentCategory:;			arguments: (Array with: cat);			toggleButtonMode: true;			toggleMode: false.		ScratchTranslator isRTL			ifTrue:[b rightJustifyInset: 10]			ifFalse:[b leftJustifyInset: 10].		maxExtent _ maxExtent max: (b extent + (3 @ -6)).		b].	"calculate catButtonsExtent"	pad _ 15. "padding on left, right, and betwen the button columns"	catButtonsExtent _ ((2 * maxExtent x) + (3 * pad)) @ (((catList size // 2) * (maxExtent y + 6)) + 25).	"place the buttons"	leftColumnX _ self left + 12 + pad.	rightColumnX _ leftColumnX + maxExtent x + pad.	x _ leftColumnX.	y _ self top + 17.	1 to: buttons size do: [:i |		b _ buttons at: i.		b extent: maxExtent.		self addMorph: (b position: x@y).		i even			ifTrue: [x _ leftColumnX. y _ y + b height + 6]			ifFalse: [x _ rightColumnX]].	self width: catButtonsExtent x.	pageViewer position: self position + (0@catButtonsExtent y).	topSectionHeight _ catButtonsExtent y - 4.! !!ScratchViewerMorph methodsFor: 'initialization' stamp: 'jm 3/14/2009 09:44' prior: 40756714!rebuildCategorySelectors	| catList maxExtent buttons label offForm onForm overForm b pad leftColumnX rightColumnX x y |	catList _ #(		motion		control		looks		sensing		sound		operators		pen			variables).	"First, delete the old category buttons"	submorphs do: [:m | (m isKindOf: ResizableToggleButton2) ifTrue: [m delete]].	"Create new buttons, keeping track of the maximum extent."	maxExtent _ 75@0.	buttons _ catList collect: [:cat |		label _ (ScratchTranslator translationFor: cat asString) capitalized.		cat = 'numbers' ifTrue: [			label _ ScratchTranslator translationFor: '+ - < ='].		offForm _ (ScratchFrameMorph skinAt: cat).		onForm _ (ScratchFrameMorph skinAt: (cat, 'Pressed')).		overForm _ (ScratchFrameMorph skinAt: (cat, 'Over')).		ScratchTranslator isRTL			ifTrue:[				b _ ResizableToggleButton2 new					offForm:	(offForm flipBy: #horizontal centerAt: offForm center)					onForm:		(onForm flipBy: #horizontal centerAt: onForm center)					overForm:	(overForm flipBy: #horizontal centerAt: overForm center)]			ifFalse:[				b _ ResizableToggleButton2 new					offForm:	offForm					onForm:		onForm					overForm:	overForm].		b			label: label font: (ScratchFrameMorph getFont: #Category);			setLabelColor: Color white;			target: self;			actionSelector: #currentCategory:;			arguments: (Array with: cat);			toggleButtonMode: true;			toggleMode: false.		ScratchTranslator isRTL			ifTrue:[b rightJustifyInset: 10]			ifFalse:[b leftJustifyInset: 10].		maxExtent _ maxExtent max: (b extent + (3 @ -6)).		b].	"calculate catButtonsExtent"	pad _ 15. "padding on left, right, and betwen the button columns"	catButtonsExtent _ ((2 * maxExtent x) + (3 * pad)) @ (((catList size // 2) * (maxExtent y + 6)) + 25).	"place the buttons"	leftColumnX _ self left + 12 + pad.	rightColumnX _ leftColumnX + maxExtent x + pad.	x _ leftColumnX.	y _ self top + 17.	1 to: buttons size do: [:i |		b _ buttons at: i.		b extent: maxExtent.		self addMorph: (b position: x@y).		i even			ifTrue: [x _ leftColumnX. y _ y + b height + 6]			ifFalse: [x _ rightColumnX]].	self width: catButtonsExtent x.	pageViewer position: self position + (0@catButtonsExtent y).	topSectionHeight _ catButtonsExtent y - 4.! !!ScratchViewerMorph methodsFor: 'initialization' stamp: 'jm 2/26/2009 15:55' prior: 40759054!rebuildCategorySelectors	| catList maxExtent buttons label offForm onForm overForm b pad leftColumnX rightColumnX x y |	catList _ #(		motion		control		looks		sensing		sound		numbers		pen			variables).	"First, delete the old category buttons"	submorphs do: [:m | (m isKindOf: ResizableToggleButton2) ifTrue: [m delete]].	"Create new buttons, keeping track of the maximum extent."	maxExtent _ 75@0.	buttons _ catList collect: [:cat |		label _ (ScratchTranslator translationFor: cat asString) capitalized.		cat = 'numbers' ifTrue: [			label _ ScratchTranslator translationFor: '+ - < ='].		offForm _ (ScratchFrameMorph skinAt: cat).		onForm _ (ScratchFrameMorph skinAt: (cat, 'Pressed')).		overForm _ (ScratchFrameMorph skinAt: (cat, 'Over')).		ScratchTranslator isRTL			ifTrue:[				b _ ResizableToggleButton2 new					offForm:	(offForm flipBy: #horizontal centerAt: offForm center)					onForm:		(onForm flipBy: #horizontal centerAt: onForm center)					overForm:	(overForm flipBy: #horizontal centerAt: overForm center)]			ifFalse:[				b _ ResizableToggleButton2 n