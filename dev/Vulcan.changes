rameMorph, reject the drop unless it is onto the work pane. For developers, accept drops into other morphs (e.g. the World). Otherwise, reject the drop."	| sFrame |	(sFrame _ newOwner ownerThatIsA: ScratchFrameMorph) ifNotNil: [		newOwner = sFrame viewerPane pageViewer contents			ifTrue: [^ self delete].		newOwner = sFrame workPane ifTrue: [^ self]. "allow drops onto the work pane"		^ self rejectDropEvent: evt].	Preferences noviceMode ifTrue: [^ self rejectDropEvent: evt].! !!ScriptableScratchMorph methodsFor: 'dropping/grabbing' stamp: 'jm 12/21/2008 15:56' prior: 39348188!justDroppedInto: newOwner event: evt	"If I'm dropped into any submorph of a ScratchFrameMorph, reject the drop unless it is onto the work pane. For developers, accept drops into other morphs (e.g. the World). Otherwise, reject the drop."	| sFrame |	(sFrame _ newOwner ownerThatIsA: ScratchFrameMorph) ifNotNil: [		newOwner = sFrame viewerPane pageViewer contents ifTrue: [			self delete.			sFrame libraryPane stop.			^ self].		newOwner = sFrame workPane ifTrue: [^ self]. "allow drops onto the work pane"		^ self rejectDropEvent: evt].	Preferences noviceMode ifTrue: [^ self rejectDropEvent: evt].! !!ScriptableScratchMorph methodsFor: 'dropping/grabbing' stamp: 'jm 12/21/2008 15:56' prior: 39348868!justDroppedInto: newOwner event: evt	"If I'm dropped into any submorph of a ScratchFrameMorph, reject the drop unless it is onto the work pane. For developers, accept drops into other morphs (e.g. the World). Otherwise, reject the drop."	| sFrame |	(sFrame _ newOwner ownerThatIsA: ScratchFrameMorph) ifNotNil: [		newOwner = sFrame viewerPane pageViewer contents ifTrue: [			self delete.			sFrame libraryPane step.			^ self].		newOwner = sFrame workPane ifTrue: [^ self]. "allow drops onto the work pane"		^ self rejectDropEvent: evt].	Preferences noviceMode ifTrue: [^ self rejectDropEvent: evt].! !!ScriptableScratchMorph methodsFor: 'dropping/grabbing' stamp: 'jm 12/2