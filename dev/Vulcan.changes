h Projects'.  "if this were localized a user could get multiple project folders for different languages..."	homeDir _ FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	(FileDirectory default directoryExists: homeDir pathName) ifFalse: [		homeDir _ FileDirectory on: (ScratchPlugin primGetFolderPath: 1)].  "home"	UserHomeFolder ifNotNil: [homeDir _ UserHomeFolder]. "home is overridden by .ini file"	(homeDir directoryExists: scratchFolderName) ifFalse: [		homeDir createDirectory: scratchFolderName].	(homeDir directoryExists: scratchFolderName)		ifTrue: [^ homeDir directoryNamed: scratchFolderName]		ifFalse: [^ homeDir].! !!ScratchFileChooserDialog methodsFor: 'accessing' stamp: 'jm 5/11/2009 10:39'!savingScratchProject	| dir |	"Check to see if we are about to save into the Sample projects directory. If so, change the default location ot the user's project folder."	dir _ ScratchFileChooserDialog getLastFolderForType: #project.	(ScratchFileChooserDialog isSampleProjectsFolder: dir) ifTrue: [		self setDirectory: ScratchFileChooserDialog userScratchProjectsDir].! !!ScratchFileChooserDialog methodsFor: 'accessing' stamp: 'jm 5/11/2009 10:39' prior: 41742844!savingScratchProject	"Check to see if we are about to save into the Sample projects directory. If so, change the default location ot the user's project folder."	| dir |	dir _ ScratchFileChooserDialog getLastFolderForType: #project.	(ScratchFileChooserDialog isSampleProjectsFolder: dir) ifTrue: [		self setDirectory: ScratchFileChooserDialog userScratchProjectsDir].! !!ScratchFileChooserDialog class methodsFor: 'instance creation' stamp: 'jm 5/11/2009 10:39' prior: 36959482!saveScratchFileFor: aScratchFrameMorph	"Choose a file for saving the current Scratch project file. Display the thumbnail and info string for the current project and allow the info string to be edited. Answer the full name of the file in which to save the project or #cancelled if the operation is cancelled."	"ScratchFileChooserDialog saveScratchFileFor: nil"	| m result |	ScratchFileChooserDialog deleteDuplicates.	m _ self new		createScratchFileChooserFor: aScratchFrameMorph saving: true;		type: #project;		savingScratchProject.	result _ m getUserResponseForNewFile.	result = #cancelled ifTrue: [^ result].	(result asLowercase endsWith: '.sb') ifFalse: [result _ result, '.sb'].	^ result! !!ScratchFileChooserDialog methodsFor: 'accessing' stamp: 'jm 5/11/2009 10:41' prior: 41743316!savingScratchProject	"Check to see if we are about to save into the Sample projects directory. If so, change the default location ot the user's project folder."	|  thisDir sampleProjectDir |	thisDir _ ScratchFileChooserDialog getLastFolderForType: #project.	sampleProjectDir _ FileDirectory default directoryNamed: 'Projects'.	(thisDir pathName = sampleProjectDir pathName) ifTrue: [		self setDirectory: ScratchFileChooserDialog userScratchProjectsDir].! !!ScratchFileChooserDialog methodsFor: 'accessing' stamp: 'jm 5/11/2009 10:41' prior: 41744607!savingScratchProject	"Check to see if we are about to save into the Sample projects directory. If so, change the default location ot the user's project folder."	| thisDir sampleProjectDir |	thisDir _ ScratchFileChooserDialog getLastFolderForType: #project.	sampleProjectDir _ FileDirectory default directoryNamed: 'Projects'.	(thisDir pathName = sampleProjectDir pathName) ifTrue: [		self setDirectory: ScratchFileChooserDialog userScratchProjectsDir].! !!ScratchFileChooserDialog methodsFor: 'accessing' stamp: 'jm 5/11/2009 10:41' prior: 41745167!savingScratchProject	"Check to see if we are about to save into the Sample projects directory. If so, change the default location ot the user's project folder."	| thisDir sampleProjectDir |	thisDir _ ScratchFileChooserDialog getLastFolderForType: #project.	sampleProjectDir _ FileDirectory default directoryNamed: 'Projects'.	(thisDir pathName = sampleProjectDir pathName)