e tags:' 'Make a list' 'My Projects' 'mouse x:' 'mouse y:' 'A') do: [:t |		self addUITranslation: t].! !!ScratchTranslator class methodsFor: 'import/export' stamp: 'ee 5/15/2009 14:38'!exportPootleTranslations	"Exports translations from the locale folder into a new localeForPootle directory with a different subdirectory structure"	"Need to figure out how to overwrite files without getting a permission dialog"	"self exportPootleTranslations"	| defaultDir localeDir localeForPootleDir fs dirName sdir |	defaultDir _ FileDirectory default.	(defaultDir directoryNames includes: 'locale')		ifTrue: [localeDir _ self translationDir]		ifFalse: [^ self "dialog should say no locale folder found"].	localeForPootleDir _ defaultDir directoryNamed: 'translate.scratch.mit.edu'.	localeForPootleDir _ localeForPootleDir directoryNamed: 'scratch'.	localeDir fileNames do: [:n |		(n endsWith: '.po') ifTrue: [			dirName _ (n copyFrom: 1 to: n size - 3).			sdir _ localeForPootleDir directoryNamed: dirName.			fs _ sdir newFileNamed: n.			fs nextPutAll: (localeDir fileNamed: n) contentsOfEntireFile.			fs close]].! !!ScratchTranslator class methodsFor: 'import/export' stamp: 'ee 5/15/2009 15:07'!importPootleTranslations	"Imports translations from the LLK Pootle translation directory into the Scratch/locale/ directory"	"First checkout svn://translate.scratch.mit.edu:52400 to the local directory, then run this"	"self importPootleTranslations"	| dir subDir fs |	dir _ FileDirectory default.	(dir directoryNames includes: 'translate.scratch.mit.edu')		ifTrue: [dir _ dir directoryNamed: 'translate.scratch.mit.edu'.			(dir directoryNames includes: 'scratch')				ifTrue: [dir _ dir directoryNamed: 'scratch']				ifFalse: [^ self "dialog should say no scratch folder found"]]		ifFalse: [^ self "dialog should say no scratch folder found"].	dir directoryNames do: [:n |		(n = '.svn') ifFalse: [			subDir _ dir directoryNamed: n.			fs _ self translationDir newFileNamed: n,'.po'.			fs nextPutAll: (subDir fileNamed: n) contentsOfEntireFile.			fs close]].! !----SNAPSHOT----(19 May 2009 10:29:18 pm) priorSource: 8296759!ScratchFrameMorph version: '1.4 (internal of ', (Date today printFormat: #(1 2 3 $- 2 2)), ')'.!----SNAPSHOT----(19 May 2009 10:29:32 pm) priorSource: 8307760!----SAVEAS Scratch19May09----(19 May 2009 10:30:17 pm)!----STARTUP----(20 May 2009 9:53:32 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!stackFrame!stackFrame expression!stackFrame expression!!ScratchProcess methodsFor: 'accessing' stamp: 'jm 5/20/2009 10:21' prior: 37261806!errorFlag: aBoolean	"Set the error flag for this process."	errorFlag _ aBoolean.	stackFrame expression isCollection		ifTrue: [stackFrame expression topBlock showErrorFeedback]		ifFalse: [stackFrame expression first topBlock showErrorFeedback].! !!ScratchProcess methodsFor: 'accessing' stamp: 'jm 5/20/2009 10:22' prior: 41862720!errorFlag: aBoolean	"Set the error flag for this process."	errorFlag _ aBoolean.	stackFrame expression isCollection		ifTrue: [stackFrame expression first topBlock showErrorFeedback]		ifFalse: [stackFrame expression topBlock showErrorFeedback].! !!ScratchProcess methodsFor: 'accessing' stamp: 'jm 5/20/2009 10:23' prior: 41863059!errorFlag: aBoolean	"Set the error flag for this process."	errorFlag _ aBoolean.	topBlock showErrorFeedback.! !!ScratchProcess methodsFor: 'accessing' stamp: 'jm 5/20/2009 10:23' prior: 41863398!errorFlag: aBoolean	"Set the error flag for this process."	errorFlag _ aBoolean.	topBlock showErrorFeedback.self halt.! !cachedFeedbackForm display!!ScratchProcess methodsFor: 'accessing' stamp: 'jm 5/20/2009 10:25' prior: 41863600!errorFlag: aBoolean	"Set the error flag for this process."	errorFlag _ aBoolean.	errorFlag ifTrue: [topBlock showErrorFeedback].! !----STARTUP----(20 May 2009 1:39:58 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!FileDirectory on: (ScratchPlug