rph that responds to keyboard events."	| tabFields current |	tabFields _ argMorphs select: [:m | m class includesSelector: #keyboardFocusChange:].	current _ (1 to: tabFields size) detect: [:i | (tabFields at: i) == evt hand keyboardFocus] ifNone: [tabFields size].	evt hand newKeyboardFocus: (tabFields at: (current \\ tabFields size) + 1).! !!CommandBlockMorph methodsFor: 'menus' stamp: 'jm 2/2/2009 16:49' prior: 39836414!tabToNextField: evt	"Move the keyboard focus to the next submorph that responds to keyboard events."	| tabFields current |	tabFields _ argMorphs select: [:m | m isKindOf: ExpressionArgMorph].	current _ (1 to: tabFields size) detect: [:i | (tabFields at: i) == evt hand keyboardFocus] ifNone: [tabFields size].	evt hand newKeyboardFocus: (tabFields at: (current \\ tabFields size) + 1).! !!CommandBlockMorph methodsFor: 'menus' stamp: 'jm 2/2/2009 16:49' prior: 39836911!tabToNextField: evt	"Move the keyboard focus to the next submorph that responds to keyboard events."	| fields current |	fields _ argMorphs select: [:m | m isKindOf: ExpressionArgMorph].	current _ (1 to: fields size) detect: [:i | (fields at: i) == evt hand keyboardFocus] ifNone: [fields size].	evt hand newKeyboardFocus: (fields at: (current \\ fields size) + 1).! !!CommandBlockMorph methodsFor: 'menus' stamp: 'jm 2/2/2009 16:51' prior: 39837391!tabToNextField: evt	"Move the keyboard focus to the next submorph that responds to keyboard events."	| fields current |	fields _ argMorphs select: [:m | m isKindOf: ExpressionArgMorph].	current _ (1 to: fields size) detect: [:i | (fields at: i) labelMorph == evt hand keyboardFocus] ifNone: [fields size].	evt hand newKeyboardFocus: (fields at: (current \\ fields size) + 1) labelMorph.! !!StringFieldMorph methodsFor: 'event handling' stamp: 'jm 2/2/2009 16:52' prior: 38304812!keyStroke: evt	| ch m |	ch _ evt unicodeChar.	ch = 0 ifTrue: [ch _ evt keyValue].	evt buttons = 64 ifTrue: [ch _ ch \\ 32].  "command (alt) key pressed; map to a control key"	(ch = 3) & (evt buttons = 0) ifTrue: [ch _ 13].  "map enter key to cr"	ch = 9 ifTrue: [  "tab"		(m _ self ownerThatIsA: DialogBoxMorph) ifNotNil: [m tabToNextField: evt].		(m _ self ownerThatIsA: CommandBlockMorph) ifNotNil: [m tabToNextField: evt].		^ self].	(ch = 10) | (ch = 13) ifTrue: [  "cr, lf, or enter key"		(owner respondsTo: #tabToNextField:)			ifTrue: [owner tabToNextField: evt]			ifFalse: [evt hand newKeyboardFocus: nil].		^ self].	ch = 8 ifTrue: [^ self backspace].	ch = 127 ifTrue: [^ self deleteSelection].	(evt buttons = 64) | (evt buttons = 16) ifTrue: [	"ctrl (or alt) is pressed"		ch = 1 ifTrue: [self selectAll].		"ctrl-a"		ch = 3 ifTrue: [self copySelection]. 	"ctrl-c"		ch = 22 ifTrue: [self paste].			"ctrl-v"		ch = 24 ifTrue: [self cutSelection].	"ctrl-x"		ch = 26 ifTrue: [self undo]].			"ctrl-z"	evt buttons = 8 ifTrue: [ "shift is pressed"		ch = 28 ifTrue: [self moveCursorLeftAndSelect].  	"shift-left"		ch = 29 ifTrue: [self moveCursorRightAndSelect].	"shift-right"		ch = 1 ifTrue: [self moveCursorHomeAndSelect].	"home"		ch = 4 ifTrue: [self moveCursorEndAndSelect]].	"end"	evt buttons = 0 ifTrue: [		ch = 1 ifTrue: [self moveCursorHome].	"home"		ch = 4 ifTrue: [self moveCursorEnd].		"end"		ch = 28 ifTrue: [self moveCursorLeft].	"left"		ch = 29 ifTrue: [self moveCursorRight].	"right"		blinkState _ true].	ch >= 32 ifTrue: [self insertCharacter: ch].! !----SNAPSHOT----(2 February 2009 4:52:37 pm) priorSource: 6281254!!StringFieldMorph methodsFor: 'event handling' stamp: 'jm 2/2/2009 16:56' prior: 39838339!keyStroke: evt	| ch m |	ch _ evt unicodeChar.	ch = 0 ifTrue: [ch _ evt keyValue].	evt buttons = 64 ifTrue: [ch _ ch \\ 32].  "command (alt) key pressed; map to a control key"	(ch = 3) & (evt buttons = 0) ifTrue: [ch _ 13].  "map enter key to cr"	ch = 9 ifTrue: [  "tab"		(m _ self ownerThatIsA: DialogBoxMorph) ifNotNil: [m tabToNextField: evt].		(m _ self ownerThatIsA: CommandBlockMorph) ifNotNil: [m tabToNextField: evt].		^ self].	(ch = 10) | (ch = 13) ifTrue: [  "cr, lf, or enter key"		(m _ self ownerThatIsA: DialogBoxMorph) ifNotNil: [^ m tabToNextField: evt].		(m _ self ownerThatIsA: CommandBlockMorph) ifNotNil: [^ m tabToNextField: evt].		evt hand newKeyboardFocus: nil.		^ self].	ch = 8 ifTrue: [^ self backspace].	ch = 127 ifTrue: [^ self deleteSelection].	(evt buttons = 64) | (evt buttons = 16) ifTrue: [	"ctrl (or alt) is pressed"		ch = 1 ifTrue: [self selectAll].		"ctrl-a"		ch = 3 ifTrue: [self copySelection]. 	"ctrl-c"		ch = 22 ifTrue: [self paste].			"ctrl-v"		ch = 24 ifTrue: [self cutSelection].	"ctrl-x"		ch = 26 ifTrue: [self undo]].			"ctrl-z"	evt buttons = 8 ifTrue: [ "shift is pressed"		ch = 28 ifTrue: [self moveCursorLeftAndSelect].  	"shift-left"		ch = 29 ifTrue: [self moveCursorRightAndSelect].	"shift-right"		ch = 1 ifTrue: [self moveCursorHomeAndSelect].	"home"		ch = 4 ifTrue: [self moveCursorEndAndSelect]].	"end"	evt buttons = 0 ifTrue: [		ch = 1 ifTrue: [self moveCursorHome].	"home"		ch = 4 ifTrue: [self moveCursorEnd].		"end"		ch = 28 ifTrue: [self moveCursorLeft].	"left"		ch = 29 ifTrue: [self moveCursorRight].	"right"		blinkState _ true].	ch >= 32 ifTrue: [self insertCharacter: ch].! !!DialogBoxMorph methodsFor: 'event handling' stamp: 'jm 2/2/2009 16:59'!enterKeyPressed	"Respond to the enter key being pressed in one of my input fields."	self yes.! !!StringFieldMorph methodsFor: 'event handling' stamp: 'jm 2/2/2009 16:59' prior: 39840106!keyStroke: evt	| ch m |	ch _ evt unicodeChar.	ch = 0 ifTrue: [ch _ evt keyValue].	evt buttons = 64 ifTrue: [ch _ ch \\ 32].  "command (alt) key pressed; map to a control key"	(ch = 3) & (evt buttons = 0) ifTrue: [ch _ 13].  "map enter key to cr"	ch = 9 ifTrue: [  "tab"		(m _ self ownerThatIsA: DialogBoxMorph) ifNotNil: [m tabToNextField: evt].		(m _ self ownerThatIsA: CommandBlockMorph) ifNotNil: [m tabToNextField: evt].		^ self].	(ch = 10) | (ch = 13) ifTrue: [  "cr, lf, or enter key"		(m _ self ownerThatIsA: DialogBoxMorph) ifNotNil: [^ m enterKeyPressed].		evt hand newKeyboardFocus: nil.		^ self].	ch = 8 ifTrue: [^ self backspace].	ch = 127 ifTrue: [^ self deleteSelection].	(evt buttons = 64) | (evt buttons = 16) ifTrue: [	"ctrl (or alt) is pressed"		ch = 1 ifTrue: [self selectAll].		"ctrl-a"		ch = 3 ifTrue: [self copySelection]. 	"ctrl-c"		ch = 22 ifTrue: [self paste].			"ctrl-v"		ch = 24 ifTrue: [self cutSelection].	"ctrl-x"		ch = 26 ifTrue: [self undo]].			"ctrl-z"	evt buttons = 8 ifTrue: [ "shift is pressed"		ch = 28 ifTrue: [self moveCursorLeftAndSelect].  	"shift-left"		ch = 29 ifTrue: [self moveCursorRightAndSelect].	"shift-right"		ch = 1 ifTrue: [self moveCursorHomeAndSelect].	"home"		ch = 4 ifTrue: [self moveCursorEndAndSelect]].	"end"	evt buttons = 0 ifTrue: [		ch = 1 ifTrue: [self moveCursorHome].	"home"		ch = 4 ifTrue: [self moveCursorEnd].		"end"		ch = 28 ifTrue: [self moveCursorLeft].	"left"		ch = 29 ifTrue: [self moveCursorRight].	"right"		blinkState _ true].	ch >= 32 ifTrue: [self insertCharacter: ch].! !----QUIT----(2 February 2009 10:41:02 pm) priorSource: 6285514!----STARTUP----(3 February 2009 1:59:18 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!MultilineStringMorph allInstances!self genAll!!CommandBlockMorph methodsFor: 'evaluation' stamp: 'jm 2/3/2009 14:11' prior: 39559797!coerceArgs: argList	"Answer an arugments array in which all arguments that should be numbers have been coerced to numbers if necessary."	| args specialCommands numFlags |	args _ argList asArray.	specialCommands _ #(		appendLettersOf:toList: append:toList: deleteLine:ofList: getLine:ofList: insert:at:ofList: list:contains: setLine:ofList:to:		lookLike: showBackground:		playSound: doPlaySoundAndWait		setVar:to:).	(specialCommands includes: selector) ifFalse: [		"ensure args are numbers where numbers are expected"		numFlags _ self numberArgFlags.		ScratchTranslator isRTL ifTrue: [numFlags _ numFlags reversed].		1 to: args size do: [:i |			(numFlags at: i) ifTrue: [args at: i put: (args at: i) asNumberNoError]]].	^ args! !!Encoder methodsFor: 'temps' stamp: 'jm 2/3/2009 14:12' prior: 39592128!bindTemp: name 	"Declare a temporary; error not if a field or class variable."	scopeTable at: name ifPresent: [:node |		"when non-interactive, raise the error only if its a duplicate"		(node isTemp or: [requestor interactive])			ifTrue: [^ self notify: 'Name is already defined']			ifFalse: [Transcript show: '(', name, ' is shadowed in ', class name, ')'; cr]].	^ self reallyBind: name! !!GraphMorph methodsFor: 'commands' stamp: 'jm 2/3/2009 14:13' prior: 39588604!playOnce	| factor absV scaledData |	data isEmpty ifTrue: [^ self].  "nothing to play"	factor _ 1.	data do: [:v | (absV _ v abs) > factor ifTrue: [factor _ absV]].	factor _ 32767.0 / factor.	scaledData _ SoundBuffer newMonoSampleCount: data size.	1 to: data size do: [:i |		scaledData at: i put: (factor * (data at: i)) truncated].	(SampledSound samples: scaledData samplingRate: 11025) play.! !!ObjStream methodsFor: 'private-writing' stamp: 'jm 2/3/2009 14:14' prior: 39591071!writeObjRef: anObject	"Write a reference to the given object to my output stream. The object must have an entry in the object dictionary."	| objEntry objIndex |	objEntry _ objects at: anObject ifAbsent: [self error: 'object not in dictionary'].  "should never happen"	objIndex _ objEntry at: 1.	stream nextPut: ObjectReferenceID.	stream uint24: objIndex.! !!ScratchGlobalFetcher methodsFor: 'private' stamp: 'jm 2/3/2009 14:16' prior: 39591508!sendGetRequest	"Send an Scratch GET request."	| requestString s requestMsg i byteCount |	requestString _ '/get/', varName.	s _ WriteStream on: ByteArray new.	s uint32: requestString size.	s nextPutAll: requestString asByteArray.	requestMsg _ s contents.	i _ 1.	[socket isConnected and: [i < requestMsg size]] whileTrue: [		byteCount _ socket sendDataNoWait: requestMsg startIndex: i.		byteCount > 0 ifTrue: [i _ i + byteCount].		i < requestMsg size ifTrue: [self sleepAWhile]].! !!ScratchGraphMorph methodsFor: 'commands' stamp: 'jm 2/3/2009 14:17' prior: 39590017!loadSoundData: aCollection	| factor absV newData |	factor _ 0.	aCollection do: [:v | (absV _ v abs) > factor ifTrue: [scale _ absV]].	scale _ 100.0 / factor.	newData _ OrderedCollection new: aCollection size.	1 to: aCollection size do: [:i | newData addLast: (factor * (aCollection at: i))].	self data: newData.	self startIndex: 1.	self cursor: 1.! !!ScratchGraphMorph methodsFor: 'commands' stamp: 'jm 2/3/2009 14:19' prior: 39589079!playOnce	| factor absV scaledData |	data isEmpty ifTrue: [^ self].  "nothing to play"	factor _ 1.	data do: [:v | (absV _ v abs) > factor ifTrue: [factor _ absV]].	factor _ 32767.0 / factor.	scaledData _ SoundBuffer newMonoSampleCount: data size.	1 to: data size do: [:i |		scaledData at: i put: (factor * (data at: i)) truncated].	(SampledSound samples: scaledData samplingRate: 11025) play.! !!ScratchListMorph methodsFor: 'list ops' stamp: 'jm 2/3/2009 14:19' prior: 39558409!concatenatedLines	| isSingleLetters s |	isSingleLetters _ true.	cellMorphs do: [:m | m firstSubmorph contents size <= 1 ifFalse: [isSingleLetters _ false]].	s _ WriteStream on: (UTF8 new: 1000).	isSingleLetters		ifTrue: [			cellMorphs do: [:m | s nextPutAll: m firstSubmorph contents]]		ifFalse: [			cellMorphs do: [:m | s nextPutAll: m firstSubmorph contents; space].			s position > 0 ifTrue: [s skip: -1]].	^ s contents! !!ScratchListMorph methodsFor: 'list ops' stamp: 'jm 2/3/2009 14:20' prior: 39557051!contains: aStringOrNumber	| s |	s _ aStringOrNumber asString asUTF8.	cellMorphs do: [:m |		s = m firstSubmorph contents ifTrue: [^ true]].	^ false! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 2/3/2009 14:22' prior: 39543297!exportScriptsAsText	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| fName f |	fName _ ScratchFileChooserDialog		chooseNewFileDefault: ''		title: 'Save Scripts as Text'		type: #scriptsExport.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.txt') ifFalse: [fName _ fName, '.txt'].	f _ FileStream newFileNamed: fName.	pageViewerMorph contents submorphs do: [:m |		(m isKindOf: BlockMorph) ifTrue: [			f nextPutAll: (ScratchPrinter new printTuple: m tupleSequence).			f nextPutAll: String crlf]].	f close.! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 2/3/2009 14:23' prior: 39544470!scriptsMenu: aPosition	"Present a menu of Scratch script operations."	| menu choice |	self target ifNil: [^ self].	menu _ CustomMenu new.	menu add: 'clean up' action: #cleanUp.	menu add: 'save picture of scripts' action: #saveScriptsToImage.	menu add: 'add comment' action: #addComment:."experimental feature, disabled for now:	Sensor shiftPressed ifTrue: [		menu addLine.		menu add: 'export scripts as text' action: #exportScriptsAsText.		menu add: 'import scripts from text' action: #importScriptsFromText].xxx"	choice _ menu localize startUp.	choice ifNil: [^ self].	choice = #addComment:		ifTrue: [self perform: choice with: aPosition]		ifFalse: [self perform: choice].! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 1/26/2009 15:07' prior: 39849193!scriptsMenu: aPosition	"Present a menu of Scratch script operations."	| menu choice |	self target ifNil: [^ self].	menu _ CustomMenu new.	menu add: 'clean up' action: #cleanUp.	menu add: 'save picture of scripts' action: #saveScriptsToImage.	menu add: 'add comment' action: #addComment:.	Sensor shiftPressed ifTrue: [		menu addLine.		menu add: 'export scripts as text' action: #exportScriptsAsText.		menu add: 'import scripts from text' action: #importScriptsFromText].	choice _ menu localize startUp.	choice ifNil: [^ self].	choice = #addComment:		ifTrue: [self perform: choice with: aPosition]		ifFalse: [self perform: choice].! !DialogBoxMorph inform: 'Operation complete.'!!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 2/3/2009 14:26' prior: 39545223!importScriptsFromText	"Import textual scripts for this sprite."	| fName |	true ifTrue: [^ DialogBoxMorph inform: 'Importing scripts is not yet implemented.'].	fName _ ScratchFileChooserDialog		chooseExistingFileType: #scriptsExport		extensions: #(txt)		title: 'Import Scripts from Text'.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].! !^ DialogBoxMorph inform: 'Importing scripts is not yet implemented.'!!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 2/3/2009 14:26' prior: 39850792!importScriptsFromText	"Import textual scripts for this sprite."	| fName |	true ifTrue: [		DialogBoxMorph inform: 'Importing scripts is not yet implemented.'.		^ self].	fName _ ScratchFileChooserDialog		chooseExistingFileType: #scriptsExport		extensions: #(txt)		title: 'Import Scripts from Text'.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].! !!ScratchSoundEditor methodsFor: 'initialization' stamp: 'jm 2/3/2009 14:27' prior: 39590456!makeSliderButton: buttonExtent	| button |	button _ BorderedMorph		newBounds: (self innerBounds bottomRight - buttonExtent extent: buttonExtent)		color: Color lightGray.	button setBorderWidth: 1 borderColor: #raised.	^ button! !!ScratchSoundEditor methodsFor: 'graph ops' stamp: 'jm 2/3/2009 14:27' prior: 39590764!startTime: hrMinSecs		| secs hrs mins hms |	hms _ hrMinSecs findTokens: ' :.'.	hrs _ hms at: 1.	mins _ hms at: 2.	secs _ hms at: 3.	self startIndex: ((hrs asNumber * 3600) + (mins asNumber * 60) + secs asNumber) * samplingRate.! !----SNAPSHOT----(3 February 2009 2:30:31 pm) priorSource: 6289210!----QUIT----(3 February 2009 