ockValue.	(LastReadTime isNil or: [LastReadTime > msecs])		ifTrue: [LastReadTime _ Time millisecondClockValue].	inactiveMSecs _ msecs - LastReadTime.	inactiveMSecs > 2000 ifTrue: [self closePort].! !WeDoPlugin isOpen!WeDoPlugin readInputs!WeDoPlugin readInputs!WeDoPlugin readInputs!WeDoPlugin readInputs!WeDoPlugin readInputs!WeDoPlugin isOpen!WeDoPlugin readInputs!WeDoPlugin isOpen!WeDoPlugin readInputs!WeDoPlugin readInputs!WeDoPlugin readInputs!WeDoPlugin readInputs!!WeDoPlugin class methodsFor: 'private' stamp: 'jm 5/14/2009 08:33' prior: 41797023!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is available."	"Note: read as much data as available and take the last 8 bytes read to get the most recent values."	"Note: ID's are meaningless while the motor is running and for about a second after it has been turned off."	"self readInputs"	| buf n |	self closeIfInactive.	self isOpen ifFalse: [^ nil].	buf _ ByteArray new: 500.	n _ WeDoPlugin readInto: buf.	n < 8 ifTrue: [^ nil]. "no data"	buf _ buf copyFrom: n - 7 to: n.	LastReadTime _ Time millisecondClockValue.	self motorAIsOff ifTrue: [		PortAID _ self mapID: (buf at: 4).		PortAValue _ buf at: 3].	self motorBIsOff ifTrue: [		PortBID _ self mapID: (buf at: 6).		PortBValue _ buf at: 5].	^ {PortAID. PortBID. PortAValue. PortBValue }! !WeDoPlugin readInputs!WeDoPlugin isOpen!!WeDoPlugin class methodsFor: 'private' stamp: 'jm 5/14/2009 08:36' prior: 41037099!isOpen	"Answer true if the WeDo port is open. If it is not open, try to open it."	| isOpen |	isOpen _ self openPort notNil.	isOpen ifFalse: [].	^ isOpen! !LastReadTime _ Time millisecondClockValue!!WeDoPlugin class methodsFor: 'private' stamp: 'jm 5/14/2009 08:36' prior: 41799638!isOpen	"Answer true if the WeDo port is open. If it is not open, try to open it."	| isOpen |	isOpen _ self openPort notNil.	isOpen ifFalse: [LastReadTime _ Time millisec