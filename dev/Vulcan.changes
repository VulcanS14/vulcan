tartupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/24/2009 17:18' prior: 40381109!startup	| startupFileNames fileName arg presentationMode |	HostSystemMenus startUp.	HostSystemMenus menuBarControler reviseHostMenus.	ScriptableScratchMorph randomInit.	ScratchTranslator detectRenderPlugin.	ScratchTranslator importLanguagesList.	TakeOverScreen ifTrue: [		Smalltalk fullScreenMode: true.		DisplayScreen startUp].	NormalModeEnabled _ (Display width >= 980) & (Display height >= 555).	(NormalModeEnabled not and: [viewMode = #normal])		ifTrue: [self enterQuarterMode].	ScratchFrameMorph readShareServerEntry.	self processSettingsFile.	self updateProjectName.	shuffledCostumeNames _ nil.	author _ ''.	loginName _ ''.	loginPassword _ ''.	justSaved _ true.	presentationMode _ false.	startupFileNames _ InputSensor startupFileNames asOrderedCollection.	2 to: 10 do: [:i |		arg _ Smalltalk getSystemAttribute: i.		(arg notNil and: [arg size > 0]) ifTrue: [			startupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/24/2009 17:19' prior: 40380486!processSettingsFile	"Process settings from the Scratch.ini file."	| lang settings |	self class setVisibleDrives: nil.	lang _ nil.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		assoc key = 'language' ifTrue: [lang _ assoc value].		assoc key = 'home' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		assoc key = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/24/2009 17:20' prior: 40385301!processSettingsFile	"Process settings from the Scratch.ini file."	| lang settings k |	self class setVisibleDrives: nil.	lang _ nil.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		k _ assoc key.		k = 'language' ifTrue: [lang _ assoc value].		k = 'home' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		k = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value].		k = 'noshare' ifTrue: [self beep]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.! !ScratchFrameMorph new readSettingsFile!'foo' findTokens: '='.!!ScratchFrameMorph methodsFor: 'private' stamp: 'jm 2/24/2009 17:23' prior: 37093871!readSettingsFile	"Read my settings file and answer a Dictionary of settings."	"ScratchFrameMorph new readSettingsFile"	| f dict tokens k |	f _ FileStream readOnlyFileNamedOrNil: 'Scratch.ini'.	f ifNil: [^ Dictionary new].	dict _ Dictionary new.	f contentsOfEntireFile lines do: [:s |		tokens _ s findTokens: '='.		k _ tokens first withBlanksTrimmed asLowercase.		tokens size = 2			ifTrue: [dict at: k put: tokens second withBlanksTrimmed]			ifFalse: [dict at: k put: true]].	^ dict! !ScratchFrameMorph new readSettingsFile!!ScratchFrameMorph methodsFor: 'private' stamp: 'jm 2/24/2009 17:24' prior: 40386739!readSettingsFile	"Read my settings file and answer a Dictionary of settings."	"ScratchFrameMorph new readSettingsFile"	| f dict tokens k |	f _ FileStream readOnlyFileNamedOrNil: 'Scratch.ini'.	f ifNil: [^ Dictionary new].	dict _ Dictionary new.	f contentsOfEntireFile lines do: [:s |		tokens _ s findTokens: '='.		k _ tokens first withBlanksTrimmed asLowercase.		tokens size = 2			ifTrue: [dict at: k put: tokens second withBlanksTrimmed]			ifFalse: [dict at: k put: 1]].	^ dict! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/24/2009 17:24' prior: 40385977!processSettingsFile	"Process settings from the Scratch.ini file."	| lang settings k |	self class setVisibleDrives: nil.	lang _ nil.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		k _ assoc key.		k = 'language' ifTrue: [lang _ assoc value].		k = 'home' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		k = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value].		k = 'noshare' ifTrue: [(assoc value) = '1' ifTrue: [self beep]]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.! !ScratchFrameMorph new readSettingsFile!ScratchFrameMorph new readSettingsFile!!ScratchFrameMorph methodsFor: 'private' stamp: 'jm 2/24/2009 17:26' prior: 40387366!readSettingsFile	"Read my settings file and answer a Dictionary of settings."	"ScratchFrameMorph new readSettingsFile"	| f dict tokens k |	f _ FileStream readOnlyFileNamedOrNil: 'Scratch.ini'.	f ifNil: [^ Dictionary new].	dict _ Dictionary new.	f contentsOfEntireFile lines do: [:s |		tokens _ s findTokens: '='.		k _ tokens first withBlanksTrimmed asLowercase.		tokens size = 2			ifTrue: [dict at: k put: tokens second withBlanksTrimmed]			ifFalse: [dict at: k put: '1']].	^ dict! !ScratchFrameMorph new readSettingsFile!ScratchFrameMorph new readSettingsFile!ScratchFrameMorph new readSettingsFile!ScratchFrameMorph new readSettingsFile!ScratchFrameMorph new readSettingsFile!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/24/2009 17:27' prior: 40387961!processSettingsFile	"Process settings from the Scratch.ini file."	| lang settings k |	self class setVisibleDrives: nil.	lang _ nil.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		k _ assoc key.		k = 'language' ifTrue: [lang _ assoc value].		k = 'home' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		k = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value].		k = 'share' ifTrue: [(assoc value) = '0' ifTrue: [self beep]]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.! !ScratchFrameMorph new readSettingsFile!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 2/24/2009 17:28' prior: 40389571!processSettingsFile	"Process settings from the Scratch.ini file."	| lang settings k |	self class setVisibleDrives: nil.	lang _ nil.	AllowSharing _ true.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		k _ assoc key.		k = 'language' ifTrue: [lang _ assoc value].		k = 'home' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		k = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value].		k = 'share' ifTrue: [(assoc value) = '0' ifTrue: [AllowSharing _ false]]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/24/2009 17:31' prior: 40137739!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton buttonSpecs b |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu:		'Open, save, and share projects')		(Edit			editMenu:		'Undo the last delete')		(Share			shareMenu:		'Share this project online')		(Language		languageMenu:	'Switch languages')		(Help			helpMenu:		'Get help')	).	AllowSharing ifFalse: [		menuSpecs _ menuSpecs select: [:spec | spec second ~= #shareMenu:]].	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	"buttonSpecs defines the save and share buttons"	buttonSpecs _ #(		"name			tool tip				selector"		(save			'Save this project'	saveScratchProjectNoDialog)		(share			'Share this project'	share)	).	AllowSharing ifFalse: [		buttonSpecs _ buttonSpecs select: [:spec | spec first ~= #share]].	buttonSpecs do: [:spec |		b _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver')			offForm: (ScratchFrameMorph skinAt: (spec at: 1), 'Button')			overForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver').		b			target: self;			actionSelector: (spec at: 3);			setBalloonText: (spec at: 2) localized;			actWhen: #buttonUp;			isMomentary: true.		menuPanel addMorphBack: b.		((spec at: 1) = 'save') ifTrue: [			menuPanel addMorphBack: (Morph new extent: (8@5); color: Color transparent)]].	menuPanel addMorphBack: (Morph new extent: ((stageFrame width - 140)@5); color: Color transparent).	self addViewModeButtonsTo: menuPanel.	TakeOverScreen ifTrue: [		closeButton _ IconicButton new			labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !!ScratchFrameMorph class methodsFor: 'class initialization' stamp: 'jm 2/24/2009 17:32' prior: 40106222!initialize	"self initialize"	Clipboard _ nil.	WorkpaneExtent _ 480@360.	UseErrorCatcher _ true.	QuarterModeEnabled _ true.	NormalModeEnabled _ true.	AllowSharing _ true.	self initFonts.! !self initialize!AllowSharing!ScratchFileChooserDialog removeSelector: #scratchProjects!UserHomeFolder!ScratchPlugin primGetFolderPathOrNil: 1.!!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 17:42' prior: 40257093!userNameForHomeFolderOrNil	"Answer the name to use for the home folder. This is the user name unless the home folder location has been overridden by an entry in the Scratch.ini file."	| home delimiter |	home _ ScratchPlugin primGetFolderPathOrNil: 1.	UserHomeFolder ifNotNil: [home _ UserHomeFolder]. 	home ifNil: [^ nil].	delimiter _ FileDirectory pathNameDelimiter asString.	^ (home findTokens: delimiter) last! !UserHomeFolder!!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 17:44' prior: 40394081!userNameForHomeFolderOrNil	"Answer the name to use for the home folder. This is the user name unless the home folder location has been overridden by an entry in the Scratch.ini file."	| home delimiter |	home _ ScratchPlugin primGetFolderPathOrNil: 1.	UserHomeFolder ifNotNil: [home _ UserHomeFolder pathName]. 	home ifNil: [^ nil].	delimiter _ FileDirectory pathNameDelimiter asString.	^ (home findTokens: delimiter) last! !	home _ ScratchPlugin primGetFolderPathOrNil: 1.!UserHomeFolder!	UserHomeFolder ifNotNil: [home _ UserHomeFolder pathName]. !home!	delimiter _ FileDirectory pathNameDelimiter asString.! (home findTokens: delimiter) last!!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 17:49'!userProjects	"Sample Projects button was pressed."	(FileDirectory default directoryExists: 'Projects') ifTrue: [		list currentDirectory:			(FileDirectory default directoryNamed: 'Projects')].! !!ScratchFileChooserDialog methodsFor: 'initialization' stamp: 'jm 2/24/2009 17:50' prior: 40254861!addShortcutButtons	"Add these to my current shortcuts."	"Note: The shortcut column morph was created by initialize; I just add to its contents a new collection of shortcuts."	| backgrounds costumes sounds projects spacer homeLabel |	backgrounds _ ScratchFileChooserDialog getDefaultFolderForType: #background.	costumes _ ScratchFileChooserDialog getDefaultFolderForType: #costume.	sounds _ ScratchFileChooserDialog getDefaultFolderForType: #sound.	projects _ ScratchFileChooserDialog getDefaultFolderForType: #project.	spacer _ Morph new extent: 5@5; color: Color transparent.	shortcutColumn removeAllMorphs.	shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Computer' action: #myComp icon: #folderIcon).	shortcutColumn addMorphBack: spacer fullCopy.	homeLabel _ self userNameForHomeFolderOrNil.	homeLabel ifNil: [homeLabel _ 'Home'].	shortcutColumn addMorphBack: (self shortcutButtonLabel: homeLabel action: #myHome icon: #folderHouseIcon).	shortcutColumn addMorphBack: spacer fullCopy.	(self type = #project) & (projects isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Examples' action: #sampleProjects icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy.		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'My Projects' action: #userProjects icon: #folderIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #costume) & (costumes isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Costumes' action: #scratchCostumes icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #background) & (backgrounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Backgrounds' action: #scratchBackgrounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sound) & (sounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Sounds' action: #scratchSounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sprite) | (self type = #stage) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Scratch' action: #scratchFolder icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 17:51' prior: 40395365!userProjects	"Sample Projects button was pressed."	list currentDirectory: self class userScratchProjectsDir.! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/24/2009 17:52' prior: 40398060!userProjects	"My Projects button was pressed."	list currentDirectory: self class userScratchProjectsDir.! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 17:57' prior: 40357340!userScratchProjectsDir	"Return the path to the user's 'Scratch' project folder, usually located inside the user's 'Documents' folder. If the folder does not already exists, ttempt to create it. If the .ini file specifies an alternate home directory, create the folder there. If the directory can't be created, return the user's home folder."	| scratchFolderName homeDir |	scratchFolderName _ 'My Scratch'.  "if this were localized user could get multiple project folders for different languages..."	homeDir _  FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	UserHomeFolder ifNotNil: [homeDir _ UserHomeFolder]. "overridden by .ini file"	(homeDir directoryExists: scratchFolderName) ifFalse: [		homeDir createDirectory: scratchFolderName].	(homeDir directoryExists: scratchFolderName)		ifTrue: [^ homeDir directoryNamed: scratchFolderName]		ifFalse: [^ homeDir].! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 17:59' prior: 40398484!userScratchProjectsDir	"Return the path to the user's 'Scratch' project folder, usually located inside the user's 'Documents' folder. If the folder does not already exists, ttempt to create it. If the .ini file specifies an alternate home directory, create the folder there. If the directory can't be created, return the user's home folder."	| scratchFolderName homeDir |	scratchFolderName _ 'My Projects'.  "if this were localized user could get multiple project folders for different languages..."	homeDir _  FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	UserHomeFolder ifNotNil: [homeDir _ UserHomeFolder]. "overridden by .ini file"	(homeDir directoryExists: scratchFolderName) ifFalse: [		homeDir createDirectory: scratchFolderName].	(homeDir directoryExists: scratchFolderName)		ifTrue: [^ homeDir directoryNamed: scratchFolderName]		ifFalse: [^ homeDir].! !----SNAPSHOT----(24 February 2009 5:59:57 pm) priorSource: 6816905!----STARTUP----(24 February 2009 6:00:57 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 18:02' prior: 40399486!userScratchProjectsDir	"Return the path to the user's 'Scratch' project folder, usually located inside the user's 'Documents' folder. If the folder does not already exists, ttempt to create it. If the .ini file specifies an alternate home directory, create the folder there. If the directory can't be created, return the user's home folder."	| scratchFolderName homeDir |	scratchFolderName _ 'My Scratch Projects'.  "if this were localized user could get multiple project folders for different languages..."	homeDir _  FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	UserHomeFolder ifNotNil: [homeDir _ UserHomeFolder]. "overridden by .ini file"	(homeDir directoryExists: scratchFolderName) ifFalse: [		homeDir createDirectory: scratchFolderName].	(homeDir directoryExists: scratchFolderName)		ifTrue: [^ homeDir directoryNamed: scratchFolderName]		ifFalse: [^ homeDir].! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/24/2009 18:48' prior: 40391111!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton buttonSpecs b buttonsWidth |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu:		'Open, save, and share projects')		(Edit			editMenu:		'Undo the last delete')		(Share			shareMenu:		'Share this project online')		(Language		languageMenu:	'Switch languages')		(Help			helpMenu:		'Get help')	).	AllowSharing ifFalse: [		menuSpecs _ menuSpecs select: [:spec | spec second ~= #shareMenu:]].	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	"buttonSpecs defines the save and share buttons"	buttonSpecs _ #(		"name			tool tip				selector"		(save			'Save this project'	saveScratchProjectNoDialog)		(share			'Share this project'	share)	).	AllowSharing ifFalse: [		buttonSpecs _ buttonSpecs select: [:spec | spec first ~= #share]].	buttonsWidth _ 0.	buttonSpecs do: [:spec |		b _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver')			offForm: (ScratchFrameMorph skinAt: (spec at: 1), 'Button')			overForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver').		b			target: self;			actionSelector: (spec at: 3);			setBalloonText: (spec at: 2) localized;			actWhen: #buttonUp;			isMomentary: true.		menuPanel addMorphBack: b.		buttonsWidth _ buttonsWidth + b width.		'save' = (spec at: 1) ifTrue: [			menuPanel addMorphBack: (Morph new extent: (8@5); color: Color transparent).			buttonsWidth  _ buttonsWidth + menuPanel submorphs last width]].	menuPanel addMorphBack: (Morph new extent: ((stageFrame width - 140)@5); color: Color transparent).	self addViewModeButtonsTo: menuPanel.	TakeOverScreen ifTrue: [		closeButton _ IconicButton new			labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/24/2009 18:50' prior: 40401660!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton buttonSpecs b buttonsWidth |	"create panel"	menuPanel _ AlignmentMo