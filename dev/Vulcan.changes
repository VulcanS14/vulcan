cess."	| blockList proc |	blockList _ aBlock blockSequence.	aBlock isHatBlock ifTrue: [blockList _ blockList allButFirst].  "omit hat block"	proc _ ScratchProcess new		topBlock: aBlock;		expression: blockList.	processes addLast: proc.	^ proc! !!CommandBlockMorph methodsFor: 'processes' stamp: 'jm 12/21/2008 12:25' prior: 34351444!start	| stage |	self stop.	self receiver ifNil: [^ self].	scratchProc ifNotNil: [^ self].  "this stack is already running"	(stage _ self receiver ownerThatIsA: ScratchStageMorph) ifNil: [^ self].	scratchProc _ stage startProcessFor: self.	self changed.! !!EventHatMorph methodsFor: 'other' stamp: 'jm 12/21/2008 12:25' prior: 34640086!startForEvent: aScratchEvent	"Starts a process for this event hat triggered by the given event. Answer the process that was started or nil if no new process was started."	"Details: The current policy is to stop and re-start the script for all events except key-pressed. Key-pressed events are just ignored if the script for that event is already running."	| stage |	(aScratchEvent name = 'Scratch-KeyPressedEvent') ifFalse: [		scratchProc ifNotNil: [self stop]].  "non-key events stop currently running process, if any"	self isRunning ifTrue: [^ nil].  "don't re-trigger if running"	scriptOwner ifNil: [^ nil].	(stage _ scriptOwner ownerThatIsA: ScratchStageMorph) ifNil: [^ nil].	scratchProc _ stage startProcessFor: self.	self changed.	^ scratchProc! !!HatBlockMorph methodsFor: 'processes' stamp: 'jm 12/21/2008 12:25' prior: 35168967!start	| stage |	self stop.	scratchProc ifNil: [		scriptOwner ifNil: [^ self].		(stage _ self receiver ownerThatIsA: ScratchStageMorph) ifNil: [^ self].		scratchProc _ stage startProcessFor: self.		self changed].! !ScratchStageMorph removeSelector: #startProcessForStatements:!!ScratchProcess methodsFor: 'accessing' stamp: 'jm 11/20/2003 11:12' prior: 39289165!expression: expression	"Sets the expression to evaluate. This can be a single b