mp: '' prior: 36978538!addDriveShortcuts: menu	"Add shortcuts to the file picker menu."	| drives visible |	"Include drives"	menu addLine.	(FileDirectory default isKindOf: WinFileDirectory)		ifTrue: [  "Windows"			drives _ (FileDirectory on: '') directoryNames.			drives _ drives copyWithout: 'Network'.			drives _ drives copyWithout: 'automount/Servers'.			(visible _ ScratchFrameMorph visibleDrives) ifNotNil: [				drives _ drives select: [:drive | visible includes: drive asUppercase]].			drives do: [:drive | menu add: drive action: drive]]		ifFalse: [  "Mac OS X"			drives _ (FileDirectory on: '/Volumes') directoryNames.			(visible _ ScratchFrameMorph visibleDrives) ifNotNil: [				drives _ drives select: [:drive | visible includes: drive asUppercase]].			drives _ drives do: [:drive |				menu add: drive action: '/Volumes/', drive]].! !!ScratchFilePicker methodsFor: 'private' stamp: '' prior: 40426829!navigationForbidden	"Answer true if navigating the file hierarch is forbidden because there is a visibledrives entry in the Scratch.ini file."	| thisDrive pathParts |	ScratchFrameMorph visibleDrives ifNil: [^ false].	thisDrive _ ''.	pathParts _ currentDir pathParts.	pathParts size > 0 ifTrue: [thisDrive _ pathParts first asUppercase].	((thisDrive = 'volumes') and: [pathParts size > 1]) ifTrue: [		thisDrive _ pathParts second asLowercase].	(ScratchFrameMorph visibleDrives includes: thisDrive) ifTrue: [^ false].	self beep.	^ true! !!ScratchFilePicker methodsFor: 'private' stamp: '' prior: 36991464!getLocalDirectoryNames	"Answer the directories in currentDir. Suppress hidden volumes."	| dirNames visible |	dirNames _ currentDir directoryNames.	(visible _ ScratchFrameMorph visibleDrives) ifNil: [^ dirNames].	Smalltalk isMacOSX		ifTrue: [currentDir pathName = '/Volumes' ifFalse: [^ dirNames]]		ifFalse: [currentDir pathName = '' ifFalse: [^ dirNames]].	^ dirNames select: [:dir | visible includes: dir asUppercase]! !!ScratchFrameMorph class methodsFor: 'utilities' stamp: 'jm 3/17/2009 21:51' prior: 40907906!setVisibleDrives: driveListString	"Set my set of visible drives. If the argument is nil, then all drives are made visible."	| in drive |	VisibleDrives _ nil.	driveListString ifNil: [^ self].	VisibleDrives _ OrderedCollection new.	in _ ReadStream on: driveListString.	[in atEnd] whileFalse: [		in skipSeparators.		drive _ (in upTo: $,) withBlanksTrimmed.		Smalltalk isWindows ifTrue: [drive _ drive asUppercase].		drive size > 0 ifTrue: [VisibleDrives addLast: drive]].	VisibleDrives size > 0		ifTrue: [VisibleDrives _ VisibleDrives asArray]		ifFalse: [VisibleDrives _ nil].! !!ScratchFilePicker methodsFor: 'private' stamp: 'jm 3/17/2009 21:54' prior: 40908522!addDriveShortcuts: menu	"Add shortcuts to the file picker menu."	| drives visible |	"Include drives"	menu addLine.	(FileDirectory default isKindOf: WinFileDirectory)		ifTrue: [  "Windows"			drives _ (FileDirectory on: '') directoryNames.			drives _ drives copyWithout: 'Network'.			drives _ drives copyWithout: 'automount/Servers'.			(visible _ ScratchFrameMorph visibleDrives) ifNotNil: [				drives _ drives select: [:drive | visible includes: drive asUppercase]].			drives do: [:drive | menu add: drive action: drive]]		ifFalse: [  "Mac OS X"			drives _ (FileDirectory on: '/Volumes') directoryNames.			(visible _ ScratchFrameMorph visibleDrives) ifNotNil: [				visible _ visible collect: [:v | v asUppercase].				drives _ drives select: [:drive | visible includes: drive asUppercase]].			drives _ drives do: [:drive |				menu add: drive action: '/Volumes/', drive]].! !!ScratchFilePicker methodsFor: 'private' stamp: 'jm 3/17/2009 21:58' prior: 40909432!navigationForbidden	"Answer true if navigating the file hierarch is forbidden because there is a visibledrives entry in the Scratch.ini file."	| thisDrive pathParts |	ScratchFrameMorph visibleDrives ifNil: [^ false].	thisDrive _ ''.	pathParts _ currentDir pathParts.	pathParts size > 0 ifTrue: [thisDrive _ pathParts first asUppercase].	Smalltalk isMacOS ifTrue: [		((thisDrive = 'volumes') and: [pathParts size > 1]) ifTrue: [			thisDrive _ pathParts second asUppercase]].	(ScratchFrameMorph visibleDrives includes: thisDrive) ifTrue: [^ false].	self beep.	^ true! !!ScratchFrameMorph class methodsFor: 'utilities' stamp: 'jm 3/17/2009 21:59' prior: 40910581!setVisibleDrives: driveListString	"Set my set of visible drives. If the argument is nil, then all drives are made visible."	| in drive |	VisibleDrives _ nil.	driveListString ifNil: [^ self].	VisibleDrives _ OrderedCollection new.	in _ ReadStream on: driveListString.	[in atEnd] whileFalse: [		in skipSeparators.		drive _ (in upTo: $,) withBlanksTrimmed asUppercase.		drive size > 0 ifTrue: [VisibleDrives addLast: drive]].	VisibleDrives size > 0		ifTrue: [VisibleDrives _ VisibleDrives asArray]		ifFalse: [VisibleDrives _ nil].! !!ScratchFilePicker methodsFor: 'private' stamp: 'jm 3/17/2009 22:00' prior: 40911262!addDriveShortcuts: menu	"Add shortcuts to the file picker menu."	| drives visible |	"Include drives"	menu addLine.	(FileDirectory default isKindOf: WinFileDirectory)		ifTrue: [  "Windows"			drives _ (FileDirectory on: '') directoryNames.			drives _ drives copyWithout: 'Network'.			drives _ drives copyWithout: 'automount/Servers'.			(visible _ ScratchFrameMorph visibleDrives) ifNotNil: [				drives _ drives select: [:drive | visible includes: drive asUppercase]].			drives do: [:drive | menu add: drive action: drive]]		ifFalse: [  "Mac OS X"			drives _ (FileDirectory on: '/Volumes') directoryNames.			(visible _ ScratchFrameMorph visibleDrives) ifNotNil: [				drives _ drives select: [:drive | visible includes: drive asUppercase]].			drives _ drives do: [:drive |				menu add: drive action: '/Volumes/', drive]].! !!ScratchFrameMorph class methodsFor: 'utilities' stamp: 'jm 3/17/2009 22:02' prior: 40912922!setVisibleDrives: driveListString	"Set my set of visible drives. If the argument is nil, then all drives are made visible."	| in drive |	VisibleDrives _ nil.	driveListString ifNil: [^ self].	VisibleDrives _ OrderedCollection new.	in _ ReadStream on: driveListString.	[in atEnd] whileFalse: [		in skipSeparators.		drive _ (in upTo: $,) withBlanksTrimmed.		drive size > 0 ifTrue: [VisibleDrives addLast: drive asUppercase]].	VisibleDrives size > 0		ifTrue: [VisibleDrives _ VisibleDrives asArray]		ifFalse: [VisibleDrives _ nil].! !----QUIT----(17 March 2009 10:02:50 pm) priorSource: 7353017!----STARTUP----(18 March 2009 6:33:52 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SAVEAS MITBaseTemp----(18 March 2009 6:34:42 am)!----STARTUP----(18 March 2009 6:47:24 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!PNGReadWriter class methodsFor: 'as yet unclassified' stamp: 'jm 3/18/2009 06:53'!writeTestToFileNamed: fileName	"Write a tiny 32-bit PNG image to a new file with the given name."	"self writeTestToFileNamed: 'test.png'"	| form |	form _ Form extent: 5@1 depth: 32.	form colorAt: 0@0 put: Color red.	form colorAt: 1@0 put: Color green.	form colorAt: 2@0 put: Color blue.	form colorAt: 3@0 put: Color black.	form colorAt: 4@0 put: Color white.	(form magnifyBy: 20) display.	self putForm: form onFileNamed: fileName.! !self writeTestToFileNamed: 'test.png'!self writeTestToFileNamed: 'test.png'!	(ZLibReadStream on: #(120 1 99 248 207 0 68 32 200 240 31 136 25 255 131 0 0) asByteArray) upToEnd!!PNGReadWriter class methodsFor: 'as yet unclassified' stamp: 'jm 3/18/2009 07:04' prior: 40915436!writeTestToFileNamed: fileName	"Write a tiny 32-bit PNG image to a new file with the given name."	"self writeTestToFileNamed: 'test.png'"	| form |	form _ Form extent: 5@1 depth: 32.	form colorAt: 0@0 put: Color red.	form colorAt: 1@0 put: Color green.	form colorAt: 2@0 put: Color blue.	form colorAt: 3@0 put: Color black.	form colorAt: 4@0 put: Color white.	(form magnifyBy: 20) display.	self putForm: form onFileNamed: fileName."Debugging notes:The generated file does not display correctly on Mac OS X (tested on 10.5.5) and Firefox says it is a broken image. It does open correctly on Windows. On either Mac and Windows, opening and re-saving the image results in a file that does display on Mac OS.The problem appears to be how the data chunk ('IDAT' = #(73 68 65 84) asByteArray) is compressed. Here is the payload of this chunk as written by Squeak: vs. several other programs (e.g. Preview on Mac and Paint on Windows): rgbSqueak:		120 1 99 248 207 0 68 32 200 240 31 136 25 255 131 0 0rgbMac:			8 29 99 248 207 192 240 31 12 25 254 3 153 140 255 65 0 0 98 184 10 247rgbWin:			24 87 99 248 207 192 240 31 12 25 254 3 49 227 127 16 0 0 98 184 10 247Note that Squeak decompressses all three sequences to the same bytes. For example:	(ZLibReadStream on: #(120 1 99 248 207 0 68 32 200 240 31 136 25 255 131 0 0) asByteArray) upToEndIt appears that Squeak is using a non-standard zlib setting. See the Deflate/Inflate section of the PNG spec:  http://www.libpng.org/pub/png/spec/1.2/PNG-Contents.html"! !!PNGReadWriter methodsFor: 'writing' stamp: 'jm 3/18/2009 07:08' prior: 40875221!writeType6DataOn: zStream	"Write RGBA data."	"NOTE: This is a work-around for a bug that reversed R and B. But this code is slower than the BitBlt code it replaces so this should be revisited."	| transparentRGBA bits pix |	transparentRGBA _ #(0 0 0 0) asByteArray.	bits _ form bits.	form depth < 32 ifTrue: [bits _ (form asFormOfDepth: 32) bits].	1 to: bits size do: [:i |		(i \\ form width) = 1 ifTrue: [zStream nextPut: 0]. "insert filterType at start of each scanline"		pix _ bits at: i.		pix = 0			ifTrue: [zStream nextPutAll: transparentRGBA]			ifFalse: [				zStream nextPut: ((pix bitAnd: 16rFF0000) bitShift: -16).				zStream nextPut: ((pix bitAnd: 16rFF00) bitShift: -8).				zStream nextPut: (pix bitAnd: 16rFF).				zStream nextPut: 16rFF]].	zStream close.! !!ReporterBlockMorph methodsFor: 'other' stamp: 'jm 3/18/2009 07:10' prior: 40884337!doubleClick: evt	"Reporter blocks ignore double-clicks."	(self topBlock isKindOf: ReporterBlockMorph) ifFalse: [super doubleClick: evt].! !ReporterBlockMorph removeSelector: #doubleClick:!	menu _ CustomMenu new.	menu add: 'apples' action: #apples.	menu add: 'oran�ges' action: #oranges.	menu startUp: #apples!----QUIT----(18 March 2009 7:16:27 am) priorSource: 7360607!----STARTUP----(18 March 2009 7:21:45 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 11 March 2009 at 1:57:03 am'!!SimpleButtonMorph methodsFor: 'events' stamp: 'jens 3/11/2009 01:54' prior: 37879582!showBalloon: msg	| w worldBounds tooltip |	w _ self world.	tooltip _ ScratchToolTipMorph string: msg for: self.	w addMorphFront: tooltip "(w activeHand position + tooltip offset)".	self drawToolTipAbove		ifTrue: [tooltip position: self topLeft - (0@tooltip height)]		ifFalse: [tooltip position: self bottomLeft + (0@8)].	worldBounds _ 0@0 rect: Display extent.	(worldBounds containsRect: tooltip bounds) ifFalse: [		tooltip bounds: (tooltip bounds translatedToBeWithin: worldBounds).		(tooltip bounds intersects: w activeHand bounds) ifTrue: [tooltip left: w activeHand bounds right].		(worldBounds containsRect: tooltip bounds) ifFalse: [			tooltip bounds: (tooltip bounds translatedToBeWithin: worldBounds).			(tooltip bounds intersects: w activeHand bounds) ifTrue: [tooltip right: w activeHand bounds left - 8]]].! !'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 9 March 2009 at 10:38:50 pm'!!SpriteHandleMorph methodsFor: 'accessing' stamp: 'jens 3/9/2009 22:37' prior: 39207991!target: aSprite	"show me"	| stage tb x |	target _ aSprite.	stage _ target ownerThatIsA: ScratchStageMorph.	tb _ self targetBounds.	"make sure the target sprite is onstage"	stage notNil & stage fullContainsPoint: target center.	(stage notNil and: [stage bounds containsPoint: target center]) ifFalse: [		target referencePosition: 0@0.		tb _ self targetBounds].	self	openInWorld.	#resize = type		ifTrue: [			target xpos > 0				ifTrue: [					reversed _ true.					x _ tb left]				ifFalse: [x _ tb right].			^self center: x @ tb center y].	(target xpos > 0 & (target heading > 0))		ifTrue: [			reversed _ true.			self position: (tb center + (Point r: (tb width/2) degrees: target rotationDegrees + 180))]		ifFalse: [self center: (tb center + (Point r: (tb width/2) degrees: target rotationDegrees))].! !----SNAPSHOT----(18 March 2009 7:26:37 am) priorSource: 7364552!----SNAPSHOT----(18 March 2009 7:27:28 am) priorSource: 7366742!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 9 March 2009 at 1:47:33 pm'!PasteUpMorph subclass: #ScratchScriptsMorph	instanceVariableNames: 'feedbackMorph screenshooting '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Panes'!!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jens 3/9/2009 13:19' prior: 40324005!saveScriptsToImage	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| fName saveForm |	saveForm _ pageViewerMorph contents screenshot.	fName _ ScratchFileChooserDialog		chooseNewFileDefault: ''		title: 'Save Scripts Snapshot'		type: #scriptsSnapshot.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.gif') ifFalse: [fName _ fName, '.gif'].	saveForm writeGIFFileNamed: fName.! !!ScratchScriptsMorph methodsFor: 'drawing' stamp: 'jens 3/9/2009 13:25' prior: 37310722!drawOn: aCanvas	"Fill with my texture patch. Fill with a solid color if there is no texture in the current skin dictionary."	| patchF clipC y x |	self isScreenshooting ifTrue: [		aCanvas fillRectangle: self bounds color: Color transparent.		^ self].	patchF _ ScratchFrameMorph skinAt: #scriptsPaneTexture ifAbsent: [		aCanvas fillRectangle: self bounds color: color.		^ self].	clipC _ aCanvas copyClipRect: self bounds.	y _ self top.	[y <= self bottom] whileTrue: [		x _ self left.		[x <= self right] whileTrue: [			clipC paintImage: patchF at: x@y.			x _ x + patchF width].		y _ y + patchF height].! !!ScratchScriptsMorph methodsFor: 'screenshot' stamp: 'jens 3/9/2009 13:02'!isScreenshooting	^ screenshooting ifNil: [screenshooting _ false]! !!ScratchScriptsMorph methodsFor: 'screenshot' stamp: 'jens 3/9/2009 13:44'!screenshot	"answer a Form of myself apt for exporting"	| saveForm leftX topY rightX bottomY |	screenshooting _ true.	self changed.	saveForm _ self imageForm.	"clip"	leftX _ submorphs anyOne left.	topY _ submorphs anyOne top.	rightX _ submorphs anyOne right.	bottomY _ submorphs anyOne bottom.	(self allMorphs select: [:m | m ~= self]) do: [:m |		leftX _ leftX min: m left.		topY _ topY min: m top.		rightX _ rightX max: m right.		bottomY _ bottomY max: m bottom].	saveForm _ saveForm copy: (((leftX @ topY) - self position) rect: ((rightX @ bottomY) - self position)).	screenshooting _ false.	self changed.	^ saveForm! !----QUIT----(18 March 2009 8:05:57 am) priorSource: 7366808!----STARTUP----(18 March 2009 8:06:20 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SNAPSHOT----(18 March 2009 8:07:41 am) priorSource: 7369296!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 3/18/2009 08:10' prior: 40597597!editMenu: aMenuTitleMorph	| menu |	menu _ CustomMenu new.	menu add: 'Undelete' action: #undoTool.	menu addLine.	menu add: 'Compress Sounds' action: #compressSounds.	menu add: 'Compress Images' action: #compressImages.true ifTrue: [ "disabled for beta:"	menu addLine.	workPane showMotorBlocks		ifTrue: [menu add: 'Hide Motor Blocks' action: #hideMotorBlocks]		ifFalse: [menu add: 'Show Motor Blocks' action: #showMotorBlocks].].	menu localize.	#(2 3) do: [:n |		menu labels at: n put:			((menu labels at: n) copyFrom: 1 to: (menu labels at: n) size - 1), ScratchTranslator ellipsesSuffix].	menu invokeOn: self at: aMenuTitleMorph bottomLeft + (0@10).! !----QUIT----(18 March 2009 8:10:56 am) priorSource: 7369455!----STARTUP----(18 March 2009 9:27:14 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!(FileStream oldFileNamed: 'allJens2.cs') binary contentsOfEntireFile select: [:n | n > 12]!(FileStream oldFileNamed: 'allJens2.cs') binary contentsOfEntireFile select: [:n | n > 127]!#(194 160) asByteArray asString!#(194 160) asByteArray asString!(FileStream oldFileNamed: 'allJens2.cs') binary contentsOfEntireFile select: [:n | n > 127]!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 11 March 2009 at 9:25:56 pm'!StringMorph subclass: #ScratchMenuTitleMorph	instanceVariableNames: 'target selector '	classVariableNames: 'MenuBarIsActive '	poolDictionaries: ''	category: 'Scratch-UI-Support'!!HandMorph methodsFor: 'event handling' stamp: 'jens 3/9/2009 00:55' prior: 39203126!handleMouseDown: evt	"Dispatch a mouseDown event."	| p m localEvt rootForGrab aHalo |	"if carrying morphs, just drop them"	self hasSubmorphs ifTrue: [^ self dropMorphsEvent: evt].	clickState ~~ #idle ifTrue: [^ self checkForDoubleClick: evt].	(keyboardFocus notNil and: [Preferences noviceMode]) ifTrue: [		"clear keyboard focus if click is outside the focus morph (needed for Scratch)"		p _ (keyboardFocus transformFromWorld) transform: evt cursorPoint.		(keyboardFocus bounds containsPoint: p) ifFalse: [			self newKeyboardFocus: nil]].	m _ self recipientForMouseDown:		(grid  "Don't grid when determining recipient"			ifNil: [evt]			ifNotNil: [  "Should really use original cursorPoint, but this will do"				evt copy setCursorPoint: Sensor cursorPoint]).	m ifNotNil: [		(m isKindOf: SpriteHandleMorph) ifFalse: [SpriteHandleMorph vanish]. "needed for Scratch"		(ScratchMenuTitleMorph menuBarIsActive and: [			(m isKindOf: MenuItemMorph) not])				ifTrue: [ ScratchMenuTitleMorph closeAllMenus ].		aHalo _ self world haloMorphOrNil.		(aHalo isNil or: [aHalo staysUpWhenMouseIsDownIn: m])			ifFalse: [self world abandonAllHalos].		m deleteBalloon.		(m handlesMouseDown: evt)			ifTrue:				["start a mouse transaction on m"				(self newMouseFocus: m) ifNil: [^ self].				localEvt _ self transformEvent: evt.				targetOffset _ localEvt cursorPoint - m position.				m mouseDown: localEvt.				clickState == #firstClickDown ifFalse: [					"ensure that at least one mouseMove: is reported for each mouse transaction:"					(mouseDownMorph == m) ifTrue: [						m mouseMove: (localEvt copy setType: #mouseMove)].					(m handlesMouseOverDragging: localEvt) ifTrue:						["If m also handles dragOver, enter it in the list"						dragOverMorphs add: m.						mouseOverMorphs remove: m ifAbsent: []]]]			ifFalse:				["grab m by the appropriate root"				menuTargetOffset _ targetOffset _ evt cursorPoint.				rootForGrab _ m rootForGrabOf: m.				rootForGrab ifNotNil: [self grabMorph: rootForGrab]].		mouseOverTimes removeKey: m ifAbsent: []].! !!ScratchMenuTitleMorph methodsFor: 'event handling' stamp: 'jens 3/7/2009 22:24' prior: 40137501!mouseDown: evt	target isNil | selector isNil ifTrue: [^ self].	Cursor normal show.	MenuBarIsActive _ true.	target perform: selector with: self.  "invoke my menu"! !!ScratchMenuTitleMorph methodsFor: 'event handling' stamp: 'jens 3/7/2009 22:44' prior: 40122992!mouseEnter: evt	self color: self highlightColor.	self class menuBarIsActive ifTrue: [		self class closeAllMenus.		MenuBarIsActive _ true.		target perform: selector with: self ]  "invoke my menu"! !!ScratchMenuTitleMorph class methodsFor: 'as yet unclassified' stamp: 'jens 3/11/2009 21:25'!closeAllMenus	self menuBarIsActive ifFalse: [^self ].	World submorphs do: [:m |		(m isKindOf: MenuMorph) ifTrue: [m deleteIfPopUp]].	MenuBarIsActive _ false.! !!ScratchMenuTitleMorph class methodsFor: 'as yet unclassified' stamp: 'jens 3/7/2009 22:22'!menuBarIsActive	^ MenuBarIsActive ifNil: [MenuBarIsActive _ false].! !ScratchMenuTitleMorph removeSelector: #closeOtherMenus!ScratchMenuTitleMorph removeSelector: #closeOtherMenus!----QUIT----(18 March 2009 9:32:36 am) priorSource: 7370295!----STARTUP----(18 March 2009 9:32:54 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!(FileStream oldFileNamed: 'Evelyn-Mar17.1.cs') binary contentsOfEntireFile select: [:n | n > 127]!#(165) asByteArray asString!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 17 March 2009 at 6:07:46 pm'!Morph subclass: #ScratchFrameMorph	instanceVariableNames: 'topPane viewerPane scriptsPane stageFrame workPane titlePane libraryPane menuPanel buttonPanel readoutPane logoMorph projectTitleMorph flagButton fillScreenFlag paintingInProgress projectDirectory projectName projectInfo author loginName loginPassword watcherPositions shuffledCostumeNames justSaved viewModeButtons viewMode lastViewMode viewModeButtonsPanel stageButtonsPanel shortcutButtonsPanel '	classVariableNames: 'AllowSharing Clipboard DefaultNotes DefaultSprite Fonts FontsXO IsXO NormalModeEnabled QuarterModeEnabled ScratchServers ScratchSkin ScratchSkinXO ShareServer ShareServerPath SupportServer SupportServerPath TakeOverScreen UseErrorCatcher Version VersionDate VisibleDrives WorkpaneExtent '	poolDictionaries: ''	category: 'Scratch-UI-Panes'!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 3/17/2009 16:40' prior: 40604942!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector"		(File			fileMenu:)		(Edit			editMenu:)		(Share			shareMenu:)		(Language		languageMenu:)		(Help			helpMenu:)	).	AllowSharing ifFalse: [		menuSpecs _ menuSpecs select: [:spec | spec second ~= #shareMenu:]].	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2).		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	TakeOverScreen ifTrue: [		closeButton _ IconicButton new			labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 3/17/2009 18:07'!createShortcutButtonsPanel	| buttonSpecs buttonsWidth b |	shortcutButtonsPanel _ AlignmentMorph newRow color: Color transparent.	"buttonSpecs defines the save and share buttons"	buttonSpecs _ #(		"name			tool tip				selector"		(save			'Save this project'	saveScratchProjectNoDialog)		(share			'Share this project'	share)	).	AllowSharing ifFalse: [		buttonSpecs _ buttonSpecs select: [:spec | spec first ~= #share]].	buttonsWidth _ 0.	buttonSpecs do: [:spec |		b _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver')			offForm: (ScratchFrameMorph skinAt: (spec at: 1), 'Button')			overForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver').		b			target: self;			actionSelector: (spec at: 3);			setBalloonText: (spec at: 2) localized;			actWhen: #buttonUp;			isMomentary: true.		shortcutButtonsPanel addMorphBack: b.		buttonsWidth _ buttonsWidth + b width.		'save' = (spec at: 1) ifTrue: [			shortcutButtonsPanel addMorphBack: (Morph new extent: (8@5); color: Color transparent).			buttonsWidth _ buttonsWidth + menuPanel submorphs last width]].	self addMorph: shortcutButtonsPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 3/17/2009 16:36'!createStageButtonsPanel	"Create and add a panel containing the project title, green flag, and stop buttons."	| buttonSpecs bName button |	"create panel"	stageButtonsPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		height: 20.	projectTitleMorph _ StringMorph new		forceUnicodeRendering: true;		contents: '';		font: (ScratchFrameMorph getFont: #FrameMorphProjectTitle).	stageButtonsPanel		addMorphBack: projectTitleMorph;		addMorphBack: (AlignmentMorph newSpacer: Color transparent).	"buttonSpecs defines the toolbar buttons; first is icon name, second is selector"	buttonSpecs _ #(		"name	selector		tool tip"		(go		shoutGo		'Start green flag scripts')		(stop	stopAll		'Stop everything')).	buttonSpecs do: [:spec |		bName _ spec first.		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (bName, 'ButtonGrayPressed') asSymbol)			offForm: (ScratchFrameMorph skinAt: (bName, 'ButtonGray') asSymbol)			overForm: (ScratchFrameMorph skinAt: (bName, 'ButtonGrayPressed') asSymbol).		button			target: self;			actionSelector: (spec at: 2);			isMomentary: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		stageButtonsPanel addMorphBack: button.		bName = #go ifTrue: [			flagButton _ button.			stageButtonsPanel addMorphBack: (Morph new color: Color transparent; extent: 2@5)]].	titlePane addMorph: stageButtonsPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 3/17/2009 16:44'!createViewModeButtonsPanel	| specs bName button |	viewModeButtonsPanel _ AlignmentMorph newRow color: Color transparent.	viewModeButtons _ OrderedCollection new.	specs _ OrderedCollection new.	ScratchFrameMorph quarterModeEnabled ifTrue: [		specs add: #(quarter		enterQuarterMode	'Switch to small stage view')].	ScratchFrameMorph normalModeEnabled ifTrue: [		specs add: #(normal		enterNormalMode	'Switch to full stage view')].	specs add: #(presentation	enterPresentationMode	'Switch to presentation view').	specs do: [:spec |		bName _ spec first.		button _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOn')			offForm: (ScratchFrameMorph skinAt: bName, 'ViewMode')			overForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		viewModeButtonsPanel			addMorphBack: button;			addMorphBack: (Morph new extent: 1@5; color: Color transparent).		viewModeButtons add: button].	self addMorph: viewModeButtonsPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 3/17/2009 16:41' prior: 40087432!initialize	super initialize.	fillScreenFlag _ false.	paintingInProgress _ false.	projectInfo _ Dictionary new.	watcherPositions _ Dictionary new.	justSaved _ false.	author _ ''.	loginName _ ''.	loginPassword _ ''.	viewMode _ #normal.	self createBasicPanes.	self createLogo.	self createMenuPanel.	self createShortcutButtonsPanel.	self createViewModeButtonsPanel.	self createStageButtonsPanel.	self extent: 1000@600.! !!ScratchFrameMorph methodsFor: 'geometry' stamp: 'ee 3/17/2009 17:36' prior: 40320799!fixLayout	| stageExtent xyReadout |	stageExtent _		workPane isQuarterSize			ifTrue: [workPane extent // 2]			ifFalse: [workPane extent].	topPane		position: self topLeft;		width: self width;		height: (menuPanel height + 0 max: logoMorph height + 10).	stageFrame		extent: stageExtent + (14@42);		top: topPane bottom;		right: self right.	workPane position: stageFrame topLeft + (4@37).	titlePane		position: stageFrame topLeft + (0@1);		width: stageFrame width - 6;		height: 36.	self fixProjectTitleMorphLayout.	viewerPane position: topPane bottomLeft;		width: viewerPane catButtonsExtent x + 17;		height: self bottom - topPane bottom."Disable palette hiding:	self hidePalette: ((self width - (stageExtent x + viewerPane width)) < 180).xxx"	viewerPane owner isNil		ifTrue: [			scriptsPane position: topPane bottomLeft;				width: self width - stageFrame width;				height: self bottom - topPane bottom]		ifFalse: [			scriptsPane position: viewerPane topRight;				width: self width - (stageFrame width + viewerPane width);				height: self bottom - topPane bottom].	scriptsPane fixLayout.	libraryPane position: stageFrame bottomLeft;		width: (self right - scriptsPane right);		height: self bottom - libraryPane top.	menuPanel		left: logoMorph right + 18;		top: topPane top + ((topPane height - menuPanel height) // 2) + 2;		width: (self right - menuPanel left) - 15.	shortcutButtonsPanel		left: stageFrame left;		top: self top + 10.	TakeOverScreen		ifTrue: [viewModeButtonsPanel			right: stageFrame right - 35;			top: self top + 7]		ifFalse: [viewModeButtonsPanel			right: stageFrame right - 8;			top: self top + 7].	stageButtonsPanel		position: (stageFrame left + 10)@(topPane bottom + 5);		height: (workPane top - stageFrame top) - 8;		width: stageFrame width - 28.	xyReadout _ readoutPane submorphs at: 1.	readoutPane		width: xyReadout width + 23;		height: xyReadout height + 15;		position: stageFrame bottomRight - ((readoutPane width + 6)@3).	xyReadout position: readoutPane position + (18@5).! !!ScratchFrameMorph methodsFor: 'private' stamp: 'ee 3/17/2009 17:47' prior: 39886239!updatePanes	| p |	menuPanel delete.	self createMenuPanel.	shortcutButtonsPanel delete.	self createShortcutButtonsPanel.	viewModeButtonsPanel delete.	self createViewModeButtonsPanel.	stageButtonsPanel delete.	self createStageButtonsPanel.	titlePane addMorph: stageButtonsPanel.	scriptsPane tabPane delete.	scriptsPane createTabPane.	readoutPane delete.	self createReadoutPane.	workPane sensorBoard owner		ifNil: [p _ nil]		ifNotNil: [p _ workPane sensorBoard position].	workPane resetSensorBoard.	p ifNotNil:[		self showSensorBoard		workPane sensorBoard position: p].	libraryPane clearLibrary.	self scratchWatchers do: [:w | w languageChanged].	self listWatchers do: [:w | w fixLayoutForNewLanguage].	World startSteppingSubmorphsOf: self.	self fixLayout.	scriptsPane fixLayout.	self updateViewModeButtons.! !!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'ee 3/17/2009 17:43' prior: 39886953!clearLibrary	| sFrame |	"Remove all library items. My step method will re-add items for existing objects."	stagePane removeAllMorphs.	scrollPane contents removeAllMorphs.	scrollPane vScrollRelative: 0.	spriteLabel delete.	spriteLabel _ StringMorph new contents: 'Sprites' localized.	spriteLabel		font: (ScratchFrameMorph getFont: #Tab);		color: Color white.	sFrame _ self ownerThatIsA: ScratchFrameMorph.	(sFrame isNil or: [sFrame viewMode = #normal])		ifTrue: [self addMorph: spriteLabel].	buttonPane delete.	buttonPane _ self makeNewSpriteButtons.	self addMorph: buttonPane.	topSectionHeight _ (((spriteLabel stringHeight: 'Sprites' localized) + 10) max: 40).	self fixLayout.! !!ScratchTranslator class methodsFor: 'language translation' stamp: 'ee 3/17/2009 17:44' prior: 40696200!resetUITranslationSet	UITranslationSet _ Set new.	#('Normal' 'new' 'New' 't' 'New sound:' 'No' 'New Filename:' 'New background:' 'New costume:' 'No motion blocks' 'OK' 'New Sprite' '3' 'No variables.' 'no scripts' 'm' 'normal readout' 'No serial ports found' 'No MIDI ports currently available.' 'Open' 'Off' 'f' 'Open Project' 'On' 'Preparing project...' 'or' 'Open a Scratch project' 'only face left-right' '10 ^' '10' 'play' 'Pictures' 'Password:' 'Project Notes' 'Project notes' 'Paint' 'pop' 'Project uploaded.' 'u' 'Project name' 'Please enter a number' 'Paint Editor' 'Projects' 'Paintbrush' 'pixelate' 'Project author:' 'Paint new sprite' 'Percent? (100 gives original size)' '4' 'n' 'abs' 'atan' 'Position the cross-hair to set the rota