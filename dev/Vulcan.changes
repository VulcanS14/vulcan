ername' value: userName to: s.	self add: 'password' value: password to: s.	self add: 'scratchkey' value: 'ch4ng3me' to: s.	self add: 'project_name' value: projectName asUTF8 to: s.	self add: 'project_description' value: projectNotes asUTF8 to: s.	self add: 'project_history' value: self projectHistoryString asUTF8 to: s.	self add: 'tags' value: tags asUTF8 to: s.	self add: 'version' value: ScratchFrameMorph version asUTF8 to: s.	self add: 'version-date' value: ScratchFrameMorph versionDate asUTF8 to: s.	self addSpriteAndScriptCountsTo: s.	self addScriptsAndSensorBlockFlagsTo: s.	self addProjectDataTo: s.	self add: 'thumbnail_image'		filename: 'thumbnail.gif'		type: 'image/gif'		data: self thumbnailAsGIF		to: s.	self add: 'preview_image'		filename: 'preview.gif'		type: 'image/gif'		data: self previewAsGIF		to: s.	s nextPutString: '--', boundary, '--', String crlf.	contentSize _ s position.	"build the header"	header _ WriteStream on: (String new: 1000).	prefix _ ''.	ProxyServer ifNotNil: [prefix _ 'http://', hostName, ':80'].	header nextPutString: (		'POST ', prefix, servicePath, ' HTTP/1.1', String crlf,			'Host: ', hostName, String crlf,			'Content-Type: multipart/form-data; boundary=', boundary, String crlf,			'Content-Length: ').	header nextPutString: contentSize printString, String crlf, String crlf.	header _ header contents.	request _ ByteArray new: header size + contentSize.	request replaceFrom: 1 to: header size with: header.	request replaceFrom: header size + 1 to: request size with: s contents.self halt.	^ request! !self size!s position!s contents!s contents asString!self copyFrom: 3000 to: self size!request copyFrom: request size - 10 to: request size!s contents copyFrom: 5430 to: 5440!!ScratchUploadProgressDialog methodsFor: 'private-other' stamp: 'jm 3/20/2009 15:20' prior: 40994322!createRequest	"Create the POST request body for my project."	| s contentSize header prefix |	"build contents"