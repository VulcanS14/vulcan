alFont boldFont panel spaceWidth labelX readoutX labelY readoutY |	normalFont _ (ScratchFrameMorph getFont: #XYReadout).	boldFont _ (ScratchFrameMorph getFont: #XYReadoutBold).	(ScratchTranslator renderScale ~= 1) ifTrue: [		"force fonts to be fixed size:"		normalFont _ StrikeFont			osFontName: normalFont name			size: normalFont pointSize // ScratchTranslator renderScale.		boldFont _ StrikeFont			osFontName: boldFont name			size: boldFont pointSize // ScratchTranslator renderScale].	panel _ Morph new color: (Color r: 0.753 g: 0.764 b: 0.776).	ScratchTranslator isRTL		ifTrue: [labelX _ StringMorph new font: normalFont; contents: ':x' asUTF8]		ifFalse: [labelX _ StringMorph new font: normalFont; contents: 'x:' asUTF8].	readoutX _ UpdatingStringMorph new		target: self; getSelector: #mouseX;		forceUnicodeRendering: true;		font: boldFont;		stepTime: 150;		growable: false.	readoutX width: (readoutX stringWidth: '-000').	ScratchTranslator isRTL		ifTrue: [labelY _ labelX fullCopy contents: ':y' asUTF8]		ifFalse: [labelY _ labelX fullCopy contents: 'y:' asUTF8].	readoutY _ readoutX fullCopy getSelector: #mouseY.	spaceWidth _ ((readoutX stringWidth: ' ') * 0.8) asInteger.	ScratchTranslator isRTL		ifTrue: [readoutY rightJustify: true.			panel addMorph: (readoutY position: 0@0).			panel addMorph: (labelY position: ((readoutY topRight) + (spaceWidth@0))).]		ifFalse: [panel addMorph: (labelX position: 0@0).			panel addMorph: (readoutX position: ((labelX topRight) + (spaceWidth@0)))].	ScratchTranslator isRTL		ifTrue: [readoutX rightJustify: true.			panel addMorph: (readoutX position: (labelY right@labelY top) + (spaceWidth@0)).			panel addMorph: (labelX position: ((readoutX topRight) + (spaceWidth@0)))]		ifFalse: [panel addMorph: (labelY position: (labelX right + readoutX width + 8)@(labelX top)).			panel addMorph: (readoutY position: ((labelY topRight) + (spaceWidth@0)))].		ScratchTranslator isRTL		ifTrue: [panel extent: ((labelX right) max: (labelY right))@(labelY bottom)]		ifFalse: [panel extent: ((readoutX right) max: (readoutY right))@(labelY bottom)].	^ panel! !ScratchFrameMorph getFont: #XYReadout!ScratchFrameMorph getFont: #XYReadoutBold!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/8/2009 17:45' prior: 41317388!makeXYReadout	"Make and answer an x-y readout."	| normalFont boldFont panel spaceWidth labelX readoutX labelY readoutY |	normalFont _ (ScratchFrameMorph getFont: #XYReadout).	boldFont _ (ScratchFrameMorph getFont: #XYReadoutBold).	(ScratchTranslator renderScale ~= 1) ifTrue: [		"force fonts to be fixed size:"		normalFont _ StrikeFont			osFontName: normalFont name			size: normalFont pointSize / ScratchTranslator renderScale asFloat.		boldFont _ StrikeFont			osFontName: boldFont name			size: boldFont pointSize / ScratchTranslator renderScale asFloat].	panel _ Morph new color: (Color r: 0.753 g: 0.764 b: 0.776).	ScratchTranslator isRTL		ifTrue: [labelX _ StringMorph new font: normalFont; contents: ':x' asUTF8]		ifFalse: [labelX _ StringMorph new font: normalFont; contents: 'x:' asUTF8].	readoutX _ UpdatingStringMorph new		target: self; getSelector: #mouseX;		forceUnicodeRendering: true;		font: boldFont;		stepTime: 150;		growable: false.	readoutX width: (readoutX stringWidth: '-000').	ScratchTranslator isRTL		ifTrue: [labelY _ labelX fullCopy contents: ':y' asUTF8]		ifFalse: [labelY _ labelX fullCopy contents: 'y:' asUTF8].	readoutY _ readoutX fullCopy getSelector: #mouseY.	spaceWidth _ ((readoutX stringWidth: ' ') * 0.8) asInteger.	ScratchTranslator isRTL		ifTrue: [readoutY rightJustify: true.			panel addMorph: (readoutY position: 0@0).			panel addMorph: (labelY position: ((readoutY topRight) + (spaceWidth@0))).]		ifFalse: [panel addMorph: (labelX position: 0@0).			panel addMorph: (readoutX position: ((labelX topRight) + (spaceWidth@0)))].	ScratchTranslator isRTL		ifTrue: [readoutX rightJustify: true.			panel addMorph: (readoutX position: (labelY right@labelY top) + (spaceWidth@0)).			panel addMorph: (labelX position: ((readoutX topRight) + (spaceWidth@0)))]		ifFalse: [panel addMorph: (labelY position: (labelX right + readoutX width + 8)@(labelX top)).			panel addMorph: (readoutY position: ((labelY topRight) + (spaceWidth@0)))].		ScratchTranslator isRTL		ifTrue: [panel extent: ((labelX right) max: (labelY right))@(labelY bottom)]		ifFalse: [panel extent: ((readoutX right) max: (readoutY right))@(labelY bottom)].	^ panel! !ScratchTranslator renderScale!ScratchTranslator renderScale * font pointSize!RenderFont!!ScratchTranslator class methodsFor: 'Unicode rendering' stamp: 'jm 4/8/2009 17:50' prior: 37546881!setFont: aStrikeFont antialias: antialiasFlag	| font isBold fontName fontSize |	font _ aStrikeFont.	font ifNil: [font _ StrikeFont fontName: 'Times' size: 14].	fontName _ font name.	fontSize _ (font pointSize * RenderScale) rounded.	isBold _ false.	(fontName asLowercase endsWith: 'bold') ifTrue: [		fontName _ fontName copyFrom: 1 to: (fontName size - 4).		isBold _ true].	aStrikeFont isOSFont ifFalse: [		(fontName beginsWith: 'VerdanaBoldNarrowSpace') ifTrue: [			fontName _ 'Verdana'.			isBold _ true].		(fontName beginsWith: 'Times') ifTrue: [ "Squeak font; not used by Scratch"			fontName _ 'Comic'.			fontSize _ font pointSize + 1].		RenderFont ifNotNil: [fontName _ RenderFont].		RenderSuppressBold ifTrue: [isBold _ false]].	RenderPlugin		primSetFont: fontName		size: fontSize		bold: isBold		italic: false		antialias: antialiasFlag.! !----QUIT----(8 April 2009 5:51:00 pm) priorSource: 7747743!----STARTUP----(9 April 2009 5:48:04 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!self height!self height!Rectangle fromUser height!----STARTUP----(9 April 2009 10:09:00 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchScriptEditorMorph methodsFor: 'accessing' stamp: 'jm 4/9/2009 10:09' prior: 41317025!bareMinimumWidth	"Answer the bare minimum width for this pane to be useable."	lockButton ifNil: [^ 100].	^ lockButton right - self left! !self readSkinFrom: (FileDirectory default directoryNamed: 'ScratchSkin')!----SNAPSHOT----(9 April 2009 10:10:29 am) priorSource: 7768612!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/9/2009 05:31'!createButtonPane	"Create and add a buttonPane and then create my control panel buttons."	| buttonSpecs bName bSelector button |	"create button pane"	buttonPane _ AlignmentMorph new		color: Color transparent;		position: workPane bounds topLeft + (10@5).	buttonPane centering: #center; height: 20.	self addMorph: buttonPane.	"buttonSpecs defines the toolbar buttons; first is icon name, second is selector"	ScratchFrameMorph isPT		ifFalse: [			buttonSpecs _ #(				"name			selector"				(point			normalTool				'Move')				(copy			copyTool				'Duplicate')				(delete			cutTool					'Delete')				(zoomIn 		zoomInTool				'Grow sprite')				(zoomOut 		zoomOutTool				'Shrink sprite')				(go				shoutGo					'Start green flag scripts')				(stop			stopAll					'Stop everything'))]		ifTrue: [			buttonSpecs _ #(				"name			selector"				(go				shoutGo					'Start green flag scripts')				(stop			stopAll					'Stop everything'))].	ScratchFrameMorph isPT ifTrue: [			buttonPane centering: #topLeft.			buttonPane addMorphBack: (AlignmentMorph newSpacer: Color transparent)].	buttonSpecs do: [:spec |		bName _ spec at: 1.		bSelector _ spec at: 2.		(#(go stop) includes: bName)			ifTrue: [				button _ ToggleButton					onForm: (ScratchFrameMorph skinAt: (bName, 'ButtonPressed') asSymbol)					offForm: (ScratchFrameMorph skinAt: (bName, 'Button') asSymbol)]			ifFalse: [				button _ ToggleButton					onForm: (ScratchFrameMorph skinAt: (bName, 'ButtonPressed') asSymbol)					offForm: (ScratchFrameMorph skinAt: (bName, 'Button') asSymbol)					overForm: (ScratchFrameMorph skinAt: (bName, 'ButtonOver') asSymbol)].		button			target: self;			actionSelector: bSelector;			isMomentary: true;			setProperty: #balloonText toValue: (spec at: 3) localized.		buttonPane addMorphBack: button.		bName = #go ifTrue: [flagButton _ button].		((bName = #zoomOut) or: [bName = #help]) ifTrue: [			buttonPane addMorphBack: (AlignmentMorph newSpacer: Color transparent)].		((bName = #go) and: [ScratchFrameMorph isPT]) ifTrue: [			buttonPane addMorphBack: (Morph new extent: (10@5); color: Color transparent)]].! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/9/2009 10:13'!createToolbar	"Create and add the toolbar."	| buttonSpecs bName bSelector button buttonPane |	"create button pane"	buttonPane _ AlignmentMorph new		color: Color transparent;		position: workPane bounds topLeft + (10@5).	buttonPane centering: #center; height: 20.	self addMorph: buttonPane.	"buttonSpecs defines the toolbar buttons; first is icon name, second is selector"	ScratchFrameMorph isPT		ifFalse: [			buttonSpecs _ #(				"name			selector"				(point			normalTool				'Move')				(copy			copyTool				'Duplicate')				(delete			cutTool					'Delete')				(zoomIn 		zoomInTool				'Grow sprite')				(zoomOut 		zoomOutTool				'Shrink sprite')				(go				shoutGo					'Start green flag scripts')				(stop			stopAll					'Stop everything'))]		ifTrue: [			buttonSpecs _ #(				"name			selector"				(go				shoutGo					'Start green flag scripts')				(stop			stopAll					'Stop everything'))].	ScratchFrameMorph isPT ifTrue: [			buttonPane centering: #topLeft.			buttonPane addMorphBack: (AlignmentMorph newSpacer: Color transparent)].	buttonSpecs do: [:spec |		bName _ spec at: 1.		bSelector _ spec at: 2.		(#(go stop) includes: bName)			ifTrue: [				button _ ToggleButton					onForm: (ScratchFrameMorph skinAt: (bName, 'ButtonPressed') asSymbol)					offForm: (ScratchFrameMorph skinAt: (bName, 'Button') asSymbol)]			ifFalse: [				button _ ToggleButton					onForm: (ScratchFrameMorph skinAt: (bName