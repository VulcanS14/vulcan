asLowercase.	thisDrive = 'volumes' ifTrue: [		currentDir pathParts size > 1 ifTrue: [			thisDrive _ currentDir pathParts second asLowercase]].	(ScratchFrameMorph visibleDrives includes: thisDrive) ifTrue: [^ false].	self beep.	^ true! !currentDir!!ScratchFilePicker methodsFor: 'private' stamp: 'jm 2/25/2009 09:31' prior: 40426232!navigationForbidden	"Answer true if navigating the file hierarch is forbidden because there is a visibledrives entry in the Scratch.ini file."	| thisDrive pathParts |	ScratchFrameMorph visibleDrives ifNil: [^ false].	thisDrive _ ''.	pathParts _ currentDir pathParts.	pathParts size > 0 ifTrue: [thisDrive _ pathParts first asLowercase].	((thisDrive = 'volumes') and: [pathParts size > 1]) ifTrue: [		thisDrive _ pathParts second asLowercase].	(ScratchFrameMorph visibleDrives includes: thisDrive) ifTrue: [^ false].	self beep.	^ true! !----SNAPSHOT----(25 February 2009 9:33:09 am) priorSource: 6870026!!HandMorph methodsFor: 'event handling' stamp: 'jm 2/25/2009 09:34' prior: 40423971!handleQutEvent	"Dispatch a closeWindow event."	self showTemporaryCursor: nil.	Preferences noviceMode		ifTrue: [ScratchFrameMorph quitFromMenu]		ifFalse: [self quitSession].! !----SNAPSHOT----(25 February 2009 9:35:00 am) priorSource: 6872949!----QUIT----(25 February 2009 9:35:06 am) priorSource: 6873287!----STARTUP----(25 February 2009 9:36:33 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchPrompterMorph methodsFor: 'accessing' stamp: 'jm 2/25/2009 09:46'!question: aString! !!ScratchPrompterMorph methodsFor: 'accessing' stamp: 'jm 2/25/2009 09:47'!sprite: aSprite! !ImageFrameMorph subclass: #ScratchPrompterMorph	instanceVariableNames: 'typeinMorph okButton done sprite '	classVariableNames: 'LastAnswer '	poolDictionaries: ''	category: 'Scratch-UI-Dialogs'!!ScratchPrompterMorph methodsFor: 'accessing' stamp: 'jm 2/25/2009 09:47' prior: 40428126!sprite: aSprite	sprite _ aSprite.! !!Scriptab