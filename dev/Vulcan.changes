ick: evt].	mouseDownMorph ifNotNil:		[mouseDownMorph mouseMove: (self transformEvent: evt)].	ungriddedEvt _ evt copy setCursorPoint: Sensor cursorPoint.	submorphs isEmpty		ifTrue: [			evt anyButtonPressed				ifTrue: [self handleDragOver: ungriddedEvt]				ifFalse: [self handleMouseOver: ungriddedEvt]]		ifFalse: [self handleDragOver: ungriddedEvt].! !----SNAPSHOT----(18 November 2008 7:49:03 pm) priorSource: 5498752!----STARTUP----(18 November 2008 7:49:15 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchStageMorph methodsFor: 'drawing' stamp: 'jm 11/18/2008 19:50' prior: 39086383!drawQuarterSizeOn: aCanvas	"Draw myself and my submorphs to an offscreen canvas, then scale down to quarter size and draw that on the given canvas."	| c f2 |	cachedForm ifNil: [cachedForm _ Form extent: self extent depth: 32].	c _ (FormCanvas on: cachedForm)		copyOrigin: self position negated		clipRect: (aCanvas clipRect translateBy: self position negated).	super fullDrawOn: c.	f2 _ cachedForm magnifyBy: 0.5.	c _ aCanvas copy			setOrigin: aCanvas origin			clipRect: (0@0 corner: 10000@10000).	c drawImage: f2 at: self position."	f2 displayOn: Display at: self position rule: Form over.	Display forceToScreen: (self position extent: f2 extent)."! !!ScratchStageMorph methodsFor: 'drawing' stamp: 'jm 11/18/2008 19:51' prior: 39087879!drawQuarterSizeOn: aCanvas	"Draw myself and my submorphs to an offscreen canvas, then scale down to quarter size and draw that on the given canvas."	| c f2 |	cachedForm ifNil: [cachedForm _ Form extent: self extent depth: 32].	c _ (FormCanvas on: cachedForm)		copyOrigin: self position negated		clipRect: (aCanvas clipRect translateBy: self position negated).	super fullDrawOn: c.	f2 _ cachedForm magnifyBy: 0.5.	c _ aCanvas copy		setOrigin: aCanvas origin		clipRect: (0@0 corner: 10000@10000).	c drawImage: f2 at: self position."	f2 displayOn: Display at: self position rule: Form over.	Display forceToSc