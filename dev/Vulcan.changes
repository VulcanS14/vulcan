eset	"self reset"	self sendStatus: 128 motorA: 0 motorB: 0.	self sendStatus: 8 motorA: 0 motorB: 0.	self sendStatus: 64 motorA: 0 motorB: 0.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 11:53'!sendStatus: status motorA: motorA motorB: motorB	| buf |	buf _ ByteArray new: 9.	buf at: 2 put: status.	buf at: 3 put: motorA.	buf at: 4 put: motorB.	self writeFrom: buf.! !InterpreterPlugin subclass: #WeDoPlugin	instanceVariableNames: ''	classVariableNames: 'PortAID PortAValue PortBID PortBValue MotorOn MotorStopTime '	poolDictionaries: ''	category: 'Primitives-Plugins'!!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:16' prior: 39131258!reset	"self reset"	self openPort.	self sendStatus: 128 motorA: 0 motorB: 0.	self sendStatus: 8 motorA: 0 motorB: 0.	self sendStatus: 64 motorA: 0 motorB: 0.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:18' prior: 39130721!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is available."	"Note: the ID's will be meaningless while the motor is running and for about a second after it has been turned off."	"self readInputs"	| buf n |	buf _ ByteArray new: 10000.	n _ WeDoPlugin readInto: buf.	n < 9 ifTrue: [^ nil].	buf _ buf copyFrom: n - 8 to: n.	PortAID _ self mapID: (buf at: 5).	PortAValue _ buf at: 4.	PortBID _ self mapID: (buf at: 7).	PortBValue _ buf at: 6.! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:19' prior: 39130462!mapID: n	"Covert a raw ID value into a device index. Some device ID's:		2 - tilt sensor		13 - motor"	| rangeMap |	rangeMap _ #(9 27 47 67 87 109 131 152 169 190 211 224 233 246 255).	1 to: rangeMap size do: [:i |		n < (rangeMap at: i) ifTrue: [^ i - 1]].	^ rangeMap size! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:20' prior: 39132204!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is 