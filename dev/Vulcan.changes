t: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '� ' asUTF8, (spec at: 1) localized, ' �' asUTF8].		(#(undoTool share launchHelp) includes: m selector) ifTrue: [m actOnMouseUp: true].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	self addViewModeButtonsTo: menuPanel.	closeButton _ IconicButton new		labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;		actionSelector: #quitScratch;		target: self;		actWhen: #buttonDown.	menuPanel addMorphBack: closeButton.	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 12/30/2008 14:12' prior: 39152063!initialize	super initialize.	fillScreenFlag _ false.	paintingInProgress _ false.	projectInfo _ Dictionary new.	watcherPositions _ Dictionary new.	justSaved _ false.	author _ ''.	loginName _ ''.	loginPassword _ ''.	viewMode _ #normal.	self createBasicPanes.	self createLogo.	self createMenuPanel.	self createButtonPanel.	self extent: 1000@600.! !!ScratchFrameMorph methodsFor: 'accessing' stamp: 'ee 12/30/2008 13:47'!viewMode	^ viewMode! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/30/2008 12:57'!editMenu	| menu |	menu _ CustomMenu new.	menu add: 'undelete' action: #undoTool.	menu addLine.	ScratchProcess blockHighlightMSecs <= 1		ifTrue: [menu add: 'start single stepping' action: #toggleSingleStepping]		ifFalse: [menu add: 'stop single stepping' action: #toggleSingleStepping].	menu addLine.	menu add: 'compress sounds' action: #compressSounds.	menu add: 'compress images' action: #compressImages.	menu localize.	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/30/2008 12:57' prior: 39307980!fileMenu	| menu |	menu _ CustomMenu new.	menu add: 'new' action: #newScratchProject.	menu add: 'open' action: #openScratchProject.	menu add: 'save (s)' action: #saveScratchProjectNoDialog.	menu add: 'save as' action: #saveScratchProject.	menu addLine.	menu add: 'import project' action: #importScratchProject.	menu add: 'export sprite' action: #exportSprite.	menu addLine.	menu add: 'notes' action: #editNotes.		menu labels at: 5 put:		((menu labels at: 5) copyFrom: 1 to: (menu labels at: 5) size - 1), ScratchTranslator ellipsesSuffix.	menu localize.	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/30/2008 13:00'!helpMenu	| menu |	menu _ CustomMenu new.	menu add: 'about...' action: #aboutScratch.	menu add: 'launch help' action: #launchHelp.	menu localize.	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'extra menu' stamp: 'ee 12/30/2008 13:04' prior: 37039461!extraMenu	"Present the Scratch extras menu."	| menu enableRenderingMenu |	self world activeHand toolType: nil.	Cursor normal show.	menu _ CustomMenu new.	Sensor shiftPressed ifFalse: [  "normal menu"		self addServerCommandsTo: menu].	Sensor shiftPressed ifTrue: [  "special menu"		enableRenderingMenu _ false.		enableRenderingMenu ifTrue: [			menu add: 'set translation formatting...' action: #renderingMenu.			menu addLine].		menu add: 'write project summary' action: #writeSummaryFile.		menu add: 'write multiple project summaries' action: #writeMultipleSummaries.		menu addLine.		menu add: 'set single stepping...' action: #setSingleStepping].	menu localize.	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/30/2008 13:28' prior: 39309933!enterPresentationMode	"Go into presentation mode."	| presenter |	ScratchPlugin pluginAvailable ifFalse: [		self updateViewModeButtons.		^ self beep].	(viewMode = #presentation) ifTrue: [^ self].	lastViewMode _ viewMode.	viewMode _ #presentation.	self closeDialogBoxes.	presenter _ ScratchPresenterMorph new frame: self.	self delete.	Display fillBlack.	Smalltalk fullScreenMode: true.	World restoreDisplay.	Display fillBlack.	World assuredCanvas.  "re-allocate canvas after entering full-screen mode"	((Display width >= 965) & (Display height >= 750))		ifTrue: [presenter beDoubleSize].	presenter extent: Display extent.	World addMorphFront: presenter.	World startSteppingSubmorphsOf: presenter.	World activeHand newKeyboardFocus: nil.	self updatePenPositions.	self updateViewModeButtons.	World assuredCanvas.  "re-allocate canvas after entering full-screen mode"	World fullRepaintNeeded.	World displayWorldSafely.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/30/2008 13:29' prior: 39023955!exitPresentationMode	"Exit presentation mode."	TakeOverScreen ifFalse: [		Smalltalk fullScreenMode: false.		DisplayScreen startUp].	ScriptableScratchMorph doubleSize: false.	self addMorphFront: workPane.	self fixLayout.	World addMorphFront: self.	World startSteppingSubmorphsOf: self.	World fullRepaintNeeded.	self updatePenPositions.	lastViewMode = #normal		ifTrue: [self enterNormalMode. ^ self].	lastViewMode = #quarter		ifTrue: [self enterQuarterMode].! !!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'ee 12/30/2008 13:53' prior: 39163196!clearLibrary	| sFrame |	"Remove all library items. My step method will re-add items for existing objects."	stagePane removeAllMorphs.	scrollPane contents removeAllMorphs.	scrollPane vScrollRelative: 0.	spriteLabel delete.	spriteLabel _ StringMorph new contents: 'Sprites' localized.	spriteLabel		font: (ScratchFrameMorph getFont: #Tab);		color: Color white.	sFrame _ self ownerThatIsA: ScratchFrameMorph.	(sFrame isNil or: [sFrame viewMode = #normal])		ifTrue: [self addMorph: spriteLabel].		topSectionHeight _ (((spriteLabel stringHeight: 'Sprites' localized) + 15) max: 40).	self fixLayout.! !!ScratchLibraryMorph methodsFor: 'geometry' stamp: 'ee 12/30/2008 13:55' prior: 39164296!fixLayout	"Position and size thumbnails."	| libPane x y rMargin sFrame |	scrollPane isNil | stagePane isNil | spritePane isNil ifTrue: [^ self].	spritePane width: self width.	spritePane height: topSectionHeight.	spriteLabel position: (self left + 15)@(self top + (topSectionHeight // 2) - (spriteLabel height // 2) + 3).	sFrame _ self ownerThatIsA: ScratchFrameMorph.	(sFrame isNil or: [sFrame viewMode = #normal])		ifTrue: [buttonPane position: (spriteLabel right + 10)@(self top + (topSectionHeight // 2) - (buttonPane height // 2) + 3)]		ifFalse: [buttonPane position: (self left + 12)@(self top + (topSectionHeight // 2) - (buttonPane height // 2) + 3)].		stagePane height = self height ifFalse: [		stagePane height: self height].	scrollPane height = self height ifFalse: [		scrollPane height: self height - topSectionHeight].	scrollPane width = (self right - stagePane right) ifFalse: [		scrollPane width: self right - stagePane right].	scrollPane position: scrollPane left @ (self top + topSectionHeight + 3).	stagePane position: stagePane left @ (self top + topSectionHeight + 3).	libPane _ scrollPane contents.	ScratchTranslator isRTL		ifTrue: [x _ libPane left + 30]		ifFalse: [x _ libPane left + 8].	y _ libPane top + 7.	rMargin _ x + scrollPane width - 5.	libPane submorphs do: [:m |		(x + m width) > rMargin ifTrue: [			ScratchTranslator isRTL				ifTrue: [x _ libPane left + 30]				ifFalse: [x _ libPane left + 8].			y _ y + m height].		m position: x@y.		x _ x + m width].	stagePane submorphCount > 0 ifTrue: [		m _ stagePane firstSubmorph.		m position: stagePane topLeft + ((stagePane extent - stagePane firstSubmorph extent) // 2) + (0@15) - (0@topSectionHeight)].! !!ScratchPresenterMorph methodsFor: 'initialization' stamp: 'ee 12/30/2008 13:17' prior: 39311438!initialize	| button |	super initialize.	self color: Color black.	doubleSize _ false.	buttons _ #(		(presentationExit	exitPresentation		'Exit presentatoin')		(goSmall			shoutGo				'Start green flag scripts')		(stopSmall			stopAll				'Stop everything')	) collect: [:spec |		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonPressed'))			offForm: (ScratchFrameMorph skinAt: (spec first, 'Button'))			overForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonPressed')).		button			target: self;			actionSelector: spec second;			isMomentary: true;			actWhen: #buttonUp;			setProperty: #balloonText toValue: spec third localized;			drawToolTipAbove: true;			off.		#shoutGo = spec second ifTrue: [flagButton _ button].		button].	buttons do: [:b | self addMorph: b].! !!ScratchPresenterMorph methodsFor: 'button actions' stamp: 'ee 12/30/2008 13:11'!exitPresentation	self delete.	frame exitPresentationMode.! !!ScratchPresenterMorph methodsFor: 'geometry' stamp: 'ee 12/30/2008 13:27' prior: 39313754!fixLayout	| stageExtent stageBox y totalW x |	stageExtent _ doubleSize ifTrue: [2 * stage extent] ifFalse: [stage extent].	stageBox _ Rectangle center: self center extent: stageExtent.	stage owner center: self center.	y _ stageBox top - 22.	buttons first position: (stageBox left + 5) @ y.  "exit presentation button"	"other buttons"	totalW _ (buttons collect: [:b | b width] from: 2 to: buttons size) sum.	x _ stageBox right - totalW - (10 * (buttons size - 2)) - 5.	buttons allButFirst do: [:b |		b position: x@y.		x _ x + b width + 10].	offscreenWorld redrawAll.! !!ScratchPresenterMorph methodsFor: 'event handling' stamp: 'ee 12/30/2008 13:12' prior: 39169033!processKeyboardEvents	| evt ch |	World hands do: [:h |		[(evt _ h nextUnclaimedKeystrokeOrNil) notNil] whileTrue: [			ch _ evt keyValue.			(ch = 3) | (ch = 13) ifTrue: [^ self shoutGo].			ch = 27 ifTrue: [^ self exitPresentation].  "escape"			stage broadcastEventNamed: 'Scratch-KeyPressedEvent' with: evt]].! !ScratchPresenterMorph removeSelector: #exitPresentation:!Scrat