s methodsFor: 'polling' stamp: 'jm 12/4/2008 11:03' prior: 39140994!tilt	"Answer the value of the tilt sensor:		0 - no tilt (or tilt sensor not available)		1-4 - tilt direction"	| v |	v _ nil.	PortAID = 2 ifTrue: [v _ PortAValue].	PortBID = 2 ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	v < 49 ifTrue: [^ 3].	v < 100 ifTrue: [^ 2].	v < 154 ifTrue: [^ 0].	v < 205 ifTrue: [^ 1].	^ 4! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 11:03' prior: 39141328!tilt	"Answer the value of the tilt sensor:		0 - no tilt or tilt sensor not available		1-4 - tilt direction"	| v |	v _ nil.	PortAID = 2 ifTrue: [v _ PortAValue].	PortBID = 2 ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	v < 49 ifTrue: [^ 3].	v < 100 ifTrue: [^ 2].	v < 154 ifTrue: [^ 0].	v < 205 ifTrue: [^ 1].	^ 4! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 11:04' prior: 39132792!mapID: n	"Covert a raw ID value into a device index. Some device ID's:		2 - tilt sensor		13 - motor"	| rangeMap |	rangeMap _ #(9 27 47 67 87 109 131 152 169 190 211 224 233 246 256).	1 to: rangeMap size do: [:i |		n < (rangeMap at: i) ifTrue: [^ i - 1]].	^ rangeMap size! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 11:08' prior: 39142158!mapID: n	"Covert a raw ID value into a device index. Some device ID's:		2 - tilt sensor		10 - light brick		13 - motor"	| rangeMap |	rangeMap _ #(9 27 47 67 87 109 131 152 169 190 211 224 233 246 256).	1 to: rangeMap size do: [:i |		n < (rangeMap at: i) ifTrue: [^ i - 1]].	^ rangeMap size! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 11:09' prior: 39142528!mapID: n	"Covert a raw ID value into a device index. Some device ID's:		2 - tilt sensor		9 - proximity sensor		10 - light brick		13 - motor"	| rangeMap |	rangeMap _ #(9 27 47 67 87 109 131 152 169 190 211 224 233 246 256).	1 to: rangeMap size do: [:i |		n < (rangeMap at: i) ifTrue: [^ i - 1]].	^ rangeMap size! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 11:11' prior: 39141744!tilt	"Answer the value of the tilt sensor:		0 - no tilt or tilt sensor not available		1-4 - tilt direction"	| id v |	id _ 2. "tilt sensor ID"	v _ nil.	PortAID = id ifTrue: [v _ PortAValue].	PortBID = id ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	v < 49 ifTrue: [^ 3].	v < 100 ifTrue: [^ 2].	v < 154 ifTrue: [^ 0].	v < 205 ifTrue: [^ 1].	^ 4! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 11:14'!distance	"Answer the value of the distance sensor."	| id table v |	id _ 9. "distance sensor ID"	table _ #(2 8 11 16 36 58 70 77 83 96).	v _ nil.	PortAID = id ifTrue: [v _ PortAValue].	PortBID = id ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	"add scaling code here..."	^ v! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/4/2008 12:29' prior: 39143758!distance	"Answer the value of the distance sensor."	| id v |	id _ 9. "distance sensor ID"	v _ nil.	PortAID = id ifTrue: [v _ PortAValue].	PortBID = id ifTrue: [v _ PortBValue].	v ifNil: [^ 0].	"add scaling code here..."	^ v! !----SNAPSHOT----(4 December 2008 12:29:58 pm) priorSource: 5584744!----QUIT----(4 December 2008 12:30:07 pm) priorSource: 5589937!----STARTUP----(7 December 2008 11:32:28 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 5 December 2008 at 11:34:10 pm'!Morph subclass: #ScratchFrameMorph	instanceVariableNames: 'topPane viewerPane scriptsPane stageFrame workPane offscreenStage libraryPane menuPanel buttonPanel readoutPane logoMorph projectTitleMorph flagButton fillScreenFlag paintingInProgress projectDirectory projectName projectInfo author loginName loginPassword watcherPositions shuffledCostumeNames justSaved viewModeButtons viewMode '	classVariableNames: 'ClassmateDemo Clipboard DefaultSprite Fonts FontsXO IsXO MinHeight MinWidth Platform ScratchServers ScratchSkin ScratchSkinPT ScratchSkinXO ShareServer ShareServerPath TakeOverScreen UseErrorCatcher Version VersionDate VisibleDrives WorkpaneExtent QuarterModeEnabled NormalModeEnabled '	poolDictionaries: ''	category: 'Scratch-UI-Panes'!Morph subclass: #ScratchPresenterMorph	instanceVariableNames: 'frame stage buttons flagButton offscreenWorld doubleSize mouseFocus mouseDownPoint dragOffset clickWasHandled mouseMoved quarterModeButton presentationModeButton normalModeButton '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Panes'!!CommandBlockMorph methodsFor: 'private' stamp: 'ee 12/5/2008 21:08' prior: 34353317!addCommandIcons	"Add additional icons to certain blocks. Do nothing if this isn't one of those blocks."	| f m |	#turnLeft: = selector ifTrue: [		f _ ScratchFrameMorph skinAt: #turnCCW ifAbsent: [^ self].		m _ self firstSubmorph delete.		self addMorphFront: (ImageMorph new form: f).		self addMorphFront: m].	#turnRight: = selector ifTrue: [		f _ ScratchFrameMorph skinAt: #turnCW ifAbsent: [^ self].		m _ self firstSubmorph delete.		self addMorphFront: (ImageMorph new form: f).		self addMorphFront: m].	#stopAll = selector ifTrue: [		f _ ScratchFrameMorph skinAt: #stopSmallButton ifAbsent: [^ self].		self addMorphBack: (ImageMorph new form: f)].! !!EventHatMorph methodsFor: 'initialization' stamp: 'ee 12/5/2008 21:09' prior: 34637077!forStartEvent	| parts s m |	super initialize.	self removeAllMorphs.	parts _ ScratchTranslator labelPartsFor: 'when %m clicked'.	s _ StringMorph new contents: parts first; font: (ScratchFrameMorph getFont: #Label); color: Color white.	self addMorphBack: s.	m _ ImageMorph new form: (ScratchFrameMorph skinAt: #goSmallButton).	self addMorphBack: m.	s _ s fullCopy contents: parts second.	self addMorphBack: s.	"create scriptNameMorph but don't add it"	scriptNameMorph _ EventTitleMorph new eventName: 'Scratch-StartClicked'.	self fixBlockLayout.! !!LibraryItemMorph methodsFor: 'initialization' stamp: 'ee 12/4/2008 11:58' prior: 35479977!buildSubmorphs	"LibraryItemMorph open"	thumbnailMorph _ ImageMorph new		form: (Form extent: thumbWidth@thumbWidth depth: 16) fillWhite;		position: ((self width - thumbWidth) // 2) @ 0.	self addMorph: thumbnailMorph.	"nameMorph _ StringMorph new		font: (ScratchFrameMorph getFont: #LibraryItemName);		position: 0 @ thumbnailMorph bottom.	self addMorph: nameMorph.	scriptCountMorph _ StringMorph new		font: (ScratchFrameMorph getFont: #LibraryItemInfo);		contents: '';		position: 0 @ nameMorph bottom.	self addMorph: scriptCountMorph."	self color: Color transparent.! !!LibraryItemMorph methodsFor: 'accessing' stamp: 'ee 12/4/2008 11:57' prior: 35481366!highlight: aBoolean	| labelColor |	isSelected = aBoolean ifTrue: [^ self].	isSelected _ aBoolean.	isSelected		ifTrue: [			rolloverOn _ false.			highlightForm extent: self extent.			currentForm _ highlightForm.			self addMorphBack: (currentForm position: (self position + (0@0))).			labelColor _ Color white]		ifFalse: [			currentForm ifNotNil: [				currentForm delete.				currentForm _ nil].			labelColor _ Color gray: 0.8].	"nameMorph color: labelColor.	scriptCountMorph color: labelColor darker."	self changed.! !!LibraryItemMorph methodsFor: 'drawing' stamp: 'ee 12/5/2008 17:14' prior: 35483314!updateNameAndInfo	| w y |	self setProperty: #balloonText toValue: ((target objName, ' (' asUTF8, 'Scripts' localized, ScratchTranslator colonSuffix, ' ' asUTF8, target scripts size printString asUTF8,')' asUTF8) asUTF8).	nameMorph ifNotNil:[		scriptCountMorph ifNotNil: [	(target isKindOf: ScriptableScratchMorph) ifFalse: [		nameMorph contents: '<no object>'.		scriptCountMorph contents: ''.		^ self].	nameMorph contents = target objName ifFalse: [		nameMorph contents: self truncatedLabel.		nameMorph left: self left + ((self width - nameMorph width) // 2)].	w _ 0.	target scripts size > 0		ifTrue: [			w > 0 ifTrue: [w _ w + 2].			scriptCountMorph contents: 'Scripts' localized, ScratchTranslator colonSuffix, ' ', target scripts size printString.			w _ w + scriptCountMorph width + 2]		ifFalse: [			scriptCountMorph contents: ''].	"layout info morph row"	y _ nameMorph bottom.	w > 0 ifTrue: [		scriptCountMorph position: (self left + ((self width - (scriptCountMorph width)) // 2))@y]]].! !!LibraryItemMorph methodsFor: 'stepping' stamp: 'ee 12/4/2008 11:49' prior: 35489058!step	"Optimization: Don't update unless the costume has changed."	| changeTime stage frame |	target ifNil: [		(frame _ (self ownerThatIsA: ScratchFrameMorph)) ifNotNil: [			(stage _ frame workPane) ifNotNil: [				stage updateSpritesList]].		^ self].	target world isNil ifTrue: [target _ nil. ^ self].	changeTime _ target costumeChangeMSecs.	changeTime = lastUpdateMSecs ifFalse: [		self updateThumbnail.		lastUpdateMSecs _ changeTime].	Sensor anyButtonPressed ifFalse: [self updateNameAndInfo].! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 12/5/2008 13:29' prior: 37006896!createLogo	"Create and the Scratch logo."	logoMorph _ SketchMorph withForm: (ScratchFrameMorph skinAt: #scratchLogo2).	logoMorph position: topPane position + (12@8).	topPane addMorph: logoMorph.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 12/3/2008 17:02' prior: 39040290!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu		'Open, save, and share projects')		(Undo			undoTool		'Undo the last delete')		(Language		languageMenu	'Switch languages')		(Extras			extraMenu		'Extra operations')		('Share!!'		shareDisabled	'Share your project on the web')		(Help			launchHelp		'Get help')	).	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		(#(undoTool share launchHelp) includes: m selector) ifTrue: [m actOnMouseUp: true].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	self addViewModeButtonsTo: menuPanel.	closeButton _ IconicButton new		labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;		actionSelector: #quitScratch;		target: self;		actWhen: #buttonDown.	menuPanel addMorphBack: closeButton.	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'ee 12/5/2008 17:08' prior: 39022581!initialize	super initialize.	fillScreenFlag _ false.	paintingInProgress _ false.	projectInfo _ Dictionary new.	watcherPositions _ Dictionary new.	justSaved _ false.	author _ ''.	loginName _ ''.	loginPassword _ ''.	self createBasicPanes.	self createLogo.	self createMenuPanel.	self createButtonPanel.	self extent: 1000@600.! !!ScratchFrameMorph methodsFor: 'accessing' stamp: 'ee 12/5/2008 23:27' prior: 37096266!updatePanes	| p |	menuPanel delete.	self createMenuPanel.	scriptsPane tabPane delete.	scriptsPane createTabPane.	workPane sensorBoard owner		ifNil: [p _ nil]		ifNotNil: [p _ workPane sensorBoard position].	workPane resetSensorBoard.	p ifNotNil:[		self showSensorBoard		workPane sensorBoard position: p].	libraryPane clearLibrary.	self scratchWatchers do: [:w | w languageChanged].	self listWatchers do: [:w | w fixLayoutForNewLanguage].	World startSteppingSubmorphsOf: self.	self fixLayout.	scriptsPane fixLayout.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/3/2008 17:14' prior: 37023865!fileMenu	| menu |	menu _ CustomMenu new.	menu add: 'new' action: #newScratchProject.	menu add: 'open' action: #openScratchProject.	menu add: 'save (s)' action: #saveScratchProjectNoDialog.	menu add: 'save as' action: #saveScratchProject.	menu addLine.	menu add: 'export sprite' action: #exportSprite.	menu localize.	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 12/5/2008 17:35' prior: 37025229!newScratchProject	"Make a new, blank Scratch project."	| response newProject sprite |	self closeMediaEditorsAndDialogs ifFalse: [^ self].	self stopAll.	(justSaved or: [self projectIsEmpty]) ifFalse: [		"ask the user if they want to save the current project"		response _ DialogBoxMorph askWithCancel: 'Save the current project?'.		response = #cancelled ifTrue: [^ self].		response ifTrue: [self saveScratchProjectNoDialog.			justSaved ifFalse: [^ self]]].	projectDirectory _ ScratchFileChooserDialog getDefaultFolderForType: #project.	projectName _ ''.	projectInfo _ Dictionary new.	newProject _ ScratchStageMorph new.	sprite _ ScratchFrameMorph defaultSprite fullCopy.	sprite position: (241@181) - sprite extent.	ClassmateDemo ifTrue: [sprite position: (73@35) - (sprite extent // 2)].	newProject addMorph: sprite.	self installNewProject: newProject.	self initializeWatcherPositions.	justSaved _ true.	"self enterNormalMode."! !!ScratchFrameMorph methodsFor: 'geometry' stamp: 'ee 12/5/2008 23:26' prior: 39044054!fixLayout	| stageExtent |	stageExtent _		workPane isQuarterSize			ifTrue: [workPane extent // 2]			ifFalse: [workPane extent].	topPane		position: self topLeft;		width: self width;		height: (menuPanel height + 0 max: logoMorph height + 12).	stageFrame		extent: stageExtent + (14@49);		top: topPane bottom;		right: self right.	workPane position: stageFrame topLeft + (4@44).	viewerPane position: topPane bottomLeft;		width: viewerPane catButtonsExtent x + 17;		height: self bottom - topPane bottom.	scriptsPane position: viewerPane topRight;		width: self width - (stageFrame width + viewerPane width);		height: self bottom - topPane bottom.	libraryPane position: stageFrame bottomLeft;		width: (self right - scriptsPane right);		height: self bottom - libraryPane top.	menuPanel		left: logoMorph right + 18;		top: topPane top + ((topPane height - menuPanel height) // 2) + 2;		width: (self right - menuPanel left) - 15.	buttonPanel		position: (stageFrame left + 10)@(topPane bottom + 5);		height: (workPane top - stageFrame top) - 8;		width: stageFrame width - 25.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/5/2008 15:59' prior: 39047758!addViewModeButtonsTo: aMorph	| specs bName button |	viewModeButtons _ OrderedCollection new.	specs _ OrderedCollection new.	ScratchFrameMorph quarterModeEnabled ifTrue: [		specs add: #(quarter		enterQuarterMode)].	ScratchFrameMorph normalModeEnabled ifTrue: [		specs add: #(normal		enterNormalMode)].	specs add: #(presentation	enterPresentationMode).	specs do: [:spec |		bName _ spec first.		button _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOn')			offForm: (ScratchFrameMorph skinAt: bName, 'ViewMode')			overForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true.		aMorph			addMorphBack: button;			addMorphBack: (Morph new extent: 5@5; color: Color transparent).		viewModeButtons add: button].! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/5/2008 17:26' prior: 39047455!enterNormalMode	"Go into normal (full-stage) mode."	NormalModeEnabled ifFalse:[		self enterQuarterMode.		^ self].	viewMode _ #normal.	workPane isQuarterSize: false.	workPane isInWorld		ifTrue: [self fixLayout]		ifFalse: [self exitPresentationMode].	self updatePanes.	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/5/2008 16:59' prior: 39023051!enterPresentationMode	"Go into presentation mode."	| presenter |	ScratchPlugin pluginAvailable ifFalse: [^ self beep].	viewMode _ #presentation.	self closeDialogBoxes.	presenter _ ScratchPresenterMorph new frame: self.	self delete.	Display fillBlack.	Smalltalk fullScreenMode: true.	DisplayScreen startUp.	Display fillBlack.	ClassmateDemo		ifTrue: [presenter beDoubleSize]		ifFalse: [			((Display width >= 965) & (Display height >= 750))				ifTrue: [presenter beDoubleSize]].	presenter extent: Display extent.	World addMorphFront: presenter.	World startSteppingSubmorphsOf: presenter.	World activeHand newKeyboardFocus: nil.	self updatePenPositions.	World fullRepaintNeeded.	World displayWorldSafely.	presenter buttons do: [:b | b changed].  "force buttons to redisplay"	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/5/2008 22:29'!enterQuarterMode	"Go into quarter stage mode."	QuarterModeEnabled ifFalse:[		self enterPresentationMode.		^ self].	viewMode _ #quarter.	workPane isQuarterSize: true.	workPane isInWorld		ifTrue: [self fixLayout]		ifFalse: [self exitPresentationMode].	self updatePanes.	self updateViewModeButtons.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/5/2008 22:25'!exitPresentationMode: aSymbol	"Exit presentation mode."	TakeOverScreen ifFalse: [		Smalltalk fullScreenMode: false.		DisplayScreen startUp].	ScriptableScratchMorph doubleSize: false.	self addMorphFront: workPane.	self fixLayout.	World addMorphFront: self.	World startSteppingSubmorphsOf: self.	World fullRepaintNeeded.	self updatePenPositions.	aSymbol = #normal		ifTrue: [self enterNormalMode. ^ self].	aSymbol = #quarter		ifTrue: [self enterQuarterMode].! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/5/2008 17:27' prior: 39048535!updateViewModeButtons	viewModeButtons do: [:b | b off].	viewModeButtons do: [:b |		(b actionSelector = #enterQuarterMode and: [viewMode = #quarter])			ifTrue: [b on].		(b actionSelector = #enterNormalMode and: [viewMode = #normal])			ifTrue: [b on].		(b actionSelector = #enterPresentationMode and: [viewMode = #presentation])			ifTrue: [b on]].! !!ScratchFrameMorph class methodsFor: 'class initialization' stamp: 'ee 12/4/2008 13:28' prior: 39002263!initialize	"self initialize"	Clipboard _ nil.	MinWidth _ 680.	MinHeight _ 370.	WorkpaneExtent _ 480@360.	UseErrorCatcher _ true.	QuarterModeEnabled _ true.	NormalModeEnabled _ true.	ClassmateDemo ifTrue: [WorkpaneExtent _ 480@360 / 2].	self initFonts.! !!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'ee 12/4/2008 13:27'!normalModeEnabled	^ NormalModeEnabled! !!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'ee 12/4/2008 13:27'!normalModeEnabled: aBoolean	NormalModeEnabled _ aBoolean! !!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'ee 12/4/2008 13:27'!quarterModeEnabled	^ QuarterModeEnabled! !!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'ee 12/4/2008 13:26'!quarterModeEnabled: aBoolean	QuarterModeEnabled _ aBoolean! !!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'ee 12/5/2008 13:42' prior: 37102634!readSkinFrom: aDirectory	"Read the Forms for my skin from the given directory and store them in myskin dictionary."	"When in XO mode, entries in ScratchSkinXO override the corresponding entries in ScratchSkin."	"self readSkinFrom: (FileDirectory default directoryNamed: 'ScratchSkin')"	| dict img i xoDict |	dict _ Dictionary new.	xoDict _ Dictionary new.	aDirectory fileNames do: [:fn |		Cursor read showWhile: [			img _ [Form fromFileNamed: (aDirectory fullNameFor: fn)] ifError: [nil]].		img ifNotNil: [			i _ fn findLast: [:c | c = $.].			i = 0 ifFalse: [fn _ fn copyFrom: 1 to: i - 1].			(fn asLowercase endsWith: '_xo')				ifTrue: [xoDict at: (fn copyFrom: 1 to: fn size - 3) asSymbol put: img]				ifFalse: [dict at: fn asSymbol put: img]]].	ScratchSkin _ dict.	ScratchSkinXO _ xoDict.	img _ ScratchSkin at: #scriptsPaneTexture ifAbsent: [nil].	(img notNil and: [img depth ~= 32]) ifTrue: [		ScratchSkin at: #scriptsPaneTexture put: (img asFormOfDepth: 32)].! !!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'ee 12/4/2008 11:43' prior: 37104076!skinAt: aSymbolOrString ifAbsent: aBlock	"Answer the skin image with the given name. In XO mode, first check to see if an entry appears in ScratchSkinXO. If so, use it. Otherwise, use the image from the normal skin dictionary."	| k |	k _ aSymbolOrString asSymbol.	self isXO ifTrue: [		k = #scriptsPaneTexture ifTrue: [^ aBlock value].		(ScratchSkinXO includesKey: k) ifTrue: [^ ScratchSkinXO at: k]].	^ ScratchSkin at: k ifAbsent: aBlock! !!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'ee 12/5/2008 16:32'!buildPanes	"Build my scroll pane."	| bin |	stagePane _ Morph new		color: Color transparent;		position: self position + (7@0).	bin _ ScratchSpriteLibraryMorph new		color: Color transparent;		borderWidth: 0.	scrollPane _ ScrollFrameMorph2 new		color: Color transparent;		contents: bin;		showHorizontalScrollbar: false.	spritePane _ Morph new		color: Color gray;		position: self position.	spriteLabel _ StringMorph new contents: 'Sprites' localized.	spriteLabel		font: (ScratchFrameMorph getFont: #Tab);		color: Color white.	buttonPane _ self makeNewSpriteButtons.	self addMorph: spritePane.	self addMorph: spriteLabel.	self addMorph: buttonPane.	self addMorph: scrollPane.	self addMorph: stagePane.! !!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'ee 12/5/2008 17:27' prior: 37141801!initialize	super initialize.	self buildPanes.	self		initFrontFromForm: (ScratchFrameMorph skinAt: 'spriteLibraryPaneFrameTransparent2')		topSectionHeight: (spriteLabel stringHeight: 'Sprites' localized) + 15.	self middleBarLeftMargin: 0 rightMargin: 6.	self extent: 200@100.! !!ScratchLibraryMorph methodsFor: 'accessing' stamp: 'ee 12/5/2008 16:52' prior: 37143163!clearLibrary	"Remove all library items. My step method will re