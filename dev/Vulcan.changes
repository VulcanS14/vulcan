rue: [s _ UTF8 withAll: s].	super		labels: s		font: MenuStyle defaultFont		lines: dividers.! !!CustomMenu methodsFor: 'construction' stamp: 'jm 5/1/2009 14:15' prior: 34477746!localize	"Localize my labels. Note: This should be called before build."	| s2 |	labels _ labels collect: [:s |		s2 _ (s copyFrom: 2 to: s size - 1) localized asUTF8.		s2 isUnicode ifTrue: [includesUTF8 _ true].		' ', s2, ' '].	title ifNotNil: [title _ title localized].! !!CustomMenu methodsFor: 'construction' stamp: 'jm 5/1/2009 14:16' prior: 41598903!add: aString action: actionItem	"Add the given string as the next menu item. If it is selected, the given action (usually but not necessarily a symbol) will be returned to the client."	| utf8 s |	utf8 _ aString asUTF8.	s _ String new: utf8 size + 2.	s at: 1 put: Character space.	s replaceFrom: 2 to: s size - 1 with: utf8.	s at: s size put: Character space.	labels addLast: s.	selections addLast: actionItem.! !!CustomMenu methodsFor: 'initialize-release' stamp: 'jm 5/1/2009 14:16' prior: 34475019!initialize	labels _ OrderedCollection new.	selections _ OrderedCollection new.	dividers _ OrderedCollection new.	lastDivider _ 0.! !!CustomMenu methodsFor: 'construction' stamp: 'jm 5/1/2009 14:18' prior: 41600283!localize	"Localize my labels. Note: This should be called before build."	| s2 |	labels _ labels collect: [:s |		s2 _ (s copyFrom: 2 to: s size - 1) localized asUTF8.		' ' asUTF8, s2, ' '].	title ifNotNil: [title _ title localized].! !!CustomMenu methodsFor: 'private' stamp: 'jm 5/1/2009 14:18' prior: 41599841!build	"Turn myself into an invokable ActionMenu."	| stream |	stream _ WriteStream on: String new.	labels do: [:label | stream nextPutAll: label; cr].	labels isEmpty ifFalse: [stream skip: -1].  "remove final cr"	super		labels: (UTF8 withAll: stream contents)		font: MenuStyle defaultFont		lines: dividers.! !SelectionMenu subclass: #CustomMenu	instanceVariableNames: 'title labels dividers lastDivider  '	classVariableNames: ''	poolDictionaries: ''	category: 'Tools-Menus'!UTF8 new: 2!self at: 1 put: Character space!!CustomMenu methodsFor: 'construction' stamp: 'jm 5/1/2009 14:21' prior: 41600648!add: aString action: actionItem	"Add the given string as the next menu item. If it is selected, the given action (usually but not necessarily a symbol) will be returned to the client."	| utf8 s |	utf8 _ aString asUTF8.	s _ UTF8 new: utf8 size + 2.	s at: 1 put: Character space.	s replaceFrom: 2 to: s size - 1 with: utf8.	s at: s size put: Character space.	labels addLast: s.	selections addLast: actionItem.! !!CustomMenu methodsFor: 'construction' stamp: 'jm 5/1/2009 14:16' prior: 41602326!add: aString action: actionItem	"Add the given string as the next menu item. If it is selected, the given action (usually but not necessarily a symbol) will be returned to the client."	| utf8 s |	utf8 _ aString asUTF8.	s _ String new: utf8 size + 2.	s at: 1 put: Character space.	s replaceFrom: 2 to: s size - 1 with: utf8.	s at: s size put: Character space.	labels addLast: s.	selections addLast: actionItem.! !ScratchTranslator languageNames!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'jm 5/1/2009 14:25' prior: 41552803!languageMenu: aToggleButtonMorph	"Present a menu of possible languages for blocks."	| bullet menu choice |	ScratchTranslator canRenderUnicode ifFalse: [		"try to find a Unicode plugin in case this is the first use after startup"		ScratchTranslator detectRenderPlugin].	bullet _ UTF8 withAll: '• '.	menu _ CustomMenu new.	ScratchTranslator languageNames do: [:lang |		((ScratchTranslator isoCodeForName: lang) = (ScratchTranslator currentLanguage))			ifTrue: [menu add: (bullet, lang) action: lang]			ifFalse: [menu add: lang action: lang]].self halt.	choice _ menu startUp: nil withCaption: nil at: aToggleButtonMorph bottomLeft + (0@10).	choice ifNil: [^ self].	self stopAll.	self setLanguage: choice.	self recordLanguage: (ScratchTranslator currentLanguage).! !self build!!ScratchFrameMorph methodsFor: 'menu/button actions' stamp: 'ee 4/29/2009 13:18' prior: 41603386!languageMenu: aToggleButtonMorph	"Present a menu of possible languages for blocks."	| bullet menu choice |	ScratchTranslator canRenderUnicode ifFalse: [		"try to find a Unicode plugin in case this is the first use after startup"		ScratchTranslator detectRenderPlugin].	bullet _ UTF8 withAll: '• '.	menu _ CustomMenu new.	ScratchTranslator languageNames do: [:lang |		((ScratchTranslator isoCodeForName: lang) = (ScratchTranslator currentLanguage))			ifTrue: [menu add: (bullet, lang) action: lang]			ifFalse: [menu add: lang action: lang]].	choice _ menu startUp: nil withCaption: nil at: aToggleButtonMorph bottomLeft + (0@10).	choice ifNil: [^ self].	self stopAll.	self setLanguage: choice.	self recordLanguage: (ScratchTranslator currentLanguage).! !ColonSuffix!!CustomMenu methodsFor: 'private' stamp: 'jm 5/1/2009 14:33' prior: 41601704!build	"Turn myself into an invokable ActionMenu."	| stream |	stream _ WriteStream on: String new.	stream nextPutAll: (UTF32 with: 16r200F) asUTF8.  "ensure UTF8"	labels do: [:label | stream nextPutAll: label; cr].	labels isEmpty ifFalse: [stream skip: -1].  "remove final cr"	super		labels: (UTF8 withAll: stream contents)		font: MenuStyle defaultFont		lines: dividers.! !UTF8 withAll: #(239 187 191) asByteArray asString!!UTF8 class methodsFor: 'utilities' stamp: 'jm 5/1/2009 14:36'!byteOrderMark	"Return the UTF8 byte order mark."	^ UTF8 withAll: #(239 187 191) asByteArray asString! !!CustomMenu methodsFor: 'private' stamp: 'jm 5/1/2009 14:37' prior: 41605152!build	"Turn myself into an invokable ActionMenu."	| stream |	stream _ WriteStream on: String new.	stream nextPutAll: UTF8 byteOrderMark. "ensure UTF8"	labels do: [:label | stream nextPutAll: label; cr].	labels isEmpty ifFalse: [stream skip: -1].  "remove final cr"	super		labels: (UTF8 withAll: stream contents)		font: MenuStyle defaultFont		lines: dividers.! !----SNAPSHOT----(1 May 2009 2:37:40 pm) priorSource: 8044057!----SNAPSHOT----(1 May 2009 2:37:55 pm) priorSource: 8051780!----SNAPSHOT----(1 May 2009 2:40:05 pm) priorSource: 8051843!Preferences restoreDefaultFonts!!UTF8 class methodsFor: 'utilities' stamp: 'jm 5/1/2009 14:43' prior: 41605653!byteOrderMark	"Return the UTF8 byte order mark. This is a non-printing character that indicates that a string is really UTF8."	^ UTF8 withAll: #(239 187 191) asByteArray asString! !!UTF8 class methodsFor: 'utilities' stamp: 'jm 5/1/2009 14:44' prior: 41606516!byteOrderMark	"Return the UTF8 byte order mark. This is a non-printing 3-byte Unicode character sometimes used to indicate that a string is encoded as UTF8."	^ UTF8 withAll: #(239 187 191) asByteArray asString! !----QUIT----(1 May 2009 2:44:50 pm) priorSource: 8051906!----STARTUP----(1 May 2009 2:46:40 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 1 May 2009 at 1:06:03 pm'!!ScratchMenuTitleMorph methodsFor: 'accessing' stamp: 'ee 5/1/2009 13:03' prior: 39888708!normalColor	^ Color gray: 0.3! !'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 1 May 2009 at 1:06:03 pm'!!ScratchMenuTitleMorph methodsFor: 'accessing' stamp: 'ee 5/1/2009 13:03' prior: 41607334!normalColor	^ Color gray: 0.3! !----SNAPSHOT----(1 May 2009 3:06:14 pm) priorSource: 8052566!----SNAPSHOT----(1 May 2009 3:06:27 pm) priorSource: 8053155!----SAVEAS Scratch01May09----(1 May 2009 3:06:38 pm)!----STARTUP----(2 May 2009 3:03:39 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchMenuTitleMorph methodsFor: 'event handling' stamp: 'jm 5/2/2009 15:53' prior: 40927779!mouseDown: evt	target isNil | selector isNil ifTrue: [^ self].Display reverse: (0@0 extent: 30@30).	Cursor normal show.	MenuBarIsActive _ tr