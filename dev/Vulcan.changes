ontents: (spec at: 1) localized;			target: self selector: (spec at: 2).		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/8/2009 14:27' prior: 41277708!addShortcutButtonsTo: rowMorph	| buttonSpecs b |	rowMorph addMorphBack: (Morph new extent: (20@5); color: Color transparent).	buttonSpecs _ #(		"name		tool tip				selector"		(save		'Save this project'	saveScratchProjectNoDialog)		(share		'Share this project'	share)	).	AllowSharing ifFalse: [		buttonSpecs _ buttonSpecs select: [:spec | spec first ~= #share]].	buttonSpecs do: [:spec |		b _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver')			offForm: (ScratchFrameMorph skinAt: (spec at: 1), 'Button')			overForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver').		b			target: self;			actionSelector: (spec at: 3);			setBalloonText: (spec at: 2) localized;			actWhen: #buttonUp;			isMomentary: true.		rowMorph addMorphBack: b.		'save' = (spec at: 1) ifTrue: [			rowMorph addMorphBack: (Morph new extent: (8@5); color: Color transparent)]].	rowMorph addMorphBack: (Morph new extent: (20@5); color: Color transparent).! !self width!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/8/2009 14:28' prior: 41279928!addShortcutButtonsTo: rowMorph	| buttonSpecs b |	rowMorph addMorphBack: (Morph new extent: (10@5); color: Color transparent).	buttonSpecs _ #(		"name		tool tip				selector"		(save		'Save this project'	saveScratchProjectNoDialog)		(share		'Share this project'	share)	).	AllowSharing ifFalse: [		buttonSpecs _ buttonSpecs select: [:spec | spec first ~= #share]].	buttonSpecs do: [:spec |		b _ ToggleButton			onForm