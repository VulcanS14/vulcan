ld		10)		(FileChooserContents			Verdana		11)		(FileChooserComment			Verdana		10)		(FilePickerDirectoryName	VerdanaBold		9)		(FilePickerEntry				Verdana		11)		(FilePickerEntryHighlighted	VerdanaBold		11)		(FrameMorphProjectTitle		VerdanaBold		13)	).	fonts _ Dictionary new.	fontSpecs do: [:r |		fonts at: (r at: 1) put: (StrikeFont fontName: (r at: 2) size: (r at: 3))].	Fonts _ fonts.! !ScratchFrameMorph initFonts!!ScratchLibraryMorph methodsFor: 'initialization' stamp: 'rox 11/8/2026 00:12' prior: 42612576!buildSpriteLabel	^ StringMorph new		font: (ScratchFrameMorph getFont: #Tab);		color: (Color gray: 0.5);		contents: 'New sprite:' localized! !!DialogBoxMorph methodsFor: 'private' stamp: 'rox 11/8/2026 00:13' prior: 42587813!buttonLabel: labelString action: actionSelector	"Answer a new button with the given label and selector. The button target will be me and it will use my button forms."	"(DialogBoxMorph new buttonLabel: 'Yes' action: #beep) openInWorld"	| onForm offForm button overForm |	onForm _ ScratchFrameMorph skinAt: #dialogButtonFrameOver.	offForm _ ScratchFrameMorph skinAt: #dialogButtonFrame.	overForm _ ScratchFrameMorph skinAt: #dialogButtonFrame.	button _ ResizableToggleButton2 new		offForm: offForm		onForm: onForm		overForm: overForm.	^ button		padding: 39@22;		label: labelString font: (ScratchFrameMorph getFont: #DialogBoxButton);		target: self;		actionSelector: actionSelector;		setLabelColorOn: (Color white) off: (Color white)! !!DialogBoxMorph methodsFor: 'accessing' stamp: 'rox 11/8/2026 00:13' prior: 42591101!shortcutButtonLabel: labelString action: actionSelector icon: aSymbol	"Answer a new shortcut button with the given label and selector. A shortcut button has a folder icon on it. The button target will be me and it will use my button forms. Icon can be: #folderIcon, #folderCatIcon, #folderHouseIcon #folderPicIcon, #folderSoundIcon"	"(DialogBoxMorph new shortcutButtonLabel: 'Yes' action: #beep isCat: true) openInWorld"	| onForm offForm button |	onForm _ ScratchFrameMorph skinAt: #dialogButtonFrameOver.	offForm _ ScratchFrameMorph skinAt: #dialogButtonFrame.	button _ ResizableToggleButton2 new		offForm: offForm		onForm: onForm		overForm: offForm.	button addMorph: (ImageMorph new form: (ScratchFrameMorph skinAt: aSymbol)).	^ (button		label: labelString localized font: (ScratchFrameMorph getFont: #FolderShortcut);		target: self;		actionSelector: actionSelector;		setLabelColorOn: (Color white) off: (Color white)).! !!ScratchFrameMorph class methodsFor: 'scratch skin' stamp: 'rox 11/8/2026 00:14' prior: 42651345!initFonts	"self initFonts"	| fontSpecs fonts |	fontSpecs _ #(		(Arg						Verdana		10)		(Label			VerdanaBoldNarrowSpace	10)		(MenuTitle					VerdanaBold		12)		(Button						VerdanaBold		10)		(Category					VerdanaBold		10)		(Tab						VerdanaBold		11)		(CommentBlock				Verdana		10)		(TalkBubble					VerdanaBold		12)		(ToolTip						Verdana		12)		(ReporterToolTip				Verdana		12)		(XYReadout					Verdana		10)		(XYReadoutBold				VerdanaBold		10)		(CostumesPage				VerdanaBold		11)		(SoundsPage					VerdanaBold		11)		(ViewerPage				VerdanaBold		11)		(UpdatingStringField			VerdanaBold		11)		(Watcher					VerdanaBold		10)		(WatcherLarge				VerdanaBold		14)		(PaintUtilityButton			VerdanaBold		10)		(PaintSetRotationCenter		VerdanaBold		11)		"Library"		(LibraryItemName			VerdanaBold		9)		(LibraryItemInfo			Verdana		6)		(MediaItemIndex				VerdanaBold		9)		(MediaItemInfo				Verdana		9)		"Dialog Boxes"		(DialogBoxTitle				VerdanaBold		12)		(DialogBoxMessage			VerdanaBold		11)		(DialogBoxButton			VerdanaBold		11)		(ProjectNotes				Verdana		10)		(LinkMorphDefault			VerdanaBold		10)		(ShareLink					VerdanaBold		11)		(SoundRecorderButton		VerdanaBold		11)		(SoundRecorderTimer		VerdanaBold		10)		(StringDialogTypeIn			Verdana		11)		(NewVariableDialogBox		Verdana		11)		(AboutScratch				VerdanaBold		11)		(UploadTagLabel		