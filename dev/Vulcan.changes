 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !self beep!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/8/2009 14:16' prior: 41270331!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector"		(File			fileMenu:)		(Edit			editMenu:)		(Share			shareMenu:)		(Language		languageMenu:)		(Help			helpMenu:)	).	AllowSharing ifFalse: [		menuSpecs _ menuSpecs select: [:spec | spec second ~= #shareMenu:]].	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2).		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	(TakeOverScreen | self class isXO | true) ifTrue: [self beep.		closeButton _ IconicButton new			labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 4/8/2009 14:17' prior: 41194944!createViewModeButtonsPanel	| specs bName button closeButton |	viewModeButtonsPanel _ AlignmentMorph newRow color: Color transparent.	viewModeButtons _ OrderedCollection new.	specs _ OrderedCollection new.	ScratchFrameMorph quarterModeEnabled ifTrue: [		specs add: #(quarter		enterQuarterMode	'Switch to small stage')].	ScratchFrameMorph normalModeEnabled ifTrue: 