tchSession.			menu add: 'Join Mesh' action: #joinScratchSession].! !ScratchFrameMorph version: '1.4 (internal of ', (Date today printFormat: #(1 2 3 $- 2 2)), ')'.!----SNAPSHOT----(5 June 2009 2:22:48 pm) priorSource: 8483747!----SNAPSHOT----(5 June 2009 2:23:20 pm) priorSource: 8488202!----SAVEAS Scratch05Jun09----(5 June 2009 2:23:30 pm)!----STARTUP----(5 June 2009 7:44:57 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchStageMorph methodsFor: 'private' stamp: 'jm 6/5/2009 19:46' prior: 37485956!resetSensorBoardself beep.	sensorBoard delete.	sensorBoard _ SensorBoardMorph new.! !!SensorBoardMorph methodsFor: 'serial port' stamp: 'jm 6/5/2009 20:57'!setPort: aSerialPort name: aString	"Uset the given serial port."	portName _ aString.	port _ aSerialPort.	lastPollMSecs _ Time millisecondClockValue.! !!SensorBoardMorph methodsFor: 'serial port' stamp: 'jm 6/5/2009 20:57'!port	^ port! !!SensorBoardMorph methodsFor: 'serial port' stamp: 'jm 6/5/2009 20:57'!portName	^ portName! !!ScratchStageMorph methodsFor: 'private' stamp: 'jm 6/5/2009 20:58' prior: 42042999!resetSensorBoard	sensorBoard delete.	sensorBoard _ SensorBoardMorph new		setPort: sensorBoard port name: sensorBoard portName.! !----QUIT----(5 June 2009 9:02:16 pm) priorSource: 8488266!----STARTUP----(5 June 2009 9:05:27 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!SensorBoardMorph methodsFor: 'serial port' stamp: 'jm 6/5/2009 21:08' prior: 42043161!setPort: aSerialPort name: aString	"Uset the given serial port."	portName _ aString.	port _ aSerialPort.	lastPollMSecs _ Time millisecondClockValue.	(port notNil and: [port isOpen]) ifTrue: [scanState = #on].! !!ScratchFrameMorph methodsFor: 'private' stamp: 'jm 6/5/2009 21:11' prior: 41464562!updatePanes	| p |	menuPanel delete.	self createMenuPanel.	toolbarPanel delete.	self createToolbar.	viewModeButtonsPanel delete.	self createViewModeButtonsPanel.	stageButtonsPane