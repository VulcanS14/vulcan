sRunning _ (MotorA ~= 0) | (MotorB ~= 0).	(wasRunning and: [isRunning not]) ifTrue: [		MotorStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:30'!motorBSpeed: n	"Set the speed of motor B. Range is -100 to 100, where 0 is off and the sign determines the direction."	| wasRunning isRunning |	wasRunning _ (MotorA ~= 0) | (MotorB ~= 0).	MotorB _ (1.27 * n) rounded within: -127 and: 127.	isRunning _ (MotorA ~= 0) | (MotorB ~= 0).	(wasRunning and: [isRunning not]) ifTrue: [		MotorStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:31' prior: 39135013!motorASpeed: n	"Set the speed of motor A. Range is -100 to 100, where 0 is off and the sign determines the direction."	| wasRunning isRunning |	wasRunning _ (MotorA ~= 0) | (MotorB ~= 0).	MotorA _ (1.27 * n) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	isRunning _ (MotorA ~= 0) | (MotorB ~= 0).	(wasRunning and: [isRunning not]) ifTrue: [		MotorStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:31' prior: 39135466!motorBSpeed: n	"Set the speed of motor B. Range is -100 to 100, where 0 is off and the sign determines the direction."	| wasRunning isRunning |	wasRunning _ (MotorA ~= 0) | (MotorB ~= 0).	MotorB _ (1.27 * n) rounded within: -127 and: 127.	self sendStatus: 64 motorA: MotorA motorB: MotorB.	isRunning _ (MotorA ~= 0) | (MotorB ~= 0).	(wasRunning and: [isRunning not]) ifTrue: [		MotorStopTime _ Time millisecondClockValue].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:32' prior: 39133884!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is available."	"Note: read as much data as available (it will be multiple of 9 bytes) and take the last 9 bytes read to get the most recent values."	"Note: ID's are meaningless while the motor is running and for about a second after it has been turned off."	"self readInputs"	| buf n |	buf _ ByteArray new: 288. "32 * 9"	n _ WeDoPlugin readInto: buf.	n < 9 ifTrue: [^ nil].	buf _ buf copyFrom: n - 8 to: n.	PortAValue _ buf at: 4.	PortBValue _ buf at: 6.	(MotorA = 0) & (MotorB = 0) ifTrue: [		PortAID _ self mapID: (buf at: 5).		PortBID _ self mapID: (buf at: 7)].! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:36'!motorsStopped	| now |	"Answer true if no motor has run in the past second."	(MotorA ~= 0) | (MotorB ~= 0) ifTrue: [^ false].  "currently running"	now _ Time millisecondClockValue.	(MotorStopTime isNil or:	 [now < MotorStopTime]) ifTrue: [		MotorStopTime _ 0].	^ (now - MotorStopTime) > 1000! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:36' prior: 39137725!motorsStopped	"Answer true if no motor has run in the past second."	| now |	(MotorA ~= 0) | (MotorB ~= 0) ifTrue: [^ false].  "currently running"	now _ Time millisecondClockValue.	(MotorStopTime isNil or:	 [now < MotorStopTime]) ifTrue: [		MotorStopTime _ 0].	^ (now - MotorStopTime) > 1000! !!WeDoPlugin class methodsFor: 'polling' stamp: 'jm 12/3/2008 15:36' prior: 39136977!readInputs	"Return an array of the form <id1> <value1> <id2> <value2>. Answer nil if no data is available."	"Note: read as much data as available (it will be multiple of 9 bytes) and take the last 9 bytes read to get the most recent values."	"Note: ID's are meaningless while the motor is running and for about a second after it has been turned off."	"self readInputs"	| buf n |	buf _ ByteArray new: 288. "32 * 9"	n _ WeDoPlugin readInto: buf.	n < 9 ifTrue: [^ nil].	buf _ buf copyFrom: n - 8 to: n.	PortAValue _ buf at: 4.	PortBValue _ buf at: 6.	self motorsStopped ifTrue: [		PortAID _ self mapID: (buf at: 5).		PortBID _ self mapID: (buf at: 7)].! !----QUIT----(3 December 2008 6:20:36 pm) priorSource: 5575699!----STARTUP----(4