l: 'Backgrounds' action: #scratchBackgrounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sound) & (sounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Sounds' action: #scratchSounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Desktop' action: #desktop icon: #folderIcon).	shortcutColumn addMorphBack: spacer fullCopy.	shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Home' action: #myHome icon: #folderHouseIcon).	shortcutColumn addMorphBack: spacer fullCopy.	shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Computer' action: #myComp icon: #folderIcon).	shortcutColumn addMorphBack: spacer fullCopy.	(#(costume #background) includes: self type) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Pictures' action: #myPics icon: #folderPicIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sound) & (sounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Music' action: #myMusic icon: #folderSoundIcon).		shortcutColumn addMorphBack: spacer fullCopy].! !self beep.!!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/19/2009 19:35' prior: 40216001!myScratchProjects	"My Scratch Projects button was pressed."	| projects |self beep.	projects _ ScratchFileChooserDialog getDefaultFolderForType: #project.	projects ifNotNil: [list currentDirectory: projects].! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/19/2009 19:37' prior: 36951198!myHome	"My Home button was pressed."	| dir |	dir _ FileDirectory on: (ScratchPlugin primGetFolderPath: 1).	list currentDirectory: dir.! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'ee 6/28/2008 13:24' prior: 40220122!myHome	"My Home button was pressed."	list currentDirectory: (ScratchPlugin primGetFolderPath: 1).! !!ScratchFileChoo