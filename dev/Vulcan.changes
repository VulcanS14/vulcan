turn the path to the user's 'Scratch' project folder, usually located inside the user's 'Documents' folder. If the folder does not already exists, attempt to create it. If the .ini file specifies an alternate home directory, create the folder there. If the directory can't be created, return the user's home folder."	| scratchFolderName homeDir |	scratchFolderName _ 'Scratch Projects'.  "if this were localized a user could get multiple project folders for different languages..."	homeDir _ FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	(FileDirectory default directoryExists: homeDir pathName) ifFalse: [		homeDir _ FileDirectory on: (ScratchPlugin primGetFolderPath: 1)].  "home"	UserHomeFolder ifNotNil: [homeDir _ UserHomeFolder]. "home is overridden by .ini file"	(homeDir directoryExists: scratchFolderName) ifFalse: [		homeDir createDirectory: scratchFolderName].	(homeDir directoryExists: scratchFolderName)		ifTrue: [^ homeDir directoryNamed: scratchFolderName]		ifFalse: [^ homeDir].! !ScratchFileChooserDialog removeSelector: #scratchFolder!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/7/2009 15:38' prior: 40733206!getDefaultFolderForType: type	| f |	(type = #costume) ifTrue: [f _ DefaultCostumeFolder].	(type = #background) ifTrue: [f _ DefaultBackgroundFolder].	(type = #project) ifTrue: [f _ self userScratchProjectsDir].	(type = #sprite) ifTrue: [f _ DefaultSpriteFolder].	(type = #stage) ifTrue: [f _ DefaultStageFolder].	(type = #sound) ifTrue: [f _ DefaultSoundFolder].	f ifNotNil: [		(f isKindOf: FileDirectory) ifTrue: [			(f parentDirectory directoryExists: f pathName) ifTrue: [^ f]]].	^ FileDirectory on: self homeDir! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/7/2009 15:39' prior: 41691300!getDefaultFolderForType: type	| f |	(type = #costume) ifTrue: [f _ DefaultCostumeFolder].	(type = #background) ifTrue: [f _ DefaultBackgroundFolder].	(type = #project) ifTrue: [f _ self userScratchProjectsDir].	(type = #sprite) ifTrue: [f _ DefaultSpriteFolder].	(type = #sound) ifTrue: [f _ DefaultSoundFolder].	f ifNotNil: [		(f isKindOf: FileDirectory) ifTrue: [			(f parentDirectory directoryExists: f pathName) ifTrue: [^ f]]].	^ FileDirectory on: self homeDir! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/7/2009 15:40' prior: 36960916!getLastFolderForType: type	| f |	(type = #costume) ifTrue: [f _ LastCostumeFolder].	(type = #background) ifTrue: [f _ LastBackgroundFolder].	(type = #project) ifTrue: [f _ LastProjectFolder].	(type = #sprite) ifTrue: [f _ LastSpriteFolder].	(type = #sound) ifTrue: [f _ LastSoundFolder].	f ifNotNil: [		(f isKindOf: FileDirectory) 			ifTrue: [(f parentDirectory directoryExists: f pathName) ifTrue: [^ f]]].	^ ScratchFileChooserDialog getDefaultFolderForType: type! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/7/2009 15:40' prior: 36961533!setLastFolderTo: dir forType: t	(dir isKindOf: ScratchServerDirectory) ifTrue: [^ self].	(t = #costume) ifTrue: [LastCostumeFolder _ dir].	(t = #background) ifTrue: [LastBackgroundFolder _ dir].	(t = #project) ifTrue: [LastProjectFolder _ dir].	(t = #sprite) ifTrue: [LastSpriteFolder _ dir].	(t = #sound) ifTrue: [LastSoundFolder _ dir].! !ScratchFilePicker removeSelector: #addShortcuts:!!ScratchFileChooserDialog class methodsFor: 'class initialization' stamp: 'jm 5/7/2009 15:45' prior: 40358998!initialize	| media |	LastBackgroundFolder _ nil.	LastCostumeFolder _ nil.	LastProjectFolder _ nil.	LastSoundFolder _ nil.	LastSpriteFolder _ nil.	UserHomeFolder _ nil.	DefaultBackgroundFolder _ FileDirectory default.	DefaultCostumeFolder _ FileDirectory default.	DefaultSoundFolder _ FileDirectory default.	DefaultSpriteFolder _ FileDirectory default.	(FileDirectory default directoryExists: 'Media') ifTrue: [		media _ FileDirectory default directoryNamed: 'Media'.		DefaultSpriteFolder _ media.		(media directoryExists: 'Backgrounds') ifTrue: [			DefaultBackgroundFolder _ media directoryNamed: 'Backgrounds'].		(media directoryExists: 'Costumes') ifTrue: [			DefaultCostumeFolder _ DefaultSpriteFolder _ media directoryNamed: 'Costumes'].		(media directoryExists: 'Sounds') ifTrue: [			DefaultSoundFolder _ media directoryNamed: 'Sounds']].! !DialogBoxMorph subclass: #ScratchFileChooserDialog	instanceVariableNames: 'scratchFrame list choosingFolder newFileTitle newFileName thumbnailFrameMorph thumbnailMorph authorLabelMorph authorMorph commentLabelMorph commentMorph readingScratchFile type newTitleBin '	classVariableNames: 'DefaultBackgroundFolder DefaultCostumeFolder  DefaultSoundFolder DefaultSpriteFolder  LastBackgroundFolder LastCostumeFolder LastProjectFolder LastSoundFolder LastSpriteFolder  UserHomeFolder '	poolDictionaries: ''	category: 'Scratch-UI-Dialogs'!Undeclared!Smalltalk cleanOutUndeclared!Undeclared!----QUIT----(7 May 2009 3:47:43 pm) priorSource: 8135419!----STARTUP----(8 May 2009 9:22:12 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!Preferences restoreMVCMenuFont!!ScratchFileChooserDialog class methodsFor: 'class initialization' stamp: 'jm 5/8/2009 09:32'!clearLastFolder	"Clear the LastFolderForType dictionary."	LastFolderForType _ Dictionary new.! !!ScratchFileChooserDialog class methodsFor: 'class initialization' stamp: 'jm 5/8/2009 09:32' prior: 41695358!clearLastFolder	"Clear the LastFolderForType dictionary."	LastFolderForType _ Dictionary new.! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/8/2009 09:36' prior: 41692517!getLastFolderForType: type	| dir |	"Return the last used folder for the given type. If this is the first time the type has been used, return the default folder for that type."	dir _ LastFolderForType at: type ifAbsent: [nil].	dir ifNotNil: [		(dir isKindOf: FileDirectory) 			ifTrue: [(dir parentDirectory directoryExists: dir pathName) ifTrue: [^ dir]]].	^ ScratchFileChooserDialog getDefaultFolderForType: type! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/8/2009 09:36' prior: 41695772!getLastFolderForType: type	"Return the last used folder for the given type. If this is the first time the type has been used, return the default folder for that type."	| dir |	dir _ LastFolderForType at: type ifAbsent: [nil].	dir ifNotNil: [		(dir isKindOf: FileDirectory) 			ifTrue: [(dir parentDirectory directoryExists: dir pathName) ifTrue: [^ dir]]].	^ ScratchFileChooserDialog getDefaultFolderForType: type! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/8/2009 09:37' prior: 41693098!setLastFolderTo: dir forType: type	(dir isKindOf: ScratchServerDirectory) ifTrue: [^ self].	LastFolderForType at: type put: dir.! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 5/8/2009 09:37' prior: 41696824!setLastFolderTo: dir forType: type	"Remember the given dir as the last folder used for the given type of file."	(dir isKindOf: ScratchServerDirectory) ifTrue: [^ self].	LastFolderForType at: type put: dir.! !!ScratchFileChooserDialog class methodsFor: 'class initialization' stamp: 'jm 5/8/2009 09:37' prior: 41693610!initialize	| media |"xxx	LastBackgroundFolder _ nil.	LastCostumeFolder _ nil.	LastProjectFolder _ nil.	LastSoundFolder _ nil.	LastSpriteFolder _ nil.xxx"	UserHomeFolder _ nil.	DefaultBackgroundFolder _ FileDirectory default.	DefaultCostumeFolder _ FileDirectory default.	DefaultSoundFolder _ FileDirectory default.	DefaultSpriteFolder _ FileDirectory default.	(FileDirectory default directoryExists: 'Media') ifTrue: [		media _ FileDirectory default directoryNamed: 'Media'.		DefaultSpriteFolder _ media.		(media directoryExists: 'Backgrounds') ifTrue: [			DefaultBackgroundFolder _ media directoryNamed: 'Backgrounds'].		(media directoryExists: 'Costumes') ifTrue: [			DefaultCostumeFolder _ D