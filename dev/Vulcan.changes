nt.	tagLabelMorph color: (Color gray: 0.3).	mainColumn		addMorphBack: (spacer fullCopy extent: (5@6));		addMorphBack: tagLabelMorph;		addMorphBack: (spacer fullCopy extent: (5@0)).	panel _ AlignmentMorph newRow color: Color transparent;		hResizing: #shrinkWrap;		vResizing: #shrinkWrap.	col1 _ AlignmentMorph newColumn		hResizing: #shrinkWrap;		color: Color transparent.	col2 _ AlignmentMorph newColumn		hResizing: #shrinkWrap;		color: Color transparent.	button _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #watcherButtonPressed)		offForm: (ScratchFrameMorph skinAt: #watcherButton).	popularTagCheckBoxes _ popularTagList collect: [:tag |		b _ button fullCopy			label: tag localized			font: labelFont;			setLabelColor: (Color gray: 0.3).		ScratchTranslator isRTL			ifTrue: [b label position: ((-1*(b label stringWidth: tag capitalized)) - 5)@0]			ifFalse: [b label position: 19 @ 0].		b].	halfway _ (popularTagCheckBoxes size // 2) + 1.	1 to: halfway do: [:i |		col1 addMorphBack: (popularTagCheckBoxes at: i).		(i = halfway) ifFalse: [			col1 addMorphBack: spacer fullCopy]].	halfway to: popularTagCheckBoxes size do: [:i |		col2 addMorphBack: (popularTagCheckBoxes at: i).		(i = popularTagCheckBoxes size) ifFalse: [			col2 addMorphBack: spacer fullCopy]].	panel		addMorphBack: col1;		addMorphBack: col2.	mainColumn		addMorphBack: panel.	moreTagsLabelMorph _ tagLabelMorph fullCopy contents: 'More tags:' localized.	mainColumn		addMorphBack: (spacer fullCopy extent: (5@0));		addMorphBack: moreTagsLabelMorph;		addMorphBack: (spacer fullCopy extent: (5@6)).	tagMorphs _ (1 to: 4) collect: [:i |		StringFieldMorph new			color: self color;			font: contentsFont;			width: 140].	tagMorphs reverseDo: [:m |		tabFields add: m.		mainColumn addMorphBack: m.		mainColumn addMorphBack: spacer fullCopy].	"add compression checkbox"	compressionCheckbox _ button fullCopy		label: 'Compress sounds and images' localized		font: labelFont;		setLabelColor: (Color gray: 0.3);		on.	compressionCheckbox label position: (19@0) - ((0@vOffset) // 3).	mainColumn addMorphBack: compressionCheckbox.! !!ScratchUploadDialog methodsFor: 'other' stamp: 'ee 1/30/2009 17:05' prior: 37577967!createUploadDialogFor: aScratchFrameMorph	"Create a Scratch file chooser dialog box with a project thumbnail and info box."	| labelFont contentsFont commentFont notes passLinkBin |	scratchFrame _ aScratchFrameMorph.	self title: 'Upload to Scratch Server'.	ScratchFrameMorph shareServer ifNotNil: [		titleMorph contents: titleMorph contents, ' (', ScratchFrameMorph shareServer, ')'].	labelFont _ (ScratchFrameMorph getFont: #UploadDialogLabel).	contentsFont _ (ScratchFrameMorph getFont: #UploadDialogContents).	commentFont _ (ScratchFrameMorph getFont: #UploadDialogComment).	thumbnailFrameMorph _ ImageMorph new		form: (ScratchFrameMorph skinAt: #dialogThumbnailFrame).	mainColumn addMorphBack: thumbnailFrameMorph.	thumbnailMorph _ (ImageMorph new form: scratchFrame workPane thumbnailForm).	thumbnailFrameMorph addMorphFront: (thumbnailMorph position: (thumbnailFrameMorph position + (5@5))).	authorLabelMorph _ StringMorph contents: 'Your Scratch website login name:' localized font: labelFont.	authorLabelMorph color: (Color gray: 0.3).	fileInfoColumn addMorphBack: authorLabelMorph.	authorMorph _ StringFieldMorph new		useStringFieldFrame;		contents: scratchFrame loginName;		font: contentsFont.	fileInfoColumn addMorphBack: authorMorph.	linkMorph _ LinkMorph new		contents: 'Create account' localized;		url: 'http://', ScratchFrameMorph shareServer.	passLinkBin _ AlignmentMorph newRow		vResizing: #shrinkWrap;		hResizing: #spaceFill;		color: Color transparent.	ScratchFrameMorph isXO ifFalse: [passLinkBin addMorphBack: linkMorph].	passwordLabelMorph _ StringMorph contents: 'Password:' localized font: labelFont.	passwordLabelMorph color: (Color gray: 0.3).	passLinkBin		addMorphFront: (AlignmentMorph newSpacer: Color transparent);		addMorphFront: passwordLabelMorph.	fileInfoColumn addMorphBack: passLinkBin.	ScratchTranslator isRTL			ifTrue: [passLinkBin submorphs reversed do: [:m |				m delete.				passLinkBin addMorphBack: m]].	passwordMorph _ StringFieldMorph new		useStringFieldFrame;		passwordMode: true;		contents: scratchFrame loginPassword;		font: contentsFont.	fileInfoColumn addMorphBack: passwordMorph.	projectNameLabelMorph _ StringMorph		contents: 'Project name' localized, ScratchTranslator colonSuffix		font: labelFont.	projectNameLabelMorph color: (Color gray: 0.3).	fileInfoColumn addMorphBack: projectNameLabelMorph.	projectNameMorph _ StringFieldMorph new		useStringFieldFrame;		contents: scratchFrame projectName;		font: contentsFont.	fileInfoColumn addMorphBack: projectNameMorph.	(scratchFrame projectInfo includesKey: 'comment')		ifTrue: [notes _ (scratchFrame projectInfo at: 'comment')]		ifFalse: [notes _ ''].	commentLabelMorph _ StringMorph		contents: 'Project notes' localized, ScratchTranslator colonSuffix		font: labelFont.	commentLabelMorph color: authorLabelMorph color.	fileInfoColumn addMorphBack: commentLabelMorph.	commentMorph _ ScrollingStringMorph new		borderWidth: 0;		contents: notes;		font: commentFont;		backForm: (ScratchFrameMorph skinAt: #stringFieldFrame).	commentMorph		width: 300;		height: 165.	fileInfoColumn addMorphBack: commentMorph.	self addTagFields.	tabFields		add: authorMorph;		add: passwordMorph;		add: projectNameMorph;		add: commentMorph.	fileInfoColumn addMorphBack: buttonRow.	bottomSpacer delete.	bottomSpacer _ nil.! !!ScratchUploadDialog methodsFor: 'other' stamp: 'ee 1/30/2009 16:58' prior: 37581415!getUserResponse	"Wait for the user to respond, then answer #ok or #cancelled."	"Details: This is invoked synchronously from the caller. In order to keep processing inputs and updating the screen while waiting for the user to respond, this method has its own version of the World's event loop."	| w |	self openInWorld.	w _ self world.	self extent: self extent.  "force layout"	self position: w center - (self extent // 2) + (0@5).  "center on screen but ignore the bottom shadow"	w activeHand newKeyboardFocus: authorMorph.	response _ #cancelled.  "default response"	done _ false.	[done] whileFalse: [		[done] whileFalse: [w doOneCycle].			response = #cancelled ifTrue: [			self delete.			w doOneCycle.  "erase myself from the screen"			^ #cancelled].		response _ #cancelled.  "default response"		done _ self checkAndHighlightRequiredFields.		done ifFalse: [self openInWorld]].	scratchFrame loginName: authorMorph contents.	scratchFrame loginPassword: passwordMorph contents.	self delete.	w doOneCycle.  "erase myself from the screen"	^ #ok! !!ScratchViewerMorph methodsFor: 'initialization' stamp: 'ee 1/29/2009 13:44' prior: 39171112!initialize	super initialize.	self		initFrontFromForm: (ScratchFrameMorph skinAt: #blocksPaletteFrameTransparent2)		topSectionHeight: 120.	self middleBarLeftMargin: 5 rightMargin: 0.	color _ (Color r: 0.584 g: 0.603 b: 0.623).	pageViewer _ ScrollFrameMorph2 new growthFraction: 0.1.	self addMorphBack: (pageViewer position: self position + (0@120)).	self target: nil.	self extent: 214@500.! !!ScratchViewerMorph methodsFor: 'initialization' stamp: 'ee 1/29/2009 13:45' prior: 37603509!rebuildCategorySelectors	| catList maxExtent buttons label offForm onForm overForm b pad leftColumnX rightColumnX x y |	catList _ #(		motion		control		looks		sensing		sound		numbers		pen			variables).	"First, delete the old category buttons"	submorphs do: [:m | (m isKindOf: ResizableToggleButton2) ifTrue: [m delete]].	"Create new buttons, keeping track of the maximum extent."	maxExtent _ 75@0.	buttons _ catList collect: [:cat |		label _ (ScratchTranslator translationFor: cat asString) capitalized.		offForm _ (ScratchFrameMorph skinAt: cat).		onForm _ (ScratchFrameMorph skinAt: (cat, 'Pressed')).		overForm _ (ScratchFrameMorph skinAt: (cat, 'Over')).		ScratchTranslator isRTL			ifTrue:[				b _ ResizableToggleButton2 new					offForm:	(offForm flipBy: #horizontal centerAt: offForm center)					onForm:		(onForm flipBy: #horizontal centerAt: onForm center)					overForm:	(overForm flipBy: #horizontal centerAt: overForm center)]			ifFalse:[				b _ ResizableToggleButton2 new					offForm:	offForm					onForm:		onForm					overForm:	overForm].		b			label: label font: (ScratchFrameMorph getFont: #Category);			setLabelColor: Color white;			target: self;			actionSelector: #currentCategory:;			arguments: (Array with: cat);			toggleButtonMode: true;			toggleMode: false.		ScratchTranslator isRTL			ifTrue:[b rightJustifyInset: 10]			ifFalse:[b leftJustifyInset: 10].		maxExtent _ maxExtent max: (b extent + (3 @ -6)).		b].	"calculate catButtonsExtent"	pad _ 15. "padding on left, right, and betwen the button columns"	catButtonsExtent _ ((2 * maxExtent x) + (3 * pad)) @ (((catList size // 2) * (maxExtent y + 6)) + 25).	"place the buttons"	leftColumnX _ self left + 12 + pad.	rightColumnX _ leftColumnX + maxExtent x + pad.	x _ leftColumnX.	y _ self top + 17.	1 to: buttons size do: [:i |		b _ buttons at: i.		b extent: maxExtent.		self addMorph: (b position: x@y).		i even			ifTrue: [x _ leftColumnX. y _ y + b height + 6]			ifFalse: [x _ rightColumnX]].	self width: catButtonsExtent x.	pageViewer position: self position + (0@catButtonsExtent y).	topSectionHeight _ catButtonsExtent y - 4.! !!ScriptableScratchMorph methodsFor: 'blocks' stamp: 'ee 2/3/2009 13:32' prior: 37666585!addGenericListBlocksTo: page y: startY	"Add the generic list blocks to the given page starting at the given y offset."	| addButton deleteButton x y hasLists stage |	addButton _ ScratchFrameMorph		buttonLabel: 'Make a list' localized		selector: #addList.	(self isKindOf: ScratchStageMorph) ifTrue: [addButton actionSelector: #addGlobalList].	deleteButton _ ScratchFrameMorph		buttonLabel: 'Delete a list' localized		selector: #deleteList.	x _ 13.	y _ startY + 10.	page addMorph: (addButton target: self; position: x@y).	y _ addButton bottom + 3.	hasLists _ self listVarNames size > 0.	(stage _ self ownerThatIsA: ScratchStageMorph) ifNotNil: [		stage listVarNames size > 0 ifTrue: [hasLists _ true]].	hasLists ifFalse: [^ self].	page addMorph: (deleteButton target: self; position: x@y).	y _ deleteButton bottom + 10.	y _ (self addListReportersTo: page x: x y: y) + 10.	(self blocksFor: 'list') do: [:blockOrSym |		(blockOrSym = #-) | (blockOrSym = #~)			ifTrue: [				(blockOrSym = #-) ifTrue: [y _ y + 15].	"insert a full space"				(blockOrSym = #~) ifTrue: [y _ y + 5]]	"insert a half space"			ifFalse: [				y _ self createBlock: blockOrSym atPosition: x@y onPage: page.				page submorphs last color: ScriptableScratchMorph listBlockColor]].! !!ScriptableScratchMorph methodsFor: 'blocks' stamp: 'ee 1/29/2009 12:26' prior: 37685233!variablesPage	"Answer a morph containing my variables."	| page addButton deleteButton hasVars stage x y maxX |	page _ ScratchBlockPaletteMorph new		color: (Color r: 0.8 g: 0.8 b: 1.0);		borderWidth: 0.	addButton _ ScratchFrameMorph		buttonLabel: 'Make a variable' localized		selector: #addGlobalVariable.	(self isKindOf: ScratchSpriteMorph) ifTrue: [addButton actionSelector: #addVariable].	deleteButton _ ScratchFrameMorph		buttonLabel: 'Delete a variable' localized		selector: #deleteVariable.	x _ 13.	page addMorph: (addButton target: self; position: x@7).	y _ addButton bottom + 3.	hasVars _ self varNames size > 0.	(stage _ self ownerThatIsA: ScratchStageMorph) ifNotNil: [		stage varNames size > 0 ifTrue: [hasVars _ true]].	hasVars ifTrue: [		page addMorph: (deleteButton target: self; position: x@y).		y _ deleteButton bottom + 10.		y _ self addVariableReportersTo: page x: x y: y.		y _ y + 12.		y _ self addGenericVariableBlocksTo: page x: x y: y].	self addGenericListBlocksTo: page y: y.	page updateWatcherButtonsForFrame: (self ownerThatIsA: ScratchFrameMorph).	maxX _ page submorphs inject: 0 into: [:t :m | t max: m right].	page extent: (maxX + 10) @ y.	^ page! !ScratchTabPaneMorph removeSelector: #bar!ScratchTabPaneMorph removeSelector: #bar!ScratchTabPaneMorph removeSelector: #bar:!ScratchTabPaneMorph removeSelector: #bar:!ScratchTabPaneMorph removeSelector: #extent:!ScratchTabPaneMorph removeSelector: #extent:!PasteUpMorph subclass: #ScratchTabPaneMorph	instanceVariableNames: 'targetPane currentTab lastTabAdded barForm '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Support'!ScratchScriptsMorph removeSelector: #handlesMouseOverDragging:!ScratchScriptEditorMorph removeSelector: #drawFrameOn:!ScratchFrameMorph removeSelector: #extraMenu!ScratchFrameMorph removeSelector: #extraMenu!ScratchFrameMorph removeSelector: #fixProjectNameLayout!Morph subclass: #ScratchFrameMorph	instanceVariableNames: 'topPane viewerPane scriptsPane stageFrame workPane titlePane offscreenStage libraryPane menuPanel buttonPanel readoutPane logoMorph projectTitleMorph flagButton fillScreenFlag paintingInProgress projectDirectory projectName projectInfo author loginName loginPassword watcherPositions shuffledCostumeNames justSaved viewModeButtons viewMode lastViewMode '	classVariableNames: 'ClassmateDemo Clipboard DefaultSprite Fonts FontsXO IsXO MinHeight MinWidth NormalModeEnabled Platform QuarterModeEnabled ScratchServers ScratchSkin ScratchSkinXO ShareServer ShareServerPath TakeOverScreen UseErrorCatcher Version VersionDate VisibleDrives WorkpaneExtent '	poolDictionaries: ''	category: 'Scratch-UI-Panes'!Smalltalk removeClassNamed: #ScratchPaneDivider!Smalltalk removeClassNamed: #ScratchPaneDivider!----SNAPSHOT----(3 February 2009 6:43:18 pm) priorSource: 6298496!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 27 January 2009 at 9:34:01 pm'!AlignmentMorph subclass: #ScratchCommentMorph	instanceVariableNames: 'labelMorph resizeMorph commentMorph showHideMorph isShowing isResizing resizeOffset autoAlign connector anchor offset '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Support'!Morph subclass: #ScratchConnectorMorph	instanceVariableNames: 'anchorPoint targetPoint point2 point1 '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Support'!!BlockMorph methodsFor: 'dropping/grabbing' stamp: 'jens 1/26/2009 00:18'!acceptDroppingMorph: aMorph event: evt	"This message is sent when a morph is dropped onto a morph that has agreed to accept the dropped morph by responding 'true' to the wantsDroppedMorph:Event: message. This default implementation just adds the given morph to the receiver."	(aMorph isKindOf: ScratchCommentMorph)		ifTrue: [owner acceptDroppingMorph: aMorph event: evt]		ifFalse: [super acceptDroppingMorph: aMorph event: evt].! !!BlockMorph methodsFor: 'dropping/grabbing' stamp: 'jens 1/26/2009 00:00'!wantsDroppedMorph: aMorph event: evt	"Return true if the receiver wishes to accept the given morph, which is being dropped by a hand in response to the given event. The default implementation returns false.NOTE: the event is assumed to be in global (world) coordinates."	^ aMorph isKindOf: ScratchCommentMorph! !!ScratchCommentMorph methodsFor: 'accessing' stamp: 'jens 1/27/2009 21:33'!anchor: aBlock	Sensor shiftPressed ifTrue: [^ self].	anchor _ aBlock.	autoAlign _ true.	self align.	connector ifNotNil: [connector delete].	connector _ ScratchConnectorMorph new.	connector color: self topBarColor darker slightlyDarker slightlyDarker.	self refreshConnector.	owner addMorph: connector.	connector goBehind! !!ScratchCommentMorph methodsFor: 'accessing' stamp: 'jens 1/27/2009 20:16' prior: 36931990!delete	self detach.	ScratchFrameMorph putInClipboard: self.	super delete! !!ScratchCommentMorph methodsFor: 'dropping/grabbing' stamp: 'jens 1/27/2009 20:17'!aboutToBeGrabbedBy: aHand	"The receiver is being grabbed by a hand. Perform necessary adjustments (if any) and return the morph that should be added to the hand. This default implementation just returns the reciver."	Sensor shiftPressed 		ifTrue: [autoAlign _ false]		ifFalse: [self detach].	^ self! !!ScratchCommentMorph methodsFor: 'dropping/grabbing' stamp: 'jens 1/26/2009 00:08' prior: 36930086!justDroppedInto: newOwner event: evt	"Handle being dropped into a new situation."	| frame block |	(frame _ newOwner ownerThatIsA: ScratchFrameMorph)		ifNotNil: [frame projectModified].	(block _ newOwner ownerThatIsA: BlockMorph)		ifNotNil: [^ self anchor: block].	((self ownerThatIsA: ScratchViewerMorph) notNil) ifTrue: [		"delete myself when dropped in the blocks palette area"		self delete.		^ self].	"comments cannot be dropped onto the stage"	(owner isKindOf: ScratchStageMorph) ifTrue: [		^ self rejectDropEvent: evt].	"okay to drop comments into the world during development"	((owner == World) and: [Preferences noviceMode not]) ifTrue: [^ self].	(owner isKindOf: ScratchScriptsMorph) ifFalse: [		^ self rejectDropEvent: evt].! !!ScratchCommentMorph methodsFor: 'private' stamp: 'jens 1/27/2009 20:43'!align	| rect |	self position: (anchor right + 5) @ (anchor center y - 9).	((anchor isKindOf: CBlockMorph) or: [anchor isKindOf: IfElseBlockMorph])		ifTrue: [self position: (anchor right + 5) @ (anchor top + 3)].	anchor topBlock allMorphsDo: [:m|		(m isKindOf: BlockMorph) ifTrue: [			rect _ m bounds.			(m isKindOf: ReporterBlockMorph) ifFalse: [				rect _ rect withHeight: (rect height - 4)].			(rect intersects: self bounds) ifTrue: [				self position: (m right + 5) @ self top]]].! !!ScratchCommentMorph methodsFor: 'private' stamp: 'jens 1/27/2009 20:16'!detach	anchor _ nil.	connector ifNotNil: [		connector delete.		connector _ nil].	autoAlign _ true.! !!ScratchCommentMorph methodsFor: 'private' stamp: 'jens 1/27/2009 20:26'!refreshConnector	connector 		from: (anchor right - 2) @(anchor center y - 3)		to: (self left ) @ (self top + 6) .	((anchor isKindOf: CBlockMorph) or: [anchor isKindOf: IfElseBlockMorph])		ifTrue: [connector			from: (anchor right - 2) @(anchor top + 9)			to: (self left ) @ (self top + 6)].! !!ScratchCommentMorph methodsFor: 'stepping and presenter' stamp: 'jens 1/27/2009 20:44'!step	"Do some periodic activity. Use startStepping/stopStepping to start and stop getting sent this message. The time between steps is specified by this morph's answer to the stepTime message. This default implementation does nothing."	(anchor isNil or: [anchor isInWorld not])		ifTrue: [^ self detach].	Sensor shiftPressed ifTrue: [		self refreshConnector.		offset _ self position - anchor position.		^ self].	autoAlign ifFalse: [		self position: anchor position + offset.		self refreshConnector.		^ self].	self align.	self refreshConnector! !!ScratchCommentMorph methodsFor: 'stepping and presenter' stamp: 'jens 1/27/2009 18:43'!stepTime	"Answer the desired time between steps in milliseconds. This default implementation requests that the 'step' method be called once every second."	^ 50! !!ScratchCommentMorph methodsFor: '-- all --' stamp: 'jens 1/27/2009 21:23' prior: 36932137!duplicate	| new |	connector ifNotNil: [connector delete].	new _ self fullCopy detach.	connector _ ScratchConnectorMorph new.	connector color: self topBarColor darker slightlyDarker slightlyDarker.	owner addMorph: connector.	connector goBehind.	self refreshConnector.	self world activeHand attachMorph: new.! !!ScratchConnectorMorph methodsFor: 'as yet unclassified' stamp: 'jens 1/27/2009 19:53'!drawOn: aCanvas	(point1 isNil | point2 isNil) ifTrue: [^ self].	aCanvas line: point1 to: point2 width: 1 color: color! !!ScratchConnectorMorph methodsFor: 'as yet unclassified' stamp: 'jens 1/27/2009 21:24'!from: p1 to: p2	| left right top bottom |	((point1 = p1) & (point2 = p2))		ifTrue: [^ self].	point1 _ p1.	point2 _ p2.	left _ point1 x min: point2 x.	right _ point1 x max: point2 x.	top _ point1 y min: point2 y.	bottom _ point1 y max: point2 y.	self position: left @ top - 1.	self extent: ((right - left) @ ((bottom - top) max: 1)) + 2.! !!ScratchConnectorMorph methodsFor: 'as yet unclassified' stamp: 'jens 1/27/2009 19:53'!rootForGrabOf: aMorph	"prevent the receiver from being picked up"	^ nil! !AlignmentMorph subclass: #ScratchCommentMorph	instanceVariableNames: 'labelMorph resizeMorph commentMorph showHideMorph isShowing isResizing resizeOffset anchor connector autoAlign offset '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Support'!Morph subclass: #ScratchConnectorMorph	instanceVariableNames: 'point2 point1 '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Support'!!ScratchConnectorMorph methodsFor: 'as yet unclassified' stamp: 'jm 2/3/2009 18:58' prior: 39922423!from: p1 to: p2	| left right top bottom |	((point1 = p1) & (point2 = p2)) ifTrue: [^ self].	point1 _ p1.	point2 _ p2.	left _ point1 x min: point2 x.	right _ point1 x max: point2 x.	top _ point1 y min: point2 y.	bottom _ point1 y max: point2 y.	self position: left @ top - 1.	self extent: ((right - left) @ ((bottom - top) max: 1)) + 2.! !----SNAPSHOT----(3 February 2009 6:59:43 pm) priorSource: 6361872!self readSkinFrom: (FileDirectory default directoryNamed: 'ScratchSkin')!----QUIT----(3 February 2009 7:00:12 pm) priorSource: 6369400!----STARTUP----(3 February 2009 7:05:26 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!Point fromUser!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display reverse: bounds!Display 