Value	| w msg tooltip worldBounds |	w _ self world.	msg _ [self evaluate] ifError: ['error!!'].	tooltip _ (ScratchToolTipMorph string: msg for: self).	w addMorphFront: (tooltip position: self bottomLeft + (0@8)).	((worldBounds _ w bounds) containsRect: tooltip bounds) ifFalse:		[tooltip bounds: (tooltip bounds translatedToBeWithin: worldBounds)].	tooltip initialCursorPoint: Sensor cursorPoint.	tooltip startStepping.! !!ScratchToolTipMorph methodsFor: 'stepping' stamp: 'jm 3/14/2009 10:21' prior: 40788275!step	initialCursorPoint ifNotNil: [		(Sensor cursorPoint - initialCursorPoint) r > 40			ifTrue: [self delete]].! !!ScratchToolTipMorph methodsFor: 'stepping' stamp: 'jm 3/14/2009 10:21' prior: 40789009!step	initialCursorPoint ifNotNil: [		(Sensor cursorPoint - initialCursorPoint) r > 60			ifTrue: [self delete]].! !!ScratchToolTipMorph methodsFor: 'stepping' stamp: 'jm 3/14/2009 10:21' prior: 40789218!step	initialCursorPoint ifNotNil: [		(Sensor cursorPoint - initialCursorPoint) r > 100			ifTrue: [self delete]].! !!ScratchToolTipMorph methodsFor: 'stepping' stamp: 'jm 3/14/2009 10:22' prior: 40789427!step	initialCursorPoint ifNotNil: [		(Sensor cursorPoint - initialCursorPoint) r > 70			ifTrue: [self delete]].! !!ScratchToolTipMorph methodsFor: 'stepping' stamp: 'jm 3/14/2009 10:22' prior: 40789637!step	initialCursorPoint ifNotNil: [		(Sensor cursorPoint - initialCursorPoint) r > 80			ifTrue: [self delete]].! !!ReporterBlockMorph methodsFor: 'other' stamp: 'jm 3/14/2009 10:24' prior: 40788480!showValue	| w msg tooltip worldBounds |	w _ self world.	msg _ [self evaluate] ifError: ['error!!'].	tooltip _ (ScratchToolTipMorph string: msg for: self).	w addMorphFront: (tooltip position: self bottomLeft + (0@8)).	((worldBounds _ w bounds) containsRect: tooltip bounds) ifFalse:		[tooltip bounds: (tooltip bounds translatedToBeWithin: worldBounds)].	tooltip initialCursorPoint: Sensor cursorPoint.	tooltip startStepping