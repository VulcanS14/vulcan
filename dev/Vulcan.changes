on on]		ifFalse: [flagButton off].! !----SNAPSHOT----(22 April 2009 8:14:33 am) priorSource: 7910956!----SNAPSHOT----(22 April 2009 8:14:43 am) priorSource: 7913062!!ScratchFrameMorph methodsFor: 'stepping' stamp: 'jm 4/22/2009 08:16' prior: 41465620!updateToolButtons	"Update the highlighting of my tool buttons."	| toolButtons currentTool |	Sensor anyButtonPressed ifTrue: [^ self].  "don't update if mouse button pressed"	toolButtons _ toolbarPanel submorphs select: [:m |		(m isKindOf: ToggleButton) and: [m actionSelector endsWith: 'Tool']].	currentTool _ World activeHand toolType.	currentTool ifNil: [		(toolButtons size > 0) ifTrue: [		toolButtons first on.		2 to: toolButtons size do: [:i | (toolButtons at: i) off].		^ self]].	toolButtons do: [:b |		(b actionSelector asLowercase = currentTool asLowercase)			ifTrue: [b on]			ifFalse: [b off]].! !Parameters at: #standardMenuFont!!ScratchFrameMorph methodsFor: 'stepping' stamp: 'jm 4/22/2009 08:35' prior: 41467714!updateToolButtons	"Update the highlighting of my tool buttons."	| toolButtons currentTool |	Sensor anyButtonPressed ifTrue: [^ self].  "don't update if mouse button pressed"	toolButtons _ toolbarPanel submorphs select: [:m |		(m isKindOf: ToggleButton) and: [m actionSelector endsWith: 'Tool']].	currentTool _ World activeHand toolType asLowercase.	toolButtons do: [:b |		(b actionSelector asLowercase = currentTool)			ifTrue: [b on]			ifFalse: [b off]].! !World activeHand toolType!World activeHand toolType ifNil: ['none']!!ScratchFrameMorph methodsFor: 'stepping' stamp: 'jm 4/22/2009 08:36' prior: 41468463!updateToolButtons	"Update the highlighting of my tool buttons."	| toolButtons currentTool |	Sensor anyButtonPressed ifTrue: [^ self].  "don't update if mouse button pressed"	toolButtons _ toolbarPanel submorphs select: [:m |		(m isKindOf: ToggleButton) and: [m actionSelector endsWith: 'Tool']].	currentTool _ (World activeHand toolType ifNil: ['none'