' action: #exportScriptsAsText.		menu add: 'import scripts from text' action: #importScriptsAsText].	choice _ menu localize startUp.	choice ifNil: [^ self].	choice = #addComment:		ifTrue: [self perform: choice with: aPosition]		ifFalse: [self perform: choice].! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 1/26/2009 14:42'!exportScriptsAsText	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| fName s |	fName _ ScratchFileChooserDialog		chooseNewFileDefault: ''		title: 'Save Scripts Snapshot'		type: #scriptsSnapshot.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.txt') ifFalse: [fName _ fName, '.txt'].	s _ WriteStream on: (String new: 5000).	self halt.! !pageViewerMorph contents!pageViewerMorph contents submorphs!pageViewerMorph contents submorphs first tupleSequence!!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 1/26/2009 14:53' prior: 39541977!exportScriptsAsText	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| fName f |	fName _ ScratchFileChooserDialog		chooseNewFileDefault: ''		title: 'Save Scripts as Text'		type: #scriptsExport.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.txt') ifFalse: [fName _ fName, '.txt'].	f _ FileStream newFileNamed: fName.	pageViewerMorph contents submorphs do: [:m |		(m isKindOf: BlockMorph) ifTrue: [			f nextPutAll: (ScratchPrinter new printTuple: m tupleSequence)]].	f close.! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 1/26/2009 14:55' prior: 39542626!exportScriptsAsText	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| fName f |	fName _ ScratchFileChooserDialog		chooseNewFileDefault: ''		title: 'Save Scripts as Text'		type: #scriptsExport.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.txt') ifFalse: [fName _ fName, '.txt'].	f _ FileStream newFileNamed: fName.	pageViewerMorph contents submorphs do: [:m |		(m isKindOf: BlockMorph) ifTrue: [			f nextPutAll: (ScratchPrinter new printTuple: m tupleSequence).			f nextPutAll: String crlf]].	f close.! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 1/26/2009 15:07'!importScriptsFromText	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| fName |	fName _ ScratchFileChooserDialog		chooseExistingFileType: #scriptsExport		extensions: #(txt)		title: 'Import Scripts from Text'.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].	(fName asLowercase endsWith: '.txt') ifFalse: [fName _ fName, '.txt'].! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 1/26/2009 15:07' prior: 39541242!scriptsMenu: aPosition	"Present a menu of Scratch script operations."	| menu choice |	self target ifNil: [^ self].	menu _ CustomMenu new.	menu add: 'clean up' action: #cleanUp.	menu add: 'save picture of scripts' action: #saveScriptsToImage.	menu add: 'add comment' action: #addComment:.	Sensor shiftPressed ifTrue: [		menu addLine.		menu add: 'export scripts as text' action: #exportScriptsAsText.		menu add: 'import scripts from text' action: #importScriptsFromText].	choice _ menu localize startUp.	choice ifNil: [^ self].	choice = #addComment:		ifTrue: [self perform: choice with: aPosition]		ifFalse: [self perform: choice].! !!ScratchScriptEditorMorph methodsFor: 'menu/button ops' stamp: 'jm 1/26/2009 15:09' prior: 39543982!importScriptsFromText	"Take a snapshot of all scripts for a sprite and save as a GIF file"	| fName |	fName _ ScratchFileChooserDialog		chooseExistingFileType: #scriptsExport		extensions: #(txt)		title: 'Import Scripts from Text'.	fName = #cancelled ifTrue: [^ self].	fName size = 0 ifTrue: [^ self].self halt.! !----QUIT----(26 January 2009 3:18:03 pm) priorSource: 5982080!----STAR