"self primGetFolderPathOrNil: 1"	<primitive: 'primitiveGetFolderPath' module: 'ScratchPlugin'>	^ nil! !self primGetFolderPathOrNil: 1!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:00' prior: 40239243!setHomeDir: aStringOrNil	"Set the home directory for this user. If the user name contains an asterisk, replace it with the name of logged in user."	| path root |	DefaultUserProjectsFolder _ nil.	aStringOrNil ifNotNil: [		path _ self replaceAsteriskWithUserName: aStringOrNil.		root _ FileDirectory on: ''.		(root directoryExists: path) ifTrue: [			DefaultUserProjectsFolder _ root on: path]].! !FileDirectory pathNameDelimiter asString!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:06'!replaceAsteriskWithUserName: aString	"If the given string includes an asterisk, replace it with the name of the current user. Otherwise, return the string."	| i home delimiter userName |	(i _ aString indexOf: $*) = 0 ifTrue: [^ aString].	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ aString].	delimiter _ FileDirectory pathNameDelimiter asString.	userName _ (home findTokens: delimiter) last.	^ (aString copyFrom: 1 to: i - 1), delimiter,		userName, delimiter,		(aString copyFrom: i + 1 to: aString size).! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:07' prior: 40245261!replaceAsteriskWithUserName: aString	"If the given string includes an asterisk, replace it with the name of the current user. Otherwise, return the string."	"self replaceAsteriskWithUserName: '/test/*/documents'"	| i home delimiter userName |	(i _ aString indexOf: $*) = 0 ifTrue: [^ aString].	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ aString].	delimiter _ FileDirectory pathNameDelimiter asString.	userName _ (home findTokens: delimiter) last.	^ (aString copyFrom: 1 to: i - 1), delimiter,		userName, delimiter,		(aString copyFrom: i + 1 to: aString size).! !self replaceAsteriskWithUserName: '/test/*/documents'!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:07' prior: 40245902!replaceAsteriskWithUserName: aString	"If the given string includes an asterisk, replace it with the name of the current user. Otherwise, return the string."	"self replaceAsteriskWithUserName: '/test/*/documents' '/test//jmaloney//documents'"	| i home delimiter userName |	(i _ aString indexOf: $*) = 0 ifTrue: [^ aString].	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ aString].	delimiter _ FileDirectory pathNameDelimiter asString.	userName _ (home findTokens: delimiter) last.	^ (aString copyFrom: 1 to: i - 1), userName, (aString copyFrom: i + 1 to: aString size).! !self replaceAsteriskWithUserName: '/test/*/documents'!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:08' prior: 40246656!replaceAsteriskWithUserName: aString	"If the given string includes an asterisk, replace it with the name of the current user. Otherwise, return the string."	"self replaceAsteriskWithUserName: 'C:/Users/*/documents'"	| i home delimiter userName |	(i _ aString indexOf: $*) = 0 ifTrue: [^ aString].	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ aString].	delimiter _ FileDirectory pathNameDelimiter asString.	userName _ (home findTokens: delimiter) last.	^ (aString copyFrom: 1 to: i - 1), userName, (aString copyFrom: i + 1 to: aString size).! !self replaceAsteriskWithUserName: 'C:/Users/*/documents'!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:09' prior: 40247413!replaceAsteriskWithUserName: aString	"If the given string includes an asterisk, replace it with the name of the current user. Otherwise, return the string."	"self replaceAsteriskWithUserName: '/Users/*/Documents'"	| i home delimiter userName |	(i _ aString indexOf: $*) = 0 ifTrue: [^ aString].	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ aString].	delimiter _ FileDirectory pathNameDelimiter asString.	userName _ (home findTokens: delimiter) last.	^ (aString copyFrom: 1 to: i - 1), userName, (aString copyFrom: i + 1 to: aString size).! !self replaceAsteriskWithUserName: '/Users/*/Documents'!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:09' prior: 40244726!setHomeDir: aStringOrNil	"Set the home directory for this user. If the user name contains an asterisk, replace it with the name of logged in user."	"self setHomeDir: '/Users/*/Documents'"	| path root |	DefaultUserProjectsFolder _ nil.	aStringOrNil ifNotNil: [		path _ self replaceAsteriskWithUserName: aStringOrNil.		root _ FileDirectory on: ''.		(root directoryExists: path) ifTrue: [			DefaultUserProjectsFolder _ root on: path]].! !self setHomeDir: '/Users/*/Documents'!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:10' prior: 40248877!setHomeDir: aStringOrNil	"Set the home directory for this user. If the user name contains an asterisk, replace it with the name of logged in user."	"self setHomeDir: '/Users/*/Documents'"	| path root |	DefaultUserProjectsFolder _ nil.	aStringOrNil ifNotNil: [		path _ self replaceAsteriskWithUserName: aStringOrNil.		root _ FileDirectory on: ''.		(root directoryExists: path) ifTrue: [			DefaultUserProjectsFolder _ root on: path]].	^ DefaultUserProjectsFolder! !self setHomeDir: '/Users/*/Documents'!self setHomeDir: '/Users/*/Documents'!self fileNames!self directoryNames!DefaultUserProjectsFolder!DefaultUserProjectsFolder!DefaultUserProjectsFolder!!ScratchFileChooserDialog class methodsFor: 'class initialization' stamp: 'jm 2/22/2009 22:17' prior: 40240842!initialize	| media |	LastBackgroundFolder _ nil.	LastCostumeFolder _ nil.	LastProjectFolder _ nil.	LastSoundFolder _ nil.	LastSpriteFolder _ nil.	LastStageFolder _ nil.	UserHomeFolder _ nil.	DefaultStageFolder _ DefaultSpriteFolder _ DefaultScratchFolder _ FileDirectory default.	(FileDirectory default directoryExists: 'Media') ifTrue: [		media _ FileDirectory default directoryNamed: 'Media'.		DefaultSpriteFolder _ media.		(media directoryExists: 'Backgrounds') ifTrue: [			DefaultBackgroundFolder _ media directoryNamed: 'Backgrounds'].		(media directoryExists: 'Costumes') ifTrue: [			DefaultCostumeFolder _ media directoryNamed: 'Costumes'.			DefaultSpriteFolder _ media directoryNamed: 'Costumes'].		(media directoryExists: 'Sounds') ifTrue: [			DefaultSoundFolder _ media directoryNamed: 'Sounds']].	(FileDirectory default directoryExists: 'Projects') ifTrue: [		DefaultProjectFolder _ FileDirectory default directoryNamed: 'Projects'].! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:17' prior: 40249465!setHomeDir: aStringOrNil	"Set the home directory for this user. If the user name contains an asterisk, replace it with the name of logged in user."	"self setHomeDir: '/Users/*/Documents'"	| path root |	DefaultUserProjectsFolder _ nil.	aStringOrNil ifNotNil: [		path _ self replaceAsteriskWithUserName: aStringOrNil.		root _ FileDirectory on: ''.		(root directoryExists: path) ifTrue: [			UserHomeFolder _ root on: path]].	^ UserHomeFolder! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:17' prior: 40251331!setHomeDir: aStringOrNil	"Set the home directory for this user. If the user name contains an asterisk, replace it with the name of logged in user."	"self setHomeDir: '/Users/*/Documents'"	| path root |	UserHomeFolder _ nil.	aStringOrNil ifNotNil: [		path _ self replaceAsteriskWithUserName: aStringOrNil.		root _ FileDirectory on: ''.		(root directoryExists: path) ifTrue: [			UserHomeFolder _ root on: path]].	^ UserHomeFolder! !DialogBoxMorph subclass: #ScratchFileChooserDialog	instanceVariableNames: 'scratchFrame list choosingFolder newFileTitle newFileName thumbnailFrameMorph thumbnailMorph authorLabelMorph authorMorph commentLabelMorph commentMorph readingScratchFile type newTitleBin '	classVariableNames: 'DefaultBackgroundFolder DefaultCostumeFolder DefaultProjectFolder DefaultScratchFolder DefaultSoundFolder DefaultSpriteFolder DefaultStageFolder  LastBackgroundFolder LastCostumeFolder LastProjectFolder LastSoundFolder LastSpriteFolder LastStageFolder UserHomeFolder '	poolDictionaries: ''	category: 'Scratch-UI-Dialogs'!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:22'!homeDir	"Return the home directory for this user. This is either provided by the OS via primGetFolderPath: or it can be overridden by adding a 'homedir=path' entry in the Scratch.ini folder."	UserHomeFolder ifNotNil: [^ UserHomeFolder].	^ ScratchPlugin primGetFolderPath: 1! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:22' prior: 40253030!homeDir	"Return the home directory for this user. This is either provided by the OS via primGetFolderPath: or it can be overridden by adding a 'homedir=path' entry to the Scratch.ini folder."	UserHomeFolder ifNotNil: [^ UserHomeFolder].	^ ScratchPlugin primGetFolderPath: 1! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 22:23' prior: 40253414!homeDir	"Return the home directory for this user. By default, this is either provided by the OS via primGetFolderPath: but it can be overridden by adding a 'homedir=path' entry to the Scratch.ini folder."	UserHomeFolder ifNotNil: [^ UserHomeFolder].	^ ScratchPlugin primGetFolderPath: 1! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/22/2009 22:23' prior: 40220363!myHome	"My Home button was pressed."	list currentDirectory: self class homeDir.! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/22/2009 22:30'!userNameForHomeFolderOrNil	"Answer the name to use for the home folder. This is the user name unless the home folder location has been overridden by an entry in the Scratch.ini file."	| home delimiter |	UserHomeFolder ifNil: [^ nil]. 	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ nil].	delimiter _ FileDirectory pathNameDelimiter asString.	^ (home findTokens: delimiter) last! !!ScratchFileChooserDialog methodsFor: 'initialization' stamp: 'jm 2/22/2009 22:32' prior: 40228808!addShortcutButtons	"Add these to my current shortcuts."	"Note: The shortcut column morph was created by initialize; I just add to its contents a new collection of shortcuts."	| backgrounds costumes sounds projects spacer homeLabel |	backgrounds _ ScratchFileChooserDialog getDefaultFolderForType: #background.	costumes _ ScratchFileChooserDialog getDefaultFolderForType: #costume.	sounds _ ScratchFileChooserDialog getDefaultFolderForType: #sound.	projects _ ScratchFileChooserDialog getDefaultFolderForType: #project.	spacer _ Morph new extent: 5@5; color: Color transparent.	shortcutColumn removeAllMorphs.	shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Computer' action: #myComp icon: #folderIcon).	shortcutColumn addMorphBack: spacer fullCopy.	homeLabel _ self userNameForHomeFolderOrNil.	homeLabel ifNil: [homeLabel _ 'Home'].	shortcutColumn addMorphBack: (self shortcutButtonLabel: homeLabel action: #myHome icon: #folderHouseIcon).	shortcutColumn addMorphBack: spacer fullCopy.	(self type = #project) & (projects isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Examples' action: #sampleProjects icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #costume) & (costumes isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Costumes' action: #scratchCostumes icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #background) & (backgrounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Backgrounds' action: #scratchBackgrounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sound) & (sounds isNil not) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Sounds' action: #scratchSounds icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].	(self type = #sprite) | (self type = #stage) ifTrue: [		shortcutColumn addMorphBack: (self shortcutButtonLabel: 'Scratch' action: #scratchFolder icon: #folderCatIcon).		shortcutColumn addMorphBack: spacer fullCopy].! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/22/2009 22:33' prior: 40254355!userNameForHomeFolderOrNil	"Answer the name to use for the home folder. This is the user name unless the home folder location has been overridden by an entry in the Scratch.ini file."	| home delimiter |	UserHomeFolder ifNotNil: [^ nil]. 	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ nil].	delimiter _ FileDirectory pathNameDelimiter asString.	^ (home findTokens: delimiter) last! !VisibleDrives!ScratchFrameMorph visibleDrives!!ScratchFilePicker methodsFor: 'private' stamp: 'jm 2/22/2009 22:40'!navigationForbidden	"Answer true if navigating the file hierarch is forbidden because there is a visibledrives entry in the Scratch.ini file."	ScratchFrameMorph visibleDrives ifNotNil: [		self beep.		^ true].	^ false! !!ScratchFilePicker methodsFor: 'private' stamp: 'jm 2/22/2009 22:40' prior: 36986126!directoryMenu	"Present a drop-down menu of all directories in my current path."	| menu pathParts prefix n serverEntries choice s serverPath |	self navigationForbidden ifTrue: [^ self].	menu _ CustomMenu new.	pathParts _ currentDir pathParts.	prefix _ ''.	n _ 1.	pathParts do: [:part |		menu add: prefix asUTF8, part action: n.		prefix _ prefix ,'  '.		n _ n + 1].	pathParts isEmpty ifTrue: [menu add: 'Computer' action: (FileDirectory on: '') pathName].	self addDriveShortcuts: menu.	"if opening a Scratch project, allow access to servers"	scratchInfoClient ifNotNil: [		serverEntries _ ScratchFrameMorph scratchServers.		serverEntries size > 0 ifTrue: [			menu addLine.			serverEntries do: [:entry |				menu add: entry first action: n.				n _ n + 1]]].	choice _ menu		startUp: nil		withCaption: nil		at: (directoryBarMorph right - 117)@(directoryBarMorph top + 8).	choice ifNil: [^ self].	(choice isKindOf: String) ifTrue: [		choice = 'Computer'			ifTrue: [^ self currentDirectory: '']			ifFalse: [^ self currentDirectory: choice contents]].	choice > pathParts size ifTrue: [		entry _ serverEntries at: choice - pathParts size.		^ self currentDirectory: (ScratchServerDirectory new			serverName: (entry at: 2);			path: (entry at: 3))].	s _ WriteStream on: String new.	1 to: choice do: [:i |		s nextPutAll: (pathParts at: i).		i < choice ifTrue: [s nextPut: currentDir pathNameDelimiter]].	(currentDir isKindOf: ScratchServerDirectory)		ifTrue: [			serverPath _ '/', s contents.			(serverPath endsWith: '/') ifFalse: [serverPath _ serverPath, '/'].			self currentDirectory: (currentDir copy path: serverPath)]		ifFalse: [			self currentDirectory: s contents].! !!ScratchFilePicker methodsFor: 'private' stamp: 'jm 2/22/2009 22:40' prior: 36996530!showParentDirectory	"Go to my parent directory."	self navigationForbidden ifTrue: [^ self].	self currentDirectory: currentDir parentDirectory.! !!ScratchFilePicker methodsFor: 'private' stamp: 'jm 2/22/2009 22:41' prior: 40257622!navigationForbidden	"Answer true if navigating the file hierarch is forbidden because there is a visibledrives entry in the Scratch.ini file."true ifTrue: [self beep. ^ true].	ScratchFrameMorph visibleDrives ifNotNil: [		self beep.		^ true].	^ false! !!ScratchFilePicker methodsFor: 'private' stamp: 'jm 2/22/2009 23:30' prior: 40259979!navigationForbidden	"Answer true if navigating the file hierarch is forbidden because there is a visibledrives entry in the Scratch.ini file."	ScratchFrameMorph visibleDrives ifNotNil: [		self beep.		^ true].	^ false! !!InputSensor methodsFor: 'private-OS events' stamp: 'jm 2/22/2009 23:34' prior: 40211289!windowCloseReceived	"Answer true if we've received a window close event. Skip all other window events."	| evtRec |	[true] whileTrue: [		evtRec _ self nextEventRecordOfType: 5.		evtRec ifNil: [^ false].		(evtRec at: 3) = 2 ifTrue: [^ true]].	^ false! !!ScratchFileChooserDialog methodsFor: 'shortcuts' stamp: 'jm 2/22/2009 23:35' prior: 40216607!sampleProjects	"Sample Projects button was pressed."	(FileDirectory default directoryExists: 'Projects') ifTrue: [		list currentDirectory:			(FileDirectory default directoryNamed: 'Projects')].! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 23:35' prior: 40248147!replaceAsteriskWithUserName: aString	"If the given string includes an asterisk, replace it with the name of the current user. Otherwise, return the string."	"self replaceAsteriskWithUserName: '/Users/*/Documents'"	| i home delimiter userName |	(i _ aString indexOf: $*) = 0 ifTrue: [^ aString].	home _ ScratchPlugin primGetFolderPathOrNil: 1.	home ifNil: [^ aString].	delimiter _ FileDirectory pathNameDelimiter asString.	userName _ (home findTokens: delimiter) last.	^ (aString copyFrom: 1 to: i - 1), userName, (aString copyFrom: i + 1 to: aString size).! !!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/22/2009 23:36' prior: 40176245!formatInfix: aString	'+' = aString ifTrue: [^ 'add_operator'].	'-' = aString ifTrue: [^ 'subtract_operator'].	'*' = aString ifTrue: [^ 'multiply_operator'].	'/' = aString ifTrue: [^ 'divide_operator'].	'\\' = aString ifTrue: [^ 'mod_operator'].	'&' = aString ifTrue: [^ 'and_operator'].	'|' = aString ifTrue: [^ 'or_operator'].	'<' = aString ifTrue: [^ 'isLessThan'].	'=' = aString ifTrue: [^ 'isEqualTo'].	'>' = aString ifTrue: [^ 'isGreaterThan'].	self error: 'unknown infix operator'! !-