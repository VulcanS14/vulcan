tch-version' put: Version.	projectInfo at: 'language' put: ScratchTranslator currentLanguage.	platform _ Smalltalk platformName.	platform ifNil: [platform _ 'unknown'].	'linux' = platform ifTrue: [		Display extent = (1200@900) ifTrue: [platform _ 'XO']].	projectInfo at: 'platform' put: platform.	osVersion _ Smalltalk osVersion.	osVersion ifNil: [osVersion _ 'unknown'].	projectInfo at: 'os-version' put: osVersion.! !!ScratchFrameMorph methodsFor: 'geometry' stamp: 'jm 2/3/2009 19:38' prior: 39883776!fixLayout	| stageExtent xyReadout |	stageExtent _		workPane isQuarterSize			ifTrue: [workPane extent // 2]			ifFalse: [workPane extent].	topPane		position: self topLeft;		width: self width;		height: (menuPanel height + 0 max: logoMorph height + 10).	stageFrame		extent: stageExtent + (14@42);		top: topPane bottom;		right: self right.	workPane position: stageFrame topLeft + (4@37).	titlePane		position: stageFrame topLeft + (0@1);		width: stageFrame width - 6;		height: 36.	self fixProjectTitleMorphLayout.	viewerPane position: topPane bottomLeft;		width: viewerPane catButtonsExtent x + 17;		height: self bottom - topPane bottom."Disable palette hiding:	self hidePalette: ((self width - (stageExtent x + viewerPane width)) < 180).xxx"	viewerPane owner isNil		ifTrue: [			scriptsPane position: topPane bottomLeft;				width: self width - stageFrame width;				height: self bottom - topPane bottom]		ifFalse: [			scriptsPane position: viewerPane topRight;				width: self width - (stageFrame width + viewerPane width);				height: self bottom - topPane bottom].	scriptsPane fixLayout.	libraryPane position: stageFrame bottomLeft;		width: (self right - scriptsPane right);		height: self bottom - libraryPane top.	menuPanel		left: logoMorph right + 18;		top: topPane top + ((topPane height - menuPanel height) // 2) + 2;		width: (self right - menuPanel left) - 15.	buttonPanel		position: (stageFrame left + 10)@(topPane bottom + 5);		height: (workPane top - stageFrame top) - 8;		width: stageFrame width - 28.	xyReadout _ readoutPane submorphs at: 1.	readoutPane		width: xyReadout width + 20;		height: xyReadout height + 15;		position: stageFrame bottomRight - ((readoutPane width + 6)@3).	xyReadout position: readoutPane position + (15@5).! !self extent!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/3/2009 19:42' prior: 37015195!startup	| settings startupFileNames fileName arg presentationMode lang |	HostSystemMenus startUp.	HostSystemMenus menuBarControler reviseHostMenus.	ScriptableScratchMorph randomInit.	ScratchTranslator detectRenderPlugin.	ScratchTranslator importLanguagesList.	TakeOverScreen ifTrue: [		Smalltalk fullScreenMode: true.		DisplayScreen startUp].	NormalModeEnabled _ (Display width >= 980) & (Display height >= 555).	ScratchFrameMorph readShareServerEntry.	self class setVisibleDrives: nil.	lang _ nil.	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		assoc key = 'language' ifTrue: [lang _ assoc value].		assoc key = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.	self updateProjectName.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	shuffledCostumeNames _ nil.	author _ ''.	loginName _ ''.	loginPassword _ ''.	justSaved _ true.	presentationMode _ false.	startupFileNames _ InputSensor startupFileNames asOrderedCollection.	2 to: 10 do: [:i |		arg _ Smalltalk getSystemAttribute: i.		(arg notNil and: [arg size > 0]) ifTrue: [			startupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/3/2009 19:46' prior: 39936905!startup	| settings startupFileNames fileName arg presentationMode lang |	HostSystemMenus startUp.	HostSystemMenus menuBarControler reviseHostMenus.	ScriptableScratchMorph randomInit.	ScratchTranslator detectRenderPlugin.	ScratchTranslator importLanguagesList.	TakeOverScreen ifTrue: [		Smalltalk fullScreenMode: true.		DisplayScreen startUp].	NormalModeEnabled _ (Display width >= 980) & (Display height >= 555).	(NormalModeEnabled not and: [viewMode = #normal])		ifTrue: [self enterQuarterMode].	ScratchFrameMorph readShareServerEntry.	self class setVisibleDrives: nil.	lang _ nil.	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		assoc key = 'language' ifTrue: [lang _ assoc value].		assoc key = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.	self updateProjectName.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	shuffledCostumeNames _ nil.	author _ ''.	loginName _ ''.	loginPassword _ ''.	justSaved _ true.	presentationMode _ false.	startupFileNames _ InputSensor startupFileNames asOrderedCollection.	2 to: 10 do: [:i |		arg _ Smalltalk getSystemAttribute: i.		(arg notNil and: [arg size > 0]) ifTrue: [			startupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !----SNAPSHOT----(3 February 2009 7:46:58 pm) priorSource: 6369543!----SNAPSHOT----(3 February 2009 7:48:20 pm) priorSource: 6386791!----QUIT----(3 February 2009 7:48:54 pm) priorSource: 6386859!----STARTUP----(3 February 2009 10:16:46 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----SNAPSHOT----(3 February 2009 10:17:45 pm) priorSource: 6386927!----SNAPSHOT----(3 February 2009 10:17:48 pm) priorSource: 6387091!----SAVEAS Scratch03Feb09----(3 February 2009 10:18:05 pm)!----STARTUP----(4 February 2009 2:14:25 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchParser methodsFor: 'ops' stamp: 'jm 2/4/2009 14:17'!range: cmd	cmd size < 4		ifTrue: [^ (self eval: (cmd at: 2)) to: (self eval: (cmd at: 3))]		ifFalse: [^ (self eval: (cmd at: 2)) to: (self eval: (cmd at: 3)) by: (self eval: (cmd at: 4))]! !!ScratchParser class methodsFor: 'as yet unclassified' stamp: 'jm 2/4/2009 14:33' prior: 39832236!initSimpleBlocks	"Create a blocks table for a very simple set of blocks."	"self initSimpleBlocks"	Blocks _ #(		('repeat %n'						repeat:)		('for %s in %n to %n'			forToDo:)		('for %s in %n to %n by %n'	forToDoBy:)		('while %b'						while:)		('if %b'							if:)		('set %s to %n'			varSet:)