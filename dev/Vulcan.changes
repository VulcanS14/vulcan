ck.	Smalltalk fullScreenMode: true.	World restoreDisplay.	Display fillBlack.	World assuredCanvas.  "re-allocate canvas after entering full-screen mode"	((Display width >= 965) & (Display height >= 750))		ifTrue: [presenter beDoubleSize].	presenter extent: Display extent.	World addMorphFront: presenter.	World startSteppingSubmorphsOf: presenter.	World activeHand newKeyboardFocus: nil.	self updatePenPositions.	self updateViewModeButtons.	World assuredCanvas.  "re-allocate canvas after entering full-screen mode"	World fullRepaintNeeded.	World displayWorldSafely.! !!ScratchFrameMorph methodsFor: 'view mode' stamp: 'ee 12/12/2008 10:36' prior: 39158050!enterQuarterMode	"Go into quarter stage mode."	(viewMode = #quarter) ifTrue: [		self updateViewModeButtons.		^ self].	QuarterModeEnabled ifFalse:[		self enterPresentationMode.		^ self].	viewMode _ #quarter.	workPane isQuarterSize: true.	workPane isInWorld		ifTrue: [self fixLayout]		ifFalse: [self exitPresentationMode].	self updatePanes.	self updateViewModeButtons.! !!ScratchPresenterMorph methodsFor: 'initialization' stamp: 'ee 12/12/2008 10:44' prior: 39195734!initialize	| button normalModeButton quarterModeButton presentationModeButton |	super initialize.	self color: Color black.	doubleSize _ false.	buttons _ #(		(goSmall	shoutGo		'Start green flag scripts')		(stopSmall	stopAll		'Stop everything')	) collect: [:spec |		button _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec first, 'ButtonPressed'))			offForm: (ScratchFrameMorph skinAt: (spec first, 'Button')).		button			target: self;			actionSelector: spec second;			isMomentary: true;			actWhen: #buttonUp;			setProperty: #balloonText toValue: spec third localized;			drawToolTipAbove: true;			off.		#shoutGo = spec second ifTrue: [flagButton _ button].		button].	buttons do: [:b | self addMorph: b].	"view mode buttons"	"expecting to throw this following code away"	viewModeButtons _ AlignmentMorph newRow		hResizing: #shrinkWrap;		vResizing: #shrinkWrap;		color: Color transparent.	ScratchFrameMorph quarterModeEnabled ifTrue: [		quarterModeButton _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: #quarterViewModeOn)			offForm: (ScratchFrameMorph skinAt: #quarterViewMode)			overForm: (ScratchFrameMorph skinAt: #quarterViewModeOver).		quarterModeButton			target: self;			actionSelector: #exitPresentation:;			arguments: #(quarter);			alphaOn: true.		viewModeButtons addMorphBack: quarterModeButton].	ScratchFrameMorph normalModeEnabled ifTrue: [		normalModeButton _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: #normalViewModeOn)			offForm: (ScratchFrameMorph skinAt: #normalViewMode)			overForm: (ScratchFrameMorph skinAt: #normalViewModeOver).		normalModeButton			target: self;			actionSelector: #exitPresentation:;			arguments: #(normal);			alphaOn: true.		viewModeButtons addMorphBack: normalModeButton].	presentationModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #presentationViewModeOn)		offForm: (ScratchFrameMorph skinAt: #presentationViewMode)		overForm: (ScratchFrameMorph skinAt: #presentationViewModeOver).	presentationModeButton		target: presentationModeButton;		actionSelector: #on;		alphaOn: true;		on.	viewModeButtons addMorphBack: presentationModeButton.	self addMorphBack: viewModeButtons.! !!ScratchPresenterMorph methodsFor: 'geometry' stamp: 'ee 12/11/2008 13:45' prior: 39168169!fixLayout	| stageExtent stageBox y totalW x |	stageExtent _ doubleSize ifTrue: [2 * stage extent] ifFalse: [stage extent].	stageBox _ Rectangle center: self center extent: stageExtent.	stage owner center: self center.	y _ stageBox top - 22.	buttons first position: (stageBox left + 5) @ y.  "exit presentation button"	"other buttons"	totalW _ (buttons collect: [:b | b width]) sum.	x _ stageBox right - totalW - (10 * (buttons size - 2)) - 5.	buttons do: [:b |		b position: x@y.		x _ x + b width + 10].	