stamp: 'jens 11/18/2008 10:16' prior: 37072934!openScratchProjectNamed: fName	"Open a Scratch project with the given name."	| f projData newProj dir fn|	self closeMediaEditorsAndDialogs ifFalse: [^ self].		fn _ fName.	f _ FileStream readOnlyFileNamedOrNil: fn. 	f ifNil: ["try a different encoding, fixes a Firefox bug, -Jens"		fn _ fName isoLatinToMac asUTF8.		f _ FileStream readOnlyFileNamedOrNil: fn.		f ifNil: [^ self inform: 'Could not read' withDetails: fName]].	[	projData _ f binary contentsOfEntireFile.		newProj _ self extractProjectFrom: projData.		projectInfo _ self extractInfoFrom: projData.	] ifError: [:err :rcvr | ^ self inform: 'Could not read project; file may be damaged' withDetails: '(', err, ')'].	dir _ FileDirectory dirPathFor: fn.	projectDirectory _ FileDirectory on: dir.	ScratchFileChooserDialog setLastFolderTo: projectDirectory forType: #project.	projectName _ FileDirectory localNameFor: fn.	self installNewProject: newProj.	self initializeWatcherPositions.	viewerPane updateContents.! !'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 21 November 2008 at 12:51:10 pm'!!Float methodsFor: 'truncation and round off' stamp: 'jm 11/21/2008 12:42' prior: 18717390!rounded	"Answer the integer nearest the receiver."	self isNaN ifTrue: [^ self].	self isInf ifTrue: [^ self].	self >= 0.0		ifTrue: [^ (self + 0.5) truncated]		ifFalse: [^ (self - 0.5) truncated].! !----SNAPSHOT----(21 November 2008 1:25:56 pm) priorSource: 5541294!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 21 November 2008 at 9:51:09 am'!!ScratchSpriteMorph methodsFor: 'motion ops' stamp: 'jens 11/21/2008 09:49' prior: 37418714!forward: distance	"Move the object forward (i.e., the direction of its heading) by the given distance.	Avoid infinite or NaN coordinates"	| radians deltaP newPos newX newY |	radians _ rotationDegrees degreesToRadians.	deltaP _ ((radians cos)@(radians sin)) * distance.	newPos _ self position + deltaP.	newX _ newPos x.	newY _ newPos y.	newX isNaN ifTrue: [newX _ 0].	newX isInf ifTrue: [newX _ newX sign * 10000].	newY isNaN ifTrue: [newY _ 0].	newY isInf ifTrue: [newY _ newY sign * 10000].	self position: newX @ newY.	self keepOnScreen.! !----SNAPSHOT----(21 November 2008 1:27:06 pm) priorSource: 5544269!----QUIT----(21 November 2008 1:28:55 pm) priorSource: 5545086!----STARTUP----(21 November 2008 1:30:23 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(21 November 2008 1:31:00 pm) priorSource: 5545155!----STARTUP----(21 November 2008 1:31:59 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(21 November 2008 1:33:37 pm) priorSource: 5545320!----STARTUP----(21 November 2008 1:39:15 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!NokiaTestPlugin methodsFor: 'as yet unclassified' stamp: 'jm 11/4/2008 22:51' prior: 36106827!primitiveSndPlayStart	"Start the sound player"	| samplingRate |	self export: true.	samplingRate _ interpreterProxy stackIntegerValue: 0.	interpreterProxy failed ifTrue: [^ nil].	self cCode: 'snd_startPlaying(samplingRate)'.	interpreterProxy pop: 1.  "pop arg, leave rcvr on stack"	^ nil! !----SNAPSHOT----(21 November 2008 1:44:53 pm) priorSource: 5545485!----QUIT----(21 November 2008 1:46:55 pm) priorSource: 5546049!----STARTUP----(21 November 2008 1:49:24 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!----QUIT----(21 November 2008 1:50:58 pm) priorSource: 5546118!----STARTUP----(21 November 2008 1:52:46 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchStageMorph methodsFor: 'nil' stamp: 'jm 11/21/2008 13:56'!containsPoint: aPoint	self isQuarterSize ifTrue: [^ (self position extent: self extent // 2)  containsPoint: aPoint].	^ self bounds containsPoint: aPoint! !!ScratchStageMorph methodsFor: 'event handling' stamp: 'jm 11/21/2008 13:57' prior: 39100948!containsPoint: aPoint	self isQuarterSize ifTrue: [^ (self position extent: self extent // 2)  containsPoint: aPoint].	^ self bounds containsPoint: aPoint! !ScratchStageMorph removeSelector: #containsPoint:!!ScratchStageMorph methodsFor: 'event handling' stamp: 'jm 11/21/2008 13:57' prior: 39101203!containsPoint: aPoint	self isQuarterSize ifTrue: [^ (self position extent: self extent // 2)  containsPoint: aPoint].	^ self bounds containsPoint: aPoint! !self containsPoint: Point fromUser!!ScratchStageMorph methodsFor: 'event handling' stamp: 'jm 11/21/2008 14:02' prior: 39051456!unlockedMorphsAt: aPoint addTo: mList	"Adjust aPoint to handle quarter-size case if necessary."	| p |	isQuarterSize ifFalse: [		super unlockedMorphsAt: aPoint addTo: mList.		^ mList].	(self containsPoint: aPoint) ifFalse: [^ mList]. "quick elimination"	p _ self position + (2 * (aPoint - self position)).	submorphs size > 0 ifTrue: [		submorphs do: [:m | m unlockedMorphsAt: p addTo: mList]].	mList addLast: self.	^ mList! !----QUIT----(21 November 2008 2:02:57 pm) priorSource: 5546283!----STARTUP----(21 November 2008 4:16:26 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!dir _ FileDirectory on: '/Users/jmaloney/Desktop/MIT Squeak/Scratch 1.3.1 Release/Scratch 1.3.1'.!strange _ OrderedCollection new.dir allFileNamesDo: [:fn |	ext _ FileDirectory extensionFor: fn.	(fn includesSubString: 'Scratch.app') ifFalse: [		(#('wav' 'aif' 'aiff' 'mp3' 'png' 'gif' 'jpg' 'bmp' 'html' 'pdf' 'hlp' 'sb' 'sprite' 'po' 'pot') includes: ext asLowercase) ifFalse: [			strange addLast: fn]]].strange!strange _ OrderedCollection new.dir allFileNamesDo: [:fn |	ext _ FileDirectory extensionFor: fn.	(fn includesSubString: 'Scratch.app') ifFalse: [		(#('wav' 'aif' 'aiff' 'mp3' 'png' 'gif' 'jpg' 'bmp' 'html' 'pdf' 'hlp' 'sb' 'sprite' 'po' 'pot' 'db') includes: ext asLowercase) ifFalse: [			strange addLast: fn]]].strange!----STARTUP----(24 November 2008 7:35:09 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 27 October 2008 at 2:11:29 pm'!ScriptableScratchMorph subclass: #ScratchSpriteMorph	instanceVariableNames: 'scalePoint rotationDegrees rotationStyle rotatedForm offsetWhenRotated initialRotationAngle draggable penDown penSize penColor penHue penShade resizingOffset '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-Objects'!Morph subclass: #SpriteHandleMorph	instanceVariableNames: 'type offset target '	classVariableNames: 'Current '	poolDictionaries: ''	category: 'Scratch-UI-Support'!!SpriteHandleMorph commentStamp: '<historical>' prior: 0!I am an interactive sprite handle, sort of like a halo button in Scratch. I am meant to be a singleton. Currently I can only resize or rotate a sprite.!!HandMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 11:05' prior: 35116618!handleMouseDown: evt	"Dispatch a mouseDown event."	| p m localEvt rootForGrab aHalo |	"if carrying morphs, just drop them"	self hasSubmorphs ifTrue: [^ self dropMorphsEvent: evt].	clickState ~~ #idle ifTrue: [^ self checkForDoubleClick: evt].	(keyboardFocus notNil and: [Preferences noviceMode]) ifTrue: [		"clear keyboard focus if click is outside the focus morph (needed for Scratch)"		p _ (keyboardFocus transformFromWorld) transform: evt cursorPoint.		(keyboardFocus bounds containsPoint: p) ifFalse: [			self newKeyboardFocus: nil]].	m _ self recipientForMouseDown:		(grid  "Don't grid when determining recipient"			ifNil: [evt]			ifNotNil: [  "Should really use original cursorPoint, but this will do"				evt copy setCursorPoint: Sensor cursorPoint]).	m ifNotNil: [		(m isKindOf: SpriteHandleMorph) ifFalse: [SpriteHandleMorph vanish]. "needed for Scratch"		aHalo _ self world haloMorphOrNil.		(aHalo isNil or: [aHalo staysUpWhenMouseIsDownIn: m])			ifFalse: [self world abandonAllHalos].		m deleteBalloon.		(m handlesMouseDown: evt)			ifTrue:				["start a mouse transaction on m"				(self newMouseFocus: m) ifNil: [^ self].				localEvt _ self transformEvent: evt.				targetOffset _ localEvt cursorPoint - m position.				m mouseDown: localEvt.				clickState == #firstClickDown ifFalse: [					"ensure that at least one mouseMove: is reported for each mouse transaction:"					(mouseDownMorph == m) ifTrue: [						m mouseMove: (localEvt copy setType: #mouseMove)].					(m handlesMouseOverDragging: localEvt) ifTrue:						["If m also handles dragOver, enter it in the list"						dragOverMorphs add: m.						mouseOverMorphs remove: m ifAbsent: []]]]			ifFalse:				["grab m by the appropriate root"				menuTargetOffset _ targetOffset _ evt cursorPoint.				rootForGrab _ m rootForGrabOf: m.				rootForGrab ifNotNil: [self grabMorph: rootForGrab]].		mouseOverTimes removeKey: m ifAbsent: []].! !!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jens 10/23/2008 19:26'!mouseDown: evt	"Handle a mouse click. If the Ctrl key is pressed, let the user resize the sprite"	(evt hand toolType isNil not or:[ evt controlKeyPressed not])		ifTrue: [^super mouseDown: evt].	resizingOffset _ (evt hand position dist: bounds center) max: 1.	World activeHand		newKeyboardFocus: self;		showTemporaryCursor: Cursor resizeHorizontally asXOCursorForm .! !!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jens 10/23/2008 19:27' prior: 37436607!mouseMove: evt	"Rotate me if rotateFlag is true. Resize me if the resizeFlag is true."	| offsetP resizingRatio |	resizingOffset ifNotNil:[		resizingRatio _ ((evt hand position dist: bounds center) / resizingOffset).		((bounds containsPoint: evt hand position) not or: [			resizingRatio < 1]) ifTrue: [				self multiplySizeBy: resizingRatio ].		resizingOffset _ (evt hand position dist: bounds center) max: 1 ].	initialRotationAngle ifNil: [^ self].	offsetP _ evt hand position - (bounds origin + offsetWhenRotated).	offsetP r > 1.0 ifTrue: [		self rotationDegrees: (initialRotationAngle + offsetP theta radiansToDegrees) rounded].! !!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jens 10/23/2008 19:27' prior: 37436980!mouseUp: evt	"Clear my rotating and resizing flag."	initialRotationAngle _ nil.	resizingOffset _ nil.	evt hand toolType ifNil: [		World activeHand showTemporaryCursor: nil ]! !!ScratchSpriteMorph methodsFor: 'right button menu' stamp: 'jens 10/27/2008 12:53' prior: 37438212!rightButtonMenu	"Present the right button menu."	| menu |	menu _ CustomMenu new.	menu add: 'grab screen region for new costume' action: #grabFromScreen.	menu add: 'export this sprite' action: #exportObject.	menu addLine.	menu add: 'duplicate' action: #duplicate.	menu add: 'delete' action: #undoableDeleteSprite.	menu addLine.	menu add: 'resize' action: #resizeHandle.	menu add: 'rotate' action: #rotateHandle.	menu localize; invokeOn: self.! !!ScratchSpriteMorph methodsFor: 'handle ops' stamp: 'jens 10/27/2008 10:58'!resizeHandle	SpriteHandleMorph resize: self! !!ScratchSpriteMorph methodsFor: 'handle ops' stamp: 'jens 10/27/2008 12:53'!rotateHandle	SpriteHandleMorph rotate: self! !!SpriteHandleMorph methodsFor: 'initialization' stamp: 'jens 10/27/2008 10:14'!initialize	super initialize.	self		color: Color transparent;		addMorph: ImageMorph new.! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 13:38'!handlesMouseDown: evt	"Return true if this morph wants to receive mouseDown events" 	^true! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 14:02'!handlesMouseOver: evt	^ true! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 14:09'!mouseDown: evt	#resize = type		ifTrue: [ offset _ evt hand cursorPoint - self position]		ifFalse: [ offset _ target center dist: self center]! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 14:05'!mouseEnter: evt	(#resize = type)		ifTrue: [self form: (ScratchFrameMorph skinAt: #rotStyleFlipOver)]		ifFalse: [self form: (ScratchFrameMorph skinAt: #rotStyleSmoothOver)].! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 14:06'!mouseLeave: evt	(#resize = type)		ifTrue: [self form: (ScratchFrameMorph skinAt: #rotStyleFlip)]		ifFalse: [self form: (ScratchFrameMorph skinAt: #rotStyleSmooth)].! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 13:37'!mouseMove: evt	offset ifNil: [^self].	#resize = type 		ifTrue: [			evt hand cursorPoint x < target center x ifTrue: [^self].			self position: (evt hand cursorPoint x - offset x) @ (self position y).			self resizeTarget]		ifFalse: [			self position: (target center + (Point r: offset				degrees: ( (evt cursorPoint - target center) theta radiansToDegrees rounded)) 					- (self extent / 2)).			self rotateTarget]! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'jens 10/27/2008 10:17'!mouseUp: evt	offset _ nil! !!SpriteHandleMorph methodsFor: 'accessing' stamp: 'jens 10/27/2008 13:10'!target: aSprite	"show me"	target _ aSprite.	(target owner notNil and: [target owner bounds containsPoint: target center]) ifFalse: [		target referencePosition: 0@0].	self	openInWorld.	#resize = type 		ifTrue: [self position: (target bounds right @ target center y) - (self extent / 2)]		ifFalse: [self position: (target center + (Point r: (target width/2) 			degrees: target rotationDegrees) - (self extent / 2))]! !!SpriteHandleMorph methodsFor: 'private' stamp: 'jens 10/27/2008 08:18'!form: aForm	(self submorphs at: 1) form: aForm.	self extent: (self submorphs at: 1) extent.! !!SpriteHandleMorph methodsFor: 'private' stamp: 'jens 10/27/2008 12:51'!type: aSymbol	"#resize / #rotate"	type _ aSymbol.! !!SpriteHandleMorph methodsFor: 'sprite handling' stamp: 'jens 10/27/2008 10:32'!resizeTarget	| factor |	factor _ (self center x - (target center x)) / (target bounds right - (target center x)).	target multiplySizeBy: factor! !!SpriteHandleMorph methodsFor: 'sprite handling' stamp: 'jens 10/27/2008 13:17'!rotateTarget	target rotationDegrees: (self center - target center) theta radiansToDegrees rounded! !!SpriteHandleMorph class methodsFor: 'accessing' stamp: 'jens 10/27/2008 11:30'!vanish	"delete my single instance"	Current ifNotNil: [		Current delete.		Current _ nil ]! !!SpriteHandleMorph class methodsFor: 'instance creation' stamp: 'jens 10/27/2008 12:58'!resize: aSprite	"create my single instance and set it to resize aSprite"		self vanish.	Current _ self new 		type: #resize;		form: (ScratchFrameMorph skinAt: #rotStyleFlip); 		target: aSprite;		setBalloonText: 'slide to resize' localized, ' ', aSprite objName.	^Current! !!SpriteHandleMorph class methodsFor: 'instance creation' stamp: 'jens 10/27/2008 12:57'!rotate: aSprite	"create my single instance and set it to rotate aSprite"		self vanish.	Current _ self new 		type: #rotate;		form: (ScratchFrameMorph skinAt: #rotStyleSmooth); 		target: aSprite;		setBalloonText: 'drag to rotate' localized, ' ', aSprite objName.	^Current! !----STARTUP----(24 November 2008 7:38:50 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!CameraPlugin videoTest!CameraPlugin videoTest!self cameraName: 1!self cameraName: 1!!CameraPlugin class methodsFor: 'camera ops' stamp: 'jm 11/24/2008 19:41' prior: 33975023!cameraIsAvailable	"Answer true if at least one camera is available."	| enableCamera |	enableCamera _ true.	^ enableCamera and: [(self cameraName: 1) notNil]! !!CameraMedia methodsFor: 'accessing' stamp: 'jm 11/24/2008 19:42'!compositeForm	^ self form! !!CameraMedia methodsFor: 'accessing' stamp: 'jm 11/24/2008 19:43' prior: 39112870!compositeForm	^ self form! !!CameraPlugin class methodsFor: 'camera ops' stamp: 'jm 11/24/2008 19:43' prior: 39112637!cameraIsAvailable	"Answer true if at least one camera is available."	| enableCamera |	enableCamera _ false.	^ enableCamera and: [(self cameraName: 1) notNil]! !----SNAPSHOT----(24 November 2008 7:44:34 pm) priorSource: 5547810!----SAVEAS Scratch24Nov08----(24 November 2008 7:44:45 pm)!----STARTUP----(1 December 2008 2:46:12 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jm 12/1/2008 14:50'!grabMe: evt	"Grab this sprite."	self position: self position + (evt hand position - evt cursorPoint).	evt hand grabMorph: self.! !!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jm 12/1/2008 14:50' prior: 39113583!grabMe: evt	"Grab this sprite."self beep.	self position: self position + (evt hand position - evt cursorPoint).	evt hand grabMorph: self.! !!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jm 12/1/2008 14:51' prior: 37437133!startDrag: evt	"This is a drag gesture. If shift is not pressed, pick me up. Otherwise, rotate me."	| m offsetP |	initialRotationAngle _ nil.	m _ owner rootForGrabOf: self.	m == self ifFalse: [^ super startDrag: evt].	(self ownerThatIsA: ScratchStageMorph) ifNotNil: [		(self ownerThatIsA: ScratchStageMorph) changed].	evt shiftPressed		ifTrue: [  "start rotating; record the initial angle"			offsetP _ evt hand position - (bounds origin + offsetWhenRotated).			initialRotationAngle _ self rotationDegrees - offsetP theta radiansToDegrees]		ifFalse: [^ self grabMe: evt].  "pick me up"! !!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jm 12/1/2008 14:54' prior: 39113813!grabMe: evt	"Grab this sprite."	| isQuarterSize |	isQuarterSize _ (owner isKindOf: ScratchStageMorph) and: [owner isQuarterSize].	isQuarterSize		ifTrue: [		]		ifFalse: [			self position: self position + (evt hand position - evt cursorPoint)].	evt hand grabMorph: self.! !ScriptableScratchMorph subclass: #ScratchSpriteMorph	instanceVariableNames: 'scalePoint rotationDegrees rotationStyle rotatedForm offsetWhenRotated initialRotationAngle draggable penDown penSize penColor penHue penShade oldScalePoint '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-Objects'!!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jm 12/1/2008 14:55' prior: 39114753!grabMe: evt	"Grab this sprite."	| isQuarterSize |	isQuarterSize _ (owner isKindOf: ScratchStageMorph) and: [owner isQuarterSize].	isQuarterSize		ifTrue: [			oldScalePoint _ scalePoint.			scalePoint _ scalePoint / 2.0.		] ifFalse: [			oldScalePoint _ nil].	self position: self position + (evt hand position - evt cursorPoint).	evt hand grabMorph: self.! !!ScratchSpriteMorph methodsFor: 'event handling' stamp: 'jm 12/1/2008 15:14' prior: 39115444!grabMe: evt	"Grab this sprite."	| myStage isQuarterSize offset |	myStage _ self ownerThatIsA: ScratchStageMorph.	myStage ifNil: [^ super startDrag: evt].	isQuarterSize _ myStage isQuarterSize.	isQuarterSize		ifTrue: [			oldScalePoint _ scalePoint.			scalePoint _ scalePoint / 2.0.			offset _ evt hand position - self position.		] ifFalse: [			oldScalePoint _ nil.			offset _ evt hand position - evt cursorPoint].	self position: self position + offset.	evt hand grabMorph: self.! !----STARTUP----(2 December 2008 8:56:49 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!InterpreterPlugin subclass: #WeDoPlugin	instanceVariableNames: ''	classVariableNames: ''	poolDictionaries: ''	category: 'Primitives-Plugins'!!WeDoPlugin methodsFor: 'translated prims' stamp: 'jm 12/2/2008 14:17'!primClosePort	"Close the given Globot port."	self export: true.	self cCode: 'GlobotPortClose()'.	"leave rcvr on stack"	^ 0! !!WeDoPlugin methodsFor: 'translated prims' stamp: 'jm 12/2/2008 14:17'!primFlush	"Flush the given Globot port."	self export: true.	self cCode: 'GlobotPortFlush()'.	"leave rcvr on stack"	^ 0! !!WeDoPlugin methodsFor: 'translated prims' stamp: 'jm 12/2/2008 14:17'!primOpenPortNamed	"Open the port with the given name and baud rate."	| nameStr src nameOop baudRate count portNum |	self export: true.	self var: 'nameStr' declareC: 'char nameStr[1000]'.	self var: 'src' declareC: 'char * src'.	nameOop _ interpreterProxy stackValue: 1.	baudRate _ interpreterProxy stackIntegerValue: 0.	((interpreterProxy isIntegerObject: nameOop) or:	 [(interpreterProxy isBytes: nameOop) not]) ifTrue: [		interpreterProxy success: false].	interpreterProxy failed ifTrue: [^ 0].	src _ self cCoerce: (interpreterProxy firstIndexableField: nameOop) to: 'char *'.	count _ interpreterProxy stSizeOf: nameOop.	0 to: count - 1 do: [:i | nameStr at: i put: (src at: i)].	nameStr at: count put: 0.	portNum _ self cCode: 'GlobotOpenPortNamed(nameStr, baudRate)'.	portNum = -1 ifTrue: [interpreterProxy success: false. ^ 0].	interpreterProxy pop: 2. "pop args; leave rcvr on stack"	^ 0! !!WeDoPlugin methodsFor: 'translated prims' stamp: 'jm 12/2/2008 14:17'!primRead	"Read data from the given Globot port into the given buffer (a ByteArray or String). Answer the number of bytes read."	| bufOop bufPtr bufSize byteCount |	self export: true.	self var: 'bufPtr' declareC: 'char *bufPtr'.	bufOop _ interpreterProxy stackValue: 0.	((interpreterProxy isIntegerObject: bufOop) or:	 [(interpreterProxy isBytes: bufOop) not]) ifTrue: [		interpreterProxy success: false.		^ 0].	bufPtr _ self cCoerce: (interpreterProxy firstIndexableField: bufOop) to: 'char *'.	bufSize _ interpreterProxy stSizeOf: bufOop.	interpreterProxy failed ifTrue: [^ 0].	byteCount _ self cCode: 'GlobotPortRead(bufPtr, bufSize)'.	byteCount < 0 ifTrue: [		interpreterProxy success: false.		^ 0].	interpreterProxy pop: 2.  					"pop args and rcvr"	interpreterProxy pushInteger: byteCount.	"push result"	^ 0! !!WeDoPlugin methodsFor: 'translated prims' stamp: 'jm 12/2/2008 14:17'!primWrite	"Write data to the given Globot port from the given buffer (a ByteArray or String). Answer the number of bytes written."	| bufOop bufPtr bufSize byteCount |	self export: true.	self var: 'bufPtr' declareC: 'char *bufPtr'.	bufOop _ interpreterProxy stackValue: 0.	((interpreterProxy isIntegerObject: bufOop) or:	 [(interpreterProxy isBytes: bufOop) not]) ifTrue: [		interpreterProxy success: false.		^ 0].	bufPtr _ self cCoerce: (interpreterProxy firstIndexableField: bufOop) to: 'char *'.	bufSize _ interpreterProxy stSizeOf: bufOop.	interpreterProxy failed ifTrue: [^ 0].	byteCount _ self cCode: 'GlobotPortWrite(bufPtr, bufSize)'.	byteCount < 0 ifTrue: [		interpreterProxy success: false.		^ 0].	interpreterProxy pop: 2.  					"pop args and rcvr"	interpreterProxy pushInteger: byteCount.	"push result"	^ 0! !!WeDoPlugin class methodsFor: 'translation' stamp: 'jm 12/2/2008 14:17'!declareCVarsIn: aCCodeGenerator	"self translate"	super declareCVarsIn: aCCodeGenerator.	aCCodeGenerator cExtras: '#include <windows.h>/* Globot Functions */int GlobotOpenPortNamed(char *portName, int baudRate);void GlobotPortClose(void);int GlobotPortRead(char *bufPtr, int bufSize);int GlobotPortWrite(char *bufPtr, int bufSize);void GlobotPortFlush(void);'.! !!WeDoPlugin class methodsFor: 'testing' stamp: 'jm 12/2/2008 14:17'!test	"self test"	| buf n |	self openPortNamed: 'COM1' baud: 38400.	self writeFrom: (1 to: 100) asByteArray.	buf _ ByteArray new: 5000.	Delay waitMSecs: 1500.	n _ self readInto: buf.	self closePort.	^ buf copyFrom: 1 to: n! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:17'!closePort	"Close the Globot port."	"self closePort"	<primitive: 'primClosePort' module: 'GlobotPlugin'>! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:17'!openPortNamed: portName baud: baudRate	"Open the port with the given name at the given baud rate. Fail if the port could not be opened."	"self openPortNamed: 'COM1' baud: 9600"	<primitive: 'primOpenPortNamed' module: 'GlobotPlugin'>! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:17'!readInto: buffer	"Read from the given port into the given ByteArray or String and answer the number of bytes read."	"self readInto: (ByteArray new: 10)"	<primitive: 'primRead' module: 'GlobotPlugin'>	^ 0! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:17'!writeFrom: buffer	"Write data from the given ByteArray or String to the Globot port and answer the number of bytes written."	"self writeFrom: (0 to: 100) asByteArray"	<primitive: 'primWrite' module: 'GlobotPlugin'>	^ 0! !!WeDoPlugin class methodsFor: 'translation' stamp: 'jm 12/2/2008 14:18' prior: 39119953!declareCVarsIn: aCCodeGenerator	"self translate"	super declareCVarsIn: aCCodeGenerator.	aCCodeGenerator cExtras: '#include <windows.h>/* WeDo Functions */int WeDoOpenPort(void);void WeDoClosePort(void);int WeDoRead(char *bufPtr, int bufSize);int WeDoWrite(char *bufPtr, int bufSize);void WeDoFlush(void);'.! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:19' prior: 39120709!closePort	"Close the WeDo port."	"self closePort"	<primitive: 'primClosePort' module: 'WeDoPlugin'>! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:20'!openPort	"Open the WeDo port. Fail if the port could not be opened."	"self openPort"	<primitive: 'primOpenPort' module: 'WeDoPlugin'>! !WeDoPlugin class removeSelector: #openPortNamed:baud:!!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:21' prior: 39121206!readInto: buffer	"Read from the WeDo port into the given ByteArray and answer the number of bytes read."	"self readInto: (ByteArray new: 10)"	<primitive: 'primRead' module: 'WeDoPlugin'>	^ 0! !!WeDoPlugin class methodsFor: 'primitives' stamp: 'jm 12/2/2008 14:21' prior: 39121491!writeFrom: buffer	"Write data from the given ByteArray or String to the WeDo and answer the number of bytes written."	"self writeFrom: (0 to: 100) asByteArray"	<primitive: 'primWrite' module: 'WeDoPlugin'>	^ 0! !!WeDoPlugin commentStamp: 'jm 12/2/2008 14:22' prior: 0!Low leve