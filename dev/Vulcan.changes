StackFrame new expression: expression.	((expression isKindOf: Collection) and: [expression size > 0])		ifTrue: [topBlock _ expression first]		ifFalse: [topBlock _ expression].! !!ScratchProcess methodsFor: 'entry points' stamp: 'jm 12/19/2008 10:30' prior: 39293074!stop	"Permanently terminates this process."	stackFrame ifNotNil: [stackFrame stopMIDI].	readyToYield _ true.	readyToTerminate _ true.	(topBlock isKindOf: BlockMorph) ifTrue: [topBlock clearProcess].!]style[(4 156 10 35)f1b,f1,f1cred;,f1! !----STARTUP----(19 December 2008 3:33:10 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!BlockMorph methodsFor: 'event handling' stamp: 'jm 12/19/2008 15:36' prior: 33742569!startDrag: evt	| startEvt rootForGrab |	evt hand toolType ifNil: [		startEvt _ evt hand firstClickEvent.		startEvt ifNil: [startEvt _ evt].(startEvt cursorPoint = evt cursorPoint) ifTrue: [self beep].		rootForGrab _ self rootForGrabOf: self.		rootForGrab ifNil: [^ self].		evt hand grabMorph: rootForGrab.		rootForGrab position: evt hand position + (rootForGrab topLeft - startEvt cursorPoint)].	self handleTool: evt hand toolType hand: evt hand.! !!HandMorph methodsFor: 'double click support' stamp: 'jm 12/19/2008 15:38' prior: 39073680!checkForDoubleClick: evt	"Process the given mouse event to detect a click, double-click, or drag."	| t |	t _ evt timestamp - firstClickEvent timestamp.	clickState = #firstClickDown ifTrue: [		t > DoubleClickTime ifTrue: [self beep].		(t > DoubleClickTime or:		 [((self transformEvent: evt) cursorPoint - firstClickEvent cursorPoint) r > 15]) ifTrue: [			"consider it a drag if hand moves or timeout expires"			clickState _ #idle.			clickClient startDrag: firstClickEvent.			^ self resetClickState].		evt isMouseUp ifTrue: [			clickState _ #firstClickUp.			^ self]].	clickState = #firstClickUp ifTrue: [		evt isMouseDown ifTrue: [			clickState _ #idle.			clickClient doubleClick: firstClickEvent.			^ self resetClickSt