ddLine.	menu add: 'Compress Sounds' action: #compressSounds.	menu add: 'Compress Images' action: #compressImages.	menu addLine.	workPane showMotorBlocks		ifTrue: [menu add: 'Hide Motor Blocks' action: #hideMotorBlocks]		ifFalse: [menu add: 'Show Motor Blocks' action: #showMotorBlocks].	menu localize.	#(2 3) do: [:n |		menu labels at: n put:			((menu labels at: n) copyFrom: 1 to: (menu labels at: n) size - 1), ScratchTranslator ellipsesSuffix].	menu invokeOn: self.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/13/2009 14:59' prior: 40049402!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton buttonSpecs b |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu		'Open, save, and share projects')		(Edit			editMenu		'Undo the last delete')		(Share			shareMenu		'Share this project online')		(Language		languageMenu	'Switch languages')		(Help			helpMenu		'Get help')	).	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		((spec at: 1) = 'Language') ifTrue: [			m contents: '�' asUTF8, (spec at: 1) localized, '�' asUTF8].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	"buttonSpecs defines the save and share buttons"	buttonSpecs _ #(		"name			tool tip				selector"		(save			'Save this project'	saveScratchProjectNoDialog)		(share			'Share this project'	share)	).	buttonSpecs do: [:spec |		b _ ToggleButton			onForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver')			offForm: (ScratchFrameMorph skinAt: (spec at: 1), 'Button')			overForm: (ScratchFrameMorph skinAt: (spec at: 1), 'ButtonOver').		b			target: self;			actionSelector: (spec at: 3);			setBalloonText: (spec at: 2) localized;			actWhen: #buttonUp;			isMomentary: true.		menuPanel addMorphBack: b.		((spec at: 1) = 'save') ifTrue: [			menuPanel addMorphBack: (Morph new extent: (8@5); color: Color transparent)]].	menuPanel addMorphBack: (Morph new extent: ((stageFrame width - 140)@5); color: Color transparent).	self addViewModeButtonsTo: menuPanel.	TakeOverScreen ifTrue: [		closeButton _ IconicButton new			labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;			actionSelector: #quitScratch;			target: self;			actWhen: #buttonDown.		menuPanel addMorphBack: closeButton].	topPane addMorph: menuPanel.! !!ScratchMenuTitleMorph methodsFor: 'initialization' stamp: 'jm 2/13/2009 14:59' prior: 40082790!initialize	super initialize.	actOnMouseUp _ true.	self		font: (ScratchFrameMorph getFont: #MenuTitle);		forceUnicodeRendering: true;		color: self normalColor.! !ScratchMenuTitleMorph removeSelector: #actOnMouseUp:!!ScratchMenuTitleMorph methodsFor: 'initialization' stamp: 'jm 2/13/2009 14:59' prior: 40095373!initialize	super initialize.	self		font: (ScratchFrameMorph getFont: #MenuTitle);		forceUnicodeRendering: true;		color: self normalColor.! !!ScratchMenuTitleMorph methodsFor: 'event handling' stamp: 'jm 2/13/2009 15:00' prior: 37173706!mouseUp: evt	target isNil | selector isNil ifTrue: [^ self].	(self containsPoint: evt cursorPoint) ifTrue: [		target perform: selector].! !!ScratchMenuTitleMorph methodsFor: 'event handling' stamp: 'jm 2/13/2009 15:01' prior: 40095940!mouseUp: evt	target isNil | selector isNil ifTrue: [^ self].	Cursor normal show.	(self containsPoint: evt cursorPoint) ifTrue: [		target perform: selector].! !!ScratchMenuTitleMorph methodsFor: 'event handling' stamp: 'jm 2/13/2009 15:01' prior: 37173188!mouseDown: evt	"Do nothing."! 