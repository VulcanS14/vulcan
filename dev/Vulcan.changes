h skinAt: #normalViewModeOver).		normalModeButton			target: self;			actionSelector: #exitPresentation:;			arguments: #(normal);			alphaOn: true.		viewModeButtons addMorphBack: normalModeButton].	presentationModeButton _ ToggleButton new		onForm: (ScratchFrameMorph skinAt: #presentationViewModeOn)		offForm: (ScratchFrameMorph skinAt: #presentationViewMode)		overForm: (ScratchFrameMorph skinAt: #presentationViewModeOver).	presentationModeButton		target: presentationModeButton;		actionSelector: #on;		alphaOn: true;		on.	viewModeButtons addMorphBack: presentationModeButton.	self addMorphBack: viewModeButtons.! !!ScratchPresenterMorph methodsFor: 'geometry' stamp: 'ee 12/11/2008 13:45' prior: 39168169!fixLayout	| stageExtent stageBox y totalW x |	stageExtent _ doubleSize ifTrue: [2 * stage extent] ifFalse: [stage extent].	stageBox _ Rectangle center: self center extent: stageExtent.	stage owner center: self center.	y _ stageBox top - 22.	buttons first position: (stageBox left + 5) @ y.  "exit presentation button"	"other buttons"	totalW _ (buttons collect: [:b | b width]) sum.	x _ stageBox right - totalW - (10 * (buttons size - 2)) - 5.	buttons do: [:b |		b position: x@y.		x _ x + b width + 10].	offscreenWorld redrawAll.	"view mode buttons"	viewModeButtons position: self topRight - (viewModeButtons width@0)  + (0@12).! !Morph subclass: #ScratchPresenterMorph	instanceVariableNames: 'frame stage buttons flagButton offscreenWorld doubleSize mouseFocus mouseDownPoint dragOffset clickWasHandled mouseMoved viewModeButtons '	classVariableNames: ''	poolDictionaries: ''	category: 'Scratch-UI-Panes'!ScratchFrameMorph removeSelector: #createToolBarPane!----STARTUP----(12 December 2008 3:07:27 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!'From MIT Squeak 0.9.4 (June 1, 2003) [No updates present.] on 12 December 2008 at 11:13:36 am'!Morph subclass: #ScratchPresenterMorph	instanceVariableNames: 'frame stage buttons flag