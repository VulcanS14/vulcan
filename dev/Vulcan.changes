odsFor: 'system primitives' stamp: 'JMM 8/23/2004 13:02'!primGetMenuItemTextEncoding: aMenuHandle item: anInteger	<primitive: 'primitiveGetMenuItemTextEncoding' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/23/2004 12:04'!primGetMenuTitle: aMenuHandle	<primitive: 'primitiveGetMenuTitle' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/23/2004 13:12'!primHideMenuBar	<primitive: 'primitiveHideMenuBar' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/26/2004 16:16'!primHiliteMenu: menuID	<primitive: 'primitiveHiliteMenu' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/26/2004 12:38'!primInsertFontResMenu: menuHandleOop afterItem: afterItemInteger scriptFilter: scriptFilterInteger	<primitive: 'primitiveInsertFontResMenu' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/23/2004 15:25'!primInsertMenu: aMenuHandle beforeID: anId	<primitive: 'primitiveInsertMenu' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/25/2004 14:39'!primInsertMenuItem: aMenuHandle itemString: str255 afterItem: anInteger	<primitive: 'primitiveInsertMenuItem' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/23/2004 14:10'!primInvalMenuBar	<primitive: 'primitiveInvalMenuBar' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsFor: 'system primitives' stamp: 'JMM 8/23/2004 13:24'!primIsMenuBarVisible	<primitive: 'primitiveIsMenuBarVisible' module: 'MacMenubarPlugin'>	self primitiveFailed! !!HostSystemMenusMacOS9 methodsF