Button		onForm: (ScratchFrameMorph skinAt: #deleteSprite)		offForm: (ScratchFrameMorph skinAt: #deleteSprite)		overForm: (ScratchFrameMorph skinAt: #deleteSprite).	deleteButton		target: self;		actionSelector: #deleteSprite;		setBalloonText: 'Delete this sprite' localized;		actWhen: #buttonUp;		isMomentary: true;		position: (lockButton right + 27)@(nameMorph top + ((nameMorph height - deleteButton height) / 2)).	self addMorph: deleteButton.! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/22/2009 21:42'!setHomeDir: aStringOrNil	"Set the home directory for this user. If the user name contains an asterisk, replace it with the name of logged in user."	aStringOrNil		ifNil: [DefaultUserProjectsFolder _ nil]		ifNotNil: [DefaultUserProjectsFolder _ FileDirectory on: aStringOrNil].! !ScratchFileChooserDialog class removeSelector: #setDefaultUserProjectFolder:!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/22/2009 21:43' prior: 40088678!startup	| settings startupFileNames fileName arg presentationMode lang |	HostSystemMenus startUp.	HostSystemMenus menuBarControler reviseHostMenus.	ScriptableScratchMorph randomInit.	ScratchTranslator detectRenderPlugin.	ScratchTranslator importLanguagesList.	TakeOverScreen ifTrue: [		Smalltalk fullScreenMode: true.		DisplayScreen startUp].	NormalModeEnabled _ (Display width >= 980) & (Display height >= 555).	(NormalModeEnabled not and: [viewMode = #normal])		ifTrue: [self enterQuarterMode].	ScratchFrameMorph readShareServerEntry.	self class setVisibleDrives: nil.	lang _ nil.	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		assoc key = 'language' ifTrue: [lang _ assoc value].		assoc key = 'homedir' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		assoc key = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.	self updateProjectName.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	shuffledCostumeNames _ nil.	author _ ''.	loginName _ ''.	loginPassword _ ''.	justSaved _ true.	presentationMode _ false.	startupFileNames _ InputSensor startupFileNames asOrderedCollection.	2 to: 10 do: [:i |		arg _ Smalltalk getSystemAttribute: i.		(arg notNil and: [arg size > 0]) ifTrue: [			startupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/22/2009 21:43' prior: 40233486!startup	| settings startupFileNames fileName arg presentationMode lang |	HostSystemMenus startUp.	HostSystemMenus menuBarControler reviseHostMenus.	ScriptableScratchMorph randomInit.	ScratchTranslator detectRenderPlugin.	ScratchTranslator importLanguagesList.	TakeOverScreen ifTrue: [		Smalltalk fullScreenMode: true.		DisplayScreen startUp].	NormalModeEnabled _ (Display width >= 980) & (Display height >= 555).	(NormalModeEnabled not and: [viewMode = #normal])		ifTrue: [self enterQuarterMode].	ScratchFrameMorph readShareServerEntry.	self class setVisibleDrives: nil.	lang _ nil.	ScratchFileChooserDialog setHomeDir: nil.	settings _ self rea