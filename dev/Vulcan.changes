	workPane scratchServer ifNotNil: [workPane scratchServer stepServer].	self processDroppedFiles.	workPane processesToRun size > 0		ifTrue: [flagButton on]		ifFalse: [flagButton off].! !!ScratchPresenterMorph methodsFor: 'stepping' stamp: 'jm 2/19/2009 19:06' prior: 37259610!step	"Run each process until it gives up control, then filter out any processes that have terminated."	| screenExtent |	screenExtent _ DisplayScreen actualScreenSize.	((self position = (0@0)) and: [self extent = screenExtent]) ifFalse: [		self position: 0@0.		^ self extent: screenExtent].	ScriptableScratchMorph scratchOrigin: stage center.	stage scratchServer ifNotNil: [stage scratchServer stepServer].	self checkForQuit.	self processWhenConditions.	self processKeyboardEvents.	stage stepProcesses.	stage step.	stage submorphsDo: [:m | m allMorphsDo: [:subM | subM step]].	offscreenWorld incrRedrawDouble: doubleSize.	stage processesToRun size > 0		ifTrue: [flagButton on]		ifFalse: [flagButton off].! !----SNAPSHOT----(19 February 2009 7:07:04 pm) priorSource: 6658399!----STARTUP----(19 February 2009 7:07:20 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!DialogBoxMorph allInstances!Smalltalk garbageCollect. DialogBoxMorph allInstances!----SNAPSHOT----(19 February 2009 7:08:41 pm) priorSource: 6661063!----STARTUP----(19 February 2009 7:13:02 pm) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!!ScratchFileChooserDialog methodsFor: 'interaction' stamp: 'jm 2/19/2009 19:18'!myScratchProjects	"My Scratch Projects button was pressed."	| projects |	projects _ ScratchFileChooserDialog getDefaultFolderForType: #project.	projects ifNotNil: [list currentDirectory: projects].! !!ScratchFileChooserDialog methodsFor: 'interaction' stamp: 'jm 2/19/2009 19:19'!sampleProjects	"Sample Projects button was pressed."	| projects |	projects _ ScratchFileChooserDialog getDefaultFolderForType: #project.	projects ifNotNil: [list currentDirectory: projects].