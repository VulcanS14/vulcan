ttom - 5.	s addMorphFront: prompter.	! !!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'jm 2/10/2009 20:47' prior: 39996256!promptForInput: questionString	| s prompter |	(s _ self ownerThatIsA: ScratchStageMorph) ifNil: [^ self].	prompter _ ScratchPrompterMorph new.	prompter left: s center x - (prompter width // 2).	prompter bottom: s bottom - 5.	s addMorphFront: prompter.	^ prompter	! !----SNAPSHOT----(10 February 2009 8:47:38 pm) priorSource: 6435640!!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'jm 2/10/2009 20:48' prior: 39996616!promptForInput: questionString	| s prompter |	(s _ self ownerThatIsA: ScratchStageMorph) ifNil: [^ self].	prompter _ ScratchPrompterMorph new.	prompter left: s center x - (prompter width // 2).	prompter bottom: s bottom - 5.	s addMorphFront: prompter.	prompter grabKeyboardFocus.	^ prompter	! !!ScratchPrompterMorph methodsFor: 'other' stamp: 'jm 2/10/2009 20:51'!grabKeyboardFocus	World activeHand newKeyboardFocus: typeinMorph.! !----QUIT----(10 February 2009 11:40:05 pm) priorSource: 6442460!----STARTUP----(11 February 2009 8:24:00 am) as /Users/jmaloney/Desktop/MIT Squeak/MITBase.image!Morph subclass: #ScriptableScratchMorph	instanceVariableNames: 'objName vars lists blocksBin isClone media costume costumeChangeMSecs filterPack visibility volume tempoBPM sceneStates '	classVariableNames: 'BlockColorDict BlockSpecDict DefaultBackgroundForm DefaultSpriteForm DoubleSize Experimental ListBlockColor MeowSound OldMeowPrefixReversed PopSound RandomGen Recorder ScratchOrigin TimerStartMSecs LastAnswer '	poolDictionaries: ''	category: 'Scratch-Objects'!!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'jm 2/11/2009 09:38'!clearAnswer	LastAnswer _ ''.! !LastAnswer _ ''.!!ScriptableScratchMorph methodsFor: 'sensing ops' stamp: 'jm 2/11/2009 09:38'!answer	^ LastAnswer! !!ScriptableScratchMorph class methodsFor: 'class initialization' stamp: 'jm 2/11/2009 09:38' p