creenMode: true.		DisplayScreen startUp].	NormalModeEnabled _ (Display width >= 980) & (Display height >= 555).	(NormalModeEnabled not and: [viewMode = #normal])		ifTrue: [self enterQuarterMode].	ScratchFrameMorph readShareServerEntry.	self class setVisibleDrives: nil.	lang _ nil.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		assoc key = 'language' ifTrue: [lang _ assoc value].		assoc key = 'homedir' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		assoc key = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value]].	ScratchFileChooserDialog createScratchProjectsFolder.	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.	self updateProjectName.	shuffledCostumeNames _ nil.	author _ ''.	loginName _ ''.	loginPassword _ ''.	justSaved _ true.	presentationMode _ false.	startupFileNames _ InputSensor startupFileNames asOrderedCollection.	2 to: 10 do: [:i |		arg _ Smalltalk getSystemAttribute: i.		(arg notNil and: [arg size > 0]) ifTrue: [			startupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 15:57' prior: 40349517!createScratchProjectsFolder	"Attempt to create a 'Scratch Projects Folder' in the user's documents folder. If the .ini file specifies an alternate home directory, create the folder there."	| scratchFolderName parentDir |	scratchFolderName _ 'Scratch Projects' localized. "if we localize, we could create many Scratch folders..."	parentDir _  FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	UserHomeFolder ifNotNil: [parentDir _ UserHomeFolder].	(parentDir directoryExists: scratchFolderName) ifFalse: [		parentDir createDirectory: scratchFolderName].! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/24/2009 15:59' prior: 40350173!startup	| settings startupFileNames fileName arg presentationMode lang |	HostSystemMenus startUp.	HostSystemMenus menuBarControler reviseHostMenus.	ScriptableScratchMorph randomInit.	ScratchTranslator detectRenderPlugin.	ScratchTranslator importLanguagesList.	TakeOverScreen ifTrue: [		Smalltalk fullScreenMode: true.		DisplayScreen startUp].	NormalModeEnabled _ (Display width >= 980) & (Display height >= 555).	(NormalModeEnabled not and: [viewMode = #normal])		ifTrue: [self enterQuarterMode].	ScratchFrameMorph readShareServerEntry.	self class setVisibleDrives: nil.	lang _ nil.	ScratchFileChooserDialog initialize. "reset state in file dialogs"	settings _ self readSettingsFile.	settings associationsDo: [:assoc |		assoc key = 'language' ifTrue: [lang _ assoc value].		assoc key = 'homedir' ifTrue: [ScratchFileChooserDialog setHomeDir: assoc value].		assoc key = 'visibledrives' ifTrue: [self class setVisibleDrives: assoc value]].	lang ifNil: [lang _ ScratchTranslator guessLanguage].	self setLanguage: lang.	ScratchFileChooserDialog createScratchProjectsFolder.	self updateProjectName.	shuffledCostumeNames _ nil.	author _ ''.	loginName _ ''.	loginPassword _ ''.	justSaved _ true.	presentationMode _ false.	startupFileNames _ InputSensor startupFileNames asOrderedCollection.	2 to: 10 do: [:i |		arg _ Smalltalk getSystemAttribute: i.		(arg notNil and: [arg size > 0]) ifTrue: [			startupFileNames addLast: (ScratchPlugin primShortToLongPath: arg)]].	startupFileNames do: [:n |		(n asLowercase = 'presentation') ifTrue: [presentationMode _ true]].	fileName _ startupFileNames		detect: [:fn |			(fn asLowercase endsWith: '.sb') or: [fn asLowercase endsWith: '.scratch']]		ifNone: [nil].	fileName ifNotNil: [		presentationMode ifTrue: [Display fillColor: Color black].		self openScratchProjectNamed: fileName.		presentationMode ifTrue: [self enterPresentationMode; shoutGo].		^ self].	viewerPane currentCategory: 'motion'.	self setDefaultSprite.	self newScratchProject.	fileName _ startupFileNames		detect: [:fn | fn asLowercase endsWith: '.sprite']		ifNone: [^ self].	"open a .sprite file"	workPane submorphs do: [:m | (m isKindOf: ScratchSpriteMorph) ifTrue: [m deleteSprite]].	self importSpriteOrProject: fileName.! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 15:59' prior: 40352570!createScratchProjectsFolder	"Attempt to create a 'Scratch Projects Folder' in the user's documents folder. If the .ini file specifies an alternate home directory, create the folder there."	| scratchFolderName parentDir |	scratchFolderName _ 'Scratch Projects' localized. "if we localize, we could create many Scratch folders..."self halt.	parentDir _  FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	UserHomeFolder ifNotNil: [parentDir _ UserHomeFolder].	(parentDir directoryExists: scratchFolderName) ifFalse: [		parentDir createDirectory: scratchFolderName].! !'Scratch Projects' localized!!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 16:01' prior: 40355644!createScratchProjectsFolder	"Attempt to create a 'Scratch Projects Folder' in the user's documents folder. If the .ini file specifies an alternate home directory, create the folder there."	| scratchFolderName parentDir |	scratchFolderName _ 'Scratch'.  "do not localize, or may get many folders..."	parentDir _  FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	UserHomeFolder ifNotNil: [parentDir _ UserHomeFolder].	(parentDir directoryExists: scratchFolderName) ifFalse: [		parentDir createDirectory: scratchFolderName].! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 16:03'!userScratchProjectsDir	"Return the path to the user's 'Scratch' project folder, usually located inside the user's 'Documents' folder."	UserHomeFolder ifNotNil: [^ UserHomeFolder].	^ ScratchPlugin primGetFolderPath: 1! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 16:08' prior: 40357013!userScratchProjectsDir	"Return the path to the user's 'Scratch' project folder, usually located inside the user's 'Documents' folder. If the folder does not already exists, ttempt to create it. If the .ini file specifies an alternate home directory, create the folder there. If the directory can't be created, return the user's home folder."	| scratchFolderName homeDir |	scratchFolderName _ 'Scratch'.  "if this were localized user could get multiple project folders..."	homeDir _  FileDirectory on: (ScratchPlugin primGetFolderPath: 3).  "documents"	UserHomeFolder ifNotNil: [homeDir _ UserHomeFolder]. "overridden by .ini file"	(homeDir directoryExists: scratchFolderName) ifFalse: [		homeDir createDirectory: scratchFolderName].	(homeDir directoryExists: scratchFolderName)		ifTrue: [^ homeDir directoryNamed: scratchFolderName]		ifFalse: [^ homeDir].! !!ScratchFileChooserDialog class methodsFor: 'accessing' stamp: 'jm 2/24/2009 16:09' prior: 40335990!getDefaultFolderForType: type	| f |	(type = #costume) ifTrue: [f _ DefaultCostumeFolder].	(type = #background) ifTrue: [f _ DefaultBackgroundFolder].	(type = #project) ifTrue: [f _ self userScratchProjectsDir].	(type = #sprite) ifTrue: [f _ DefaultSpriteFolder].	(type = #stage) ifTrue: [f _ DefaultStageFolder].	(type = #sound) ifTrue: [f _ DefaultSoundFolder].	(type = #scratch) ifTrue: [f _ DefaultScratchFolder].	f ifNotNil: [		(f isKindOf: FileDirectory) ifTrue: [			(f parentDirectory directoryExists: f pathName) ifTrue: [^ f]]].	^ self homeDir! !!ScratchFileChooserDialog class methodsFor: 'class initialization' stamp: 'jm 2/24/2009 16:09' prior: 40250257!initialize	| media |	LastBackgroundFolder _ nil.	LastCostumeFolder _ nil.	LastProjectFolder _ nil.	LastSoundFolder _ nil.	LastSpriteFolder _ nil.	LastStageFolder _ nil.	UserHomeFolder _ nil.	DefaultStageFolder _ DefaultSpriteFolder _ DefaultScratchFolder _ FileDirectory default.	(FileDirectory default directoryExists: 'Media') ifTrue: [		media _ FileDirectory default directoryNamed: 'Media'.		DefaultSpriteFolder _ media.		(media directoryExists: 'Backgrounds') ifTrue: [			DefaultBackgroundFolder _ media directoryNamed: 'Backgrounds'].		(media directoryExists: 'Costumes') ifTrue: [			DefaultCostumeFolder _ media directoryNamed: 'Costumes'.			DefaultSpriteFolder _ media directoryNamed: 'Costumes'].		(media directoryExists: 'Sounds') ifTrue: [			DefaultSoundFolder _ media directoryNamed: 'Sounds']].! !DialogBoxMorph subclass: #ScratchFileChooserDialog	instanceVariableNames: 'scratchFrame list choosingFolder newFileTitle newFileName thumbnailFrameMorph thumbnailMorph authorLabelMorph authorMorph commentLabelMorph commentMorph readingScratchFile type newTitleBin '	classVariableNames: 'DefaultBackgroundFolder DefaultCostumeFolder  DefaultScratchFolder DefaultSoundFolder DefaultSpriteFolder DefaultStageFolder LastBackgroundFolder LastCostumeFolder LastProjectFolder LastSoundFolder LastSpriteFolder LastStageFolder UserHomeFolder '	poolDictionaries: ''	category: 'Scratch-UI-Dialogs'!!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 2/