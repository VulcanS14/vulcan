min and max' 'Slider range:' 'Single-step speed?' 'Stamp tool (select area, then stamp copies of it)' 'Desktop' 'connected' 'Tags:' 'down arrow' 'delete' 'Delete' 'down' 'Delete this background' 'Turbo speed' 'Delete this sprite' 'duplicate' 'Duplicate' 'Documents' 'Delete a variable' 'don''t rotate' 'close port' '=' 'Delete this costume' 'Sprite' 'costume' 'w' 'Save failed' 'turn into new sprite' 'Sounds compressed' 'Could not read' 'Could not write file' 'Text tool (edit text layer)' 'true' 'Delete this sound' 'draggable on website?' 'Save the current project?' 'Save the current project' 'enable remote access...' 'Delete a list' 'Close paint editor?' 'Extras' 'Undo' 'Close sound recorder?' 'enter' 'Eraser' 'edge' 'Edit' '6' 'Close dialog?' 'p' 'The file name already exists. Overwrite existing file?' 'Export failed' 'up' 'thing' 'Extra operations' 'Upload succeeded!!' 'That variable name is already in use' 'Exit presentatoin' 'Uploading' 'undelete' 'export' 'Extras menu' 'Export Sound' 'Export Costume' 'export sprite' 'Enter presentation mode' 'i' 'Upload to Scratch Server' 'Exit presentation mode' 'up arrow' 'enable remote sensor connections' 'Export Background' 'Export Sprite' 'cancel' 'Eyedropper tool (select a color)' 'Could not read project; file may be damaged' 'Updating thumbnails' 'Eraser size' 'export this sprite' '/' 'Sprites' 'Undo the last delete' 'Share' 'Failed:' 'Save this project' 'Ellipse tool (draw outlined or filled ellipse or circle)' 'Share this project' 'Switch to small stage view' 'File' 'Switch to full stage view' 'Switch to presentation view' 'Variable name?' 'View on stage' 'For all sprites' 'b' 'Examples' 'false' 'first' 'Close and continue.' 'Flip vertically' 'File not found' 'Flip horizontally' 'Close and continue' 'fisheye' 'For this sprite only' 'Flash blocks (fast)' 'Flash blocks (slow)' '!!' '>' 'x' 'Hmm...' 'x:' 'Fill tool (fill areas with color or gradient)' 'Game' 'Grow' 'Get help' '7' 'whirl' 'ghost' 'q' 'Want Help?' 'Get the last thing deleted' 'Grow sprite' 'write multiple project summaries' 'Get surprise sprite' 'write project summary' 'grab screen region for new costume' '0' 'j' 'grab screen region for new sprite' 'y:' 'import project..' 'help' 'Home' 'Help' 'Hello!!' 'c' '(empty)' 'High (biggest)' 'Yes' 'y' 'JPEG Quality (10-100)?' 'Import Project' 'import project' 'Import Image' 'Images compressed' 'import' 'Import' 'Import Sound' 'Import Costume' 'Your project is now online at' 'Import Background' '8' 'Incompatible Scratch file format' 'Import List' 'r' 'Your Scratch website login name:' 'Import an image on top of your current canvas' 'Is the folder read-only?' '1' 'k' 'Zoom in' #[ 'Zoom out' '*' 'd' 'kbytes' 'z' '9' 's' 'left' 'light' 'Language' 'ln' 'List name?' 'Low' 'log' '2' 'last' 'l' 'left arrow' 'length' 'launch help' 'large readout' 'Lowest (smallest)' 'Line tool (draw lines)' '+' 'e' 'Music' 'mosaic' 'Message name:' 'meow' 'mod' #] 'Min:' 'more' 'mouse-pointer' 'Move' 'Make a variable' 'Max:' 'More tags:' 'Make a list' 'My Projects' 'mouse x:' 'mouse y:') do:[:t |		self addUITranslation: t].! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'ee 3/2/2009 10:47' prior: 39206713!mouseEnter: evt	(#resize = type)		ifTrue: [self form: (ScratchFrameMorph skinAt: #spriteResizeOver)]		ifFalse: [self form: (ScratchFrameMorph skinAt: #spriteRotateOver)].! !!SpriteHandleMorph methodsFor: 'event handling' stamp: 'ee 3/2/2009 10:45' prior: 39206974!mouseLeave: evt	(#resize = type)		ifTrue: [self form: (ScratchFrameMorph skinAt: #spriteResize)]		ifFalse: [self form: (ScratchFrameMorph skinAt: #spriteRotate)].! !!SpriteHandleMorph class methodsFor: 'instance creation' stamp: 'ee 3/2/2009 10:44' prior: 39223718!resize: aSprite	"create my single instance and set it to resize aSprite"		self vanish.	Current _ self new 		type: #resize;		form: (ScratchFrameMorph skinAt: #spriteResize); 		target: aSprite;		setBalloonText: 'drag to resize' localized.	^ Current! !!SpriteHandleMorph class methodsFor: 'instance creation' stamp: 'ee 3/2/2009 10:44' prior: 39224079!rotate: aSprite	"create my single instance and set it to rotate aSprite"		self vanish.	Current _ self new 		type: #rotate;		form: (ScratchFrameMorph skinAt: #spriteRotate); 		target: aSprite;		setBalloonText: 'drag to rotate' localized.	^ Current! !ScratchTalkBubbleMorph removeSelector: #isPrompt:!ScratchTalkBubbleMorph removeSelector: #usePromptColor!ScratchTalkBubbleMorph removeSelector: #usePromptColor!ScratchSpriteMorph removeSelector: #bubble:thinkFlag:!ScratchSpriteMorph removeSelector: #bubble:thinkFlag:!ScratchPrompterMorph class removeSelector: #promptColor!ScratchPrompterMorph class removeSelector: #promptColor!ScratchFrameMorph class removeSelector: #helpServer!ScratchFrameMorph class removeSelector: #helpServer!self readSkinFrom: (FileDirectory default directoryNamed: 'ScratchSkin')!----SNAPSHOT----(2 March 2009 5:10:42 pm) priorSource: 7043847!----SNAPSHOT----(2 March 2009 5:13:04 pm) priorSource: 7066991!ScratchFrameMorph version: '1.4 (internal of ', (Date today printFormat: #(1 2 3 $- 2 2)), ')'.ScratchFrameMorph initFonts.ScratchFrameMorph isXO: false.ScratchTranslator resetUITranslationSet.ScratchTranslator resetMIDITranslationSet.ScratchFrameMorph putInClipboard: nil.Preferences setMenuFontTo: (StrikeFont fontName: 'Verdana11' size: 11).Utilities clearAuthorInfo.TranscriptStream allInstances do: [:t | t on: (String new: 1000)].ScriptableScratchMorph buildBlockSpecDictionary.ScratchTranslator setLanguage: 'en'.PaintFrame clearColorPickers.SystemWindow clearTopWindow.HandMorph clearPasteBuffer.Smalltalk reclaimDependents.Smalltalk forgetDoIts.Smalltalk removeEmptyMessageCategories.Symbol rehash.Smalltalk garbageCollect.Array with: Metaclass instanceCount with: CompiledMethod instanceCount with: Smalltalk obsoleteClasses size!Undeclared!Smalltalk unimplemented!Smalltalk removeKey: #AAA.!