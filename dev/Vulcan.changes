 skinAt: bName, 'quarterViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true.		viewModeButtons add: button.		aMorph addMorphBack: button].! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 11/18/2008 15:33' prior: 39038856!addViewModeButtonsTo: aMorph	| specs bName button |	viewModeButtons _ OrderedCollection new.	specs _ #(		(normal		enterPresentationMode)		(quarter	exitPresentationMode)).	specs do: [:spec |		bName _ spec first.		button _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOn')			offForm: (ScratchFrameMorph skinAt: bName, 'quarterViewMode')			overForm: (ScratchFrameMorph skinAt: bName, 'quarterViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true.		aMorph			addMorphBack: button;			addMorphBack: (Morph new extent: 5@5; color: Color transparent).		viewModeButtons add: button].! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 11/18/2008 15:34' prior: 37007178!createMenuPanel	"Create and add a panel containing the menus and close button."	| menuSpecs m closeButton |	"create panel"	menuPanel _ AlignmentMorph new		color: Color transparent;		centering: #center;		inset: 0;		height: 0.	"will grow as needed"	"menuSpecs defines the menus"	menuSpecs _ #(		"name			selector			tool tip"		(File			fileMenu		'Open, save, and share projects')		(Undo			undoTool		'Undo the last delete')		(Language		languageMenu	'Switch languages')		(Extra			extraMenu		'Extra operations')		('Share!!'		shareDisabled	'Share your project on the web')		(Help			launchHelp		'Get help')	).	menuSpecs do: [:spec |		m _ ScratchMenuTitleMorph new			contents: (spec at: 1) localized;			target: self selector: (spec at: 2);			setProperty: #balloonText toValue: (spec at: 3) localized.		(#(undoTool share launchHelp) includes: m selector) ifTrue: [m actOnMouseUp: true].		menuPanel addMorphBack: m.		menuPanel addMorphBack: (Morph new color: Color transparent; extent: 12@5)].	menuPanel addMorphBack: (AlignmentMorph newSpacer: Color transparent).	self addViewModeButtonsTo: menuPanel.	closeButton _ IconicButton new		labelGraphic: (ScratchFrameMorph skinAt: 'closeIcon') borderWidth: 0;		actionSelector: #quitScratch;		target: self;		actWhen: #buttonDown.	menuPanel addMorphBack: closeButton.	topPane addMorph: menuPanel.! !!ScratchFrameMorph methodsFor: 'intialization' stamp: 'jm 11/18/2008 15:35' prior: 39039537!addViewModeButtonsTo: aMorph	| specs bName button |	viewModeButtons _ OrderedCollection new.	specs _ #(		(normal		enterPresentationMode)		(quarter	exitPresentationMode)).	specs do: [:spec |		bName _ spec first.		button _ ToggleButton new			onForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOn')			offForm: (ScratchFrameMorph skinAt: bName, 'ViewMode')			overForm: (ScratchFrameMorph skinAt: bName, 'ViewModeOver').		button			target: self;			actionSelector: (spec at: 2);			alphaOn: true.		aMorph			addMorphBack: button;			addMorphBack: (Morph new extent: 5@5; color: Color transparent).		viewModeButtons add: button].! !!ScratchFrameMorph methodsFor: 'geometry' stamp: 'jm 11/18/2008 15:36' prior: 39037066!fixLayout	| stageExtent |	workPane ifNil: [^ self]. "not yet fully initialized"	stageExtent _		workPane isQuarterSize			ifTrue: [workPane extent // 2]			ifFalse: [workPane extent].	topPane		position: self topLeft;		width: self width;		height: (menuPanel height + 0 max: logoMorph height + 6).	stageFrame		extent: stageExtent + (14@49);		top: topPane bottom;		right: self right.	workPane position: stageFrame topLeft + (4@44).	viewerPane position: topPane bottomLeft;		width: viewerPane catButtonsExtent x + 17;		height: self bottom - topPane bottom.	scriptsPane position: viewerPane topRight;		width: self width - (stageFrame width + viewerPane width);		height: self bottom - topPane bottom.	libraryPane position: stageFrame bottomLeft;